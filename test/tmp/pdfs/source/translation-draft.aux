\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Shape correlation of the Open EFToI bispectrum with the standard \textit  {equilateral}, \textit  {orthogonal} and \textit  {local} templates, as used in \textit  {Planck}'s non-Gaussianity analysis. The shaded regions show the envelope obtained by varying $c_s$ between $0.01$ and $1$. At strong dissipation, the signal correlates with the equilateral template at the $90\%$ level. At weak dissipation, the signal peaks in a strongly folded configuration whose correlations with standard templates depend on $c_s$ and are not generically orthogonal. Figure taken from \cite  {Salcedo:2026sdn}.}}{119}{figure.caption.89}\protected@file@percent }
\newlabel{fig:shapecorrel}{{8}{119}{Shape correlation of the Open EFToI bispectrum with the standard \textit {equilateral}, \textit {orthogonal} and \textit {local} templates, as used in \textit {Planck}'s non-Gaussianity analysis. The shaded regions show the envelope obtained by varying $c_s$ between $0.01$ and $1$. At strong dissipation, the signal correlates with the equilateral template at the $90\%$ level. At weak dissipation, the signal peaks in a strongly folded configuration whose correlations with standard templates depend on $c_s$ and are not generically orthogonal. Figure taken from \cite {Salcedo:2026sdn}}{figure.caption.89}{}}
