\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 弱い散逸 $\gamma =0.001H$ の場合のバイスペクトル形状。信号は $x_2+x_3=1$ の折り畳み配置付近で最大となる。$x_3\ll x_2=1$ のスクイーズ極限では整合関係が引き続き成り立つ。微小な振動は有限区間の数値積分による人工的なものである。\textbf  {a：}$(\partial _i\pi _{r})^2\pi _{a}$、\textbf  {b：}$\dot  {\pi }_r^2\pi _{a}$、\textbf  {c：}$\dot  {\pi }_r\pi _{a}^2$、\textbf  {d：}$\pi _{a}^3$。}}{101}{figure.caption.64}\protected@file@percent }
\newlabel{fig:shapes_low}{{9}{101}{弱い散逸 $\gamma =0.001H$ の場合のバイスペクトル形状。信号は $x_2+x_3=1$ の折り畳み配置付近で最大となる。$x_3\ll x_2=1$ のスクイーズ極限では整合関係が引き続き成り立つ。微小な振動は有限区間の数値積分による人工的なものである。\textbf {a：}$(\partial _i\pir )^2\pia $、\textbf {b：}$\dot {\pi }_r^2\pia $、\textbf {c：}$\dot {\pi }_r\pia ^2$、\textbf {d：}$\pia ^3$。}{figure.caption.64}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 強い散逸 $\gamma =5H$ における、接触型バイスペクトルのさまざまな寄与について、$x_2=1$ に沿った形状関数。整合関係により $x_3\ll 1$ のスクイーズ極限で信号はゼロになる。}}{101}{figure.caption.65}\protected@file@percent }
\newlabel{fig:squeezed}{{10}{101}{強い散逸 $\gamma =5H$ における、接触型バイスペクトルのさまざまな寄与について、$x_2=1$ に沿った形状関数。整合関係により $x_3\ll 1$ のスクイーズ極限で信号はゼロになる。}{figure.caption.65}{}}
