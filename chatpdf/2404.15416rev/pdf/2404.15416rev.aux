\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 式~\eqref  {eq:D2resultdissip} の Minkowski 時空の $\dot  {\pi }_a^3$ が生む接触型バイスペクトルの形状関数。左：散逸が小さいと、式~\eqref  {eq:singdissip} の $\mathrm  {Sing}_\gamma $ が $x_2+x_3\simeq 1$ の折り畳み領域で小さくなり、バイスペクトルが増強される。右：散逸が大きいと、散逸による虚数項が $\mathrm  {Sing}_\gamma $ を支配し、折り畳み領域での増強は見られない。}}{96}{figure.caption.57}\protected@file@percent }
\newlabel{fig:shapeMink}{{6}{96}{\Eq {eq:D2resultdissip} の Minkowski 時空の $\dot {\pi }_a^3$ が生む接触型バイスペクトルの形状関数。左：散逸が小さいと、\Eq {eq:singdissip} の $\mathrm {Sing}_\gamma $ が $x_2+x_3\simeq 1$ の折り畳み領域で小さくなり、バイスペクトルが増強される。右：散逸が大きいと、散逸による虚数項が $\mathrm {Sing}_\gamma $ を支配し、折り畳み領域での増強は見られない。}{figure.caption.57}{}}
