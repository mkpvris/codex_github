\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces 式~\eqref  {eq:L13}、\eqref  {eq:L23}、\eqref  {eq:L33} の三次相互作用が接触型バイスペクトルへ与える非零の寄与。$\mathrm  {Sing}_\gamma $ は 式~\eqref  {eq:singdissip} に示し、$K^2\equiv {\bm  {k}}_1\cdot {\bm  {k}}_2+{\bm  {k}}_1\cdot {\bm  {k}}_3+{\bm  {k}}_2\cdot {\bm  {k}}_3$ と定義した。$\mathrm  {Poly}_n$ は 式~\eqref  {eq:var} の変数の多項式である。読みやすさのためその詳細は省略した。}}{98}{table.caption.61}\protected@file@percent }
\newlabel{tab:cubicdissip}{{1}{98}{\Eqs {eq:L13}、\eqref {eq:L23}、\eqref {eq:L33} の三次相互作用が接触型バイスペクトルへ与える非零の寄与。$\mathrm {Sing}_\gamma $ は \Eq {eq:singdissip} に示し、$K^2\equiv \bmk _1\cdot \bmk _2+\bmk _1\cdot \bmk _3+\bmk _2\cdot \bmk _3$ と定義した。$\mathrm {Poly}_n$ は \Eq {eq:var} の変数の多項式である。読みやすさのためその詳細は省略した。}{table.caption.61}{}}
