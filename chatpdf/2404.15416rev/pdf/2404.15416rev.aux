\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 運動量保存 $\delta ({\bm  {k}}_1+{\bm  {k}}_2+{\bm  {k}}_3)$ を満たす三角形の形状。$x_2\equiv k_2/k_1$、$x_3\equiv k_3/k_1$ とし、閉じた三角形を作る条件 $x_3<x_2<1$、$x_2+x_3>1$ を満たす。特に関心があるのは $x_2+x_3\simeq 1$ の折り畳み領域で、スクイーズ配置と等脚折り畳み配置をつなぐ。式~\eqref  {eq:singdissip} の特異性構造はこの領域付近でピークをもち、散逸的ダイナミクスの明瞭な兆候を与える。}}{95}{figure.caption.56}\protected@file@percent }
\newlabel{fig:triangles}{{5}{95}{運動量保存 $\delta (\bmk _1+\bmk _2+\bmk _3)$ を満たす三角形の形状。$x_2\equiv k_2/k_1$、$x_3\equiv k_3/k_1$ とし、閉じた三角形を作る条件 $x_3<x_2<1$、$x_2+x_3>1$ を満たす。特に関心があるのは $x_2+x_3\simeq 1$ の折り畳み領域で、スクイーズ配置と等脚折り畳み配置をつなぐ。\Eq {eq:singdissip} の特異性構造はこの領域付近でピークをもち、散逸的ダイナミクスの明瞭な兆候を与える。}{figure.caption.56}{}}
