\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 強い散逸 $\gamma =5H$ の場合のバイスペクトル形状。この領域では $x_2=x_3=1$ の正三角形配置で信号が最大になる。$x_3\ll x_2=1$ のスクイーズ極限でも整合関係を満たす。\textbf  {a：}$(\partial _i\pi _{r})^2\pi _{a}$、\textbf  {b：}$\dot  {\pi }_r^2\pi _{a}$、\textbf  {c：}$\dot  {\pi }_r\pi _{a}^2$、\textbf  {d：}$\pi _{a}^3$。}}{100}{figure.caption.63}\protected@file@percent }
\newlabel{fig:shapes_high}{{8}{100}{強い散逸 $\gamma =5H$ の場合のバイスペクトル形状。この領域では $x_2=x_3=1$ の正三角形配置で信号が最大になる。$x_3\ll x_2=1$ のスクイーズ極限でも整合関係を満たす。\textbf {a：}$(\partial _i\pir )^2\pia $、\textbf {b：}$\dot {\pi }_r^2\pia $、\textbf {c：}$\dot {\pi }_r\pia ^2$、\textbf {d：}$\pia ^3$。}{figure.caption.63}{}}
