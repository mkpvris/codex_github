\citation{ref001}
\citation{ref322}
\citation{ref496}
\@writefile{lof}{\contentsline {figure}{\numberline {9.7}{\ignorespaces 微小管中のキンク状励起の模型。微小管の一端で、チューブリン二量体の$\alpha $状態と$\beta $状態の間の立体配座転換に対応する、局所的双極子モーメントの変化が、二量体間の双極子相互作用を介して、微小管軸に沿って進む。これによって、微小管軸方向の双極子モーメント$p(z)$にキンク状励起が生じ、その励起が微小管軸に沿って高速で伝播する。簡単のため、ここでは$\alpha $状態と$\beta $状態を、微小管軸方向の電気双極子モーメントが、大きさは等しく向きが逆の値に対応させている。}}{71}{figure.250}\protected@file@percent }
