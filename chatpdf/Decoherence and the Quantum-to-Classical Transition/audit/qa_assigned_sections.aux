\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces 微小管の双極子モーメント。左：$\alpha $、$\beta $単量体からなる各チューブリン二量体は、小型の電気双極子として働く。中央：プロトフィラメントは、そのような電気双極子の鎖である。右：プロトフィラメントは、平行に束ねられて微小管を形成するため、微小管は個々のプロトフィラメントの双極子モーメントの和に等しい、双極子モーメントを持つ。}}{70}{figure.246}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.6}{\ignorespaces チューブリン二量体の二つの立体配座状態$\alpha $と$\beta $。}}{70}{figure.248}\protected@file@percent }
