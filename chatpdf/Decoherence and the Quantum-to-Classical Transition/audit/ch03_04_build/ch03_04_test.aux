\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces 環境散乱。光子や空気分子などの粒子の集まりが、対象となる物体によって散乱される。}}{5}{figure.3.2}\protected@file@percent }
\newlabel{fig:3.2}{{3.2}{5}{環境散乱。光子や空気分子などの粒子の集まりが、対象となる物体によって散乱される。}{figure.3.2}{}}
\citation{ref166}
\citation{ref159}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces 一回の散乱事象。初期状態$|\chi _{\mathrm  i}\rangle $で記述される入射環境粒子が、静止した対象物によって弾性散乱される。対象物の重心状態は位置固有状態$|\bm  {x}\rangle $で表される。散乱ポテンシャルの到達範囲は十分短く、物体と入射粒子の状態は初め無相関である。物体は散乱される環境粒子よりはるかに重く、散乱事象によって乱されないと仮定する。したがって、この相互作用は$|\bm  {x}\rangle |\chi _{\mathrm  i}\rangle \DOTSB \relbar \joinrel \rightarrow |\bm  {x}\rangle |\chi (\bm  {x})\rangle $という発展をもたらす。$|\chi (\bm  {x})\rangle $は散乱粒子の終状態である［(3.12)も参照］。}}{6}{figure.3.3}\protected@file@percent }
\newlabel{fig:3.3}{{3.3}{6}{一回の散乱事象。初期状態$|\chi _{\mathrm i}\rangle $で記述される入射環境粒子が、静止した対象物によって弾性散乱される。対象物の重心状態は位置固有状態$|\bm x\rangle $で表される。散乱ポテンシャルの到達範囲は十分短く、物体と入射粒子の状態は初め無相関である。物体は散乱される環境粒子よりはるかに重く、散乱事象によって乱されないと仮定する。したがって、この相互作用は$|\bm x\rangle |\chi _{\mathrm i}\rangle \longrightarrow |\bm x\rangle |\chi (\bm x)\rangle $という発展をもたらす。$|\chi (\bm x)\rangle $は散乱粒子の終状態である［(3.12)も参照］。}{figure.3.3}{}}
\citation{ref058}
\citation{ref160}
