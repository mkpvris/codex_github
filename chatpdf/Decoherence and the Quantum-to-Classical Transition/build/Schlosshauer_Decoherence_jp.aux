\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Gaussian密度行列(3.79)の記述に関係する、主な量のいくつかの図解。密度行列の非対角方向$x=-x'$における広がりは、系が空間的干渉効果を示しうる特徴的距離を測るコヒーレンス長$\ell (t)\equiv 1/\sqrt  {8A(t)}$で定量化される。アンサンブル幅$\Delta X(t)\equiv 1/\sqrt  {8C(t)}$は、異なる位置$x$についての確率分布$P(x,t)\equiv \rho _{\mathrm  S}(x,x,t)$の大きさを表す。}}{105}{figure.616}\protected@file@percent }
\newlabel{fig:3.4}{{3.4}{105}{Gaussian密度行列(3.79)の記述に関係する、主な量のいくつかの図解。密度行列の非対角方向$x=-x'$における広がりは、系が空間的干渉効果を示しうる特徴的距離を測るコヒーレンス長$\ell (t)\equiv 1/\sqrt {8A(t)}$で定量化される。アンサンブル幅$\Delta X(t)\equiv 1/\sqrt {8C(t)}$は、異なる位置$x$についての確率分布$P(x,t)\equiv \rho _{\mathrm S}(x,x,t)$の大きさを表す。}{figure.616}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces 初期密度行列$\rho _{\mathrm  S}(x,x',0)$［(3.85)参照］の図解。密度行列は$(x,x')$平面で対称なGaussianの形をもち、コヒーレンス長$\ell (0)$（「非対角」$x=-x'$に沿う広がり）が、アンサンブル幅$\Delta X(0)$（対角$x=x'$に沿う幅）に等しい。}}{106}{figure.632}\protected@file@percent }
\newlabel{fig:3.5}{{3.5}{106}{初期密度行列$\rho _{\mathrm S}(x,x',0)$［(3.85)参照］の図解。密度行列は$(x,x')$平面で対称なGaussianの形をもち、コヒーレンス長$\ell (0)$（「非対角」$x=-x'$に沿う広がり）が、アンサンブル幅$\Delta X(0)$（対角$x=x'$に沿う幅）に等しい。}{figure.632}{}}
\newlabel{srcpage:142}{{3.5}{106}{デコヒーレンスの動力学の図解}{figure.632}{}}
