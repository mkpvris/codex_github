\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces 放射環境および気体環境に浸っている、大きさ$a=10^{-3}\,\mathrm  {cm}$の塵粒子と大きさ$a=10^{-6}\,\mathrm  {cm}$の大きな分子についての散乱定数$\Lambda $の見積もり（単位：$\mathrm  {cm}^{-2}\,\mathrm  s^{-1}$）。量$\Lambda (\Delta x)^2$は、距離$\Delta x$にわたる空間的コヒーレンスがデコヒーレンスによって抑制される特徴的な率に対応する。最初の2行の光子環境の値は(3.67)から、最後の2行の空気分子の散乱（室温）の値は(3.73)、(3.74)から得た。}}{100}{table.582}\protected@file@percent }
\newlabel{tab:3.1}{{3.1}{100}{放射環境および気体環境に浸っている、大きさ$a=10^{-3}\,\mathrm {cm}$の塵粒子と大きさ$a=10^{-6}\,\mathrm {cm}$の大きな分子についての散乱定数$\Lambda $の見積もり（単位：$\mathrm {cm}^{-2}\,\mathrm s^{-1}$）。量$\Lambda (\Delta x)^2$は、距離$\Delta x$にわたる空間的コヒーレンスがデコヒーレンスによって抑制される特徴的な率に対応する。最初の2行の光子環境の値は(3.67)から、最後の2行の空気分子の散乱（室温）の値は(3.73)、(3.74)から得た。}{table.582}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.2}{\ignorespaces 物体の大きさ$a$に等しい距離$\Delta x$にわたる空間的干渉を抑制するデコヒーレンス時間尺度$\tau _{\Delta x}=\Lambda ^{-1}(\Delta x)^{-2}$の見積もり（秒）。塵粒子では$\Delta x=a=10^{-3}\,\mathrm  {cm}$、大きな分子では$\Delta x=a=10^{-6}\,\mathrm  {cm}$とした。表3.1の$\Lambda $の値を用いて計算した。}}{100}{table.584}\protected@file@percent }
\newlabel{tab:3.2}{{3.2}{100}{物体の大きさ$a$に等しい距離$\Delta x$にわたる空間的干渉を抑制するデコヒーレンス時間尺度$\tau _{\Delta x}=\Lambda ^{-1}(\Delta x)^{-2}$の見積もり（秒）。塵粒子では$\Delta x=a=10^{-3}\,\mathrm {cm}$、大きな分子では$\Delta x=a=10^{-6}\,\mathrm {cm}$とした。表3.1の$\Lambda $の値を用いて計算した。}{table.584}{}}
