\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces 環境散乱。光子や空気分子などの粒子の集まりが、対象となる物体によって散乱される。}}{88}{figure.441}\protected@file@percent }
\newlabel{fig:3.2}{{3.2}{88}{環境散乱。光子や空気分子などの粒子の集まりが、対象となる物体によって散乱される。}{figure.441}{}}
