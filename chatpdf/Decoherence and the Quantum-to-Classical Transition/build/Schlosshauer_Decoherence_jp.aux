\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces (5.125)で与えられるスペクトル密度$J(\omega )$（単位：$4J_0$）。スペクトル密度は、カットオフ振動数$\Lambda $より十分低い振動数では、ほぼOhmic、すなわち$J(\omega )\propto \omega $になるように選んだ。$\omega >\Lambda $では、Ohmicな性質は$e^{-\omega /\Lambda }$という項によって抑えられる。振動数$\omega $の単位はカットオフ$\Lambda $である。}}{167}{figure.846}\protected@file@percent }
\newlabel{fig:5.6}{{5.6}{167}{(5.125)で与えられるスペクトル密度$J(\omega )$（単位：$4J_0$）。スペクトル密度は、カットオフ振動数$\Lambda $より十分低い振動数では、ほぼOhmic、すなわち$J(\omega )\propto \omega $になるように選んだ。$\omega >\Lambda $では、Ohmicな性質は$e^{-\omega /\Lambda }$という項によって抑えられる。振動数$\omega $の単位はカットオフ$\Lambda $である。}{figure.846}{}}
\newlabel{srcpage:217}{{5.3.1}{168}{\hyperlink {toc}{デコヒーレンスの時間尺度}}{section*.847}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces 指数$\Gamma (t)$［(5.126)参照］の時間依存性（単位：$J_0$）。時間の単位はカットオフ周期$\Lambda ^{-1}$である。浴温度は$k_{\mathrm  B}T=\Lambda /60$、すなわち熱相関時間がカットオフ周期$\Lambda ^{-1}$の60倍長いと仮定した。}}{168}{figure.849}\protected@file@percent }
\newlabel{fig:5.7}{{5.7}{168}{指数$\Gamma (t)$［(5.126)参照］の時間依存性（単位：$J_0$）。時間の単位はカットオフ周期$\Lambda ^{-1}$である。浴温度は$k_{\mathrm B}T=\Lambda /60$、すなわち熱相関時間がカットオフ周期$\Lambda ^{-1}$の60倍長いと仮定した。}{figure.849}{}}
\newlabel{srcpage:218}{{5.3.1}{169}{\hyperlink {toc}{デコヒーレンスの時間尺度}}{figure.849}{}}
