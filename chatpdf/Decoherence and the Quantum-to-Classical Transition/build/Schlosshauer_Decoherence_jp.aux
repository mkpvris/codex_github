\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces デコヒーレンス因子$r(t)=\langle E_-(t)|E_+(t)\rangle $、すなわち環境の相対状態の重なりの時間発展。$N=20$個の調和振動子からなる環境について、厳密な発展(5.108)と短時間近似(5.110)の両方を示した。結合$g_i$と振動数$\omega _i$は、区間$[0,1]$から無作為に選んだ。}}{165}{figure.843}\protected@file@percent }
\newlabel{fig:5.5}{{5.5}{165}{デコヒーレンス因子$r(t)=\langle E_-(t)|E_+(t)\rangle $、すなわち環境の相対状態の重なりの時間発展。$N=20$個の調和振動子からなる環境について、厳密な発展(5.108)と短時間近似(5.110)の両方を示した。結合$g_i$と振動数$\omega _i$は、区間$[0,1]$から無作為に選んだ。}{figure.843}{}}
