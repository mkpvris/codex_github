\@writefile{toc}{\contentsline {section}{\numberline {1}デコヒーレンスへの導入}{1}{section*.7}\protected@file@percent }
\newlabel{chap:1}{{1}{1}{デコヒーレンスへの導入}{section*.7}{}}
\newlabel{srcpage:1}{{1}{1}{デコヒーレンスへの導入}{section*.7}{}}
\newlabel{srcpage:2}{{1}{1}{デコヒーレンスへの導入}{section*.7}{}}
\citation{ref003}
\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces Schrödingerの猫の逆説の模式図。左：量子力学の法則は、不安定な原子、ハンマー、毒、猫を含む複合系を、古典的には互いに両立しない二つの状態の重ね合わせにする。一方には生きた猫が、他方には死んだ猫が含まれる。右：量子力学の標準的解釈によれば、観測者が箱を開けて猫を見ると、重ね合わせはその二成分のいずれか（ここでは「生きている」成分）へと「収縮」する。しかし、これは箱が開かれる前の猫の状態という問いを先送りする。}}{2}{figure.9}\protected@file@percent }
\newlabel{srcpage:3}{{1}{2}{デコヒーレンスへの導入}{figure.9}{}}
\newlabel{srcpage:4}{{1}{3}{デコヒーレンスへの導入}{figure.9}{}}
\newlabel{srcpage:5}{{1}{4}{デコヒーレンスへの導入}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces 量子もつれの原理の模式図。初めはそれぞれの量子状態$\psi _{\mathcal  A}$および$\psi _{\mathcal  B}$によって記述される二つの系$\mathcal  A$と$\mathcal  B$を考える。この二つの系がある仕方で相互作用すると、このような個々の量子状態ではもはや記述できなくなる。二つの系は互いにもつれ、複合系$\mathcal  {AB}$にだけ量子状態$\psi _{\mathcal  {AB}}$を割り当てられる。}}{4}{figure.11}\protected@file@percent }
\newlabel{srcpage:6}{{1}{4}{デコヒーレンスへの導入}{figure.11}{}}
\citation{ref004}
\citation{ref005}
\citation{ref006}
\citation{ref007}
\citation{ref008}
\citation{ref009}
\citation{ref010}
\newlabel{srcpage:7}{{1}{5}{デコヒーレンスへの導入}{Item*.13}{}}
\newlabel{srcpage:8}{{1}{5}{デコヒーレンスへの導入}{Item*.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces 古典的な場合と量子的な場合で環境が系に及ぼす影響の違いを、全方向から入射する光（光子）の中に置かれた巨視的物体を例に示す。左：古典的な場合には、環境が系と強く相互作用していても、物体による光の散乱は物体の運動を変えない。右：量子的な場合には、相互作用によって物体と光子のもつれた状態$\psi _{\text  {物体＋光子}}$が生じる。コヒーレンスは物体から非局在化し、干渉縞のような量子効果は系のレベルで観測できなくなる。}}{6}{figure.15}\protected@file@percent }
\newlabel{srcpage:9}{{1}{6}{デコヒーレンスへの導入}{figure.15}{}}
\newlabel{srcpage:10}{{1}{7}{デコヒーレンスへの導入}{figure.15}{}}
