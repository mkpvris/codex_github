], "signature_block": "RANANa", "first_name": "A.", "uuid": "41cd196b-3e85-4d14-8e4a-23bec5375289", "recid": 1998168}, {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02n742c10"}], "full_name_unicode_normalized": "weber, t.", "full_name": "Weber, T.", "record": {"$ref": "https://inspirehep.net/api/authors/2053863"}, "ids": [{"schema": "INSPIRE BAI", "value": "T.Weber.6"}], "last_name": "Weber", "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903287"}, "value": "Trieste U."}], "signature_block": "WABARt", "first_name": "T.", "uuid": "c4ccd31f-15dd-4640-a374-9d4312c244ce", "recid": 2053863}], "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "references": [{"reference": {"publication_info": {"journal_volume": "37", "artid": "293", "page_start": "293", "journal_title": "Helv.Phys.Acta"}}}, {"reference": {"publication_info": {"journal_volume": "69", "artid": "80", "page_start": "80", "journal_title": "Prog.Theor.Phys.Suppl."}}}, {"reference": {"publication_info": {"journal_volume": "72", "artid": "79", "page_start": "79", "journal_title": "Nuovo Cim.B"}}}, {"reference": {"publication_info": {"journal_volume": "25", "artid": "583", "page_start": "583", "journal_title": "Contemp.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "5", "artid": "848", "page_start": "848", "journal_title": "J.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/9124"}}, {"reference": {"publication_info": {"journal_volume": "4", "artid": "331", "page_start": "331", "journal_title": "Commun.Math.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "87", "artid": "395", "page_start": "395", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/181927"}}, {"reference": {"publication_info": {"journal_volume": "244", "artid": "125", "page_start": "125", "journal_title": "Nucl.Phys.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/194105"}}, {"reference": {"publication_info": {"journal_volume": "241", "artid": "381", "page_start": "381", "journal_title": "Nucl.Phys.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/190725"}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "119", "page_start": "119", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/98305"}}, {"reference": {"publication_info": {"journal_volume": "150", "artid": "1070", "page_start": "1070", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/50839"}}], "number_of_pages": 60, "referenced_authors_bais": ["Dimitri.V.Nanopoulos.1", "J.S.Hagelin.1", "M.E.Peskin.1", "Stephen.W.Hawking.1", "T.Banks.1", "M.Srednicki.1", "R.Haag.1", "O.W.Greenberg.1", "G.Lindblad.1", "R.J.Genolio.1", "D.Kastler.2", "L.Susskind.1", "J.R.Ellis.1"], "legacy_version": "20180320150534.0", "inspire_categories": [{"term": "Computing"}], "legacy_creation_date": "1986-05-05", "preprint_date": "1985-12", "author_count": 3, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02n742c10"}, {"schema": "ROR", "value": "https://ror.org/009gyvm78"}], "full_name": "Ghirardi, G.C.", "last_name": "Ghirardi", "first_name": "G.C.", "recid": 1008494}, "control_number": 222969, "dois": [{"value": "10.1103/PhysRevD.34.470"}], "earliest_date": "1985-12", "document_type": ["article"], "texkeys": ["Ghirardi:1985mt"], "abstracts": [{"source": "APS", "value": "An explicit model allowing a unified description of microscopic and macroscopic systems is exhibited. First, a modified quantum dynamics for the description of macroscopic objects is constructed and it is shown that it forbids the occurrence of linear superpositions of states localized in far-away spatial regions and induces an evolution agreeing with classical mechanics. This dynamics also allows a description of the evolution in terms of trajectories. To set up a unified description of all physical phenomena, a modification of the dynamics, with respect to the standard Hamiltonian one, is then postulated also for microscopic systems. It is shown that one can consistently deduce from it the previously considered dynamics for the center of mass of macroscopic systems. Choosing in an appropriate way the parameters of the so-obtained model one can show that both the standard quantum theory for microscopic objects and the classical behavior for macroscopic objects can all be derived in a consistent way. In the case of a macroscopic system one can obtain, by means of appropriate approximations, a description of the evolution in terms of a phase-space density distribution obeying a Fokker-Planck diffusion equation. The model also provides the basis for a conceptually appealing description of quantum measurement.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "A Unified Dynamics for Micro and MACRO Systems"}, {"title": "MONOPOLE, ASTROPHYSICS AND COSMIC RAY OBSERVATORY"}, {"title": "COSMIC-RAY"}], "external_system_identifiers": [{"schema": "ADS", "value": "1986PhRvD..34..470G"}, {"schema": "KEKSCAN", "value": "86-04-439"}, {"schema": "SPIRES", "value": "SPIRES-1494660"}, {"schema": "MSNET", "value": "848084"}], "facet_author_name": ["2053863_T. Weber", "1998168_Alberto Rimini", "1008494_Giancarlo Ghirardi"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:222969", "updated": "2023-10-03T09:31:46.417083"}, "curated": true, "journal_title_variants": ["Phys. Rev. D", "Phys.Rev.D"]}, "created": "1986-05-05T00:00:00+00:00", "id": "222969"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.34.470&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=