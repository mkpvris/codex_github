rnal_volume": "23", "artid": "27", "page_start": "27", "journal_title": "Physica"}}}, {"reference": {"publication_info": {"journal_volume": "52", "artid": "2193", "page_start": "2193", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/212555"}}, {"reference": {"publication_info": {"journal_volume": "31", "artid": "471", "page_start": "471", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/226760"}}, {"reference": {"publication_info": {"journal_volume": "167", "artid": "390", "page_start": "390", "journal_title": "Annals Phys."}}}, {"reference": {"publication_info": {"journal_volume": "168", "artid": "155", "page_start": "155", "journal_title": "Phys.Rept."}}}, {"reference": {"publication_info": {"journal_volume": "58", "artid": "1285", "page_start": "1285", "journal_title": "Phys.Rev.Lett."}}}, {"reference": {"publication_info": {"journal_volume": "64", "artid": "105020", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/564806"}}], "number_of_pages": 4, "referenced_authors_bais": ["Sougato.Bose.1", "V.Ambegaokar.1", "K.Hornberger.1", "U.Weiss.2", "W.H.Zurek.1", "C.Kiefer.1", "K.Jacobs.2", "A.Zoupas.1", "D.J.Wineland.1", "Robert.F.OConnell.1", "D.Giulini.1", "I.C.Percival.5", "Salman.Habib.1", "H.Grabert.1", "W.M.Itano.4", "G.W.Ford.2", "Q.A.Turchette.1", "V.Hakim.2", "P.S.Riseborough.1", "S.Uttenthaler.2", "B.E.King.1", "H.D.Zeh.1", "J.J.Halliwell.1", "B.Brezger.1", "Lucia.Hackermueller.1", "M.B.Plenio.1", "C.A.Sackett.1", "M.Arndt.1", "R.Karrlein.1", "N.Gisin.1", "J.P.Paz.1", "J.R.Anglin.1", "J.Eisert.1", "L.Diosi.1", "C.Monroe.2", "A.Zeilinger.1", "Peter.Knight.1", "P.Hanggi.1", "D.Kielpinski.2", "C.J.Myatt.1"], "legacy_version": "20190508165140.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "figures": [{"filename": "Plot2.png", "material": "preprint", "caption": "This figure shows $\\log T_c=\\lim_{T\\rightarrow\\infty} \\log t_{c}$, where for a given temperature the number $t_{c}>0$ is the smallest number such that (\\ref{fin}) is satisfied for all $t>t_{c}$ for the case of strictly Ohmic damping, as a function of $\\log\\zeta$.  The stronger the damping, the faster is the 'localization' process.", "source": "arxiv", "label": "figure", "key": "4c6bbf0742b317577b56e5cb0c9e9afb", "url": "https://inspirehep.net/files/4c6bbf0742b317577b56e5cb0c9e9afb"}], "legacy_creation_date": "2003-11-10", "preprint_date": "2003-11", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "4 pages, 1 figure"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/03bnmw459"}, {"schema": "ROR", "value": "https://ror.org/041kmwe10"}], "full_name": "Eisert, Jens", "last_name": "Eisert", "first_name": "Jens", "recid": 1069647}, "control_number": 632782, "dois": [{"value": "10.1103/PhysRevLett.92.210401"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.92.210401"}], "earliest_date": "2003-11", "document_type": ["article"], "texkeys": ["Eisert:2003za"], "abstracts": [{"source": "arXiv", "value": "In this paper it is shown that exact decoherence to minimal uncertainty Gaussian pointer states is generic for free quantum particles coupled to a heat bath. More specifically, the paper is concerned with damped free particles linearly coupled under product initial conditions to a heat bath at arbitrary temperature, with arbitrary coupling strength and spectral densities covering the Ohmic, subohmic, and supraohmic regime. Then it is true that there exists a time t_c such that for times t>t_c the state can always be exactly represented as a mixture (convex combination) of particular minimal uncertainty Gaussian states, regardless of and independent from the initial state. This exact `localisation' is hence not a feature specific to high temperatures and weak damping limit, but is rather a generic property of damped free particles.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2004PhRvL..92u0401E"}, {"schema": "SPIRES", "value": "SPIRES-5719453"}], "titles": [{"title": "Exact decoherence to pointer states in free open quantum systems is universal"}, {"source": "arXiv", "title": "Exact decoherence to pointer states in free open quantum systems is universal"}], "facet_author_name": ["1069647_Jens Eisert"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:632782", "updated": "2026-02-06T09:59:20.231060"}, "curated": false, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."], "arxiv_eprints": [{"categories": ["quant-ph", "cond-mat", "gr-qc"], "value": "quant-ph/0311022"}]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.92.210401&size=5&page=1&format=cv"}}