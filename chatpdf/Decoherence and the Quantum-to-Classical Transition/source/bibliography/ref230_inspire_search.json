: {"journal_volume": "149", "artid": "374", "page_start": "374", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/176413"}}, {"reference": {"publication_info": {"journal_volume": "49", "artid": "1545", "page_start": "1545", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/188524"}}, {"reference": {"publication_info": {"journal_volume": "49", "artid": "681", "page_start": "681", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/188525"}}, {"reference": {"publication_info": {"journal_volume": "52", "artid": "5", "page_start": "5", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/212604"}}, {"reference": {"publication_info": {"journal_volume": "69", "artid": "80", "page_start": "80", "journal_title": "Prog.Theor.Phys.Suppl."}}}, {"reference": {"publication_info": {"journal_volume": "121", "artid": "587", "page_start": "587", "journal_title": "NOONE"}}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "1795", "page_start": "1795", "journal_title": "Phys.Rev.Lett."}}}, {"reference": {"publication_info": {"journal_volume": "47", "artid": "256", "page_start": "256", "journal_title": "Phys.Rev.Lett."}}}, {"reference": {"publication_info": {"journal_volume": "24", "artid": "118", "page_start": "118", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/9391"}}, {"reference": {"publication_info": {"journal_volume": "49", "artid": "609", "page_start": "609", "journal_title": "J.Low Temp.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "26", "artid": "1862", "page_start": "1862", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/176410"}}, {"reference": {"publication_info": {"journal_volume": "114", "artid": "479", "page_start": "479", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/129193"}}], "number_of_pages": 27, "referenced_authors_bais": ["K.Yasue.1", "Sudip.Chakravarty.1", "A.J.Leggett.1", "Richard.P.Feynman.1", "A.O.Caldeira.1", "W.H.Zurek.1", "A.M.Moore.1", "F.L.Vernon.1", "A.J.Bray.2"], "legacy_version": "20200526175202.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "1985-03-01", "preprint_date": "1985-03", "author_count": 2, "first_author": {"full_name": "Caldera, A.O.", "last_name": "Caldera", "first_name": "A.O.", "recid": 2574314}, "control_number": 16326, "dois": [{"value": "10.1103/PhysRevA.31.1059"}], "earliest_date": "1985-03", "document_type": ["article"], "texkeys": ["Caldera:1985tk"], "abstracts": [{"source": "APS", "value": "This paper reports the result of a calculation which shows the effect of damping on the quantum interference of two Gaussian wave packets in a harmonic potential. We use the influence-functional method, which seems to be the most appropriate one for this kind of calculation. It is shown that quantum interference effects are severely diminished by the presence of damping even when its influence on the system is only light. The corrections to the undamped formulas are always expressible in terms of the phenomenological damping constant γ, the temperature T (in the high-temperature limit), the cutoff frequency (Ω) of the reservoir oscillators, and the mean number (N) of quanta of energy initially present in the system. Both weakly and strongly damped systems are analyzed in the regime of low and high temperatures.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Influence of Damping on Quantum Interference: An Exactly Soluble Model"}, {"title": "INFLUENCE OF DAMPING ON QUANTUM INTERFERENCE: AN EXACTLY SOLUBLE MODEL"}], "external_system_identifiers": [{"schema": "ADS", "value": "1985PhRvA..31.1059C"}, {"schema": "SPIRES", "value": "SPIRES-1328999"}], "facet_author_name": ["1019446_Anthony James Leggett", "2574314_A.O. Caldera"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:16326", "updated": "2023-03-07T04:59:05.944411"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/16326?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/16326?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/16326?format=latex-us", "json": "https://inspirehep.net/api/literature/16326?format=json", "json-expanded": "https://inspirehep.net/api/literature/16326?format=json-expanded", "cv": "https://inspirehep.net/api/literature/16326?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A16326"}, "updated": "2023-03-07T04:59:05.944411+00:00", "id": "16326"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.31.1059&size=5&page=1&format=cv"}}