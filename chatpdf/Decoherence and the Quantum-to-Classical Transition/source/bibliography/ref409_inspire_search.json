 "5", "publication_info": {"year": 1985}, "misc": ["John Klauder and Bo-Sture Skagerstam, Coherent States Singapore,, p.12"]}}, {"reference": {"urls": [{"value": "http://www.arXiv.org/abs/quant-ph/0104033"}], "imprint": {"publisher": "Deutsch"}, "label": "6", "misc": ["D The Structure of the Multiverse"]}}, {"reference": {"label": "7", "publication_info": {"journal_volume": "11", "page_end": "20", "year": 1985, "page_start": "11", "journal_title": "Optics News"}, "misc": ["Quantum Mechanical Computers"], "authors": [{"full_name": "Feynman, R.P."}]}, "record": {"$ref": "https://inspirehep.net/api/literature/204559"}}, {"reference": {"label": "8", "publication_info": {"journal_volume": "356", "page_end": "1821", "year": 1998, "page_start": "1793", "journal_title": "Phil.Trans.Roy.Soc.Lond.A"}, "misc": ["Decoherence, Einselection, and the Existential Interpretation (the rough guide)"], "authors": [{"full_name": "Zurek, W."}]}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/470824"}}, {"reference": {"imprint": {"publisher": "World Scientific"}, "label": "9", "publication_info": {"year": 1991}, "misc": ["in Symposium on the Foundations of Modern Physics 1990, P. Lahti and P. Mittelstaedt (eds.) Singapore,. Sec. 3"], "authors": [{"full_name": "Stapp, H.P."}]}}], "number_of_pages": 19, "referenced_authors_bais": ["H.D.Zeh.1", "W.H.Zurek.1", "E.Joos.1", "D.Deutsch.1", "Richard.P.Feynman.1"], "legacy_version": "20190520230034.0", "inspire_categories": [{"term": "General Physics", "source": "curator"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2002-03-27", "preprint_date": "2001-10", "author_count": 1, "urls": [{"description": "Canadian Journal of Physics Server", "value": "http://www.nrc.ca/cgi-bin/cisti/journals/rp/rp2_abst_e?cjp_p02-068_80_ns_nf_cjp9-02"}], "public_notes": [{"source": "arXiv", "value": "This extended version is to be published in The Canadian Journal of Physics"}], "first_author": {"full_name": "Stapp, Henry P.", "last_name": "Stapp", "first_name": "Henry P.", "recid": 987722}, "control_number": 571303, "dois": [{"value": "10.1139/p02-068"}, {"material": "publication", "source": "arXiv", "value": "10.1139/p02-068"}], "earliest_date": "2001-10", "document_type": ["article"], "texkeys": ["Stapp:2001at"], "abstracts": [{"source": "arXiv", "value": "It is emphasized that a many-worlds interpretation of quantum theory exists only to the extent that the associated basis problem is solved. The core basis problem is that the robust enduring states specified by environmental decoherence effects are essentially Gaussian wave packets that form continua of non-orthogonal states. Hence they are not a discrete set of orthogonal basis states to which finite probabilities can be assigned by the usual rules. The natural way to get an orthogonal basis without going outside the Schroedinger dynamics is to use the eigenstates of the reduced density matrix, and this idea is the basis of some recent attempts by many-worlds proponents to solve the basis problem. But these eigenstates do not enjoy the locality and quasi-classicality properties of the states defined by environmental decoherence effects, and hence are not satisfactory preferred basis states. The basis problem needs to be addressed and resolved before a many-worlds-type interpretation can be said to exist.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "861224"}, {"schema": "SPIRES", "value": "SPIRES-4896181"}], "titles": [{"title": "The basis problem in many-worlds theories"}, {"source": "arXiv", "title": "The basis problem in many-worlds theories."}, {"source": "arXiv", "title": "The basis problem in many-worlds theories"}], "facet_author_name": ["987722_Henry P. Stapp"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:571303", "updated": "2025-10-01T11:10:48.183965"}, "curated": true, "journal_title_variants": ["Can.J.Phys.", "Can. J. Phys."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0110148"}]}, "id": "571303", "updated": "2025-10-01T11:10:48.183965+00:00", "created": "2002-03-27T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1139%2Fp02-068&size=5&page=1&format=cv"}}