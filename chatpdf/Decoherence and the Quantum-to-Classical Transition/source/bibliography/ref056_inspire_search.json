{"hits": {"hits": [{"updated": "2024-09-19T14:50:42.508998+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/2701914?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2701914?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2701914?format=latex-us", "json": "https://inspirehep.net/api/literature/2701914?format=json", "json-expanded": "https://inspirehep.net/api/literature/2701914?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2701914?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2701914"}, "metadata": {"citation_count": 3456, "citation_count_without_self_citations": 3452, "publication_info": [{"year": 2012}], "authors": [{"raw_affiliations": [{"value": "Massachusetts Institute of Technology"}], "full_name_unicode_normalized": "nielsen, michael a.", "full_name": "Nielsen, Michael A.", "record": {"$ref": "https://inspirehep.net/api/authors/1073272"}, "ids": [{"schema": "INSPIRE BAI", "value": "M.A.Nielsen.2"}], "last_name": "Nielsen", "affiliations": [{"curated_relation": true, "record": {"$ref": "https://inspirehep.net/api/institutions/907455"}, "value": "MIT"}], "uuid": "70042b28-0cca-4644-a69e-ef8da9415a30", "first_name": "Michael A.", "recid": 1073272}, {"raw_affiliations": [{"value": "Massachusetts Institute of Technology"}], "full_name_unicode_normalized": "chuang, isaac l.", "full_name": "Chuang, Isaac L.", "record": {"$ref": "https://inspirehep.net/api/authors/1058441"}, "ids": [{"schema": "INSPIRE BAI", "value": "I.L.Chuang.1"}], "last_name": "Chuang", "affiliations": [{"curated_relation": true, "record": {"$ref": "https://inspirehep.net/api/institutions/907455"}, "value": "MIT"}], "uuid": "226af75f-0aec-41f1-ac3a-f0de3228e040", "first_name": "Isaac L.", "recid": 1058441}], "isbns": [{"value": "9780521635035"}], "$schema": "https://inspirehep.net/schemas/records/hep.json", "number_of_pages": 702, "inspire_categories": [{"term": "Quantum Physics"}], "author_count": 2, "first_author": {"full_name": "Nielsen, Michael A.", "last_name": "Nielsen", "first_name": "Michael A.", "recid": 1073272}, "control_number": 2701914, "dois": [{"value": "10.1017/cbo9780511976667"}], "earliest_date": "2012-06-05", "document_type": ["book"], "texkeys": ["Nielsen:2012yss"], "abstracts": [{"source": "submitter", "value": "<jats:p>One of the most cited books in physics of all time, Quantum Computation and Quantum Information remains the best textbook in this exciting field of science. This 10th anniversary edition includes an introduction from the authors setting the work in context. This comprehensive textbook describes such remarkable effects as fast quantum algorithms, quantum teleportation, quantum cryptography and quantum error-correction. Quantum mechanics and computer science are introduced before moving on to describe what a quantum computer is, how it can be used to solve problems faster than 'classical' computers and its real-world implementation. It concludes with an in-depth treatment of quantum information. Containing a wealth of figures and exercises, this well-known textbook is ideal for courses on the subject, and will interest beginning graduate students and researchers in physics, computer science, mathematics, and electrical engineering.</jats:p>", "abstract_source_suggest": {"input": "submitter"}}], "titles": [{"source": "submitter", "title": "Quantum Computation and Quantum Information"}], "facet_author_name": ["1058441_Isaac L. Chuang", "1073272_M.A. Nielsen"], "core": true, "imprints": [{"date": "2012-06-05", "publisher": "Cambridge University Press"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2701914", "updated": "2024-09-19T14:50:42.508998"}, "curated": true}, "created": "2023-09-23T20:54:49.544074+00:00", "id": "2701914"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1017%2Fcbo9780511976667&size=5&page=1&format=cv"}}