t/api/literature/71383"}}, {"reference": {"publication_info": {"journal_volume": "5", "artid": "379", "page_start": "379", "journal_title": "Lett.Math.Phys.A"}}}, {"reference": {"publication_info": {"journal_volume": "101", "artid": "429", "page_start": "429", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "13", "artid": "857", "page_start": "857", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/113389"}}, {"reference": {"publication_info": {"journal_volume": "18", "artid": "489", "page_start": "489", "journal_title": "Int.J.Theor.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/148773"}}, {"reference": {"publication_info": {"journal_volume": "12", "artid": "249", "page_start": "249", "journal_title": "Found.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "18", "artid": "622", "page_start": "622", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/52405"}}, {"reference": {"publication_info": {"journal_volume": "69", "artid": "80", "page_start": "80", "journal_title": "Prog.Theor.Phys.Suppl."}}}], "number_of_pages": 5, "referenced_authors_bais": ["J.H.Tutsch.1", "D.Bohm.1", "C.Papaliolios.2", "J.Bub.1", "P.M.Pearle.1"], "legacy_version": "20160311150255.0", "legacy_creation_date": "2008-09-22", "preprint_date": "1984-01-15", "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/05709zb94"}], "full_name": "Pearle, Philip", "last_name": "Pearle", "first_name": "Philip", "recid": 993978}, "control_number": 212596, "dois": [{"value": "10.1103/PhysRevD.29.235"}], "earliest_date": "1984-01-15", "document_type": ["article"], "texkeys": ["Pearle:1984zz"], "abstracts": [{"source": "APS", "value": "We consider theories in which the Schrödinger equation is modified so that the reduction of the state vector becomes a dynamical process characterized by a mean reduction time τR. It is generally believed that such a theory and quantum theory differently predict the outcome of any two experiments performed in rapid enough succession (separated by a time interval ≲τR), such as Papaliolios's successive measurements of a photon's polarization. It is shown that the predictions of a plausible class of dynamical reduction theories (for which the ensemble average of |〈φn|ψ〉|2 remains constant during the reduction process, where |ψ〉 is the state vector, and |φn〉 is any one of the basis states to which it may reduce) and quantum theory do not differ for any Papaliolios-type experiment. However, there are deviations from the predictions of quantum theory if the second experiment measures interference between the superposed states created by the first measurement. As an example, the result of a recent two-slit neutron interference experiment by Zeilinger et al. is applied to the theory of Pearle, placing an upper limit τR≳5 sec on the neutron self-reduction time.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Experimental tests of dynamical state-vector reduction"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-7971001"}, {"schema": "MSNET", "value": "758026"}], "facet_author_name": ["993978_Philip Mark Pearle"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:212596", "updated": "2023-10-03T08:12:50.159997"}, "curated": true, "journal_title_variants": ["Phys. Rev. D", "Phys.Rev.D"]}, "id": "212596", "updated": "2023-10-03T08:12:50.159997+00:00", "created": "2008-09-22T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.29.235&size=5&page=1&format=cv"}}