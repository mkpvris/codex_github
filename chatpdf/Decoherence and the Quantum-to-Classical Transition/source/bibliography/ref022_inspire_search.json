irehep.net/api/authors/998865"}, "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903139"}, "value": "Princeton U."}], "ids": [{"schema": "INSPIRE BAI", "value": "John.March.Russell.1"}], "last_name": "March-Russell", "signature_block": "RASALj", "first_name": "John", "uuid": "0a0bc34d-6ef7-4c0c-8ba4-43c25f36142f", "recid": 998865}], "report_numbers": [{"value": "HUTP-90-A040"}, {"value": "PUPT-1196"}, {"value": "NSF-ITP-90-152"}], "citation_count_without_self_citations": 46, "citation_count": 51, "publication_info": [{"journal_volume": "351", "page_end": "748", "year": 1991, "page_start": "735", "journal_title": "Nucl.Phys.B"}, {"pubinfo_freetext": "Nucl. Phys. B351 (1991) 735-748 and Harvard Univ. Cambridge - HUTP-90-A040 (90,rec.Nov.) 18 p"}], "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "keywords": [{"schema": "INSPIRE", "value": "gauge field theory: nonabelian"}, {"schema": "INSPIRE", "value": "symmetry breaking"}, {"schema": "INSPIRE", "value": "symmetry: discrete"}, {"schema": "INSPIRE", "value": "black hole: quantum hair"}, {"schema": "INSPIRE", "value": "astrophysics: string"}, {"schema": "INSPIRE", "value": "group theory: representation"}, {"schema": "INSPIRE", "value": "tunneling"}], "references": [{"reference": {"publication_info": {"journal_volume": "62", "artid": "1221", "page_start": "1221", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/266944"}}, {"reference": {"publication_info": {"journal_volume": "61", "artid": "2823", "page_start": "2823", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/264650"}}, {"reference": {"publication_info": {"journal_volume": "337", "artid": "695", "page_start": "695", "journal_title": "Nucl.Phys.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/283528"}}, {"reference": {"publication_info": {"journal_volume": "341", "artid": "50", "page_start": "50", "journal_title": "Nucl.Phys.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/27193"}}, {"reference": {"publication_info": {"journal_volume": "62", "artid": "1071", "page_start": "1071", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/264561"}}, {"reference": {"publication_info": {"journal_volume": "116", "artid": "464", "page_start": "464", "journal_title": "Phys.Lett.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/156681"}}], "number_of_pages": 14, "referenced_authors_bais": ["L.Stodolsky.1", "J.Preskill.1", "Mark.G.Alford.1", "A.Strominger.1", "S.B.Giddings.1", "M.J.Bowick.1", "R.A.Harris.2", "G.T.Horowitz.1", "Lawrence.M.Krauss.1", "Jeffrey.A.Harvey.1", "John.March.Russell.1", "Frank.A.Wilczek.1"], "legacy_version": "20180611214439.0", "inspire_categories": [{"term": "Astrophysics", "source": "curator"}, {"term": "Theory-HEP", "source": "curator"}], "legacy_creation_date": "1990-10-23", "preprint_date": "1990-09", "author_count": 3, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02t274463"}], "full_name": "Alford, Mark G.", "ids": [{"schema": "ORCID", "value": "0000-0001-9675-7005"}, {"schema": "INSPIRE BAI", "value": "Mark.G.Alford.1"}], "last_name": "Alford", "first_name": "Mark G.", "recid": 1018658}, "control_number": 299678, "dois": [{"value": "10.1016/S0550-3213(05)80042-2"}], "earliest_date": "1990-09", "document_type": ["article"], "texkeys": ["Alford:1990pt"], "abstracts": [{"source": "Elsevier", "value": "Last year, Krauss and Wilczek studied a theory in which a U(1) gauge group broke down to a discrete Z N subgroup. They argued that despite the classical no-hair theorems, the Z N charge carried by a black hole was an observable quantity, “discrete quantum hair”. In this note we extend their analysis to the case in which a general continuous gauge group G breaks down to a discrete nonabehan subgroup H. We find that the H-transformation properties of a black hole are (with one minor exception) as observable as those of any other particle. Just as in the Z N case, the observations are made by gedanken experiments involving the interactions of black holes and cosmic strings. To complete the argument we have to investigate the quantum theory of nonabelian cosmic strings. We find (somewhat surprisingly) that one should not expect to find cosmic strings in states that correspond to irreducible representations of H.", "abstract_source_suggest": {"input": "Elsevier"}}], "refereed": true, "external_system_identifiers": [{"schema": "MSNET", "value": "1098236"}, {"schema": "SPIRES", "value": "SPIRES-2255464"}], "titles": [{"title": "Disentangling nonAbelian discrete quantum hair"}], "facet_author_name": ["998865_John March-Russell", "1013257_Sidney Richard Coleman", "1018658_Mark G. Alford"], "core": true, "imprints": [{"date": "1991-03-11"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:299678", "updated": "2023-03-06T15:58:16.006108"}, "curated": true, "journal_title_variants": ["Nucl.Phys.B", "Nucl. Phys. B"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/299678?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/299678?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/299678?format=latex-us", "json": "https://inspirehep.net/api/literature/299678?format=json", "json-expanded": "https://inspirehep.net/api/literature/299678?format=json-expanded", "cv": "https://inspirehep.net/api/literature/299678?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A299678"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0550-3213%2805%2980042-2&size=5&page=1&format=cv"}}