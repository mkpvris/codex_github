"David.Bacon.1", "L.Viola.3", "E.Pazy.2", "D.Mozyrsky.1", "D.A.Lidar.1", "F.Rossi.3", "V.Roychowdhury.1", "A.Imamoglu.3", "I.A.Small.1", "I.DAmico.1", "D.P.DiVincenzo.1", "Ke.Lin.Wang.1", "T.Calarco.1", "Peter.Knight.1"], "figures": [{"filename": "fig1.png", "material": "preprint", "caption": "Quantum circuit of the LEO for $4$ physical (encoded) qubits in Example 1 (3). $U_{A}=e^{i\\frac{\\pi }{4}A}$, where $A$ stands for $ X_{i},Y_{i},Z_{i},Z_{i}Z_{j}$ ($\\overline{X}_{i},\\overline{Y}_{i},\\overline{Z }_{i},\\overline{Z}_{i}\\overline{Z}_{j}$) for Example 1 (3).", "label": "fig1", "source": "arxiv", "key": "e06fb9f8a83103fc66e2a721372350fc", "url": "https://inspirehep.net/files/e06fb9f8a83103fc66e2a721372350fc"}], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "2002-02-27", "author_count": 3, "public_notes": [{"source": "arXiv", "value": "4 pages, including 1 figure"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/03dbr7087"}], "full_name": "Wu, L.-A.", "last_name": "Wu", "first_name": "L.-A.", "recid": 1982154}, "control_number": 3031543, "dois": [{"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.89.127901"}], "earliest_date": "2002-02-27", "document_type": ["article"], "texkeys": ["Wu:2002jug"], "abstracts": [{"source": "arXiv", "value": "Decoherence-induced leakage errors can couple a physical or encoded qubit to other levels, thus potentially damaging the qubit. They can therefore be very detrimental in quantum computation and require special attention. Here we present a general method for removing such errors by using simple decoupling and recoupling pulse sequences. The proposed gates are experimentally accessible in a variety of promising quantum computing proposals.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "Efficient Universal Leakage Elimination for Phys