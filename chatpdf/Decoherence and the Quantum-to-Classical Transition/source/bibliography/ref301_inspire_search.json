: "Janne", "recid": 1890455}, "public_notes": [{"source": "arXiv", "value": "18 pages, RevTex, 5 postscript figures, 1 MacBinary eps-figure"}], "control_number": 2987556, "dois": [{"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.57.511"}], "earliest_date": "1997-08-13", "document_type": ["article"], "texkeys": ["Ruostekoski:1997lrw"], "abstracts": [{"source": "arXiv", "value": "We consider two dilute gas Bose-Einstein condensates with opposite velocities from which a monochromatic light field detuned far from the resonance of the optical transition is coherently scattered. In the thermodynamic limit, when the relative fluctuations of the atom number difference between the two condensates vanish, the relative phase between the Bose-Einstein condensates may be established in a superposition state by detections of spontaneously scattered photons, even though the condensates have initially well-defined atom numbers. For a finite system, stochastic simulations show that the measurements of the scattered photons lead to a randomly drifting relative phase and drive the condensates into entangled superpositions of number states. This is because according to Bose-Einstein statistics the scattering to an already occupied state is enhanced.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["cond-mat"], "titles": [{"source": "arXiv", "title": "Macroscopic superpositions of Bose-Einstein condensates"}], "facet_author_name": ["1890455_Janne Ruostekoski", "2205217_M.J. Collett", "1007753_Robert Graham", "1040623_Daniel Frank Walls"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2987556", "updated": "2026-02-09T15:02:04.865656"}, "curated": false, "journal_title_variants": ["Phys.Rev.A", "Phys. Rev. A"], "arxiv_eprints": [{"categories": ["cond-mat", "physics.atom-ph", "quant-ph"], "value": "cond-mat/9708089"}]}, "id": "2987556", "updated": "2026-02-09T15:02:04.865656+00:00", "created": "2025-10-01T10:33:33.065965+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.511&size=5&page=1&format=cv"}}