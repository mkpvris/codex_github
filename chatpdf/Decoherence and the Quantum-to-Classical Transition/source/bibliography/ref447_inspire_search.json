{"hits": {"hits": [{"links": {"bibtex": "https://inspirehep.net/api/literature/148773?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/148773?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/148773?format=latex-us", "json": "https://inspirehep.net/api/literature/148773?format=json", "json-expanded": "https://inspirehep.net/api/literature/148773?format=json-expanded", "cv": "https://inspirehep.net/api/literature/148773?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A148773"}, "id": "148773", "metadata": {"publication_info": [{"journal_volume": "18", "page_end": "518", "year": 1979, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214707"}, "page_start": "489", "journal_title": "Int.J.Theor.Phys."}], "citation_count_without_self_citations": 58, "authors": [{"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/05709zb94"}], "full_name_unicode_normalized": "pearle, philip m.", "full_name": "Pearle, Philip M.", "record": {"$ref": "https://inspirehep.net/api/authors/993978"}, "last_name": "Pearle", "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903496"}, "value": "Hamilton Coll."}], "ids": [{"schema": "INSPIRE BAI", "value": "P.M.Pearle.1"}], "signature_block": "PARLp", "uuid": "150b4c45-ccd1-4004-9750-a26c6c09b8bb", "first_name": "Philip M.", "recid": 993978}], "citation_count": 60, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "keywords": [{"schema": "INSPIRE", "value": "QUANTUM MECHANICS"}, {"schema": "INSPIRE", "value": "MODEL: STATISTICAL"}, {"schema": "INSPIRE", "value": "FUNCTIONAL ANALYSIS: linear space"}], "number_of_pages": 30, "legacy_version": "20180607151955.0", "inspire_categories": [{"term": "General Physics", "source": "curator"}, {"term": "Math and Math Physics", "source": "curator"}], "legacy_creation_date": "1979-01-01", "preprint_date": "1979", "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/05709zb94"}], "full_name": "Pearle, Philip M.", "last_name": "Pearle", "first_name": "Philip M.", "recid": 993978}, "control_number": 148773, "dois": [{"value": "10.1007/BF00670504"}], "earliest_date": "1979", "document_type": ["article"], "texkeys": ["Pearle:1979vm"], "abstracts": [{"source": "Springer", "value": "The possibility is raised of adding a randomly fluctuating interaction term to the Schrödinger equation, so that the new equation “reduces” the state vector. The exact event that occurs is predicted by the equation and depends upon the precise time dependence of the interaction term. The uncertainty in nature is attributed to the random behavior of this term. A class of such terms is found. This class includes terms whose nonlinear dependence on the wave function is identical to that of terms introduced in a previous paper for a similar purpose. In the previous paper, the exact event predicted depends upon the initial phase factors in the superposition making up the state vector: the uncertainty in nature is attributed to random initial phase factors. Another derivation of the results in the previous paper is given in an appendix: the calculations in that paper and in this appendix are of second order in perturbation theory. On the other hand, the calculations in the present paper are exact. A possible answer is given to the question, raised in the previous paper, of the nature of the “observable” states to which the state vector reduces.", "abstract_source_suggest": {"input": "Springer"}}], "refereed": true, "titles": [{"title": "TOWARD EXPLAINING WHY EVENTS OCCUR"}], "external_system_identifiers": [{"schema": "MSNET", "value": "563222"}, {"schema": "SPIRES", "value": "SPIRES-759244"}], "facet_author_name": ["993978_Philip Mark Pearle"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:148773", "updated": "2023-03-06T13:41:17.740631"}, "curated": true, "journal_title_variants": ["Int. J. Theor. Phys.", "Int.J.Theor.Phys."]}, "created": "1979-01-01T00:00:00+00:00", "updated": "2023-03-06T13:41:17.740631+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00670504&size=5&page=1&format=cv"}}