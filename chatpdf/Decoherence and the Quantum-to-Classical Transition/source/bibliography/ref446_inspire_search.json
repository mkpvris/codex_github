e": {"publication_info": {"journal_volume": "23", "artid": "30", "page_start": "30", "journal_title": "Phys.Today"}}}, {"reference": {"publication_info": {"journal_volume": "24", "artid": "36", "page_start": "36", "journal_title": "Phys.Today"}}}, {"reference": {"publication_info": {"journal_volume": "31", "artid": "6", "page_start": "6", "journal_title": "Am.J.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/1777593"}}, {"reference": {"publication_info": {"journal_volume": "38", "artid": "453", "page_start": "453", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/50845"}}, {"reference": {"publication_info": {"journal_volume": "101", "artid": "429", "page_start": "429", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "15", "artid": "1", "page_start": "1", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/4793"}}, {"reference": {"publication_info": {"journal_volume": "18", "artid": "622", "page_start": "622", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/52405"}}], "number_of_pages": 12, "referenced_authors_bais": ["Eugene.P.Wigner.1", "D.Bohm.1", "C.Papaliolios.2", "J.Bub.1", "Subrahmanyan.Chandrasekhar.1", "E.Schrodinger.1"], "legacy_version": "20180203205928.0", "inspire_categories": [{"term": "General Physics", "source": "curator"}], "legacy_creation_date": "1976-01-01", "preprint_date": "1976", "author_count": 1, "first_author": {"full_name": "Pearle, Philip M.", "last_name": "Pearle", "first_name": "Philip M.", "recid": 993978}, "control_number": 113389, "dois": [{"value": "10.1103/PhysRevD.13.857"}], "earliest_date": "1976", "document_type": ["article"], "texkeys": ["Pearle:1976ka"], "abstracts": [{"source": "APS", "value": "It is hypothesized that the state vector describes the physical state of a single system in nature. Then it is necessary that the state vector of a macroscopic apparatus not assume the form of a superposition of macroscopically distinguishable state vectors. To prevent this, it is suggested that a nonlinear term be added to the Schrödinger equation, which rapidly drives the amplitude of one or another of the state vectors in such a superposition to one, and the rest to zero. It is proposed that it is the phase angles of the amplitudes immediately after a measurement which determine which amplitude is driven to one. A diffusion equation is arrived at to describe the reduction of an ensemble of state vectors corresponding to an ensemble of macroscopically identically prepared experiments. Then a nonlinear term to add to the Schrödinger equation is presented, and it is shown that this leads to the diffusion equation in a weak-coupling approximation.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "OSTI", "value": "4009075"}, {"schema": "ADS", "value": "1976PhRvD..13..857P"}, {"schema": "SPIRES", "value": "SPIRES-445932"}, {"schema": "MSNET", "value": "395511"}], "titles": [{"title": "Reduction of the State Vector by a Nonlinear Schrodinger Equation"}], "facet_author_name": ["993978_Philip Mark Pearle"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:113389", "updated": "2023-10-03T08:42:42.639689"}, "curated": true, "journal_title_variants": ["Phys. Rev. D", "Phys.Rev.D"]}, "updated": "2023-10-03T08:42:42.639689+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.13.857&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.13.857&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.13.857&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/