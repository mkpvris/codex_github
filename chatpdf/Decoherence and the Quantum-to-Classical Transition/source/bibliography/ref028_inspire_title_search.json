i/literature/50055"}}, {"reference": {"publication_info": {"journal_volume": "53", "artid": "893", "page_start": "893", "journal_title": "J.Statist.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/261975"}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "807", "page_start": "807", "journal_title": "Naturwiss."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/11041"}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "824", "page_start": "824", "journal_title": "Naturwiss."}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "844", "page_start": "844", "journal_title": "Naturwiss."}}, "record": {"$ref": "https://inspirehep.net/api/literature/2793427"}}], "number_of_pages": 18, "referenced_authors_bais": ["R.B.Griffiths.1", "Nino.Zanghi.1", "S.Goldstein.1", "E.Schrodinger.1", "E.Specker.1", "Edward.Nelson.1", "T.Weber.6", "Hugh.Everett.1", "John.Stewart.Bell.1", "J.B.Hartle.1", "M.Gell.Mann.1", "S.Kochen.1", "D.Bohm.1", "R.Omnes.1", "G.C.Ghirardi.1", "P.M.Pearle.1", "A.Rimini.2", "K.Berndl.1", "D.Durr.1", "G.Peruzzi.1"], "legacy_version": "20180504184336.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1996-01-16", "preprint_date": "1996-01", "author_count": 4, "public_notes": [{"value": "Submitted to Erkenntnis"}, {"source": "arXiv", "value": "18 pages, LaTex2e with AMS-LaTeX, to appear in Erkenntnis, 1996 (the proceedings of the international conference ``Probability, Dynamics and Causality,'' Luino, Italy, 15-17 June 1995, a special issue edited by D. Costantini and M.C. Gallavotti and dedicated to Prof. R. Jeffrey)"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/05591te55"}], "full_name": "Daumer, Martin", "last_name": "Daumer", "first_name": "Martin", "recid": 2484638}, "control_number": 415289, "earliest_date": "1996-01", "document_type": ["conference paper"], "texkeys": ["Daumer:1996ca"], "abstracts": [{"value": "A source of much difficulty and confusion in the interpretation of quantum mechanics is a ``naive realism about operators.'' By this we refer to various ways of taking too seriously the notion of operator-as-observable, and in particular to the all too casual talk about ``measuring operators'' that occurs when the subject is quantum mechanics. Without a specification of what should be meant by ``measuring'' a quantum observable, such an expression can have no clear meaning. A definite specification is provided by Bohmian mechanics, a theory that emerges from Sch\\\"rodinger's equation for a system of particles when we merely insist that ``particles'' means particles. Bohmian mechanics clarifies the status and the role of operators as observables in quantum mechanics by providing the operational details absent from standard quantum mechanics. It thereby allows us to readily dismiss all the radical claims traditionally enveloping the transition from the classical to the quantum realm---for example, that we must abandon classical logic or classical probability. The moral is rather simple: Beware naive realism, especially about operators!"}, {"source": "arXiv", "value": "A source of much difficulty and confusion in the interpretation of quantum mechanics is a ``naive realism about operators.'' By this we refer to various ways of taking too seriously the notion of operator-as-observable, and in particular to the all too casual talk about ``measuring operators'' that occurs when the subject is quantum mechanics. Without a specification of what should be meant by ``measuring'' a quantum observable, such an expression can have no clear meaning. A definite specification is provided by Bohmian mechanics, a theory that emerges from Schrodinger's equation for a system of particles when we merely insist that ``particles'' means particles. Bohmian mechanics clarifies the status and the role of operators as observables in quantum mechanics by providing the operational details absent from standard quantum mechanics. It thereby allows us to readily dismiss all the radical claims traditionally enveloping the transition from the classical to the quantum realm---for example, that we must abandon classical logic or classical probability. The moral is rather simple: Beware naive realism, especially about operators!", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-3283690"}], "titles": [{"title": "Naive realism about operators"}, {"source": "arXiv", "title": "Naive Realism about Operators"}], "facet_author_name": ["1039952_Sheldon Goldstein", "1039953_Nino Zanghi", "1045354_Detlef Dürr", "2484638_Martin Daumer"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:415289", "updated": "2025-09-30T14:23:46.788896"}, "curated": true, "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9601013"}]}, "created": "1996-01-16T00:00:00+00:00", "updated": "2025-09-30T14:23:46.788896+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=t%20%22Naive%20realism%20about%20operators%22&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/li