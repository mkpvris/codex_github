 "INSPIRE", "value": "FEYNMAN GRAPH"}], "references": [{"reference": {"publication_info": {"journal_volume": "52", "artid": "54", "page_start": "54", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/23337"}}, {"reference": {"publication_info": {"journal_volume": "13", "artid": "379", "page_start": "379", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/2313"}}, {"reference": {"publication_info": {"journal_volume": "140", "artid": "111", "page_start": "111", "journal_title": "Phys.Lett.B"}}}, {"reference": {"publication_info": {"journal_volume": "9", "artid": "315", "page_start": "315", "journal_title": "J.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/1724889"}}, {"reference": {"publication_info": {"journal_volume": "173", "artid": "1527", "page_start": "1527", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/55893"}}, {"reference": {"publication_info": {"journal_volume": "174", "artid": "1883", "page_start": "1883", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "175", "artid": "1624", "page_start": "1624", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/55753"}}, {"reference": {"publication_info": {"journal_volume": "7", "artid": "1062", "page_start": "1062", "journal_title": "Phys.Rev.D"}}}, {"reference": {"publication_info": {"journal_volume": "139", "artid": "B257", "page_start": "B257", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/1840716"}}, {"reference": {"publication_info": {"journal_volume": "10", "artid": "826", "page_start": "826", "journal_title": "J.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/58518"}}, {"reference": {"publication_info": {"journal_volume": "14", "artid": "15", "page_start": "15", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/58750"}}], "number_of_pages": 124, "referenced_authors_bais": ["H.Suura.1", "S.C.Frautschi.1", "D.Iagolnitzer.1", "T.W.B.Kibble.1", "Felix.Bloch.1", "D.R.Yennie.1", "C.Chandler.1", "H.P.Stapp.1", "A.Nordsieck.1"], "legacy_version": "20180611210229.0", "inspire_categories": [{"term": "Theory-HEP", "source": "curator"}], "legacy_creation_date": "1983-04-01", "preprint_date": "1983-04", "author_count": 1, "public_notes": [{"value": "Revised version"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02jbv0t02"}], "full_name": "Stapp, Henry P.", "last_name": "Stapp", "first_name": "Henry P.", "recid": 987722}, "control_number": 190266, "dois": [{"value": "10.1103/PhysRevD.28.1386"}], "earliest_date": "1983-04", "document_type": ["article"], "texkeys": ["Stapp:1983gw"], "abstracts": [{"source": "APS", "value": "A simple but rigorous solution of the infrared problem is obtained. The basis of this solution is a factorization of the operator corresponding to the Feynman coordinate space plus all electromagnetic corrections to it into a product of two operators. The first is a unitary operator that represents precisely the contribution corresponding to classical electromagnetic theory. The second is a residual operator that is free of infrared problems. This factorization is exact: no soft-photon approximation, or any other approximation, is used. Both the unitary operator and the residual operator are expressed in simple forms amenable to rigorous mathematical analysis. The central technical result of this work, namely the exact yet simple organization of all contributions corresponding to classical physics into unitary factors, may have other important uses.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "MSNET", "value": "717544"}, {"schema": "OSTI", "value": "5691851"}, {"schema": "ADS", "value": "1983PhRvD..28.1386S"}, {"schema": "SPIRES", "value": "SPIRES-1073010"}], "titles": [{"title": "Exact Solution of the Infrared Problem"}, {"title": "EXACT SOLUTION OF THE INFRARED PROBLEM"}], "facet_author_name": ["987722_Henry P. Stapp"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:190266", "updated": "2023-03-06T14:21:23.615169"}, "curated": true, "journal_title_variants": ["Phys.Rev.D", "Phys. Rev. D"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.28.1386&size=5&page=1&format=cv"}}