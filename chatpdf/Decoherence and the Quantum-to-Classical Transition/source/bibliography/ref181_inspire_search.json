t_date": "1972", "document_type": ["article"], "texkeys": ["Kossakowski:1972sbn"], "abstracts": [{"source": "Elsevier Ltd", "value": "An axiomatic definition of time evolution (dynamical semi-group) of a physical system has been given. A dynamical semi-group is defined as a one-parametersemi-group of linear endomorphisms of the set of all density operators corresponding to the physical system in question. Some classes of dynamical semi-groups (quantum Poisson and Brownian processes) induced by Markov processes on topological groups are described. Examples of dynamical semi-groups for the harmonic oscillator are given.", "abstract_source_suggest": {"input": "Elsevier Ltd"}}], "refereed": true, "titles": [{"source": "Elsevier Ltd", "title": "On quantum statistical mechanics of non-Hamiltonian systems"}], "facet_author_name": ["1059131_Andrzej Kossakowski"], "core": false, "imprints": [{"date": "2002-03-22"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2725134", "updated": "2024-06-04T02:41:35.905803"}, "curated": false, "journal_title_variants": ["Rept.Math.Phys.", "Rept. Math. Phys."]}, "links": {"bibtex": "https://inspirehep.net/api/literature/2725134?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2725134?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2725134?format=latex-us", "json": "https://inspirehep.net/api/literature/2725134?format=json", "json-expanded": "https://inspirehep.net/api/literature/2725134?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2725134?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2725134"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0034-4877%2872%2990010-9&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0034-4877%2872%2990010-9&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0034-4877%287