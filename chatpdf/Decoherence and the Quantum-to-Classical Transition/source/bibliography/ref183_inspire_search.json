urnal_volume": "178", "artid": "2025", "page_start": "2025", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/55568"}}, {"reference": {"publication_info": {"journal_volume": "4", "artid": "739", "page_start": "739", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/73218"}}, {"reference": {"publication_info": {"journal_volume": "185", "artid": "30", "page_start": "30", "journal_title": "Z.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "27", "page_start": "27", "journal_title": "Physica"}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "56", "page_start": "56", "journal_title": "Physica"}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "74", "page_start": "74", "journal_title": "Physica"}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "90", "page_start": "90", "journal_title": "Physica"}}}, {"reference": {"publication_info": {"journal_volume": "9", "artid": "215", "page_start": "215", "journal_title": "J.Statist.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "121", "artid": "587", "page_start": "587", "journal_title": "Physica A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/176411"}}, {"reference": {"publication_info": {"journal_volume": "32", "artid": "423", "page_start": "423", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "107", "artid": "385", "page_start": "385", "journal_title": "Phys.Lett.A"}}}, {"reference": {"publication_info": {"journal_volume": "24", "artid": "118", "page_start": "118", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/9391"}}, {"reference": {"publication_info": {"journal_volume": "45", "artid": "2843", "page_start": "2843", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/31077"}}, {"reference": {"publication_info": {"journal_volume": "31", "artid": "407", "page_start": "407", "journal_title": "Z.Phys.B"}}}, {"reference": {"arxiv_eprint": "gr-qc/9402007"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/37385"}}, {"reference": {"publication_info": {"journal_volume": "204", "artid": "27", "page_start": "27", "journal_title": "Chem.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "7", "artid": "284", "page_start": "284", "journal_title": "Physica"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/45521"}}, {"reference": {"publication_info": {"journal_volume": "17", "artid": "821", "page_start": "821", "journal_title": "J.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/2064"}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "119", "page_start": "119", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/98305"}}, {"reference": {"publication_info": {"journal_volume": "173", "artid": "277", "page_start": "277", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/221244"}}], "number_of_pages": 31, "referenced_authors_bais": ["H.A.Kramers.1", "A.Kossakowski.1", "A.O.Caldeira.1", "Richard.P.Feynman.1", "V.Gorini.1", "J.P.Paz.1", "H.Scutaru.4", "B.L.Hu.1", "Hong.Yu.Zhang.1", "G.W.Ford.4", "P.Schramm.1", "E.C.G.Sudarshan.1", "G.S.Agarwal.1", "H.Haken.1", "P.Pechukas.1", "A.Sandulescu.1", "F.L.Vernon.1", "A.J.Leggett.1", "H.Grabert.1", "G.L.Ingold.1", "Robert.F.OConnell.1", "G.Lindblad.1"], "legacy_version": "20161227213825.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "1996-11-01", "preprint_date": "1996-08", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "to be published in Phys. Rev. E"}], "first_author": {"full_name": "Karrlein, Robert", "last_name": "Karrlein", "first_name": "Robert", "recid": 2547648}, "control_number": 425375, "dois": [{"value": "10.1103/PhysRevE.55.153"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevE.55.153"}], "earliest_date": "1996-08", "document_type": ["article"], "texkeys": ["Karrlein:1996ra"], "abstracts": [{"source": "APS", "value": "Using the exact path integral solution for the damped harmonic oscillator it is shown that in general there does not exist an exact dissipative Liouville operator describing the dynamics of the oscillator for arbitrary initial bath preparations. Exact nonstationary Liouville operators can be found only for particular preparations. Three physically meaningful examples are examined. An exact master equation is derived for thermal initial conditions. Second, the Liouville operator governing the time evolution of equilibrium correlations is obtained. Third, factorizing initial conditions are studied. Additionally, one can show that there are approximate Liouville operators independent of the initial preparation describing the long-time dynamics under appropriate conditions. The general form of these approximate master equations is derived and the coefficients are determined for special cases of the bath spectral density including the Ohmic, Drude, and weak coupling cases. The connection with earlier work is discussed.", "abstract_source_suggest": {"input": "APS"}}, {"source": "arXiv", "value": "Using the exact path integral solution for the damped harmonic oscillator it is shown that in general there does not exist an exact dissipative Liouville operator describing the dynamics of the oscillator for arbitrary initial bath preparations. Exact non-stationary Liouville operators can be found only for particular preparations. Three physically meaningful examples are examined. An exact new master equation is derived for thermal initial conditions. Second, the Liouville operator governing the time-evolution of equilibrium correlations is obtained. Third, factorizing initial conditions are studied. Additionally, one can show that there are approximate Liouville operators independent of the initial preparation describing the long time dynamics under appropriate conditions. The general form of these approximate master equations is derived and the coefficients are determined for special cases of the bath spectral density including the Ohmic, Drude and weak coupling cases. The connection with earlier work is discussed.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["physics.atom-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "467098"}, {"schema": "ADS", "value": "1997PhRvE..55..153K"}, {"schema": "SPIRES", "value": "SPIRES-3448096"}], "titles": [{"title": "Exact time evolution and master equations for the damped harmonic oscillator"}, {"source": "arXiv", "title": "Exact time evolution and master equations for the damped harmonic oscillator"}], "facet_author_name": ["2323873_H. Grabert", "2547648_R. Karrlein"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:425375", "updated": "2025-10-01T10:33:35.041362"}, "curated": true, "journal_title_variants": ["Phys. Rev. E", "Phys.Rev.E"], "arxiv_eprints": [{"categories": ["physics.atom-ph", "quant-ph"], "value": "physics/9610001"}]}, "created": "1996-11-01T00:00:00+00:00", "id": "425375"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.55.153&size=5&page=1&format=cv"}}