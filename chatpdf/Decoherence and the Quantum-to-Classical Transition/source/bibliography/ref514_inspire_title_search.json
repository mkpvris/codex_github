e": "Vitiello, G."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[63] E. del Guidice, S. Doglia, M. Milani, and G. Vitiello, Nucl. Phys. B 275, 185 (1986)."}], "record": {"$ref": "https://inspirehep.net/api/literature/20720"}}, {"reference": {"label": "64", "publication_info": {"journal_volume": "32", "artid": "195", "year": 1994, "page_start": "195", "journal_title": "Biosyst."}, "authors": [{"full_name": "Jibu, M."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[64] M. Jibu et al., BioSystems 32, 195 (1994)."}]}, {"reference": {"arxiv_eprint": "quant-ph/9707021", "label": "65", "publication_info": {"year": 1997}, "misc": ["Fault-tolerant quantum computation by anyons"], "authors": [{"full_name": "Kitaev, A.Y."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[65] A. Y. Kitaev, Fault-tolerant quantum computation by anyons, 1997, quant-ph/9707021."}], "record": {"$ref": "https://inspirehep.net/api/literature/445447"}}, {"reference": {"arxiv_eprint": "quant-ph/9811052", "label": "66", "publication_info": {"year": 1998}, "misc": ["Quantum codes on a lattice with boundary"], "authors": [{"full_name": "Bravyi, S.B."}, {"full_name": "Kitaev, A.Y."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[66] S. B. Bravyi and A. Y. Kitaev, Quantum codes on a lattice with boundary, 1998, quant-ph/9811052."}], "record": {"$ref": "https://inspirehep.net/api/literature/479737"}}, {"reference": {"label": "67", "publication_info": {"year": 1999}, "misc": ["personal communication"], "authors": [{"full_name": "Penrose, R."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[67] R. Penrose, 1999, personal communication."}]}, {"reference": {"label": "68", "publication_info": {"year": 1989}, "misc": ["New Ideas in Psychology 7, 73"], "authors": [{"full_name": "Marshall, I.N."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[68] I. N. Marshall, New Ideas in Psychology 7, 73 (1989)."}]}, {"reference": {"imprint": {"publisher": "Springer"}, "label": "69", "publication_info": {"year": 1993}, "misc": ["Mind, Matter, and Quantum Mechanics", "-Verlag, Berlin,)"], "authors": [{"full_name": "Stapp, H.P."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[69] H. P. Stapp, Mind, Matter, and Quantum Mechanics (Springer-Verlag, Berlin, 1993)."}]}, {"reference": {"label": "70", "publication_info": {"year": 1996}, "misc": ["Evolving the Mind: On the Nature and the Origin of Consciousness (Cambridge University Press, Cambridge,)"], "authors": [{"full_name": "Cairns-Smith, A.J."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[70] A. J. Cairns-Smith, Evolving the Mind: On the Nature and the Origin of Consciousness (Cambridge University Press, Cambridge, 1996)."}]}], "number_of_pages": 10, "referenced_authors_bais": ["Hugh.Everett.1", "A.Y.Kitaev.1", "M.V.Sataric.1", "G.Vitiello.1", "J.A.Tuszynski.1", "M.Tegmark.1", "S.B.Bravyi.1", "E.Del.Giudice.1", "R.B.Zakula.1", "S.Doglia.1", "M.Milani.1"], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "2000-05-04", "author_count": 3, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02956yf07"}], "full_name": "Hagan, S.", "last_name": "Hagan", "first_name": "S.", "recid": 2479600}, "public_notes": [{"source": "arXiv", "value": "10 pages"}], "control_number": 2975426, "earliest_date": "2000-05-04", "document_type": ["article"], "texkeys": ["Hagan:2000zvh"], "abstracts": [{"source": "arXiv", "value": "The Penrose-Hameroff (`Orch OR') model of quantum computation in brain microtubules has been criticized as regards the issue of environmental decoherence. A recent report by Tegmark finds that microtubules can maintain quantum coherence for only $10^{-13}$ s, far too short to be neurophysiologically relevant. Here, we critically examine the assumptions behind Tegmark's calculation and find that: 1) Tegmark's commentary is not aimed at an existing model in the literature but rather at a hybrid that replaces the superposed protein conformations of the `Orch OR' theory with a soliton in superposition along the microtubule, 2) Tegmark predicts decreasing decoherence times at lower temperature, in direct contradiction of the observed behavior of quantum states, 3) recalculation after correcting Tegmark's equation for differences between his model and the `Orch OR' model (superposition separation, charge vs. dipole, dielectric constant) lengthens the decoherence time to $10^{-5} - 10^{-4}$ s and invalidates a critical assumption of Tegmark's derivation, 4) incoherent metabolic energy supplied to the collective dynamics ordering water in the vicinity of microtubules at a rate exceeding that of decoherence can counter decoherence effects (in the same way that lasers avoid decoherence at room temperature), and 5) phases of actin gelation may enhance the ordering of water around microtubule bundles, further increasing the decoherence-free zone by an order of magnitude and the decoherence time to $10^{-2} - 10^{-1}$ s. These revisions bring microtubule decoherence into a regime in which quantum gravity can interact with neurophysiology.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "Quantum Computation in Brain Microtubules? Decoherence and Biological Feasibility"}], "facet_author_name": ["1938022_Jack A. Tuszynski", "2479600_Patrick S. Hagan", "2975428_S.R. Hameroff"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2975426", "updated": "2025-10-01T12:55:47.823073"}, "curated": false, "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0005025"}]}, "created": "2025-09-30T13:31:51.048299+00:00", "updated": "2025-10-01T12:55:47.823073+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20computation%20in%20brain%20microtubules%3A%20Decoherence%20and%20biological%20feasibility%22&size=5&page=1&format=cv"}}