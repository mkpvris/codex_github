J.A.Smolin.1", "S.Wiesner.1", "D.P.DiVincenzo.1", "C.H.Bennett.1", "T.Beth.1"], "legacy_version": "20161229153342.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1997-02-12", "preprint_date": "1997-02", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "30 pages, REVTeX, universal swapping operation added to allow universal computation on any stabilizer code"}], "first_author": {"emails": ["gottesma@theory.caltech.edu"], "affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/05dxps055"}], "full_name": "Gottesman, Daniel", "last_name": "Gottesman", "first_name": "Daniel", "recid": 1007876}, "control_number": 440307, "dois": [{"value": "10.1103/PhysRevA.57.127"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.57.127"}], "earliest_date": "1997-02", "document_type": ["article"], "texkeys": ["Gottesman:1997qd"], "abstracts": [{"value": "In order to use quantum error-correcting codes to actually improve the performance of a quantum computer, it is necessary to be able to perform operations fault-tolerantly on encoded states. I present a general theory of fault-tolerant operations based on symmetries of the code stabilizer. This allows a straightforward determination of which operations can be performed fault-tolerantly on a given code. I present a number of examples and demonstrate that fault-tolerant universal computation is possible for a great number of different codes, including the five-qubit code."}, {"source": "arXiv", "value": "In order to use quantum error-correcting codes to actually improve the performance of a quantum computer, it is necessary to be able to perform operations fault-tolerantly on encoded states. I present a general theory of fault-tolerant operations based on symmetries of the code stabilizer. This allows a straightforward determination of which operations can be performed fault-tolerantly on a given code. I demonstrate that fault-tolerant universal computation is possible for any stabilizer code. I discuss a number of examples in more detail, including the five-qubit code.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "565823"}, {"schema": "ADS", "value": "1998PhRvA..57..127G"}, {"schema": "SPIRES", "value": "SPIRES-3505480"}], "titles": [{"title": "A Theory of fault tolerant quantum computation"}, {"source": "arXiv", "title": "A Theory of Fault-Tolerant Quantum Computation"}], "facet_author_name": ["1007876_Daniel Gottesman"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:440307", "updated": "2025-10-01T14:31:31.381152"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9702029"}]}, "created": "1997-02-12T00:00:00+00:00", "updated": "2025-10-01T14:31:31.381152+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/440307?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/440307?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/440307?format=latex-us", "json": "https://inspirehep.net/api/literature/440307?format=json", "json-expanded": "https://inspirehep.net/api/literature/440307?format=json-expanded", "cv": "https://inspirehep.net/api/literature/440307?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A440307"}, "id": "440307"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.127&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.127&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.57.127&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2F