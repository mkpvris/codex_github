ocabulary": "crossref"}]}, {"given": "C.A.", "family": "Zorman", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "M.", "family": "Mehregany", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "M.L.", "family": "Roukes", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "16429", "event": {"number": "02TRF-0001", "sponsor": ["Transducer Research Foundation, Inc."], "acronym": "Hilton Head 2002 Workshop", "name": "2002 Solid-State, Actuators, and Microsystems Workshop", "start": {"date-parts": [[2002, 6, 2]]}, "theme": "Science and Technology of Solid-State Sensors, Actuators, and Microsystems", "location": "Hilton Head, South Carolina, USA", "end": {"date-parts": [[2002, 6, 6]]}}, "container-title": ["2002 Solid-State, Actuators, and Microsystems Workshop Technical Digest"], "deposited": {"date-parts": [[2021, 1, 7]], "date-time": "2021-01-07T09:25:12Z", "timestamp": 1610011512000}, "score": 55.090748, "resource": {"primary": {"URL": "https://transducer-research-foundation.org/technical_digests/HiltonHead_2002/hh2002_0368.pdf"}}, "proceedings-subject": "Science and Technology of Solid-State Sensors, Actuators, and Microsystems", "issued": {"date-parts": [[2002, 6, 2]]}, "references-count": 0, "URL": "https://doi.org/10.31438/trf.hh2002.92", "published": {"date-parts": [[2002, 6, 2]]}}, {"indexed": {"date-parts": [[2026, 10, 6]], "date-time": "2026-10-06T15:42:05Z", "timestamp": 1791301325198, "version": "4.1.0"}, "reference-count": 17, "publisher": "AIP Publishing", "issue": "2", "content-domain": {"domain": ["pubs.aip.org"], "crossmark-restriction": true}, "published-print": {"date-parts": [[2001, 1, 8]]}, "abstract": "<jats:p>SiC is an extremely promising material for nanoelectromechanical systems given its large Young's modulus and robust surface properties. We have patterned nanometer scale electromechanical resonators from single-crystal 3C-SiC layers grown epitaxially upon Si substrates. A surface nanomachining process is described that involves electron beam lithography followed by dry anisotropic and selective electron cyclotron resonance plasma etching steps. Measurements on a representative family of the resulting devices demonstrate that, for a given geometry, nanometer-scale SiC resonators are capable of yielding substantially higher frequencies than GaAs and Si resonators.</jats:p>", "DOI": "10.1063/1.1338959", "type": "journal-article", "created": {"date-parts": [[2002, 7, 26]], "date-time": "2002-07-26T14:13:37Z", "timestamp": 1027692817000}, "page": "162-164", "update-policy": "https://doi.org/10.1063/aip-crossmark-policy-page", "source": "Crossref", "is-referenced-by-count": 255, "title": ["Monocrystalline silicon carbide nanoelectromechanical systems"], "prefix": "10.1063", "volume": "78", "author": [{"given": "Y. T.", "family": "Yang", "sequence": "first", "affiliation": [{"name": "Condensed Matter Physics 114-36, California Institute of Technology, Pasadena, California 91125"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "K. L.", "family": "Ekinci", "sequence": "additional", "affiliation": [{"name": "Condensed Matter Physics 114-36, California Institute of Technology, Pasadena, California 91125"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "X. M. H.", "family": "Huang", "sequence": "additional", "affiliation": [{"name": "Condensed Matter Physics 114-36, California Institute of Technology, Pasadena, California 91125"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "L. M.", "family": "Schiavone", "sequence": "additional", "affiliation": [{"name": "Condensed Matter Physics 114-36, California Institute of Technology, Pasadena, California 91125"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "M. L.", "family": "Roukes", "sequence": "add