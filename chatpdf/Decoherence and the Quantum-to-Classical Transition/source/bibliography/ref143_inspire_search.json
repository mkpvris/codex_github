Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47045"}}, {"reference": {"publication_info": {"journal_volume": "24", "artid": "1516", "page_start": "1516", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/172316"}}, {"reference": {"publication_info": {"journal_volume": "26", "artid": "1862", "page_start": "1862", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/176410"}}], "number_of_pages": 50, "referenced_authors_bais": ["Hugh.Everett.1", "E.Joos.1", "T.Weber.6", "G.C.Ghirardi.1", "H.D.Zeh.1", "W.H.Zurek.1", "A.Rimini.2", "R.B.Griffiths.1", "Max.Born.1", "W.Heisenberg.1", "J.A.Wheeler.1", "Adrian.Kent.1"], "legacy_version": "20161227210858.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1996-09-02", "preprint_date": "1995-02", "author_count": 1, "public_notes": [{"value": "Alternative title On Quantum Mechanics"}, {"source": "arXiv", "value": "Substantially revised version. LaTeX file"}], "first_author": {"full_name": "Rovelli, Carlo", "last_name": "Rovelli", "first_name": "Carlo", "recid": 991095}, "control_number": 406886, "dois": [{"value": "10.1007/BF02302261"}, {"material": "publication", "source": "arXiv", "value": "10.1007/BF02302261"}], "earliest_date": "1995-02", "document_type": ["article"], "texkeys": ["Rovelli:1995fv"], "abstracts": [{"value": "I suggest that the common unease with taking quantum mechanics as a fundamental description of nature (the \"measurement problem\") could derive from the use of an incorrect notion, as the unease with the Lorentz transformations before Einstein derived from the notion of observer-independent time. I suggest that this incorrect notion is the notion of observer-independent state of a system (or observer-independent values of physical quantities). I reformulate the problem of the \"interpretation of quantum mechanics\" as the problem of deriving the formalism from a few simple physical postulates. I consider a reformulation of quantum mechanics in terms of information theory. All systems are assumed to be equivalent, there is no observer-observed distinction, and the theory describes only the information that systems have about each other; nevertheless, the theory is complete."}, {"source": "arXiv", "value": "I suggest that the common unease with taking quantum mechanics as a fundamental description of nature (the \"measurement problem\") could derive from the use of an incorrect notion, as the unease with the Lorentz transformations before Einstein derived from the notion of observer-independent time. I suggest that this incorrect notion is the notion of observer-independent state of a system (or observer-independent values of physical quantities). I reformulate the problem of the \"interpretation of quantum mechanics\" as the problem of deriving the formalism from a few simple physical postulates. I consider a reformulation of quantum mechanics in terms of information theory. All systems are assumed to be equivalent, there is no observer-observed distinction, and the theory describes only the information that systems have about each other; nevertheless, the theory is complete.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "482300"}, {"schema": "ADS", "value": "1996IJTP...35.1637R"}, {"schema": "SPIRES", "value": "SPIRES-3411320"}, {"schema": "MSNET", "value": "1409502"}], "titles": [{"title": "Relational quantum mechanics"}, {"source": "arXiv", "title": "Relational Quantum Mechanics"}], "facet_author_name": ["991095_Carlo Rovelli"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:406886", "updated": "2025-10-01T10:36:20.191320"}, "curated": true, "journal_title_variants":