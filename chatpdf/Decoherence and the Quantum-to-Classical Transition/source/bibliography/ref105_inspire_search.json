nal_volume": "62", "artid": "023805", "journal_title": "Phys.Rev.D"}}}, {"reference": {"arxiv_eprint": "quant-ph/9908084", "publication_info": {"journal_volume": "13", "artid": "221", "page_start": "221", "journal_title": "Found.Phys.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/506373"}}], "number_of_pages": 5, "referenced_authors_bais": ["A.Zoupas.1", "N.Gisin.1", "J.P.Paz.1", "I.C.Percival.5", "L.Diosi.1", "O.Kuebler.1", "Salman.Habib.1", "I.C.Percival.1", "H.D.Zeh.1", "W.H.Zurek.1", "J.J.Halliwell.1"], "legacy_version": "20160616173543.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2001-02-14", "preprint_date": "2000-05", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "5 pages, final version"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/008mx9f83"}], "full_name": "Diosi, Lajos", "last_name": "Diosi", "first_name": "Lajos", "recid": 1011732}, "control_number": 540260, "dois": [{"value": "10.1103/PhysRevLett.85.3552"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.85.3552"}], "earliest_date": "2000-05", "document_type": ["article"], "texkeys": ["Diosi:2000wt"], "abstracts": [{"source": "APS", "value": "Classical properties of an open quantum system emerge through its interaction with other degrees of freedom (decoherence). We treat the case where this interaction produces a Markovian master equation for the system. We derive the corresponding distinguished local basis (pointer basis) by three methods. The first demands that the pointer states mimic as closely as possible the local nonunitary evolution. The second demands that the local entropy production be minimal. The third imposes robustness on the inherent quantum and emerging classical uncertainties. All three methods lead to localized Gaussian pointer states, their formation and diffusion being governed by well-defined quantum Langevin equations.", "abstract_source_suggest": {"input": "APS"}}, {"source": "arXiv", "value": "Classical properties of an open quantum system emerge through its interaction with other degrees of freedom (decoherence). We treat the case where this interaction produces a Markovian master equation for the system. We derive the corresponding distinguished local basis (pointer basis) by three methods. The first demands that the pointer states mimic as close as possible the local non-unitary evolution. The second demands that the local entropy production be minimal. The third imposes robustness on the inherent quantum and emerging classical uncertainties. All three methods lead to localized Gaussian pointer states, their formation and diffusion being governed by well-defined quantum Langevin equations.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2000PhRvL..85.3552D"}, {"schema": "SPIRES", "value": "SPIRES-4566904"}], "titles": [{"title": "Robustness and diffusion of pointer states"}, {"source": "arXiv", "title": "Robustness and diffusion of pointer states"}], "facet_author_name": ["1003034_Claus Kiefer", "1011732_Lajos Diósi"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:540260", "updated": "2026-02-06T09:48:06.576792"}, "curated": true, "journal_title_variants": ["Phys. Rev. Lett.", "Phys.Rev.Lett."], "arxiv_eprints": [{"categories": ["quant-ph", "hep-th"], "value": "quant-ph/0005071"}]}, "id": "540260", "updated": "2026-02-06T09:48:06.576792+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/540260?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/540260?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/540260?format=latex-us", "json": "https://inspirehep.net/api/literature/540260?format=json", "json-expanded": "https://inspirehep.net