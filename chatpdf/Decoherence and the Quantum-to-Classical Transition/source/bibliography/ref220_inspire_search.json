45", "artid": "2843", "page_start": "2843", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/31077"}}, {"reference": {"arxiv_eprint": "hep-ph/0102152", "publication_info": {"journal_volume": "523", "artid": "317", "page_start": "317", "journal_title": "Phys.Lett.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/553063"}}, {"reference": {"arxiv_eprint": "hep-ph/0204190", "publication_info": {"journal_volume": "672", "artid": "462", "page_start": "462", "journal_title": "Nucl.Phys.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/585464"}}, {"reference": {"publication_info": {"journal_volume": "64", "artid": "066118", "journal_title": "Phys.Rev.E"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/552028"}}], "number_of_pages": 9, "referenced_authors_bais": ["So.Young.Pi.1", "W.H.Zurek.1", "Salman.Habib.1", "W.G.Unruh.1", "J.P.Paz.1", "B.L.Hu.1", "Hong.Yu.Zhang.1", "S.Sinha.12", "F.D.Mazzitelli.1", "R.J.Rivers.1", "F.C.Lombardo.1", "M.Buttiker.2", "A.H.Guth.1", "K.E.Nagaev.1", "D.Monteoliva.2", "L.D.Romero.1", "N.D.Antunes.1"], "legacy_version": "20190508165720.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "figures": [{"filename": "fig1PLA.png", "material": "preprint", "caption": "Time dependence of the coefficients of the master equation at $T=0$. On top we show frequency renormalization (a) and dissipation coefficients (b). Plots below show the normal $D$ (c) and anomalous $f$ (d) diffusion coefficients for short times in order to show the initial transient. Asymptotic values of diffusion are shown in (e) and (f). The parameters used in the plot are $\\gamma_0 = 0.05$, $\\Lambda = 100$, $\\Omega = 1$.", "source": "arxiv", "label": "figure1", "key": "e562e5c855fb3dca9c5c036f23275807", "url": "https://inspirehep.net/files/e562e5c855fb3dca9c5c036f23275807"}, {"filename": "fig2PLA.png", "material": "preprint", "caption": "This coefficient measures the importance of the nondiagonal terms in the density matrix. Alternatively, it is the width of the Wigner function. Is shows the rapid decoherence of the unstable particle coupled to a zero temperature environment. Parameters are $\\gamma_0 = 0.01$, $\\Omega = 1$, and $\\Lambda = 100$.", "source": "arxiv", "label": "figure3", "key": "895fcb7d9c7d89423a4b06b1da0b9e36", "url": "https://inspirehep.net/files/895fcb7d9c7d89423a4b06b1da0b9e36"}], "legacy_creation_date": "2004-12-30", "preprint_date": "2004-12", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "9 pages, RevTex file; 2 figures. Reference added"}], "first_author": {"emails": ["lombardo@df.uba.ar"], "full_name": "Lombardo, Fernando C.", "last_name": "Lombardo", "first_name": "Fernando C.", "recid": 999882}, "control_number": 668173, "dois": [{"value": "10.1016/j.physleta.2004.12.065"}, {"material": "publication", "source": "arXiv", "value": "10.1016/j.physleta.2004.12.065"}], "earliest_date": "2004-12", "document_type": ["article"], "texkeys": ["Lombardo:2004ff"], "abstracts": [{"value": "We show a completely analytical approach to the decoherence induced by a zero temperature environment on a Brownian test particle. We consider an Omhic environment bilinearly coupled to an oscillator and compute the master equation. From diffusive coefficients, we evaluate the decoherence time for the usual quantum Brownian motion and also for an upside-down oscillator, as a toy model of a quantum phase transition."}, {"source": "arXiv", "value": "We show a completely analytical approach to the decoherence induced by a zero temperature environment on a Brownian test particle. We consider an Omhic environment bilinearly coupled to an oscillator and compute the master equation. From diffusive coefficients, we evaluate the decoherence time for the usual quantum Brownian motion and also for an upside-down oscillator, as a toy model of a quantum phase transition.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2005PhLA..336...16L"}, {"schema": "SPIRES", "value": "SPIRES-6089585"}], "titles": [{"title": "Decoherence induced by zero point fluctuations in quantum Brownian motion"}, {"source": "arXiv", "title": "Decoherence induced by zero point fluctuations in quantum Brownian motion"}], "facet_author_name": ["999882_Fernando Cesar Lombardo", "1046041_Paula I. Villar"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:668173", "updated": "2026-02-06T10:04:00.258536"}, "curated": true, "journal_title_variants": ["Phys.Lett.A", "Phys. Lett. A"], "arxiv_eprints": [{"categories": ["quant-ph", "cond-mat.other", "hep-ph"], "value": "quant-ph/0412205"}]}, "id": "668173", "links": {"bibtex": "https://inspirehep.net/api/literature/668173?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/668173?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/668173?format=latex-us", "json": "https://inspirehep.net/api/literature/668173?format=json", "json-expanded": "https://inspirehep.net/api/literature/668173?format=json-expanded", "cv": "https://inspirehep.net/api/literature/668173?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A668173"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fj.physleta.2004.12.065&size=5&page=1&format=cv"}}