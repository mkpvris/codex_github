ume": "9", "artid": "336", "page_start": "336", "journal_title": "Nuovo Cim."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/44890"}}, {"reference": {"publication_info": {"journal_volume": "GOTTINGEN", "artid": "546", "page_start": "546", "journal_title": "NOONE"}}}], "number_of_pages": 5, "referenced_authors_bais": ["E.R.Caianiello.16", "Chen.Ning.Yang.1", "J.Tiomno.1"], "legacy_version": "20190307182557.0", "inspire_categories": [{"term": "Theory-HEP", "source": "curator"}], "legacy_creation_date": "2001-12-17", "preprint_date": "1952", "author_count": 3, "first_author": {"full_name": "Wick, G.C.", "last_name": "Wick", "first_name": "G.C.", "recid": 2146585}, "control_number": 42666, "dois": [{"value": "10.1103/PhysRev.88.101"}], "earliest_date": "1952", "document_type": ["article"], "texkeys": ["Wick:1952nb"], "abstracts": [{"source": "APS", "value": "The limitations to the concept of parity of quantum-mechanical states and, in particular, of intrinsic parity of elementary particles are discussed. These limitations are shown to follow from \"superselection rules,\" i.e., from restrictions on the nature and scope of possible measurements. The existence of such superselection rules is proved for the case of spinor fields; it is also conjectured that a superselection rule operates between states of different total charge.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "OSTI", "value": "4378367"}, {"schema": "SPIRES", "value": "SPIRES-4806743"}], "titles": [{"title": "The intrinsic parity of elementary particles"}], "facet_author_name": ["2146585_G.C. Wick", "983578_Eugene P. Wigner", "1021111_Arthur Strong Wightman"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:42666", "updated": "2023-03-06T13:12:27.384510"}, "curated": true, "journal_title_variants": ["Phys. Rev.", "Phys.Rev."]}}], "total": 1}, "links": {"self": "https://inspirehep.n