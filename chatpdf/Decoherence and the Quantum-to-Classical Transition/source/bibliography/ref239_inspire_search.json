tart": "291", "journal_title": "Proc.Roy.Soc.Lond.A"}}}, {"reference": {"publication_info": {"journal_volume": "180", "artid": "1035", "page_start": "1035", "journal_title": "Nature"}}}, {"reference": {"publication_info": {"journal_volume": "178", "artid": "1449", "page_start": "1449", "journal_title": "Nature"}}}, {"reference": {"publication_info": {"journal_volume": "10", "artid": "84", "page_start": "84", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3893"}}, {"reference": {"publication_info": {"journal_volume": "49", "artid": "959", "page_start": "959", "journal_title": "Proc.Ire."}}}, {"reference": {"publication_info": {"journal_volume": "50", "artid": "223", "page_start": "223", "journal_title": "Proc.Ire."}}}, {"reference": {"publication_info": {"journal_volume": "14", "artid": "664", "page_start": "664", "journal_title": "Naturwiss."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/850152"}}, {"reference": {"publication_info": {"journal_volume": "15", "artid": "370", "page_start": "370", "journal_title": "Nuovo Cim."}}}], "number_of_pages": 11, "referenced_authors_bais": ["R.H.Brown.4", "E.Schrodinger.1", "R.Q.Twiss.1", "R.J.Glauber.1"], "legacy_version": "20180223134223.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "1997-08-18", "preprint_date": "1963-02", "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/03vek6s52"}], "full_name": "Glauber, Roy J.", "last_name": "Glauber", "first_name": "Roy J.", "recid": 1008226}, "control_number": 9152, "dois": [{"value": "10.1103/PhysRev.130.2529"}], "earliest_date": "1963-02", "document_type": ["article"], "texkeys": ["Glauber:1963fi"], "abstracts": [{"source": "APS", "value": "The concept of coherence which has conventionally been used in optics is found to be inadequate to the needs of recently opened areas of experiment. To provide a fuller discussion of coherence, a succession of correlation functions for the complex field strengths is defined. The nth order function expresses the correlation of values of the fields at 2n different points of space and time. Certain values of these functions are measurable by means of n-fold delayed coincidence detection of photons. A fully coherent field is defined as one whose correlation functions satisfy an infinite succession of stated conditions. Various orders of incomplete coherence are distinguished, according to the number of coherence conditions actually satisfied. It is noted that the fields historically described as coherent in optics have only first-order coherence. On the other hand, the existence, in principle, of fields coherent to all orders is shown both in quantum theory and classical theory. The methods used in these discussions apply to fields of arbitrary time dependence. It is shown, as a result, that coherence does not require monochromaticity. Coherent fields can be generated with arbitrary spectra.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "The Quantum theory of optical coherence"}], "external_system_identifiers": [{"schema": "OSTI", "value": "4696901"}, {"schema": "SPIRES", "value": "SPIRES-629138"}], "facet_author_name": ["1008226_Roy Jay Glauber"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:9152", "updated": "2023-03-07T04:59:20.296742"}, "curated": true, "journal_title_variants": ["Phys.Rev.", "Phys. Rev."]}, "updated": "2023-03-07T04:59:20.296742+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.130.2529&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.130.2529&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.130.2529&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/l