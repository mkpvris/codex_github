{"hits": {"hits": [{"created": "2019-05-06T00:00:00+00:00", "updated": "2023-03-07T03:49:46.666402+00:00", "metadata": {"authors": [{"full_name_unicode_normalized": "arndt, markus", "full_name": "Arndt, Markus", "record": {"$ref": "https://inspirehep.net/api/authors/1073935"}, "last_name": "Arndt", "ids": [{"schema": "INSPIRE BAI", "value": "M.Arndt.1"}], "signature_block": "ARNDm", "uuid": "45e43f84-0475-4b39-b75e-222c75dbec25", "first_name": "Markus", "recid": 1073935}, {"full_name_unicode_normalized": "nairz, olaf", "full_name": "Nairz, Olaf", "record": {"$ref": "https://inspirehep.net/api/authors/2401133"}, "last_name": "Nairz", "ids": [{"schema": "INSPIRE BAI", "value": "O.Nairz.1"}], "signature_block": "NARo", "uuid": "b0ae9994-dbb7-47b4-a8ac-272bb94dbe65", "first_name": "Olaf", "recid": 2401133}, {"full_name_unicode_normalized": "vos-andreae, julian", "full_name": "Vos-Andreae, Julian", "record": {"$ref": "https://inspirehep.net/api/authors/2467699"}, "last_name": "Vos-Andreae", "ids": [{"schema": "INSPIRE BAI", "value": "J.VosAndreae.1"}], "signature_block": "ANDRj", "uuid": "5558bb2f-cd6e-468a-b245-60bc84a0d7d3", "first_name": "Julian", "recid": 2467699}, {"full_name_unicode_normalized": "keller, claudia", "full_name": "Keller, Claudia", "record": {"$ref": "https://inspirehep.net/api/authors/1892802"}, "last_name": "Keller", "ids": [{"schema": "INSPIRE BAI", "value": "C.Keller.1"}], "signature_block": "CALARc", "uuid": "51926175-e252-42fa-88bd-0edc5bb9547c", "first_name": "Claudia", "recid": 1892802}, {"full_name_unicode_normalized": "van der zouw, gerbrand", "full_name": "van der Zouw, Gerbrand", "record": {"$ref": "https://inspirehep.net/api/authors/2467704"}, "last_name": "van der Zouw", "ids": [{"schema": "INSPIRE BAI", "value": "G.van.der.Zouw.1"}], "signature_block": "Zg", "uuid": "1673e0ab-186b-4dc0-a2bb-be7c7e8b8e81", "first_name": "Gerbrand", "recid": 2467704}, {"full_name_unicode_normalized": "zeilinger, anton", "full_name": "Zeilinger, Anton", "record": {"$ref": "https://inspirehep.net/api/authors/1693289"}, "last_name": "Zeilinger", "ids": [{"schema": "INSPIRE BAI", "value": "A.Zeilinger.1"}], "signature_block": "ZALANGARa", "uuid": "aaff155d-7b4a-4b38-8e4d-0f8ddce9b42e", "first_name": "Anton", "recid": 1693289}], "publication_info": [{"journal_volume": "401", "page_end": "682", "year": 1999, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214565"}, "page_start": "680", "journal_issue": "6754", "journal_title": "Nature"}], "citation_count": 563, "citation_count_without_self_citations": 517, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "number_of_pages": 3, "legacy_version": "20190506214627.0", "inspire_categories": [{"term": "General Physics", "source": "user"}], "legacy_creation_date": "2019-05-06", "author_count": 6, "first_author": {"full_name": "Arndt, Markus", "last_name": "Arndt", "first_name": "Markus", "recid": 1073935}, "control_number": 1733209, "dois": [{"source": "submitter", "value": "10.1038/44348"}], "earliest_date": "1999", "document_type": ["article"], "texkeys": ["Arndt:1999kyb"], "abstracts": [{"source": "submitter", "value": "Quantum superposition lies at the heart of quantum mechanics and gives rise to many of its paradoxes. Superposition of de Broglie matter waves1 has been observed for massive particles such as electrons2, atoms and dimers3, small van der Waals clusters4, and neutrons5. But matter wave interferometry with larger objects has remained experimentally challenging, despite the development of powerful atom interferometric techniques for experiments in fundamental quantum mechanics, metrology and lithography6. Here we report the observation of de Broglie wave interference of C60 molecules by diffraction at a material absorption grating. This molecule is the most massive and complex object in which wave behaviour has been observed. Of particular interest is the fact that C60 is almost a classical body, because of its many excited internal degrees of freedom and their possible couplings to the environment. Such couplings are essential for the appearance of decoherence7,8, suggesting that interference experiments with large molecules should facilitate detailed studies of this process.", "abstract_source_suggest": {"input": "submitter"}}], "refereed": true, "titles": [{"source": "submitter", "title": "Wave–particle duality of C$_{60}$ molecules"}, {"source": "crossref", "title": "Wave–particle duality of C60 molecules"}], "facet_author_name": ["1892802_Corina Keller", "1073935_Markus Arndt", "2401133_Olaf Nairz", "1693289_Anton Zeilinger", "2467699_Julian Vos-Andreae", "2467704_Gerbrand van der Zouw"], "core": false, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:1733209", "updated": "2023-03-07T03:49:46.666402"}, "curated": false, "journal_title_variants": ["Nature"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/1733209?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1733209?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1733209?format=latex-us", "json": "https://inspirehep.net/api/literature/1733209?format=json", "json-expanded": "https://inspirehep.net/api/literature/1733209?format=json-expanded", "cv": "https://inspirehep.net/api/literature/1733209?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1733209"}, "id": "1733209"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1038%2F44348&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1038%2F44348&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1038%2F44348&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1038%2F44348&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1038%2F44348&size=5&page=1&format=json", "json-expanded": "https://inspireh