"referenced_authors_bais": ["A.T.Dorsey.1", "M.Zimmermann.2", "A.O.Caldeira.1", "P.M.V.B.Barone.1", "A.O.Caldera.1", "W.H.Zurek.1", "J.J.Bollinger.1", "Hong.Yu.Zhang.1", "D.J.Wineland.1", "Robert.F.OConnell.1", "A.Garg.4", "D.J.Heinzen.1", "R.Laflamme.1", "M.Fisher.2", "Salman.Habib.1", "H.Grabert.1", "R.W.P.Drever.1", "W.Zwerger.1", "Alain.Aspect.1", "E.Joos.1", "B.Yurke.1", "Sudip.Chakravarty.1", "A.J.Leggett.1", "C.M.Caves.1", "S.Sinha.13", "H.D.Zeh.1", "V.Sandberg.1", "W.M.Itano.3", "R.Omnes.1", "Sukanya.Sinha.1", "Kip.S.Thorne.1", "Eugene.P.Wigner.1", "D.Stoler.1", "J.P.Paz.1", "M.Hillery.1", "B.L.Hu.1", "G.Roger.1", "G.L.Ingold.1", "L.S.Bartell.1", "J.Dalibard.1", "W.G.Unruh.1", "P.Schramm.1", "M.O.Scully.1"], "legacy_version": "20170301223633.0", "legacy_creation_date": "1992-08-17", "preprint_date": "1992-08-17", "author_count": 3, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/01e41cf67"}], "full_name": "Paz, Juan Pablo", "last_name": "Paz", "first_name": "Juan Pablo", "recid": 993991}, "control_number": 32914, "dois": [{"value": "10.1103/PhysRevD.47.488"}], "earliest_date": "1992-08-17", "document_type": ["article"], "texkeys": ["Paz:1992pn"], "abstracts": [{"source": "APS", "value": "Environment-induced destruction of quantum coherence is investigated in a simple model where the system is a harmonic oscillator, the environment is a collection of harmonic oscillators, and the interaction between them is linear in the position coordinate of the system. We study decoherence for initial states consisting of coherent superpositions of two Gaussian wave packets in either position or momentum. A new measure of the effectiveness of decoherence appropriate to the model and choice of initial conditions is proposed. By studying the dependence of the decoherence rate on the location of the initial peaks of the Wigner function, we clarify the sense in which position is a preferred observable even though position eigenstates are not the pointer states of this model. We analyze decoherence in the low-temperature regime and show that the usual \"high-temperature\" approximation is remarkably accurate in its domain of applicability. We also examine the relationship between the decoherence process and the frequency distribution of the environment oscillators (in particular, we focus attention on a specific \"supra-Ohmic\" environment). Implications of our results for the quantum to classical transition in various contexts are briefly explored.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Reduction of the wave packet through decoherence: How long does it really take?"}], "external_system_identifiers": [{"schema": "OSTI", "value": "7119917"}, {"schema": "ADS", "value": "1993PhRvD..47..488P"}, {"schema": "SPIRES", "value": "SPIRES-2583739"}], "facet_author_name": ["981896_Wojciech H. Zurek", "993991_Juan Pablo Paz", "1007083_Salman Habib"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:32914", "updated": "2023-03-07T03:46:45.813775"}, "curated": true, "journal_title_variants": ["Phys.Rev.D", "Phys. Rev. D"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.47.488&size=5&page=1&format=cv"}}