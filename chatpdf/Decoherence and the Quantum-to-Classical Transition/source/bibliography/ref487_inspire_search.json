03kd"], "abstracts": [{"value": "The introduction of spinor and other massive fields by ``quantizing'' particles (corpuscles) is conceptually misleading. Only spatial fields must be postulated to form the fundamental objects to be quantized (that is, to define a formal basis for all quantum states), while apparent ``particles'' are a mere consequence of decoherence. This conclusion is also supported by the nature of gauge fields."}, {"source": "arXiv", "value": "The introduction of spinor and other massive fields by ``quantizing'' particles (corpuscles) is conceptually misleading. Only spatial fields must be postulated to form the fundamental objects to be quantized (that is, to define a formal basis for all quantum states), while apparent ``particles'' are a mere consequence of decoherence. This conclusion is also supported by the nature of gauge fields.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2003PhLA..309..329Z"}, {"schema": "SPIRES", "value": "SPIRES-5290120"}, {"schema": "MSNET", "value": "1973026"}], "titles": [{"title": "There is no 'first' quantization"}, {"source": "arXiv", "title": "There is no first quantization."}, {"source": "arXiv", "title": "There is no \"first\" quantization"}], "facet_author_name": ["982291_H.Dieter Zeh"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:610984", "updated": "2025-10-01T11:21:33.390180"}, "curated": true, "journal_title_variants": ["Phys. Lett. A", "Phys.Lett.A"], "arxiv_eprints": [{"categories": ["quant-ph", "cond-mat", "hep-th"], "value": "quant-ph/0210098"}]}, "links": {"bibtex": "https://inspirehep.net/api/literature/610984?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/610984?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/610984?format=latex-us", "json": "https://inspirehep.net/api/literature/610984?format=json", "json-expanded": "htt