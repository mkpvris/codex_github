eferenced_authors_bais": ["A.R.Calderbank.1", "G.C.Guo.1", "E.M.Rains.1", "N.J.A.Sloane.1", "R.Laflamme.1", "E.H.Lieb.1", "W.H.Zurek.1", "R.Jozsa.1", "A.Ekert.1", "W.G.Unruh.1", "K.Hepp.1", "Chiara.Macchiavello.1", "D.P.DiVincenzo.1", "D.Gottesman.1", "P.W.Shor.1", "I.L.Chuang.1", "L.M.Duan.1"], "legacy_version": "20160616173357.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1997-05-27", "preprint_date": "1997-05", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "Revised version (to make it accessible to a broader readership) to appear on PRL (4 pages, REVTEX)"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/00bgk9508"}], "full_name": "Zanardi, P.", "last_name": "Zanardi", "first_name": "P.", "recid": 1969109}, "control_number": 443512, "dois": [{"value": "10.1103/PhysRevLett.79.3306"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.79.3306"}], "earliest_date": "1997-05", "document_type": ["article"], "texkeys": ["Zanardi:1997vm"], "abstracts": [{"value": "In this paper we study a model quantum register $\\cal R$ made of $N$ replicas (cells) of a given finite-dimensional quantum system S. Assuming that all cells are coupled with a common environment with equal strength we show that, for $N$ large enough, in the Hilbert space of $\\cal R$ there exists a linear subspace ${\\cal C}_N$ which is dynamically decoupled from the environment. The states in ${\\cal C}_N$ evolve unitarily and are therefore decoherence-dissipation free. The space ${\\cal C}_N$ realizes a noiseless quantum code in which information can be stored, in principle, for arbitrarily long time without being affected by errors."}, {"source": "arXiv", "value": "In this paper we study a model quantum register $\\cal R$ made of $N$ replicas (cells) of a given finite-dimensional quantum system S. Assuming that all cells are coupled with a common environment with equal strength we show that, for $N$ large enough, in the Hilbert space of $\\cal R$ there exists a linear subspace ${\\cal C}_N$ which is dynamically decoupled from the environment. The states in ${\\cal C}_N$ evolve unitarily and are therefore decoherence-dissipation free. The space ${\\cal C}_N$ realizes a noiseless quantum code in which information can be stored, in principle, for arbitrarily long time without being affected by errors.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "1997PhRvL..79.3306Z"}, {"schema": "SPIRES", "value": "SPIRES-3558606"}], "titles": [{"title": "Noiseless quantum codes"}, {"source": "arXiv", "title": "Noiseless Quantum Codes"}], "facet_author_name": ["1969109_Paolo Zanardi", "992258_Mario Rasetti"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:443512", "updated": "2025-10-01T09:52:42.164328"}, "curated": true, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9705044"}]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.79.3306&siz