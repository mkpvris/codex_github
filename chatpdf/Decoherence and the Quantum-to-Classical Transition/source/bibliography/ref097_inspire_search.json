rnal_volume": "85", "artid": "194", "year": 2000, "page_start": "194", "journal_title": "Phys.Rev.Lett."}, "authors": [{"full_name": "Ruskai, M.B."}]}, "raw_refs": [{"schema": "text", "value": "M.B. Ruskai, Phys. Rev. Lett. 85, 194 (2000); D.A. Lidar et al., Phys. Rev. A 61, 052307 (2000)."}], "record": {"$ref": "https://inspirehep.net/api/literature/502724"}}, {"reference": {"publication_info": {"journal_volume": "57", "artid": "3276", "year": 1998, "page_start": "3276", "journal_title": "Phys.Rev.A"}, "authors": [{"full_name": "Zanardi, P."}]}, "raw_refs": [{"schema": "text", "value": "P. Zanardi, Phys. Rev. A 57, 3276 (1998)."}], "record": {"$ref": "https://inspirehep.net/api/literature/443513"}}, {"reference": {"publication_info": {"journal_volume": "82", "artid": "1784", "year": 1999, "page_start": "1784", "journal_title": "Phys.Rev.Lett."}, "authors": [{"full_name": "Lloyd, S."}, {"full_name": "Braunstein, S.L."}]}, "raw_refs": [{"schema": "text", "value": "S. Lloyd and S.L. Braunstein, Phys. Rev. Lett. 82, 1784 (1999)."}], "record": {"$ref": "https://inspirehep.net/api/literature/478509"}}], "number_of_pages": 5, "referenced_authors_bais": ["P.Zanardi.3", "A.R.Calderbank.1", "Seth.Lloyd.1", "J.Kempe.1", "G.C.Guo.1", "E.M.Rains.1", "N.J.A.Sloane.1", "R.Laflamme.1", "M.B.Ruskai.1", "W.H.Zurek.1", "L.Viola.3", "David.Bacon.1", "D.A.Lidar.1", "Andrew.M.Steane.1", "D.Gottesman.1", "R.H.Hardin.1", "N.P.Landsman.3", "P.W.Shor.1", "L.M.Duan.1", "K.B.Whaley.2", "S.L.Braunstein.1", "E.Knill.1"], "inspire_categories": [{"term": "Quantum Physics"}], "preprint_date": "2000-09-06", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "5 Pages, Latex. Presentation improved, results unchanged. To appear in PRA"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/02be6w209"}, {"schema": "ROR", "value": "https://ror.org/05eva6s33"}], "full_name": "Zanardi, Paolo", "last_name": "Zanardi", "first_name": "Paolo", "recid": 1969109}, "control_number": 2948538, "dois": [{"source": "APS", "value": "10.1103/PhysRevA.63.012301"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.63.012301"}], "earliest_date": "2000-09-06", "document_type": ["article"], "texkeys": ["Zanardi:2000ekd"], "abstracts": [{"source": "APS", "value": "The dynamical-algebraic structure underlying all the schemes for quantum information stabilization is argued to be fully contained in the reducibility of the operator algebra describing the interaction with the environment of the coding quantum system. This property amounts to the existence of a nontrivial group of symmetries for the global dynamics. We provide a unified framework that allows us to build systematically additional classes of error correcting codes and noiseless subsystems. It is shown that by using symmetrization strategies one can artificially produce noiseless subsystems supporting universal quantum computation.", "abstract_source_suggest": {"input": "APS"}}, {"source": "arXiv", "value": "The dynamical-algebraic structure underlying all the schemes for quantum information stabilization is argued to be fully contained in the reducibility of the operator algebra describing the interaction with the environment of the coding quantum system. This property amounts to the existence of a non-trivial group of symmetries for the global dynamics. We provide a unified framework which allows us to build systematically new classes of error correcting codes and noiseless subsystems. It is shown how by using symmetrization strategies one can artificially produce noiseless subsystems supporting universal quantum computation.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "APS", "title": "Stabilizing quantum information"}, {"source": "arXiv", "title": "Stabilizing Quantum Information"}], "facet_author_name": ["1969109_Paolo Zanardi"], "core": true, "imprints": [{"date": "2000-12-05"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2948538", "updated": "2025-10-01T10:51:00.387575"}, "curated": false, "journal_title_variants": ["Phys.Rev.A", "Phys. Rev. A"], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9910016"}]}, "created": "2025-07-18T07:02:38.387986+00:00", "id": "2948538"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.63.012301&size=5&page=1&format=cv"}}