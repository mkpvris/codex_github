_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/166207"}}, {"reference": {"arxiv_eprint": "gr-qc/9306016", "publication_info": {"journal_volume": "47", "artid": "5414", "page_start": "5414", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/35170"}}, {"reference": {"publication_info": {"journal_volume": "382", "artid": "295", "page_start": "295", "journal_title": "Proc.Roy.Soc.Lond.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/1181836"}}, {"reference": {"publication_info": {"journal_volume": "88", "artid": "286", "page_start": "286", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/89501"}}, {"reference": {"publication_info": {"journal_volume": "27", "artid": "2885", "page_start": "2885", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/13239"}}], "number_of_pages": 13, "referenced_authors_bais": ["Julian.B.Barbour.1", "E.Joos.1", "G.C.Wick.1", "N.P.Landsman.3", "J.L.Gervais.1", "A.O.Caldeira.1", "C.Bunster.1", "Daniel.E.Zwanziger.1", "P.M.V.B.Barone.1", "T.Regge.1", "H.D.Zeh.1", "W.H.Zurek.1", "C.Kiefer.1", "F.Strocchi.1", "Lawrence.H.Ford.1", "E.Lubkin.1", "Eugene.P.Wigner.1", "D.N.Page.1", "O.Kuebler.1", "C.J.Isham.1", "W.K.Wootters.1", "R.Mirman.9", "B.Bertotti.1", "Y.Aharonov.1", "A.S.Wightman.1", "L.Susskind.1"], "legacy_version": "20180614221517.0", "inspire_categories": [{"term": "Gravitation and Cosmology"}], "legacy_creation_date": "1994-10-25", "preprint_date": "1994-10", "author_count": 3, "first_author": {"full_name": "Giulini, D.", "last_name": "Giulini", "first_name": "D.", "recid": 1008263}, "control_number": 378809, "dois": [{"value": "10.1016/0375-9601(95)00128-P"}], "earliest_date": "1994-10", "document_type": ["article"], "texkeys": ["Giulini:1994zh"], "abstracts": [{"source": "DESY", "value": "We discuss the applicability of the programme of decoherence -- emergence of approximate classical behaviour through interaction with the environment -- to cases where it was suggested that the presence of symmetries would lead to exact superselection rules. For this discussion it is useful to make a distinction between pure symmetries and redundancies, which results from an investigation into the constraint equations of the corresponding theories. We discuss, in particular, superpositions of states with different charges, as well as with different masses, and suggest how the corresponding interference terms, although they exist in principle, become inaccessible through decoherence.", "abstract_source_suggest": {"input": "DESY"}}], "refereed": true, "primary_arxiv_category": ["gr-qc"], "external_system_identifiers": [{"schema": "MSNET", "value": "1327674"}, {"schema": "ADS", "value": "1995PhLA..199..291G"}, {"schema": "SPIRES", "value": "SPIRES-3041123"}], "titles": [{"title": "Symmetries, superselection rules, and decoherence"}], "facet_author_name": ["982291_H.Dieter Zeh", "1003034_Claus Kiefer", "1008263_Domenico Giulini"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:378809", "updated": "2023-03-09T18:03:13.384668"}, "curated": true, "journal_title_variants": ["Phys. Lett. A", "Phys.Lett.A"], "arxiv_eprints": [{"categories": ["gr-qc"], "value": "gr-qc/9410029"}]}, "links": {"bibtex": "https://inspirehep.net/api/literature/378809?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/378809?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/378809?format=latex-us", "json": "https://inspirehep.net/api/literature/378809?format=json", "json-expanded": "https://inspirehep.net/api/literature/378809?format=json-expanded", "cv": "https://inspirehep.net/api/literature/378809?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A378809"}, "updated": "2023-03