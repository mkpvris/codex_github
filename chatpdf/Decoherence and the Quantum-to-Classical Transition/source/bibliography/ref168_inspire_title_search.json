02:16:58.930972"}, "curated": true, "journal_title_variants": ["Annalen Phys."]}, "id": "483175", "updated": "2023-03-07T02:16:58.930972+00:00", "created": "1999-02-24T00:00:00+00:00"}, {"links": {"bibtex": "https://inspirehep.net/api/literature/478193?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/478193?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/478193?format=latex-us", "json": "https://inspirehep.net/api/literature/478193?format=json", "json-expanded": "https://inspirehep.net/api/literature/478193?format=json-expanded", "cv": "https://inspirehep.net/api/literature/478193?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A478193"}, "metadata": {"citation_count_without_self_citations": 1, "authors": [{"full_name_unicode_normalized": "carati, a.", "full_name": "Carati, A.", "record": {"$ref": "https://inspirehep.net/api/authors/2263293"}, "last_name": "Carati", "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903009"}, "value": "Milan U."}], "ids": [{"schema": "INSPIRE BAI", "value": "A.Carati.2"}], "signature_block": "CARATa", "first_name": "A.", "uuid": "76627ae6-5810-4570-852c-e3b949905dbf", "recid": 2263293}], "citation_count": 1, "publication_info": [{"journal_volume": "28", "page_end": "853", "year": 1998, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214747"}, "page_start": "843", "journal_title": "Found.Phys."}], "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "keywords": [{"schema": "INSPIRE", "value": "electromagnetic field: classical"}, {"schema": "INSPIRE", "value": "particle: pair production"}, {"schema": "INSPIRE", "value": "Abraham-Lorentz-Dirac equation: solution"}], "number_of_pages": 11, "legacy_version": "20180201133120.0", "legacy_creation_date": "1998-10-22", "preprint_date": "1998", "author_count": 1, "first_author": {"full_name": "Carati, A.", "last_name": "Carati", "first_name": "A.", "recid": 2263293}, "control_number": 478193, "dois": [{"value": "10.1023/A:1018810222701"}], "earliest_date": "1998", "document_type": ["article"], "texkeys": ["Carati:1998vg"], "abstracts": [{"source": "Springer", "value": "One of the most relevant features of quantum field theory is the phenomenon of pair production, the existence of which, first suggested by Dirac, was not even suspected in the older theories. On the other hand Feynman, in the spirit of his spatiotemporal approach to quantum mechanics, showed how a description of pair production could be given within classical relativistic kinematics; in fact, he actually exhibited world lines with the required properties in the framework of a nonlocal modification of classical electrodynamics conceived by Bopp. In the present paper we show how classical world lines, just of the type required by Feynman to describe the phenomenon of pair production, naturally arise in classical electrodynamics. More precisely, we show that such world lines occur as solutions of the well-known Abraham-Lorentz-Dirac equation, which was originally designed to describe the motion of just a single point charge in self-interaction with the electromagnetic field.", "abstract_source_suggest": {"input": "Springer"}}], "refereed": true, "titles": [{"title": "Pair production in classical electrodynamics"}, {"source": "arXiv", "title": "Pair production in classical electrodynamics."}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-3875350"}, {"schema": "MSNET", "value": "1652395"}], "facet_author_name": ["2263293_A. Carati"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:478193", "updated": "2023-10-03T07:45:54.583227"}, "curated": true, "journal_title_variants": ["Found. Phys.", "Found.Phys."]}, "id": "478193", "updated": "2023-10-03T07:45:54.583227+00:00", "created": "1998-10-22T00:00:00+00:00"}], "total": 182}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Classical%