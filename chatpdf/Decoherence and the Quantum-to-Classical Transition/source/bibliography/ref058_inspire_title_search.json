: [{"schema": "INSPIRE", "value": "book"}, {"schema": "INSPIRE", "value": "quantum mechanics: relativistic"}, {"schema": "INSPIRE", "value": "angular momentum"}, {"schema": "INSPIRE", "value": "symmetry"}, {"schema": "INSPIRE", "value": "approximation"}, {"schema": "INSPIRE", "value": "scattering"}, {"schema": "INSPIRE", "value": "Schroedinger equation: solution"}], "number_of_pages": 550, "legacy_version": "20201125165847.0", "inspire_categories": [{"term": "Other"}, {"term": "General Physics"}], "legacy_creation_date": "2011-06-16", "preprint_date": "2011", "author_count": 2, "urls": [{"value": "http://www.cambridge.org/academic/subjects/physics/quantum-physics-quantum-information-and-quantum-computation/modern-quantum-mechanics-2nd-edition?format=AR&isbn=9781108527422"}], "first_author": {"full_name": "Sakurai, Jun John", "last_name": "Sakurai", "first_name": "Jun John", "recid": 1037873}, "control_number": 913962, "dois": [{"source": "bibmatch", "value": "10.1017/9781108587280"}], "earliest_date": "2011", "document_type": ["book"], "texkeys": ["Sakurai:2011zz"], "abstracts": [{"source": "Cambridge University Press", "value": "Modern Quantum Mechanics is a classic graduate level textbook, originally published in 1985, covering the main concepts from quantum mechanics in a clear, organized and engaging manner. The original author, J. J. Sakurai, was a renowned particle theorist. This third edition, revised by Jim Napolitano, introduces topics that extend its value into the twenty-first century, such as modern mathematical techniques for advanced quantum mechanical calculations, while at the same time retaining fundamental topics such as neutron interferometer experiments, Feynman path integrals, correlation measurements, and Bell's inequalities. A solutions manual is available.\n\nUpdated and thoroughly classroom-tested by the author, ensuring its relevance for anyone studying physics today\nNew content helps students better understand the core material as well as more advanced topics\nForty new end-of-chapter problems have been added, while others have been clarified to be more accessible for modern students\n A solution manual for instructors using this textbook can be downloaded from https://www.cambridge.org/9781108422413.", "abstract_source_suggest": {"input": "Cambridge University Press"}}], "titles": [{"title": "Modern Quantum Mechanics"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-9099816"}], "book_series": [{"title": "Quantum physics, quantum information and quantum computation"}], "facet_author_name": ["996084_James Justin Napolitano", "1037873_Jun John Sakurai"], "core": true, "editions": ["3"], "imprints": [{"date": "2020-10-10", "publisher": "Cambridge University Press"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:913962", "updated": "2025-05-29T14:10:28.187628"}, "curated": true}}, {"updated": "2026-05-26T05:11:58.558235+00:00", "id": "2002308", "links": {"bibtex": "https://inspirehep.net/api/literature/2002308?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2002308?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2002308?format=latex-us", "json": "https://inspirehep.net/api/literature/2002308?format=json", "json-expanded": "https://inspirehep.net/api/literature/2002308?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2002308?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2002308"}, "created": "2022-01-06T08:20:42.674327+00:00", "metadata": {"publication_info": [{"year": 2021}], "authors": [{"raw_affiliations": [{"value": "Florida Atlantic University, USA"}], "full_name_unicode_normalized": "faulkner, j.s.", "full_name": "Faulkner, J.S.", "record": {"$ref": "https://inspirehep.net/api/authors/2003337"}, "last_name": "Faulkner", "ids": [{"schema": "INSPIRE BAI", "value": "J.S.Faulkner.1"}], "signature_block": "FALNARj", "first_name": "J.S.", "uuid": "3b754714-43df-424b-b0e3-0ff82d37babb", "recid": 2003337}], "citation_count": 0, "citation_count_without_self_citations": 0, "isbns": [{"medium": "online", "value": "9780750321662"}, {"medium": "print", "value": "9780750321655"}, {"medium": "online", "value": "9780750321679"}], "keywords": [{"source": "author", "value": "Quantum physics (quantum mechanics and quantum field theory)"}, {"source": "author", "value": "Quantum physics (quantum mechanics & quantum field theory)"}, {"source": "author", "value": "SCIENCE / Quantum Theory"}], "$schema": "https://inspirehep.net/schemas/records/hep.json", "inspire_categories": [{"term": "Quantum Physics"}], "author_count": 1, "first_author": {"full_name": "Faulkner, J.S.", "last_name": "Faulkner", "first_name": "J.S.", "recid": 2003337}, "control_number": 2002308, "earliest_date": "2021-12-22", "document_type": ["book"], "texkeys": ["Faulkner:2021uow"], "abstracts": [{"source": "IOP", "value": "Modern Quantum Mechanics and Quantum Information surveys the fundamental aspects of quantum mechanics against the backdrop of its use in modern science applications. Covering several topics in modern quantum mechanics and quantum information that do not appear in older texts, this authoritative and expansive survey of the field is ideal for advanced researchers, upper undergraduate and graduate students. ]]>", "abstract_source_suggest": {"input": "IOP"}}], "titles": [{"source": "IOP", "title": "Modern Quantum Mechanics and Quantum Information"}], "facet_author_name": ["2003337_J.S. Faulkner"], "core": false, "imprints": [{"date": "2021-12-22", "publisher": "IOP"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2002308", "updated": "2026-05-26T05:11:58.558235"}, "curated": false}}, {"updated": "2025-10-02T13:53:16.848967+00:00", "id": "3024920", "links": {"bibtex": "https://inspirehep.net/api/literature/3024920?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/3024920?format=latex-eu", "latex-us": "https://inspirehep.net/api/liter