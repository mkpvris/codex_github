tart": "1516", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/172316"}}, {"reference": {"publication_info": {"journal_volume": "37", "artid": "1212", "page_start": "1212", "journal_title": "Am.J.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "85", "artid": "166", "page_start": "166", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/8809"}}, {"reference": {"publication_info": {"journal_volume": "85", "artid": "180", "page_start": "180", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/8810"}}, {"reference": {"publication_info": {"journal_volume": "25", "artid": "583", "page_start": "583", "journal_title": "Contemp.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "34", "artid": "470", "page_start": "470", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/222969"}}, {"reference": {"publication_info": {"journal_volume": "102", "artid": "383", "page_start": "383", "journal_title": "Nuovo Cim.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/265509"}}], "number_of_pages": 27, "referenced_authors_bais": ["T.Weber.6", "G.C.Ghirardi.1", "J.Anandan.1", "W.H.Zurek.1", "A.Rimini.2", "J.B.Hartle.1", "D.Bohm.1", "O.Nicrosini.1", "Hugh.Everett.1"], "legacy_version": "20180614215830.0", "inspire_categories": [{"term": "Gravitation and Cosmology"}], "legacy_creation_date": "1989-06-20", "preprint_date": "1989-05", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "28 pages, with 3 page foreword; LaTeX"}], "first_author": {"emails": ["apak@damtp.cam.ac.uk"], "full_name": "Kent, Adrian", "last_name": "Kent", "first_name": "Adrian", "recid": 1003226}, "control_number": 278893, "dois": [{"value": "10.1142/S0217751X90000805"}, {"material": "publication", "source": "arXiv", "value": "10.1142/S0217751X90000805"}], "earliest_date": "1989-05", "document_type": ["article"], "texkeys": ["Kent:1989nm"], "abstracts": [{"source": "arXiv", "value": "A short foreword has been added for the archive version of this article, which otherwise appears as originally published in 1990, except for the updating of references. The original abstract follows. This is a critical review of the literature on many-worlds interpretations (MWI), with arguments drawn partly from earlier critiques by Bell and Stein. The essential postulates involved in various MWI are extracted, and their consistency with the evident physical world is examined. Arguments are presented against MWI proposed by Everett, Graham and DeWitt. The relevance of frequency operators to MWI is examined; it is argued that frequency operator theorems of Hartle and Farhi-Goldstone-Gutmann do not in themselves provide a probability interpretation for quantum mechanics, and thus neither support existing MWI nor would be useful in constructing new MWI. Comments are made on papers by Geroch and Deutsch that advocate MWI. It is concluded that no plausible set of axioms exists for an MWI that describes known physics.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["gr-qc"], "external_system_identifiers": [{"schema": "MSNET", "value": "1049497"}, {"schema": "OSTI", "value": "5695017"}, {"schema": "ADS", "value": "1990IJMPA...5.1745K"}, {"schema": "KEKSCAN", "value": "2000-33-141"}, {"schema": "SPIRES", "value": "SPIRES-2019000"}], "titles": [{"title": "AGAINST MANY WORLDS INTERPRETATIONS"}, {"source": "arXiv", "title": "Against Many-Worlds Interpretations"}], "facet_author_name": ["1003226_Adrian P.A. Kent"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:278893", "updated": "2026-02-09T13:58:11.367617"}, "curated": true, "journal_title_variants": ["Int.J.Mod.Phys.A", "Int. J. Mod. Phys. A"], "arxiv_e