"citation_count": 198, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "references": [{"reference": {"publication_info": {"journal_volume": "131", "artid": "101", "page_start": "101", "journal_title": "Z.Phys."}}}], "number_of_pages": 4, "legacy_version": "20161011200143.0", "legacy_creation_date": "2008-09-12", "preprint_date": "1960-10-15", "author_count": 2, "first_author": {"full_name": "Araki, Huzihiro", "last_name": "Araki", "first_name": "Huzihiro", "recid": 1018201}, "control_number": 46966, "dois": [{"value": "10.1103/PhysRev.120.622"}], "earliest_date": "1960-10-15", "document_type": ["article"], "texkeys": ["Araki:1960zz"], "abstracts": [{"source": "APS", "value": "The limitation on the measurement of an operator imposed by the presence of a conservation law is studied. It is shown that an operator which does not commute with a conserved (additive) quantity cannot be measured exactly (in the sense of von Neumann). It is also shown for a simple case that an approximate measurement of such an operator is possible to any desired accuracy.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Measurement of Quantum Mechanical Operators"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-7942346"}], "facet_author_name": ["1018201_Haruhiko Araki", "2578513_Mutsuo M. Yanase"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:46966", "updated": "2023-03-07T05:20:48.721722"}, "curated": true, "journal_title_variants": ["Phys.Rev.", "Phys. Rev."]}, "updated": "2023-03-07T05:20:48.721722+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.120.622&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.120.622&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.120.622&size=5&page=1&format=latex-eu", "latex-us": "https://insp