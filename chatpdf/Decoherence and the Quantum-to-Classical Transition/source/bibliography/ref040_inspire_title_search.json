ntum Physics", "source": "arxiv"}], "legacy_creation_date": "1999-04-20", "preprint_date": "1999-04", "author_count": 1, "public_notes": [{"value": "Condensed version of paper submitted to Conference on New Insights in Quantum Mechanics, Goslar, Germany, 31 Aug - 3 Sep 1998"}, {"source": "arXiv", "value": "11 pages tcilatex. This is a condensed version of material prepared for, and submitted to proceedings of the symposium entitled ``New Insights in Quantum Mechanics-Fundamentals, Experimental Results and Theoretical Directions'' Goslar, Germany, September 1-3, 1998"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/046ak2485"}], "full_name": "Schroer, Bert", "last_name": "Schroer", "first_name": "Bert", "recid": 989674}, "control_number": 498537, "earliest_date": "1999-04", "document_type": ["conference paper"], "texkeys": ["Schroer:1999up"], "abstracts": [{"value": "Several aspects of the manifestation of the causality principle in LQP (local quantum physics) are reviewed or presented. Particular emphasis is given to those properties which are typical for LQP in the sense that they do go beyond the structure of general quantum theory and even escape the Lagrangian quantization methods of standard QFT. The most remarkable are those relating causality to the modular Tomita-Takesaki theory, since they bring in the basic concepts of antiparticles, charge superselections as well as internal and external (geometric and hidden) symmetries."}, {"source": "arXiv", "value": "Several aspects of the manifestation of the causality principle in LQP (local quantum physics) are reviewed or presented. Particular emphasis is given to those properties which are typical for LQP in the sense that they do go beyond the structure of general quantum theory and even escape the Lagrangian quantization methods of standard QFT. The most remarkable are those relating causality to the modular Tomita-Takesaki theory, since they bring in the basic concepts of antiparticles, charge superselections as well as internal and external (geometric and hidden) symmetries.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "CERNKEY", "value": "0322252"}, {"schema": "SPIRES", "value": "SPIRES-4042220"}], "titles": [{"title": "Basic quantum theory and measurement from the viewpoint of local quantum physics"}, {"source": "arXiv", "title": "Basic quantum theory and measurement from the viewpoint of local quantum physics."}, {"source": "arXiv", "title": "Basic Quantum Theory and Measurement from the Viewpoint of Local Quantum Physics"}], "facet_author_name": ["989674_Bert Schroer"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:498537", "updated": "2025-09-30T14:31:14.533405"}, "curated": true, "arxiv_eprints": [{"categories": ["quant-ph", "hep-th"], "value": "quant-ph/9904072"}]}}], "total": 2}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=t%20%22Quantum%20Theory%20and%20Measurement%22&size=5&page=1&format=cv"}}