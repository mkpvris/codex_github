cord": {"$ref": "https://inspirehep.net/api/literature/212604"}}, {"reference": {"publication_info": {"journal_volume": "59", "artid": "1", "page_start": "1", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/260239"}}, {"reference": {"publication_info": {"journal_volume": "68", "artid": "1093", "page_start": "1093", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/318281"}}], "number_of_pages": 12, "referenced_authors_bais": ["A.T.Dorsey.1", "A.Garg.4", "Sudip.Chakravarty.1", "A.J.Leggett.1", "A.O.Caldeira.1", "M.Fisher.2", "K.Fujikawa.1", "M.Sasaki.1", "S.Iso.1", "Chang.Pu.Sun.1", "W.Zwerger.1", "L.H.Yu.1", "Hiroshi.Suzuki.1"], "legacy_version": "20150616112221.0", "inspire_categories": [{"term": "Theory-HEP"}], "legacy_creation_date": "1996-05-13", "preprint_date": "1996-05", "author_count": 1, "first_author": {"full_name": "Yu, Li-Hua", "last_name": "Yu", "first_name": "Li-Hua", "recid": 1075546}, "control_number": 418477, "earliest_date": "1996-05", "document_type": ["article"], "texkeys": ["Yu:1996mh"], "abstracts": [{"value": "Applying a technique developed recently [1,2] for an harmonic oscillator coupled to a bath of harmonic oscillators, we present an exact solution for the tunneling problem in an Ohmic dissipative system with inverted harmonic potential. The result shows that while the dissipation tends to suppress the tunneling, the Brownian motion tends to enhance the tunneling. Whether the tunneling rate increases or not would then depend on the initial conditions. We give a specific formula to calculate the tunneling probability determined by various parameters and the initial conditions."}], "primary_arxiv_category": ["hep-th"], "titles": [{"title": "An Exact solution for quantum tunneling in a dissipative system"}, {"source": "arXiv", "title": "An Exact Solution for Quantum Tunneling in a Dissipative System"