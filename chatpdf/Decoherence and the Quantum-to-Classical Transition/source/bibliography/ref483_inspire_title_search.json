page_start": "1", "journal_title": "Phil.Sci."}, {"page_end": "213", "page_start": "181", "parent_record": {"$ref": "https://inspirehep.net/api/literature/607314"}}], "citation_count_without_self_citations": 82, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "keywords": [{"schema": "INSPIRE", "value": "quantum mechanics: relativistic"}, {"schema": "INSPIRE", "value": "field theory: relativistic"}, {"schema": "INSPIRE", "value": "field theory: local"}, {"schema": "INSPIRE", "value": "relativity theory"}, {"schema": "INSPIRE", "value": "causality"}, {"schema": "INSPIRE", "value": "invariance: translation"}, {"schema": "INSPIRE", "value": "energy"}, {"schema": "INSPIRE", "value": "velocity"}, {"schema": "INSPIRE", "value": "axiomatic field theory"}, {"schema": "INSPIRE", "value": "particle: model"}, {"schema": "INSPIRE", "value": "philosophy"}], "references": [{"reference": {"publication_info": {"journal_volume": "4", "artid": "315", "page_start": "315", "journal_title": "Commun.Math.Phys."}}}, {"reference": {"arxiv_eprint": "math-ph/0011044"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/537551"}}, {"reference": {"publication_info": {"journal_volume": "32", "artid": "6535", "page_start": "6535", "journal_title": "J.Phys.A"}}, "record": {"$ref": "https://inspirehep.net/api/literature/3007267"}}, {"reference": {"publication_info": {"journal_volume": "8", "artid": "164", "page_start": "164", "journal_title": "Commun.Math.Phys."}}}, {"reference": {"arxiv_eprint": "quant-ph/9809030", "publication_info": {"journal_volume": "7", "artid": "716", "page_start": "716", "journal_title": "Annalen Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/476189"}}, {"reference": {"publication_info": {"journal_volume": "15", "artid": "3715", "page_start": "3715", "journal_title": "J.Phys.A"}}}], "number_of_pages": 30, "referenced_authors_bais": ["P.Busch.2", "G.C.Hegerfeldt.1", "Detlev.Buchholz.1"], "legacy_version": "20180327133104.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2001-03-16", "preprint_date": "2001-03", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "30 pages, LaTeX"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/01an3r305"}], "full_name": "Halvorson, Hans", "last_name": "Halvorson", "ids": [{"schema": "ORCID", "value": "0000-0003-3022-2344"}], "first_name": "Hans", "recid": 1006896}, "control_number": 554209, "dois": [{"value": "10.1142/9789812776440_0010"}, {"material": "publication", "source": "arXiv", "value": "10.1142/9789812776440_0010"}], "earliest_date": "2001-03", "document_type": ["article"], "texkeys": ["Halvorson:2001hb"], "abstracts": [{"value": "Several recent arguments purport to show that there can be no relativistic, quantum-mechanical theory of localizable particles and, thus, that relativity and quantum mechanics can be reconciled only in the context of quantum field theory. We point out some loopholes in the existing arguments, and we provide two no-go theorems to close these loopholes. However, even with these loopholes closed, it does not yet follow that relativity plus quantum mechanics exclusively requires a field ontology, since relativistic quantum field theory itself might permit an ontology of localizable particles supervenient on the fundamental fields. Thus, we provide another no-go theorem to rule out this possibility. Finally, we allay potential worries about this conclusion by arguing that relativistic quantum field theory can nevertheless explain the possibility of \"particle detections,\" as well as the pragmatic utility of \"particle talk.\""}, {"source": "arXiv", "value": "Several recent arguments purport to show that there can be no relativistic, quantum-mechanical theory of localizable particles and, thus, that relativity and quantum mechanics can be reconciled only in the context of quantum field theory. We point out some loopholes in the existing arguments, and we provide two no-go theorems to close these loopholes. However, even with these loopholes closed, it does not yet follow that relativity plus quantum mechanics exclusively requires a field ontology, since relativistic quantum field theory itself might permit an ontology of localizable particles supervenient on the fundamental fields. Thus, we provide another no-go theorem to rule out this possibility. Finally, we allay potential worries about this conclusion by arguing that relativistic quantum field theory can nevertheless explain the possibility of \"particle detections,\" as well as the pragmatic utility of \"particle talk.\"", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-4592425"}], "titles": [{"title": "No place for particles in relativistic quantum theories?"}, {"source": "arXiv", "title": "No place for particles in relativistic quantum theories?"}], "facet_author_name": ["1006896_Hans Halvorson", "1013361_Robert K. Clifton"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:554209", "updated": "2026-02-06T09:49:35.712355"}, "curated": true, "journal_title_variants": ["Phil. Sci.", "Phil.Sci."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0103041"}]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22No%20Place%20for%20Particles%20in%20Relativistic%20Quantum%20Theories%3F%22&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=t%20%22No%20Place%20for%20Particles%20in%20Relativistic%20Quantum%20Theories%3F%22&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=t%20%22No%20Place%20for%20Particles%20in%20Relativistic%20Quantum%20Theories%3F%22&size=5&page=1&format=latex-eu", "latex-us": "https://i