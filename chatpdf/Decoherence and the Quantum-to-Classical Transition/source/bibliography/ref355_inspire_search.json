{"hits": {"hits": [{"metadata": {"authors": [{"raw_affiliations": [{"value": "AT&T Bell Laboratories, Room 2D-149, 600 Mountain Avenue, Murray Hill, New Jersey 07974"}], "full_name_unicode_normalized": "shor, peter w.", "full_name": "Shor, Peter W.", "record": {"$ref": "https://inspirehep.net/api/authors/988844"}, "last_name": "Shor", "affiliations": [{"curated_relation": true, "record": {"$ref": "https://inspirehep.net/api/institutions/907861"}, "value": "Bell Labs"}], "ids": [{"schema": "INSPIRE BAI", "value": "P.W.Shor.1"}], "signature_block": "SARp", "uuid": "f5264b26-bf28-4d4b-8105-4e2d75b6c533", "first_name": "Peter W.", "recid": 988844}], "citation_count": 3245, "citation_count_without_self_citations": 3236, "publication_info": [{"journal_volume": "52", "page_end": "R2496", "year": 1995, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1613967"}, "page_start": "R2493", "journal_issue": "4", "journal_title": "Phys.Rev.A"}], "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "inspire_categories": [{"term": "General Physics"}], "author_count": 1, "urls": [{"description": "Physics Focus article", "value": "https://physics.aps.org/articles/v9/65"}], "first_author": {"full_name": "Shor, Peter W.", "last_name": "Shor", "first_name": "Peter W.", "recid": 988844}, "control_number": 1913890, "dois": [{"value": "10.1103/physreva.52.r2493"}], "earliest_date": "1995-10-01", "document_type": ["article"], "texkeys": ["Shor:1995hbe"], "abstracts": [{"source": "submitter", "value": "Recently, it was realized that use of the properties of quantum mechanics might speed up certain computations dramatically. Interest has since been growing in the area of quantum computation. One of the main difficulties of quantum computation is that decoherence destroys the information in a superposition of states contained in a quantum computer, thus making long computations impossible. It is shown how to reduce the effects of decoherence for information stored in quantum memory, assuming that the decoherence process acts independently on each of the bits stored in memory. This involves the use of a quantum analog of error-correcting codes.", "abstract_source_suggest": {"input": "submitter"}}], "refereed": true, "titles": [{"source": "submitter", "title": "Scheme for reducing decoherence in quantum computer memory"}], "facet_author_name": ["988844_Peter W. Shor"], "core": true, "imprints": [{"date": "1995-10-01"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:1913890", "updated": "2023-12-13T13:22:45.941329"}, "curated": true, "journal_title_variants": ["Phys.Rev.A", "Phys. Rev. A"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/1913890?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1913890?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1913890?format=latex-us", "json": "https://inspirehep.net/api/literature/1913890?format=json", "json-expanded": "https://inspirehep.net/api/literature/1913890?format=json-expanded", "cv": "https://inspirehep.net/api/literature/1913890?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1913890"}, "updated": "2023-12-13T13:22:45.941329+00:00", "created": "2021-08-31T15:35:20.213060+00:00", "id": "1913890"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.52.r2493