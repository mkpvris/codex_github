, Oxford, 1995)."}]}], "number_of_pages": 15, "referenced_authors_bais": ["C.J.Myatt.1", "C.Peterson.1", "M.Schauer.1", "M.H.Holzscheiter.1", "P.Kwiat.1", "D.Leibfried.1", "A.G.White.1", "D.F.V.James.1", "C.S.Wood.2", "S.E.Schneider.1", "D.J.Wineland.1", "M.S.Gulley.1", "D.M.Meekhof.1", "M.Murao.1", "P.Z.Wang.1", "W.M.Itano.4", "C.M.Simmons.1", "G.J.Milburn.1", "T.A.Savard.1", "Q.A.Turchette.1", "J.P.Gould.1", "Steven.K.Lamoreaux.1", "D.M.Meekhof.2", "B.E.King.1", "J.E.Thomas.1", "V.Sandberg.1", "K.M.OHara.2", "D.Tupa.2", "J.J.Gomez.55", "S.R.Jefferts.1", "C.E.Thorburn.1", "J.R.Hughes.2", "C.Monroe.2", "Peter.Knight.1"], "legacy_version": "20170111114458.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1998-12-18", "preprint_date": "1998-12", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "11 pages, 4 figures"}], "first_author": {"full_name": "Schneider, S.", "last_name": "Schneider", "first_name": "S.", "recid": 1027154}, "control_number": 481101, "dois": [{"source": "ADS", "value": "10.1103/PhysRevA.59.3766"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.59.3766"}], "earliest_date": "1998-12", "document_type": ["article"], "texkeys": ["Schneider:1998uq"], "abstracts": [{"value": "We consider two different kinds of fluctuations in an ion trap potential: external fluctuating electrical fields, which cause statistical movement (``wobbling'') of the ion relative to the center of the trap, and fluctuations of the spring constant, which are due to fluctuations of the ac-component of the potential applied in the Paul trap for ions. We write down master equations for both cases and, averaging out the noise, obtain expressions for the heating of the ion. We compare our results to previous results for far-off resonance optical traps and heating in ion traps. The effect of fluctuating external electrical fields for a quantum gate operation (controlled-NOT) is determined and the fidelity for that operation derived."}, {"source": "arXiv", "value": "We consider two different kinds of fluctuations in an ion trap potential: external fluctuating electrical fields, which cause statistical movement (``wobbling'') of the ion relative to the center of the trap, and fluctuations of the spring constant, which are due to fluctuations of the ac-component of the potential applied in the Paul trap for ions. We write down master equations for both cases and, averaging out the noise, obtain expressions for the heating of the ion. We compare our results to previous results for far-off resonance optical traps and heating in ion traps. The effect of fluctuating external electrical fields for a quantum gate operation (controlled-NOT) is determined and the fidelity for that operation derived.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "1999PhRvA..59.3766S"}, {"schema": "SPIRES", "value": "SPIRES-3915514"}], "titles": [{"title": "Decoherence and fidelity in ion traps with fluctuating trap parameters"}, {"source": "arXiv", "title": "Decoherence and fidelity in ion traps with fluctuating trap parameters"}], "facet_author_name": ["1027154_Stephen E. Schneider", "1062536_Gerard J. Milburn"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:481101", "updated": "2025-10-01T10:47:54.349667"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9812044"}]}, "created": "1998-12-18T00:00:00+00:00", "updated": "2025-10-01T10:47:54.349667+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/481101?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/481101?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/481101?format=latex-us", "json": "https://inspirehep.net/api/