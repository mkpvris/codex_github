ation_info": {"journal_volume": "53", "artid": "6450", "page_start": "6450", "journal_title": "Phys.Rev.E"}}}, {"reference": {"publication_info": {"journal_volume": "64", "artid": "237", "page_start": "237", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/343871"}}], "number_of_pages": 13, "referenced_authors_bais": ["H.Mabuchi.1", "N.P.Landsman.3", "C.G.Van.Weert.2", "John.C.Hood.1", "A.O.Caldera.1", "T.W.Darling.1", "W.H.Zurek.1", "Hong.Yu.Zhang.1", "C.Cohen.Tannoudji.1", "Y.Y.Zhang.6", "M.Gleiser.1", "D.J.Wineland.1", "J.F.Poyatos.1", "D.M.Meekhof.1", "J.I.Cirac.1", "R.Laflamme.1", "Salman.Habib.1", "P.Zoller.1", "Q.A.Turchette.1", "G.F.Moorhead.1", "A.J.Leggett.1", "B.E.King.1", "W.Lange.1", "G.N.Fleming.1", "Andrew.M.Steane.1", "R.O.Ramos.1", "P.Desbiolles.1", "P.Bouyer.2", "G.I.Opat.1", "J.P.Paz.1", "J.R.Anglin.1", "F.Rossi.3", "H.J.Kimble.1", "B.L.Hu.1", "C.Monroe.2", "C.G.Aminoff.1", "M.R.Gallis.2", "J.Dalibard.1", "W.G.Unruh.1"], "legacy_version": "20170105161812.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1996-11-26", "preprint_date": "1996-11", "author_count": 3, "public_notes": [{"source": "arXiv", "value": "13 two-column pages, 3 embedded figures"}], "first_author": {"full_name": "Anglin, J.R.", "last_name": "Anglin", "first_name": "J.R.", "recid": 2085218}, "control_number": 426402, "dois": [{"source": "ADS", "value": "10.1103/PhysRevA.55.4041"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.55.4041"}], "earliest_date": "1996-11", "document_type": ["article"], "texkeys": ["Anglin:1996bb"], "abstracts": [{"value": "The study of environmentally induced superselection and of the process of decoherence was originally motivated by the search for the emergence of classical behavior out of the quantum substrate, in the macroscopic limit. This limit, and other simplifying assumptions, have allowed the derivation of several simple results characterizing the onset of environmentally induced superselection; but these results are increasingly often regarded as a complete phenomenological characterization of decoherence in any regime. This is not necessarily the case: The examples presented in this paper counteract this impression by violating several of the simple ``rules of thumb''. This is relevant because decoherence is now beginning to be tested experimentally, and one may anticipate that, in at least some of the proposed applications (e.g., quantum computers), only the basic principle of ``monitoring by the environment'' will survive. The phenomenology of decoherence may turn out to be significantly different."}, {"source": "arXiv", "value": "The study of environmentally induced superselection and of the process of decoherence was originally motivated by the search for the emergence of classical behavior out of the quantum substrate, in the macroscopic limit. This limit, and other simplifying assumptions, have allowed the derivation of several simple results characterizing the onset of environmentally induced superselection; but these results are increasingly often regarded as a complete phenomenological characterization of decoherence in any regime. This is not necessarily the case: The examples presented in this paper counteract this impression by violating several of the simple ``rules of thumb''. This is relevant because decoherence is now beginning to be tested experimentally, and one may anticipate that, in at least some of the proposed applications (e.g., quantum computers), only the basic principle of ``monitoring by the environment'' will survive. The phenomenology of decoherence may turn out to be significantly different.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "656943"}, {"schema": "ADS", "value": "