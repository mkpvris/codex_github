ference": {"publication_info": {"journal_volume": "18", "artid": "617", "page_start": "617", "journal_title": "Nous"}}}, {"reference": {"publication_info": {"journal_volume": "54", "artid": "2759", "page_start": "2759", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/419270"}}, {"reference": {"publication_info": {"journal_volume": "6", "artid": "885", "page_start": "885", "journal_title": "J.Math.Mech."}}}], "number_of_pages": 35, "referenced_authors_bais": ["B.Podolsky.1", "Hugh.Everett.1", "Nathan.Rosen.1", "G.Bene.2", "Lucien.Hardy.1", "D.D.Mermin.1", "Carlo.Rovelli.1", "H.P.Stapp.1", "John.Stewart.Bell.1", "R.B.Griffiths.1", "Albert.Einstein.1", "Niels.Bohr.1"], "legacy_version": "20180504185958.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1998-01-27", "preprint_date": "1998-01", "author_count": 1, "public_notes": [{"value": "Expands on QUANTPH-9609013"}, {"source": "arXiv", "value": "37 pages, no figures. This is the published version of the lecture notes that expand on my earlier ``Ithaca interpretation of quantum mechanics'', quant-ph/9609013. ``Wootters' theorem'' has become the SSC theorem, an earlier citation has been added, and a joke about Talmudic scholarship has been dropped at the request of a referee"}], "first_author": {"full_name": "Mermin, N. David", "last_name": "Mermin", "first_name": "N. David", "recid": 997739}, "control_number": 466567, "dois": [{"source": "ADS", "value": "10.1119/1.18955"}, {"material": "publication", "source": "arXiv", "value": "10.1119/1.18955"}], "earliest_date": "1998-01", "document_type": ["article"], "texkeys": ["Mermin:1998cg"], "abstracts": [{"value": "I explore whether it is possible to make sense of the quantum mechanical description of physical reality by taking the proper subject of physics to be correlation and only correlation, and by separating the problem of understanding the nature of quantum mechanics from the hard problem of understanding the nature of objective probability in individual systems, and the even harder problem of understanding the nature of conscious awareness. The resulting perspective on quantum mechanics is supported by some elementary but insufficiently emphasized theorems. Whether or not it is adequate as a new Weltanschauung, this point of view toward quantum mechanics provides a different perspective from which to teach the subject or explain its peculiar character to people in other fields."}, {"source": "arXiv", "value": "I explore whether it is possible to make sense of the quantum mechanical description of physical reality by taking the proper subject of physics to be correlation and only correlation, and by separating the problem of understanding the nature of quantum mechanics from the hard problem of understanding the nature of objective probability in individual systems, and the even harder problem of understanding the nature of conscious awareness. The resulting perspective on quantum mechanics is supported by some elementary but insufficiently emphasized theorems. Whether or not it is adequate as a new Weltanschauung, this point of view toward quantum mechanics provides a different perspective from which to teach the subject or explain its peculiar character to people in other fields.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "1998AmJPh..66..753M"}, {"schema": "SPIRES", "value": "SPIRES-3692710"}], "titles": [{"title": "What is quantum mechanics trying to tell us?"}, {"source": "arXiv", "title": "What is quantum mechanics trying to tell us?"}], "facet_author_name": ["997739_N. David Mermin"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:466567", "updated": "2025-10-01T10:42:13.415797"}, "curated": true, "journal_title_variants": ["Am.J.Phys.", "Am. J. Phys."], "arx