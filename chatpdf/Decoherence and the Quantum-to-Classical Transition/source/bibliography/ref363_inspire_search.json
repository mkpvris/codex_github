504.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1996-05-23", "preprint_date": "1996-05", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "12 pages REVTeX, 1 ps figure included. Minor additions and revisions"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/0265w5591"}], "full_name": "DiVincenzo, David P.", "last_name": "DiVincenzo", "first_name": "David P.", "recid": 1949534}, "control_number": 418862, "dois": [{"source": "ADS", "value": "10.1103/PhysRevLett.77.3260"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.77.3260"}], "earliest_date": "1996-05", "document_type": ["article"], "texkeys": ["DiVincenzo:1996xb"], "abstracts": [{"value": "We exhibit a simple, systematic procedure for detecting and correcting errors using any of the recently reported quantum error-correcting codes. The procedure is shown explicitly for a code in which one qubit is mapped into five. The quantum networks obtained are fault tolerant, that is, they can function successfully even if errors occur during the error correction. Our construction is derived using a recently introduced group-theoretic framework for unifying all known quantum codes."}, {"source": "arXiv", "value": "We exhibit a simple, systematic procedure for detecting and correcting errors using any of the recently reported quantum error-correcting codes. The procedure is shown explicitly for a code in which one qubit is mapped into five. The quantum networks obtained are fault tolerant, that is, they can function successfully even if errors occur during the error correction. Our construction is derived using a recently introduced group-theoretic framework for unifying all known quantum codes.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", 