{"reference": {"publication_info": {"journal_volume": "36", "artid": "3287", "page_start": "3287", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/250416"}}, {"reference": {"publication_info": {"journal_volume": "129", "artid": "419", "page_start": "419", "journal_title": "Phys.Lett.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/261000"}}, {"reference": {"publication_info": {"journal_volume": "39", "artid": "2277", "page_start": "2277", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/263926"}}, {"reference": {"publication_info": {"journal_volume": "62", "artid": "363", "page_start": "363", "journal_title": "Helv.Phys.Acta"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/276535"}}, {"reference": {"publication_info": {"journal_volume": "42", "artid": "78", "page_start": "78", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/280441"}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "L57", "page_start": "L57", "journal_title": "J.Phys.A"}}}, {"reference": {"publication_info": {"journal_volume": "69", "artid": "80", "page_start": "80", "journal_title": "Prog.Theor.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "4", "artid": "109", "page_start": "109", "journal_title": "Found.Phys.Lett."}}}], "number_of_pages": 18, "referenced_authors_bais": ["Hugh.Everett.1", "M.Gell.Mann.1", "N.Gisin.1", "T.Weber.6", "G.C.Ghirardi.1", "L.Diosi.1", "W.H.Zurek.1", "A.Rimini.2", "R.B.Griffiths.1", "J.B.Hartle.1", "D.Bohm.1", "R.Omnes.1", "P.M.Pearle.1"], "legacy_version": "20170111104919.0", "legacy_creation_date": "1994-09-05", "preprint_date": "1994-06", "author_count": 3, "first_author": {"full_name": "Buffa, Maria Margherita", "last_name": "Buffa", "first_name": "Maria Margherita", "recid": 2209062}, "control_number": 376305, "dois": [{"value": "10.1007/BF02187582"}], "earliest_date": "1994-06", "document_type": ["article"], "texkeys": ["Buffa:1994nh"], "abstracts": [{"source": "Springer", "value": "The problem of quantum measurement is briefly recalled with particular reference to theories of reduction as a real physical process. The spontaneous localization models for systems containing identical particles are described and the choice of the model when several kinds of particles are present is discussed. Dissipation and reduction effects induced by spontaneous localization in superconducting systems are analyzed. It is found that dissipation effects are negligibly small; on the other hand, reduction effects are present, but their characteristic time is long, say of the order of one hour. It follows that testing reduction experimentally is far beyond present day technology.", "abstract_source_suggest": {"input": "Springer"}}], "refereed": true, "titles": [{"title": "Dissipation and reduction effects of spontaneous localization on superconducting states"}], "external_system_identifiers": [{"schema": "CDS", "value": "267069"}, {"schema": "SPIRES", "value": "SPIRES-2998165"}], "facet_author_name": ["1998168_Alberto Rimini", "2209062_Maria Margherita Buffa", "995696_Oreste Nicrosini"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:376305", "updated": "2023-03-06T19:54:02.393231"}, "curated": true, "journal_title_variants": ["Found. Phys. Lett.", "Found.Phys.Lett."]}, "links": {"bibtex": "https://inspirehep.net/api/literature/376305?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/376305?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/376305?format=latex-us", "json": "https://inspirehep.net/api/literature/376305?format=json", "json-expanded": "https://inspirehep.net/api/literature/376305?format=json-expanded", "cv": "https://inspirehep.net/api/literature/376305?format=cv",