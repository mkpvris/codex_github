/api/literature/421360"}}], "number_of_pages": 4, "referenced_authors_bais": ["G.Brassard.1", "S.Devabhaktuni.1", "A.N.Chari.1", "D.Beckman.1", "A.Tapp.1", "L.K.Grover.1", "A.Elitzur.1", "P.Hoyer.2", "M.Boyer.1", "L.Vaidman.1", "J.Preskill.1"], "legacy_version": "20170111110018.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1997-06-16", "preprint_date": "1997-06", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "Postscript, 4 pages. This is a modified version of the STOC paper (quant-ph/9605043) and is modified to make it more comprehensible to physicists. It appeared in Phys. Rev. Letters on July 14, 1997. (This paper was originally put out on quant-ph on June 13, 1997, the present version has some minor typographical changes)"}], "first_author": {"full_name": "Grover, Lov K.", "last_name": "Grover", "first_name": "Lov K.", "recid": 2203172}, "control_number": 444345, "dois": [{"value": "10.1103/PhysRevLett.79.325"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.79.325"}], "earliest_date": "1997-06", "document_type": ["article"], "texkeys": ["Grover:1997fa"], "abstracts": [{"value": "Quantum mechanics can speed up a range of search applications over unsorted data. For example imagine a phone directory containing N names arranged in completely random order. To find someone's phone number with a probability of 50%, any classical algorithm (whether deterministic or probabilistic) will need to access the database a minimum of O(N) times. Quantum mechanical systems can be in a superposition of states and simultaneously examine multiple names. By properly adjusting the phases of various operations, successful computations reinforce each other while others interfere randomly. As a result, the desired phone number can be obtained in only O(sqrt(N)) accesses to the database."}, {"source": "arXiv", "value": "Quantum mechanics can speed up a range of search applications over unsorted data. For example imagine a phone directory containing N names arranged in completely random order. To find someone's phone number with a probability of 50%, any classical algorithm (whether deterministic or probabilistic) will need to access the database a minimum of O(N) times. Quantum mechanical systems can be in a superposition of states and simultaneously examine multiple names. By properly adjusting the phases of various operations, successful computations reinforce each other while others interfere randomly. As a result, the desired phone number can be obtained in only O(sqrt(N)) accesses to the database.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "OSTI", "value": "549697"}, {"schema": "ADS", "value": "1997PhRvL..79..325G"}, {"schema": "SPIRES", "value": "SPIRES-3572412"}], "titles": [{"title": "Quantum mechanics helps in searching for a needle in a haystack"}, {"source": "arXiv", "title": "Quantum Mechanics helps in searching for a needle in a haystack"}], "facet_author_name": ["2203172_Lov K. Grover"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:444345", "updated": "2025-10-01T10:20:44.062540"}, "curated": true, "journal_title_variants": ["Phys. Rev. Lett.", "Phys.Rev.Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9706033"}]}, "id": "444345", "updated": "2025-10-01T10:20:44.062540+00:00", "created": "1997-06-16T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/444345?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/444345?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/444345?format=latex-us", "json": "https://inspirehep.net/api/literature/444345?format=json", "json-expanded": "https://inspirehep.net/api/literature/444345?format=json-expanded", "cv": "https://inspirehep.net/api/literature/444345?format=cv",