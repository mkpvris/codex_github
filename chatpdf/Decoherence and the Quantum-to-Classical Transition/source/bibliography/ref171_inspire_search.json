55", "journal_title": "Phys.Rev.A"}, "authors": [{"full_name": "Wiseman, H.M."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[15] H. M. Wiseman et al., Phys. Rev. A 56, 55 (1997)."}]}, {"reference": {"label": "16", "publication_info": {"journal_volume": "44", "artid": "36", "year": 1991, "page_start": "36", "journal_title": "Phys.Today"}, "authors": [{"full_name": "Zurek, W.H."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[16] W. H. Zurek, Phys. Today 44, 36 (1991)."}]}, {"reference": {"label": "17", "publication_info": {"journal_volume": "41", "artid": "3436", "year": 1990, "page_start": "3436", "journal_title": "Phys.Rev.A"}, "authors": [{"full_name": "Stern, A."}, {"full_name": "Aharonov, Y."}, {"full_name": "Imry, Y."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[17] A. Stern, Y. Aharonov, and Y. Imry, Phys. Rev. A 41, 3436 (1990)."}], "record": {"$ref": "https://inspirehep.net/api/literature/313462"}}], "referenced_authors_bais": ["D.J.Wineland.1", "J.P.Paz.1", "J.R.Anglin.1", "Y.Imry.1", "J.M.Raimond.1", "C.Monroe.2", "Q.A.Turchette.1", "Y.Aharonov.1", "M.R.Gallis.2", "M.Brune.1", "J.Dreyer.1", "W.G.Unruh.1", "D.Kielpinski.2", "C.J.Myatt.1", "S.Haroche.1", "A.J.Leggett.1", "E.Hagley.1", "A.O.Caldeira.1", "B.E.King.1", "X.Maitre.1", "C.Wunderlich.2", "G.N.Fleming.1", "W.H.Zurek.1", "A.Maali.1", "W.M.Itano.2", "C.A.Sackett.1", "Ady.Stern.1"], "figures": [{"filename": "figure1.png", "material": "preprint", "caption": "A schematic of our apparatus: a Mach-Zehnder interferometer comprised of three, evenly spaced, transmission gratings. Within the interferometer, sodium atoms continuously absorb and spontaneously emit photons from a variable intensity laser beam. Decoherence due to spontaneous emission results in reduced contrast interference fringes.", "label": "fig:schematic", "source": "arxiv", "key": "80009d326c83c750c082f18410395513", "url": "https://inspirehep.net/files/80009d326c83c750c082f18410395513"}, {"filename": "figure2.png", "material": "preprint", "caption": "The total decoherence function, $|\\betat|$, measured as the normalized contrast after spontaneous photon scattering. The solid line is the single photon decoherence function. Also displayed are the best fits from which we determine $\\bar{n}=$ 0.9 ($\\triangle$), 1.4 ($\\diamond$), 1.8 ($\\circ$), 2.6 ($\\bigtriangledown$), and 8.2 ($+$).", "label": "fig:nongaussian", "source": "arxiv", "key": "82033d9e51cc0ec96cc51884dd607863", "url": "https://inspirehep.net/files/82033d9e51cc0ec96cc51884dd607863"}, {"filename": "figure3.png", "material": "preprint", "caption": "Loss of interfering contrast as a function of mean number of photons spontaneously scattered by atoms within the interferometer. Each curve represents a different path separation: $d/\\lambda = 0.06 (\\triangle), 0.13 (\\diamond),$ and $ 0.16 (\\circ)$.", "label": "fig:cvn", "source": "arxiv", "key": "a34855c4563873bb1cf1cee9706a751e", "url": "https://inspirehep.net/files/a34855c4563873bb1cf1cee9706a751e"}, {"filename": "figure4.png", "material": "preprint", "caption": "Loss of contrast in the many-photon regime. Overlayed are theory curves generated from Eq.\\ (\\ref{eqn:betatgaussian}) using parameters ($\\bullet$) $\\bar{n} = 4.8(2)$, $\\sigma_{n}=1.8(1)$ and ($\\circ$) $\\bar{n} = 8.1(3)$, $\\sigma_{n}=3.5(1)$ determined from independent beam deflection measurements.", "label": "fig:gaussian", "source": "arxiv", "key": "f7c98c3c895a95305db0272f6568c9d6", "url": "https://inspirehep.net/files/f7c98c3c895a95305db0272f6568c9d6"}], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "2001-01-18", "author_count": 4, "first_author": {"full_name": "Kokorowski, David A.", "last_name": "Kokorowski", "first_name": "David A.", "recid": 2988611}, "public_notes": [{"source": "arXiv", "value": "submitted to PRL Septermber 5 2000 resubmitted to PRL December 5, 2000 Accepted for publication in PRL Jan 12, 2001"}], "control_number": 2988600, "dois": [{"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.86.2191"}], "earliest_date": "2001-01-18", "document_type": ["article"], "texkeys": ["Kokorowski:2001hmz"], "abstracts": [{"source": "arXiv", "value": "We measure the decoherence of a spatially separated atomic superposition due to spontaneous photon scattering. We observe a qualitative change in decoherence versus separation as the number of scattered photons increases, and verify quantitatively the decoherence rate constant in the many-photon limit. Our results illustrate an evolution of decoherence consistent with general models developed for a broad class of decoherence phenomenon.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "From Single to Multiple-Photon Decoherence in an Atom Interferometer"}], "facet_author_name": ["2390509_David E. Pritchard", "1012765_Alexander Douglas Cronin", "2988611_David A. Kokorowski", "2988613_Tony D. Roberts"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2988600", "updated": "2025-10-01T11:01:39.165432"}, "curated": false, "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0009044"}]}, "id": "2988600", "updated": "2025-10-01T11:01:39.165432+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/2988600?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2988600?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2988600?format=latex-us", "json": "https://inspirehep.net/api/literature/2988600?format=json", "json-expanded": "https://inspirehep.net/api/literature/2988600?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2988600?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2988600"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.2191&size=5&page=1", "