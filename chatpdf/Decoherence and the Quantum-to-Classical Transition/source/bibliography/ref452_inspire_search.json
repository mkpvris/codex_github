": [{"schema": "ROR", "value": "https://ror.org/00s6t1f81"}], "full_name_unicode_normalized": "rimini, alberto", "full_name": "Rimini, Alberto", "record": {"$ref": "https://inspirehep.net/api/authors/1998168"}, "ids": [{"schema": "INSPIRE BAI", "value": "A.Rimini.2"}], "last_name": "Rimini", "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903122"}, "value": "Pavia U."}], "signature_block": "RANANa", "first_name": "Alberto", "uuid": "003260d7-68f9-43bb-8b56-5de0ad24d305", "recid": 1998168}], "citation_count": 763, "report_numbers": [{"value": "IC-89-44"}], "publication_info": [{"journal_volume": "42", "page_end": "79", "year": 1990, "page_start": "78", "journal_title": "Phys.Rev.A"}], "citation_count_without_self_citations": 712, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "references": [{"reference": {"publication_info": {"journal_volume": "101", "artid": "333", "page_start": "333", "journal_title": "Nuovo Cim.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/263304"}}, {"reference": {"publication_info": {"journal_volume": "102", "artid": "383", "page_start": "383", "journal_title": "Nuovo Cim.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/265509"}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "119", "page_start": "119", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/98305"}}, {"reference": {"publication_info": {"journal_volume": "21", "artid": "755", "page_start": "755", "journal_title": "Am.J.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "18", "artid": "1", "page_start": "1", "journal_title": "Found.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "13", "artid": "857", "page_start": "857", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/113389"}}, {"reference": {"publication_info": {"journal_volume": "12", "artid": "249", "page_start": "249", "journal_title": "Found.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "52", "artid": "1657", "page_start": "1657", "journal_title": "Phys.Rev.Lett."}}, "record": {"$ref": "https://inspirehep.net/api/literature/2734316"}}, {"reference": {"publication_info": {"journal_volume": "53", "artid": "1775", "page_start": "1775", "journal_title": "Phys.Rev.Lett."}}}, {"reference": {"publication_info": {"journal_volume": "53", "artid": "1776", "page_start": "1776", "journal_title": "Phys.Rev.Lett."}}}, {"reference": {"publication_info": {"journal_volume": "29", "artid": "235", "page_start": "235", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/212596"}}, {"reference": {"publication_info": {"journal_volume": "33", "artid": "2240", "page_start": "2240", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/243662"}}, {"reference": {"publication_info": {"journal_volume": "34", "artid": "470", "page_start": "470", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/222969"}}, {"reference": {"publication_info": {"journal_volume": "36", "artid": "3287", "page_start": "3287", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/250416"}}, {"reference": {"publication_info": {"journal_volume": "100", "artid": "27", "page_start": "27", "journal_title": "Nuovo Cim.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/239454"}}], "number_of_pages": 28, "referenced_authors_bais": ["N.Gisin.1", "T.Weber.6", "G.C.Ghirardi.1", "G.Lindblad.1", "A.Rimini.2", "O.Nicrosini.1", "P.M.Pearle.1", "F.Benatti.1"], "legacy_version": "20180504133154.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "1989-08-28", "preprint_date": "1989-03", "author_count": 3, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/009gyvm78"}, {"schema": "ROR", "value": "https://ror.org/02n742c10"}], "full_name": "Ghirardi, Gian Carlo", "last_name": "Ghirardi", "first_name": "Gian Carlo", "recid": 1008494}, "control_number": 280441, "dois": [{"value": "10.1103/PhysRevA.42.78"}], "earliest_date": "1989-03", "document_type": ["article"], "texkeys": ["Ghirardi:1989cn"], "abstracts": [{"source": "APS", "value": "Stochastic differential equations describing the Markovian evolution of state vectors in the quantum Hilbert space are studied as possible expressions of a universal dynamical principle. The general features of the considered class of equations as well as their dynamical consequences are investigated in detail. The stochastic evolution is proved to induce continuous dynamical reduction of the state vector onto mutually orthogonal subspaces. A specific choice, expressed in terms of creation and annihilation operators, of the operators defining the Markov process is then proved to be appropriate to describe continuous spontaneous localization of systems of identical particles. The dynamics obtained in such a way leaves practically unaffected the standard quantum evolution of microscopic systems and induces a very rapid suppression of coherence among macroscopically distinguishable states. The classical behavior of macroscopic objects as well as the reduction of the wave packet in a quantum measurement process can be consistently derived from the postulated universal dynamical principle.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Markov Processes in Hilbert Space and Continuous Spontaneous Localization of Systems of Identical Particles"}, {"title": "MARKOV PROCESSES IN HILBERT SPACE AND CONTINUOUS SPONTANEOUS LOCALIZATION OF SYSTEMS OF IDENTICAL PARTICLES"}], "external_system_identifiers": [{"schema": "KEKSCAN", "value": "89-08-392"}, {"schema": "SPIRES", "value": "SPIRES-2045419"}, {"schema": "MSNET", "value": "1061931"}], "facet_author_name": ["1998168_Alberto Rimini", "993978_Philip Mark Pearle", "1008494_Giancarlo Ghirardi"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:280441", "updated": "2023-12-11T08:34:42.445988"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.78&size=5&page=1&format=cv"}}