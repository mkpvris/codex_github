}}}, {"reference": {"publication_info": {"journal_volume": "61", "artid": "763", "page_start": "763", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/288260"}}], "number_of_pages": 8, "referenced_authors_bais": ["Y.T.Kivshar.1", "B.A.Malomed.1"], "legacy_version": "20160315095641.0", "legacy_creation_date": "2008-09-29", "preprint_date": "1993-07", "author_count": 3, "first_author": {"full_name": "Sataric, M.V.", "last_name": "Sataric", "first_name": "M.V.", "recid": 2540411}, "control_number": 370825, "dois": [{"value": "10.1103/PhysRevE.48.589"}], "earliest_date": "1993-07", "document_type": ["article"], "texkeys": ["Sataric:1993zz"], "abstracts": [{"source": "APS", "value": "A model is presented that is intended to provide a realistic physical picture of the energy-transfer mechanism in cell microtubules. A classical φ4 model in the presence of a constant electric field is used as a conceptual basis. It is demonstrated that kinklike excitations arise as a result of the guanosine 5’-triphosphate (GTP) hydrolysis and that an intrinsic electrical force may cause them to propagate along a microtubule. A discussion is given on the possible effects of these excitations on the dynamics of microtubules.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Kinklike excitations as an energy-transfer mechanism in microtubules"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-7986580"}], "facet_author_name": ["1938022_Jack A. Tuszynski", "2540411_M.V. Sataric", "2540417_R.B. Zakula"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:370825", "updated": "2023-03-06T15:22:04.936830"}, "curated": true, "journal_title_variants": ["Phys.Rev.E", "Phys. Rev. E"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/370825?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/370825?format=latex-eu", "latex-us": "https://i