nt_without_self_citations": 144, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "references": [{"reference": {"publication_info": {"journal_volume": "47", "artid": "777", "page_start": "777", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3255"}}, {"reference": {"publication_info": {"journal_volume": "36", "artid": "827", "page_start": "827", "journal_title": "Helv.Phys.Acta"}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "469", "page_start": "469", "journal_title": "Annals Phys."}}}, {"reference": {"report_numbers": ["PHIL,138"]}}, {"reference": {"publication_info": {"journal_volume": "38", "artid": "447", "page_start": "447", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/85"}}, {"reference": {"report_numbers": ["PHYS,180"]}}, {"reference": {"publication_info": {"journal_volume": "33", "artid": "297", "page_start": "297", "journal_title": "Nucl.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "101", "artid": "429", "page_start": "429", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "91", "artid": "1551", "page_start": "1551", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "9", "artid": "880", "page_start": "880", "journal_title": "Nuovo Cim."}}}, {"reference": {"publication_info": {"journal_volume": "134", "artid": "B1410", "page_start": "B1410", "journal_title": "Phys.Rev."}}, "record": {"$ref": "https://inspirehep.net/api/literature/2731641"}}], "number_of_pages": 16, "referenced_authors_bais": ["B.Podolsky.1", "Nathan.Rosen.1", "John.Stewart.Bell.1", "Y.Aharonov.1", "Albert.Einstein.1", "P.G.Bergmann.1", "Joel.L.Lebowitz.1"], "legacy_version": "20170203215957.0", "legacy_creation_date": "2008-09-22", "preprint_date": "1966-07", "author_count": 2, "first_author": {"full_name": "BOHM, D.", "last_name": "BOHM", "first_name": "D.", "recid": 1035562}, "control_number": 50845, "dois": [{"value": "10.1103/RevModPhys.38.453"}], "earliest_date": "1966-07", "document_type": ["article"], "texkeys": ["BOHM:1966jkg", "Bohm:1966sei", "BOHM:1966zz"], "abstracts": [{"source": "APS", "value": "The measurement problem in quantum mechanics is re-examined and it is shown that it cannot really be solved in a satisfactory way, within the framework of the usual interpretation of the theory. We then discuss von Neumann's attempts to prove that quantum mechanics is incompatible with the introduction of hidden variables, and develop a more detailed form of Bell's argument, showing that von Neumann's analysis is invalid. Using certain ideas that are implicit in the \"differential-space\" theory of Wiener and Siegel, we go on to propose a new deterministic equation of motion, describing a kind of coupling of the measuring instrument to the observed system that explains in detail how the wave packet is \"reduced\" during a measurement in a continuous and causally determined way. By averaging over the hidden parameters, we then recover the usual statistical results of quantum mechanics as a special case. However, a more detailed analysis of the theory shows that new experimental and theoretical questions can now be raised, which go outside the framework of the quantum theory as it is now formulated. These questions are examined briefly.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "A Proposed Solution of the Measurement Problem in Quantum Mechanics by a Hidden Variable Theory"}], "external_system_identifiers": [{"schema": "OSTI", "value": "4531353"}, {"schema": "SPIRES", "value": "SPIRES-7975341"}], "publication_type": ["review"], "facet_author_name": ["2164716_Jeffrey Bub", "1035562_David Bohm"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:50845", "updated": "2023-12-07T19:02:13.214894"}, "curated": 