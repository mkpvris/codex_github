tle": "Phys.Rev.A"}}}, {"reference": {"arxiv_eprint": "hep-th/9509154"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/400009"}}, {"reference": {"arxiv_eprint": "hep-th/9512144"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/403798"}}, {"reference": {"publication_info": {"journal_volume": "1", "artid": "69", "page_start": "69", "journal_title": "Found.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/929885"}}, {"reference": {"publication_info": {"journal_volume": "116", "artid": "9", "page_start": "9", "journal_title": "Phys.Lett.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/232862"}}, {"reference": {"arxiv_eprint": "quant-ph/9610014"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/424462"}}, {"reference": {"publication_info": {"journal_volume": "24", "artid": "1516", "page_start": "1516", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/172316"}}, {"reference": {"publication_info": {"journal_volume": "44N10", "artid": "36", "page_start": "36", "journal_title": "Phys.Today"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/313738"}}, {"reference": {"publication_info": {"journal_volume": "46", "artid": "13", "page_start": "13", "journal_title": "Phys.Today"}}}], "number_of_pages": 24, "referenced_authors_bais": ["R.Z.Shaisultanov.1", "J.P.Paz.1", "O.Kuebler.1", "Salman.Habib.1", "J.M.Raimond.1", "J.G.Demers.1", "E.Mottola.1", "M.Brune.1", "Peter.Knight.1", "Y.Kluger.1", "J.Dreyer.1", "E.Joos.1", "S.Haroche.1", "Sougato.Bose.1", "A.J.Leggett.1", "E.Hagley.1", "A.O.Caldeira.1", "D.Polarski.1", "X.Maitre.1", "C.Wunderlich.2", "H.D.Zeh.1", "W.H.Zurek.1", "A.Maali.1", "A.A.Starobinsky.1", "C.Kiefer.1", "K.Jacobs.2"], "figures": [{"filename": "img1a.png", "material": "preprint", "caption": "{\\bf (a)} Density matrix of a superposition of two Gaussian wave packets. The wave function is shown in the inset. Coherence between the two parts of the wave function is represented by the two off-diagonal peaks. {\\bf (b)} The density matrix after interference is partially destroyed by decoherence. The position distribution, along the diagonal, is not changed appreciably.", "source": "arxiv", "key": "d1c06777e8289b9730087486068b5fc4", "url": "https://inspirehep.net/files/d1c06777e8289b9730087486068b5fc4"}, {"filename": "img1b.png", "material": "preprint", "caption": "{\\bf (a)} Density matrix of a superposition of two Gaussian wave packets. The wave function is shown in the inset. Coherence between the two parts of the wave function is represented by the two off-diagonal peaks. {\\bf (b)} The density matrix after interference is partially destroyed by decoherence. The position distribution, along the diagonal, is not changed appreciably.", "source": "arxiv", "key": "c8e02cfcb8a6534f8e42ded98f5ae83e", "url": "https://inspirehep.net/files/c8e02cfcb8a6534f8e42ded98f5ae83e"}, {"filename": "img2a.png", "material": "preprint", "caption": "The Wigner function equivalent to the density matrices shown in Fig. 1. {\\bf (a)} represents the superposition of two Gaussian wave packets. Strong oscillations together with negative values indicate coherence between the two wave packets. {\\bf (b)} oscillations are partially damped by decoherence.", "source": "arxiv", "key": "71099c365a305a5d247f1ae19c23d888", "url": "https://inspirehep.net/files/71099c365a305a5d247f1ae19c23d888"}, {"filename": "img2b.png", "material": "preprint", "caption": "The Wigner function equivalent to the density matrices shown in Fig. 1. {\\bf (a)} represents the superposition of two Gaussian wave packets. Strong oscillations together with negative values indicate coherence between the two wave packets. {\\bf (b)} oscillations are partially damped by decoherence.", "source": "arxiv", "key": "80ca5c589366d25af45741b44245175b", "url": "https://inspirehep.net/files/80ca5c589366d25af45741b44245175b"}, {"filename": "img3a.png", "material": "preprint", "caption": "{\\bf (a)}Density matrix of an energy eigenstate of a harmonic oscillator for {\\it n}=9 in the position representation. {\\bf (b)} Non-diagonal terms are damped by decoherence.", "source": "arxiv", "key": "96407bccf8a43be0ee7ac45fcd775a86", "url": "https://inspirehep.net/files/96407bccf8a43be0ee7ac45fcd775a86"}, {"filename": "img3b.png", "material": "preprint", "caption": "{\\bf (a)}Density matrix of an energy eigenstate of a harmonic oscillator for {\\it n}=9 in the position representation. {\\bf (b)} Non-diagonal terms are damped by decoherence.", "source": "arxiv", "key": "6b5232672ac37647bf4cc22132448478", "url": "https://inspirehep.net/files/6b5232672ac37647bf4cc22132448478"}, {"filename": "img4a.png", "material": "preprint", "caption": "{\\bf (a)}Wigner function for an energy eigenstate of a harmonic oscillator with {\\it n}=9. The figure shows strong oscillations indicating the non-classical character of this pure state. {\\bf (b)} Decoherence acts like diffusion in this representation. Note that the symmetry between position and momentum is broken by the interaction with the environment.", "source": "arxiv", "key": "eccab3b5cb6c8389782767f605a9fccd", "url": "https://inspirehep.net/files/eccab3b5cb6c8389782767f605a9fccd"}, {"filename": "img4b.png", "material": "preprint", "caption": "{\\bf (a)}Wigner function for an energy eigenstate of a harmonic oscillator with {\\it n}=9. The figure shows strong oscillations indicating the non-classical character of this pure state. {\\bf (b)} Decoherence acts like diffusion in this representation. Note that the symmetry between position and momentum is broken by the interaction with the environment.", "source": "arxiv", "key": "bb797ec7dde4c3e0f63515cfa7840a6b", "url": "https://inspirehep.net/files/bb797ec7dde4c3e0f63515cfa7840a6b"}, {"filename": "img5.png", "material": "preprint", "caption": "Time dependence of coherence length. It is a measure of the spatial extension over which the object can show interference effects. Except for zero coupling ($\\Lambda=0$), the coherence length always decreases for large times.", "source": "arxiv", "key": "52053d74ebdcbb43b55bd061cd6a0c6b", "url": "https://inspirehep.net/files/52053d74ebdcbb43b55bd061cd6a0c6b"}, {"filename": "img6.png", "material": "preprint", "caption": "Typical structure of an optically active, chiral molecule. Both versions are mirror-images of each other and are not connected by a proper rotation, if the four elements are different.", "source": "arxiv", "key": "79a4a72d2eaef96333383d40fddfc204", "url": "https://inspirehep.net/files/79a4a72d2eaef96333383d40fddfc204"}, {"filename": "img7.png", "material": "preprint", "caption": "Effective potential for the inversion coordinate in a model for a chiral molecule and the two lowest-lying eigenstates. The ground state is symmetrically distributed over the two wells. Only linear combinations of the two lowest-lying states are localised and correspond to a classical configuration.", "source": "arxiv", "key": "c8c2ab099253063cbf50e69dc75d773b", "url": "https://inspirehep.net/files/c8c2ab099253063cbf50e69dc75d773b"}, {"filename": "img8.png", "material": "preprint", "caption": "Time dependence of the probability of finding state $|2\\rangle$ if the system was prepared in $|1\\rangle$ at $t=0$ under continuous coupling to a meter.", "source": "arxiv", "key": "52729ba90930f89704bb8a488bf1bb2d", "url": "https://inspirehep.net/files/52729ba90930f89704bb8a488bf1bb2d"}, {"filename": "img9.png", "material": "preprint", "caption": "Probability of finding state $|2\\rangle$ at a fixed time as a function of the coupling to the meter.", "source": "arxiv", "key": "5bfe53c14798a345378687034db7e768", "url": "https://inspirehep.net/files/5bfe53c14798a345378687034db7e768"}], "legacy_version": "20160325065525.0", "inspire_categories": [{"term": "Gravitation and Cosmology", "source": "curator"}, {"term": "General Physics", "source": "curator"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1998-03-20", "preprint_date": "1997-09", "author_count": 2, "public_notes": [{"value": "Joos = Rosenweg 2, D-22869, Schenefeld, Germany"}, {"source": "arXiv", "value": "24 pages, LATEX, 9 figures, needs macro lamuphys.sty, to appear in the Proceedings of the 10th Born Symposium"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/0245cg223"}], "full_name": "Kiefer, Claus", "last_name": "Kiefer", "first_name": "Claus", "recid": 1003034}, "control_number": 454106, "dois": [{"value": "10.1007/BFb0105342"}, {"material": "publication", "source": "arXiv", "value": "10.1007/BFb0105342"}], "earliest_date": "1997-09", "document_type": ["conference paper"], "texkeys": ["Kiefer:1997hv"], "abstracts": [{"value": "We give a pedagogical introduction to the process of decoherence - the irreversible emergence of classical properties through interaction with the environment. After discussing the general concepts, we present the following examples: Localisation of objects, quantum Zeno effect, classicality of fields and charges in QED, and decoherence in gravity theory. We finally emphasise the important interpretational features of decoherence."}, {"source": "arXiv", "value": "We give a pedagogical introduction to the process of decoherence - the irreversible emergence of classical properties through interaction with the environment. After discussing the general concepts, we present the following examples: Localisation of objects, quantum Zeno effect, classicality of fields and charges in QED, and decoherence in gravity theory. We finally emphasise the important interpretational features of decoherence.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "va