rnal_title": "Rev.Mod.Phys."}, "misc": ["Anupam Garg and W. Zwerger"], "authors": [{"full_name": "Leggett, A.J."}, {"full_name": "Chakravarty, S."}, {"full_name": "Dorsey, A.T."}, {"full_name": "Fisher, Matthew P.A."}]}, "raw_refs": [{"schema": "text", "value": "A. J. Leggett, S. Chakravarty, A. T. Dorsey, Matthew P. A. Fisher, Anupam Garg and W. Zwerger, Rev. Mod. Phys. 59, 1 (1987)."}], "record": {"$ref": "https://inspirehep.net/api/literature/260239"}}, {"reference": {"publication_info": {"journal_volume": "41", "artid": "46", "year": 1988, "page_start": "46", "journal_title": "Phys.Today"}, "authors": [{"full_name": "Webb, R.A."}, {"full_name": "Washburn, S."}]}, "raw_refs": [{"schema": "text", "value": "R. A. Webb and S. Washburn, Phys. Today 41, 46 (1988)."}]}, {"reference": {"publication_info": {"journal_volume": "41", "artid": "1165", "year": 1989, "page_start": "1165", "journal_title": "Phys.Rev.A"}, "authors": [{"full_name": "Diosi, L."}]}, "raw_refs": [{"schema": "text", "value": "L. Diosi, Phys. Rev. A 41, 1165 (1989)."}]}, {"reference": {"publication_info": {"journal_volume": "221", "artid": "113", "year": 1989, "page_start": "113", "journal_title": "Phys.Lett.B"}, "authors": [{"full_name": "Ellis, J."}, {"full_name": "Mohanty, S."}, {"full_name": "Nanopoulos, D.V."}]}, "raw_refs": [{"schema": "text", "value": "J. Ellis, S. Mohanty and D. V. Nanopoulos, Phys. Lett. B 221, 113 (1989)."}], "record": {"$ref": "https://inspirehep.net/api/literature/268516"}}, {"reference": {"publication_info": {"journal_volume": "102", "artid": "383", "year": 1988, "page_start": "383", "journal_title": "Nuovo Cim.B"}, "authors": [{"full_name": "Ghirardi, G.C."}, {"full_name": "Nicrosini, O."}, {"full_name": "Rhimini, A."}, {"full_name": "Weber, T."}]}, "raw_refs": [{"schema": "text", "value": "G. C. Ghirardi, O. Nicrosini, A. Rhimini and T. Weber, Nuovo Cimento 102B, 383 (1988)."}], "record": {"$ref": "https://inspirehep.net/api/literature/265509"}}, {"reference": {"publication_info": {"year": 1989}, "misc": ["Helv. Phys. 62, 363"], "authors": [{"full_name": "Gisin, N."}]}, "raw_refs": [{"schema": "text", "value": "N. Gisin, Helv. Phys. 62, 363 (1989)."}]}, {"reference": {"misc": ["(unpublished)"], "authors": [{"full_name": "Squires, E.J."}]}, "raw_refs": [{"schema": "text", "value": "E. J. Squires (unpublished)."}]}], "referenced_authors_bais": ["W.G.Unruh.1", "C.G.Shull.1", "V.Ambegaokar.1", "A.T.Dorsey.1", "M.Srednicki.1", "T.Weber.6", "A.O.Caldeira.1", "A.O.Caldera.1", "W.H.Zurek.1", "J.R.Ellis.1", "O.Nicrosini.1", "W.Treimer.1", "F.Benatti.1", "A.Garg.4", "M.Fisher.2", "W.Zwerger.1", "S.Mohanty.1", "V.Hakim.2", "Dimitri.V.Nanopoulos.1", "E.Joos.1", "Stephen.W.Hawking.1", "Sudip.Chakravarty.1", "A.J.Leggett.1", "H.D.Zeh.1", "R.Gahler.1", "J.S.Hagelin.1", "W.Mampe.1", "G.C.Ghirardi.1", "A.Rimini.2", "A.Zeilinger.1"], "inspire_categories": [{"term": "Quantum Physics"}], "author_count": 2, "first_author": {"full_name": "Gallis, Michael R.", "last_name": "Gallis", "first_name": "Michael R.", "recid": 2432745}, "control_number": 2948607, "dois": [{"source": "APS", "value": "10.1103/PhysRevA.42.38"}], "earliest_date": "1990-07-01", "document_type": ["article"], "texkeys": ["Gallis:1990bcf"], "abstracts": [{"source": "APS", "value": "The dynamical elimination or reduction of macroscopic superpositions has long been of interest, particularly with regard to the quantum theory of measurement. A number of models have demonstrated this for the reduced density matrix of a system interacting with an environment. Alternatively, Ghirardi, Rhimini, and Weber [Phys. Rev. D 34, 470 (1986)] have proposed a fundamental modification of the Schrödinger equation, quantum mechanics with spontaneous localization (QMSL), which provides a master equation similar in mathematical form. In this paper we consider an isotropic environment that is elastically scattered by the system of interest with negligible momentum transfer, extending a previous result of Joos and Zeh [Z. Phys. B. 59, 223 (1985)] from small length scales to all length scales. We discuss the physical nature and relevance of the differences between our result and similar open systems calculations. We describe the mathematical similarity between our extended environmental model and the QMSL dynamics determining the QMSL parameters that allow calculations using QMSL to be used as a model for the effect of the environment. That gives us access to a number of interesting results obtained for the QMSL master equation. Finally, we discuss some experimental considerations for the purposes of detecting effective nonunitary evolution of this form.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"source": "APS", "title": "Environmental and spontaneous localization"}], "facet_author_name": ["1009822_Gordon N. Fleming", "2432745_Michael R. Gallis"], "core": false, "imprints": [{"date": "1990-07-01"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2948607", "updated": "2025-07-18T07:04:02.212985"}, "curated": false, "journal_title_variants": ["Phys.Rev.A", "Phys. Rev. A"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/2948607?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2948607?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2948607?format=latex-us", "json": "https://inspirehep.net/api/literature/2948607?format=json", "json-expanded": "https://inspirehep.net/api/literature/2948607?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2948607?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2948607"}, "id": "2948607", "updated": "2025-07-18T07:04:02.212985+00:00", "created": "2025-07-18T07:04:02.014492+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.38&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.42.38&size=5&pa