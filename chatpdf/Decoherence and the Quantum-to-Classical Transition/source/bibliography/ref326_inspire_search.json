ay Quantum Computer"}], "facet_author_name": ["1950393_Robert Raussendorf", "1952391_Hans J. Briegel"], "core": true, "imprints": [{"date": "2001-05-28"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2730423", "updated": "2026-02-09T13:35:16.494482"}, "curated": true, "journal_title_variants": ["Phys. Rev. Lett.", "Phys.Rev.Lett."]}, "id": "2730423", "updated": "2026-02-09T13:35:16.494482+00:00", "created": "2023-12-05T15:27:59.607472+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.86.5188&size=5&page=1&format=cv"}}