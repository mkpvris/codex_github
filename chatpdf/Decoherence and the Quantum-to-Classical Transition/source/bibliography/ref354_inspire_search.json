{"hits": {"hits": [{"created": "2021-10-05T09:14:40.755153+00:00", "updated": "2024-09-17T08:36:41.731162+00:00", "metadata": {"authors": [{"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/052gg0110"}], "full_name_unicode_normalized": "steane, a.m.", "full_name": "Steane, A.M.", "record": {"$ref": "https://inspirehep.net/api/authors/1877134"}, "last_name": "Steane", "affiliations": [{"curated_relation": true, "record": {"$ref": "https://inspirehep.net/api/institutions/908121"}, "value": "Oxford U., Ctr. Quantum Comp."}], "ids": [{"schema": "INSPIRE BAI", "value": "Andrew.M.Steane.1"}], "signature_block": "STANa", "first_name": "A.M.", "uuid": "970ff69e-9364-46ce-b636-b4b93caa9199", "recid": 1877134}], "publication_info": [{"journal_volume": "77", "page_end": "797", "year": 1996, "journal_record": {"$ref": "https://inspirehep.net/api/journals/1214495"}, "page_start": "793", "journal_issue": "5", "journal_title": "Phys.Rev.Lett."}], "citation_count": 2293, "citation_count_without_self_citations": 2283, "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "number_of_pages": 5, "inspire_categories": [{"term": "General Physics"}], "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/052gg0110"}], "full_name": "Steane, A.M.", "last_name": "Steane", "first_name": "A.M.", "recid": 1877134}, "control_number": 1938627, "dois": [{"value": "10.1103/physrevlett.77.793"}], "earliest_date": "1996-07-29", "document_type": ["article"], "texkeys": ["Steane:1996ghp"], "abstracts": [{"source": "submitter", "value": "A new type of uncertainty relation is presented, concerning the information-bearing properties of a discrete quantum system. A natural link is then revealed between basic quantum theory and the linear error correcting codes of classical information theory. A subset of the known codes is described, having properties which are important for error correction in quantum communication. It is shown that a pair of states which are, in a certain sense, “macroscopically different,” can form a superposition in which the interference phase between the two parts is measurable. This provides a highly stabilized “Schrödinger cat” state.", "abstract_source_suggest": {"input": "submitter"}}], "refereed": true, "titles": [{"source": "submitter", "title": "Error Correcting Codes in Quantum Theory"}], "external_system_identifiers": [{"schema": "MSNET", "value": "1398854"}], "facet_author_name": ["1877134_Andrew M. Steane"], "core": true, "imprints": [{"date": "1996-07-29"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:1938627", "updated": "2024-09-17T08:36:41.731162"}, "curated": true, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."]}, "links": {"bibtex": "https://inspirehep.net/api/literature/1938627?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/1938627?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/1938627?format=latex-us", "json": "https://inspirehep.net/api/literature/1938627?format=json", "json-expanded": "https://inspirehep.net/api/literature/1938627?format=json-expanded", "cv": "https://inspirehep.net/api/literature/1938627?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1938627"}, "id": "1938627"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.77.793&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.77.793&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.77.793&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.77.793&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.77.793&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/li