}, {"reference": {"publication_info": {"journal_volume": "29", "artid": "463", "page_start": "463", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47045"}}, {"reference": {"publication_info": {"journal_volume": "37", "artid": "1212", "page_start": "1212", "journal_title": "Am.J.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "30", "page_start": "30", "journal_title": "Phys.Today"}}}, {"reference": {"arxiv_eprint": "gr-qc/9507025"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/397147"}}, {"reference": {"arxiv_eprint": "quant-ph/9609006"}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/423041"}}, {"reference": {"arxiv_eprint": "quant-ph/9704039", "publication_info": {"journal_volume": "39", "artid": "6291", "page_start": "6291", "journal_title": "J.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/442442"}}, {"reference": {"arxiv_eprint": "quant-ph/9709032", "publication_info": {"journal_volume": "46", "artid": "855", "page_start": "855", "journal_title": "Fortsch.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/448429"}}, {"reference": {"arxiv_eprint": "gr-qc/9704009", "publication_info": {"journal_volume": "270", "artid": "1", "page_start": "1", "journal_title": "Annals Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/441814"}}, {"reference": {"publication_info": {"journal_volume": "40", "artid": "749", "page_start": "749", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3198"}}, {"reference": {"publication_info": {"journal_volume": "106", "artid": "121", "page_start": "121", "journal_title": "Phys.Rept."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/188661"}}], "number_of_pages": 14, "referenced_authors_bais": ["M.V.Sataric.1", "T.Weber.6", "W.H.Zurek.1", "L.Vaidman.1", "J.R.Ellis.1", "R.Gielerak.1", "L.Jakobczyk.1", "Robert.F.OConnell.1", "D.N.Page.1", "Salman.Habib.1", "J.A.Tuszynski.1", "P.M.Pearle.1", "S.Mohanty.1", "Dimitri.V.Nanopoulos.1", "E.Joos.1", "G.N.Fleming.1", "H.D.Zeh.1", "N.E.Mavromatos.1", "Hugh.Everett.1", "Eugene.P.Wigner.1", "J.P.Paz.1", "M.Hillery.1", "G.C.Ghirardi.1", "A.Rimini.2", "M.Tegmark.1", "R.B.Zakula.1", "M.R.Gallis.2", "J.A.Wheeler.1", "W.G.Unruh.1", "R.Olkiewicz.1", "M.O.Scully.1"], "figures": [{"filename": "timescales.png", "material": "preprint", "caption": "The qualitative behavior of a subsystem depends on the timescales for dynamics, dissipation and decoherence. This classification is by necessity quite crude, so the boundaries should not be thought of as sharp.", "source": "arxiv", "key": "f8a6c0c65a2ecc33d858cf30d168d040", "url": "https://inspirehep.net/files/f8a6c0c65a2ecc33d858cf30d168d040"}, {"filename": "trinity.png", "material": "preprint", "caption": "An observer can always decompose the world into three subsystems: the degrees of freedom corresponding to her subjective perceptions (the subject), the degrees of freedom being studied (the object), and everything else (the environment). As indicated, the subsystem Hamiltonians $\\Hsubj$, $\\Hobj$, $\\Henv$ and the interaction Hamiltonians $\\Hso$, $\\Hoe$, $\\Hse$ can cause qualitatively very different effects, which is why it is often useful to study them separately. This paper focuses on the interaction $\\Hse$.", "source": "arxiv", "key": "5b31cd1e3d5e20ed72a8535f7c46285a", "url": "https://inspirehep.net/files/5b31cd1e3d5e20ed72a8535f7c46285a"}, {"filename": "neuron.png", "material": "preprint", "caption": "Schematic illustration of a neuron (left), a section of the myelinated axon (center) and and a piece of its axon membrane (right). The axon is typically insulated (myelinated) with small bare patches every $0.5\\,mm$ or so (so-called Nodes of Ranvier) where the voltage-sensitive sodium and potassium gates are concentrated \\cite{Morell,Hirano}. If the neuron is in a superposition of firing and not firing, then $N\\sim 10^6$ $\\Naplus$ ions are in a superposition of being inside and outside the cell (right).", "source": "arxiv", "key": "6cbab6ce934b9e60edcecb8008275ff7", "url": "https://inspirehep.net/files/6cbab6ce934b9e60edcecb8008275ff7"}, {"filename": "matrices.png", "material": "preprint", "caption": "Time evolution of the $6\\times6$ density matrix for the basis states $\\noup$, $\\nodown$, $\\upup$, $\\updown$, $\\downup$, $\\downdown$ as the object evolves in isolation, then decoheres, then gets observed by the subject. The final result is a statistical mixture of the states $\\upup$ and $\\downdown$, simple zero-entropy states like the one we started with.", "source": "arxiv", "key": "6a75cc6e11673efd0b607d0c17e83ea8", "url": "https://inspirehep.net/files/6a75cc6e11673efd0b607d0c17e83ea8"}, {"filename": "matrices2.png", "material": "preprint", "caption": "Time evolution of the same $6\\times6$ density matrix as in \\fig{ChessFig} when the subject evolves in isolation, then decoheres. The object remains in the state $\\up$ the whole time. The final result is a statistical mixture of the two states $\\upup$ and $\\downup$.", "source": "arxiv", "key": "3e6adbd698ec9e596cd6a04395bbb575", "url": "https://inspirehep.net/files/3e6adbd698ec9e596cd6a04395bbb575"}], "legacy_version": "20160616172401.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1999-07-06", "preprint_date": "1999-07", "author_count": 1, "public_notes": [{"source": "arXiv", "value": "Minor changes to match accepted PRE version. 15 pages with 5 figs included. Color figures and links at http://www.physics.upenn.edu/~max/brain.html or from max@physics.upenn.edu. Physical Review E, in press"}], "first_author": {"emails": ["max@ias.edu"], "affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/00f809463"}, {"schema": "ROR", "value": "https://ror.org/00b30xv10"}], "full_name": "Tegmark, Max", "last_name": "Tegmark", "ids": [{"schema": "INSPIRE ID", "value": "INSPIRE-00130936"}, {"schema": "INSPIRE BAI", "value": "M.Tegmark.1"}], "first_name": "Max", "recid": 986412}, "control_number": 503120, "dois": [{"value": "10.1103/PhysRevE.61.4194"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevE.61.4194"}], "earliest_date": "1999-07", "document_type": ["article"], "texkeys": ["Tegmark:1999yf"], "abstracts": [{"value": "Based on a calculation of neural decoherence rates, we argue that that the degrees of freedom of the human brain that relate to cognitive processes should be thought of as a classical rather than quantum system, ie, that there is nothing fundamentally wrong with the current classical approach to neural network simulations. We find that the decoherence timescales ~10^{-13}-10^{-20} seconds are typically much shorter than the relevant dynamical timescales (~0.001-0.1 seconds), both for regular neuron firing and for kink-like polarization excitations in microtubules. This conclusion disagrees with suggestions by Penrose and others that the brain acts as a quantum computer. Our result is also difficult to reconcile with the Stapp model where thought processes correspond to top-level multi-neuron quantum events."}, {"source": "arXiv", "value": "Based on a calculation of neural decoherence rates, we argue that that the degrees of freedom of the human brain that relate to cognitive processes should be thought of as a classical rather than quantum system, i.e., that there is nothing fundamentally wrong with the current classical approach to neural network simulations. We find that the decoherence timescales ~10^{-13}-10^{-20} seconds are typically much shorter than the relevant dynamical timescales (~0.001-0.1 seconds), both for regular neuron firing and for kink-like polarization excitations in microtubules. This conclusion disagrees with suggestions by Penrose and others that the brain acts as a quantum computer, and that quantum coherence is related to consciousness in a fundamental way.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2000PhRvE..61.4194T"}, {"schema": "SPIRES", "value": "SPIRES-4112229"}], "titles": [{"title": "The Quantum brain"}, {"source": "arXiv", "title": "The quantum brain"}, {"source": "arXiv", "title": "The importance of quantum decoherence in brain processes"}], "facet_author_name": ["986412_Max Tegmark"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:503120", "updated": "2025-10-01T10:21:43.369035"}, "curated": true, "journal_title_variants": ["Phys. Rev. E", "Phys.Rev.E"], "arxiv_eprints": [{"categories": ["quant-ph", "cond-mat.dis-nn", "cs.NE", "physics.bio-ph", "q-bio"], "value": "quant-ph/9907009"}]}, "id": "503120", "updated": "2025-10-01T10:21:43.369035+00:00", "created": "1999-07-06T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/503120?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/503120?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/503120?format=latex-us", "json": "https://inspirehep.net/api/literature/503120?format=json", "json-expanded": "https://inspirehep.net/api/literature/503120?format=json-expanded", "cv": "https://inspirehep.net/api/literature/503120?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A503120"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreve.61.4194&size=5&page=1&format=cv"}}