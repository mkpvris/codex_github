, "texkeys": ["Szabo:2002zsn"], "abstracts": [{"source": "arXiv", "value": "A recent analysis by de Barros and Suppes of experimentally realizable GHZ correlations supports the conclusion that these correlations cannot be explained by introducing local hidden variables. We show, nevertheless, that their analysis does not exclude local hidden variable models in which the inefficiency in the experiment is an effect not only of random errors in the detector equipment, but is also the manifestation of a pre-set, hidden property of the particles (\"prism models\"). Indeed, we present an explicit prism model for the GHZ scenario; that is, a local hidden variable model entirely compatible with recent GHZ experiments.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "A local hidden variable theory for the GHZ experiment"}], "facet_author_name": ["2304908_T.A. Fine", "2206425_Laszlo E. Szabo"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2988453", "updated": "2025-10-01T10:59:59.582553"}, "curated": false, "journal_title_variants": ["Phys. Lett. A", "Phys.Lett.A"], "arxiv_eprints": [{"categories": ["quant-ph", "math-ph", "math.MP"], "value": "quant-ph/0007102"}]}, "id": "2988453", "updated": "2025-10-01T10:59:59.582553+00:00", "created": "2025-10-01T10:59:56.919781+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0375-9601%2802%2900176-7&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0375-9601%2802%2900176-7&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0375-9601%2802%2900176-7&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0375-9601%2802%2900176-7&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1016%2Fs0375-9601%2802%2900176-7&size=5&page=1