": "46", "artid": "745", "page_start": "745", "journal_title": "Am.J.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "931", "page_start": "931", "journal_title": "Am.J.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/8911"}}], "number_of_pages": 10, "referenced_authors_bais": ["Albert.Einstein.1", "A.Peres.1", "W.H.Zurek.1", "Hugh.Everett.1", "R.W.P.Drever.1", "B.Misra.1", "Nathan.Rosen.1", "M.Simonius.1", "W.G.Unruh.1", "Lev.Davidovich.Landau.1", "M.Zimmermann.2", "Y.I.Vorontsov.1", "B.Podolsky.1", "V.Sandberg.1", "W.K.Wootters.1", "R.F.Peierls.1", "Farit.Khalili.1", "C.M.Caves.1", "C.B.Chiu.1", "E.C.G.Sudarshan.1", "V.B.Braginsky.1", "Kip.S.Thorne.1"], "legacy_version": "20160616160941.0", "inspire_categories": [{"term": "General Physics", "source": "curator"}], "legacy_creation_date": "1981-01-01", "preprint_date": "1981", "author_count": 1, "first_author": {"full_name": "Zurek, W.H.", "last_name": "Zurek", "first_name": "W.H.", "recid": 981896}, "control_number": 172316, "dois": [{"value": "10.1103/PhysRevD.24.1516"}], "earliest_date": "1981", "document_type": ["article"], "texkeys": ["Zurek:1981xq"], "abstracts": [{"source": "APS", "value": "The form of the interaction Hamiltonian between the apparatus and its environment is sufficient to determine which observable of the measured quantum system can be considered \"recorded\" by the apparatus. The basis that contains this record—the pointer basis of the apparatus—consists of the eigenvectors of the operator which commutes with the apparatus-environment interaction Hamiltonian. Thus the environment can be said to perform a nondemolition measurement of an observable diagonal in the pointer basis.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "ADS", "value": "1981PhRvD..24.1516Z"}, {"schema": "SPIRES", "value": "SPIRES-938319"}, {"schema": "MSNET", "value": "628856"}], "titl