-policy-page", "source": "Crossref", "is-referenced-by-count": 23, "title": ["Efficient simulation of quantum state reduction"], "prefix": "10.1063", "volume": "43", "author": [{"given": "Dorje C.", "family": "Brody", "sequence": "first", "affiliation": [{"name": "Blackett Laboratory, Imperial College, London SW7 2BZ, United Kingdom"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Lane P.", "family": "Hughston", "sequence": "additional", "affiliation": [{"name": "Department of Mathematics, King’s College London, The Strand, London WC2R 2LS, United Kingdom"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "317", "reference": [{"key": "2024020518330788100_r1", "first-page": "363", "volume": "62", "year": "1989", "journal-title": "Helv. Phys. Acta"}, {"key": "2024020518330788100_r1a", "doi-asserted-by": "crossref", "first-page": "78", "DOI": "10.1103/PhysRevA.42.78", "volume": "42", "year": "1990", "journal-title": "Phys. Rev. A"}, {"key": "2024020518330788100_r1b", "doi-asserted-by": "crossref", "first-page": "189", "DOI": "10.1098/rspa.1994.0135", "volume": "447", "year": "1994", "journal-title": "Proc. R. Soc. London, Ser. A"}, {"key": "2024020518330788100_r1c", "doi-asserted-by": "crossref", "first-page": "503", "DOI": "10.1098/rspa.1995.0139", "volume": "451", "year": "1995", "journal-title": "Proc. R. Soc. London, Ser. A"}, {"key": "2024020518330788100_r2", "doi-asserted-by": "crossref", "first-page": "953", "DOI": "10.1098/rspa.1996.0048", "volume": "452", "year": "1996", "journal-title": "Proc. R. Soc. London, Ser. A"}, {"key": "2024020518330788100_r3", "doi-asserted-by": "crossref", "first-page": "2485", "DOI": "10.1063/1.533255", "volume": "41", "year": "2000", "journal-title": "J. Math. Phys."}, {"key": "2024020518330788100_r3a", "doi-asserted-by": "crossref", "first-page": "4386", "DOI": "10.1103/PhysRevE.62.4386", "volume": "62", "year": "2000", "journal-title": "Phys. Rev. E"}, {"key": "2024020518330788100_r3b"