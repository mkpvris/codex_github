rtid": "845", "year": 1997, "page_start": "845", "journal_title": "Found.Phys."}, "authors": [{"full_name": "Sutherland, R.I."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[41] R.I. Sutherland, Found. Phys. 27, 845 (1997)."}]}, {"reference": {"label": "42", "publication_info": {"journal_volume": "28", "artid": "881", "year": 1998, "page_start": "881", "journal_title": "Found.Phys."}, "authors": [{"full_name": "Holland, P.R."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[42] P.R. Holland, Found. Phys. 28, 881 (1998)."}]}, {"reference": {"label": "43", "publication_info": {"journal_volume": "28", "artid": "1", "year": 1998, "page_start": "1", "journal_title": "Found.Phys."}, "authors": [{"full_name": "Deotto, E."}, {"full_name": "Ghirardi, G.C."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[43] E. Deotto and G.C. Ghirardi, Found. Phys. 28, 1 (1998)."}], "record": {"$ref": "https://inspirehep.net/api/literature/442038"}}, {"reference": {"arxiv_eprint": "quant-ph/9811041", "label": "44", "misc": ["Los Alamos e-print"], "authors": [{"full_name": "Roy, S.M."}, {"full_name": "Singh, V."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[44] S.M. Roy and V. Singh, Los Alamos e-print, quant-ph/9811041."}], "record": {"$ref": "https://inspirehep.net/api/literature/455612"}}], "number_of_pages": 21, "referenced_authors_bais": ["G.M.Obermair.1", "A.O.Caldeira.1", "E.Deotto.1", "W.H.Zurek.1", "Hong.Yu.Zhang.1", "S.M.Roy.1", "Y.Y.Zhang.6", "Subrahmanyan.Chandrasekhar.1", "A.Zoupas.1", "J.Kupsch.3", "Robert.F.OConnell.1", "M.Gell.Mann.1", "H.Geiger.1", "Salman.Habib.1", "C.Helm.1", "H.Grabert.1", "R.J.Glauber.1", "W.K.Wootters.1", "Virendra.Singh.1", "E.Joos.1", "R.Jozsa.1", "A.J.Leggett.1", "G.Lindblad.1", "T.Yu.143", "H.D.Zeh.1", "J.J.Halliwell.1", "J.B.Hartle.1", "D.M.Appleby.1", "Eugene.P.Wigner.1", "C.Anastopoulos.1", "W.H.Lee.1", "J.P.Paz.1", "J.R.Anglin.1", "M.Hillery.1", "G.C.Ghirardi.1", "B.L.Hu.1", "R.B.Griffiths.1", "M.Tegmark.1", "G.L.Ingold.1", "L.P.Hughston.2", "E.C.G.Sudarshan.1", "P.Schramm.1", "M.O.Scully.1"], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "1999-08-08", "author_count": 1, "first_author": {"emails": ["d.m.appleby@qmw.ac.uk"], "full_name": "Appleby, D.M.", "last_name": "Appleby", "first_name": "D.M.", "recid": 2048912}, "public_notes": [{"source": "arXiv", "value": "21 pages, AMS Latex"}], "control_number": 2979694, "earliest_date": "1999-08-08", "document_type": ["article"], "texkeys": ["Appleby:1999tkx"], "abstracts": [{"source": "arXiv", "value": "The proposal that the interaction between a macroscopic body and its environment plays a crucial role in producing the correct classical limit in the Bohm interpretation of quantum mechanics is investigated, in the context of a model of quantum Brownian motion. It is well known that one of the effects of the interaction is to produce an extremely rapid approximate diagonalisation of the reduced density matrix in the position representation. This effect is, by itself, insufficient to produce generically quasi-classical behaviour of the Bohmian trajectory. However, it is shown that, if the system particle is initially in an approximate energy eigenstate, then there is a tendency for the Bohmian trajectory to become approximately classical on a rather longer time-scale. The relationship between this phenomenon and the behaviour of the Wigner function post-decoherence (as analysed by Halliwell and Zoupas) is discussed. It is also suggested that the phenomenon may be related to the storage of information about the trajectory in the environment, and that it may therefore be a general feature of every situation in which such environmental monitoring occurs.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "Bohmian Trajectories Post-Decoherence"}], "facet_author_name": ["2048912_D.M. Appleby"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2979694", "updated": "2025-09-30T14:34:01.047100"}, "curated": false, "journal_title_variants": ["Found.Phys.", "Found. Phys."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9908029"}]}, "created": "2025-09-30T14:34:00.793437+00:00", "id": "2979694"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=t%20%22Bohmian%20Trajectories%20Post-Decoherence%22&size=5&page=1&format=cv"}}