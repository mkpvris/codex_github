, "abstracts": [{"source": "APS", "value": "An approximate measurement procedure of the following type is considered: (i) An initial eigenstate of the object observable leads to a final statistical operator of the object plus apparatus describing a mixture of exact eigenstates of the apparatus observable; (ii) almost all the statistical weight of the mixture is assigned to eigenstates associated with one eigenvalue of the apparatus observable, which is uniquely determined by the initial value of the object observable. It is proved that each of a large class of initial states of the object leads to a final statistical operator which does not describe any mixture of exact eigenstates of the apparatus observable. The analysis also yields a proof of a theorem on measurement stated by Fine.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "OSTI", "value": "4292665"}, {"schema": "ADS", "value": "1974PhRvD...9.2321S"}, {"schema": "SPIRES", "value": "SPIRES-219231"}], "titles": [{"title": "Approximate measurement in quantum mechanics. ii"}], "facet_author_name": ["1059818_Abner Shimony"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:92979", "updated": "2023-03-07T05:31:56.768146"}, "curated": true, "journal_title_variants": ["Phys.Rev.D", "Phys. Rev. D"]}, "links": {"bibtex": "https://inspirehep.net/api/literature/92979?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/92979?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/92979?format=latex-us", "json": "https://inspirehep.net/api/literature/92979?format=json", "json-expanded": "https://inspirehep.net/api/literature/92979?format=json-expanded", "cv": "https://inspirehep.net/api/literature/92979?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A92979"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=t%20%22Measurement%20in%20Quantum%20Me