rnal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47641"}}, {"reference": {"publication_info": {"journal_volume": "123", "artid": "666", "page_start": "666", "journal_title": "Phys.Rev."}}}], "number_of_pages": 24, "referenced_authors_bais": ["T.B.Day.1", "Max.Born.1", "J.E.Moyal.1", "J.Bub.1", "B.Podolsky.1", "C.Papaliolios.2", "H.P.Robertson.1", "D.Bohm.1", "Y.Aharonov.1", "L.Susskind.1", "I.Shaknov.1", "Niels.Bohr.1", "G.C.Wick.1", "U.Fano.1", "John.Stewart.Bell.1", "J.B.Hartle.1", "H.Araki.1", "M.M.Nieto.1", "J.Glogower.1", "Nathan.Rosen.1", "Eugene.P.Wigner.1", "G.R.Allcock.1", "P.Carruthers.1", "M.M.Yanase.1", "Chien.Shiung.Wu.1", "E.Schrodinger.1", "L.Rosenfeld.1", "A.S.Wightman.1", "W.Heisenberg.1", "Albert.Einstein.1"], "legacy_version": "20180504190152.0", "legacy_creation_date": "2006-06-30", "preprint_date": "1970", "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/0213rcc28"}], "full_name": "Ballentine, L.E.", "last_name": "Ballentine", "first_name": "L.E.", "recid": 1045972}, "control_number": 65371, "dois": [{"value": "10.1103/RevModPhys.42.358"}], "earliest_date": "1970", "document_type": ["article"], "texkeys": ["Ballentine:1970yh"], "abstracts": [{"source": "APS", "value": "The Statistical Interpretation of quantum theory is formulated for the purpose of providing a sound interpretation using a minimum of assumptions. Several arguments are advanced in favor of considering the quantum state description to apply only to an ensemble of similarily prepared systems, rather than supposing, as is often done, that it exhaustively represents an individual physical system. Most of the problems associated with the quantum theory of measurement are artifacts of the attempt to maintain the latter interpretation. The introduction of hidden variables to determine the outcome of individual events is fully compatible with the statistical predictions of quantum theory. However, a theorem due to Bell seems to require that any such hidden-variable theory which reproduces all of quantum mechanics exactly (i.e., not merely in some limiting case) must possess a rather pathological character with respect to correlated, but spacially separated, systems.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "OSTI", "value": "4086460"}, {"schema": "SPIRES", "value": "SPIRES-6779123"}], "titles": [{"title": "The statistical interpretation of quantum mechanics"}], "publication_type": ["review"], "facet_author_name": ["1045972_Leslie E. Ballentine"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:65371", "updated": "2026-02-06T10:01:59.015094"}, "curated": true, "journal_title_variants": ["Rev.Mod.Phys.", "Rev. Mod. Phys."]}, "id": "65371", "updated": "2026-02-06T10:01:59.015094+00:00", "created": "2006-06-30T00:00:00+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Frevmodphys.42.358&size=5&page=1&format=cv"}}