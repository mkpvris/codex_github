7d5-76d9f6497059", "first_name": "A.S.", "recid": 1021111}, {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/00hx57361"}], "full_name_unicode_normalized": "wigner, eugene p.", "full_name": "Wigner, Eugene P.", "curated_relation": true, "record": {"$ref": "https://inspirehep.net/api/authors/983578"}, "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/903139"}, "value": "Princeton U."}], "ids": [{"schema": "INSPIRE BAI", "value": "Eugene.P.Wigner.1"}], "last_name": "Wigner", "signature_block": "WAGNARe", "uuid": "7b24a8ad-4225-4071-85ed-11349516693c", "first_name": "Eugene P.", "recid": 983578}], "citeable": true, "$schema": "https://inspirehep.net/schemas/records/hep.json", "keywords": [{"schema": "INSPIRE", "value": "charge: selection rule"}, {"schema": "INSPIRE", "value": "selection rule: superselection rule"}, {"schema": "INSPIRE", "value": "quantum mechanics"}], "references": [{"reference": {"publication_info": {"journal_volume": "186", "artid": "1380", "page_start": "1380", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/62132"}}, {"reference": {"publication_info": {"journal_volume": "155", "artid": "1428", "page_start": "1428", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/52232"}}, {"reference": {"publication_info": {"journal_volume": "88", "artid": "101", "page_start": "101", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/42666"}}, {"reference": {"publication_info": {"journal_volume": "49", "artid": "910", "page_start": "910", "journal_title": "Proc.Nat.Acad.Sci."}}, "record": {"$ref": "https://inspirehep.net/api/literature/2743870"}}], "number_of_pages": 3, "referenced_authors_bais": ["Eugene.P.Wigner.1", "G.C.Wick.1", "Y.Aharonov.1", "A.S.Wightman.1", "L.Susskind.1", "M.M.Yanase.1", "R.Mirman.5"], "legacy_version": "20180327140527.0", "legacy_creation_date": "2001-05-07", "preprint_date": "1970", "author_count": 3, "first_author": {"full_name": "Wick, G.C.", "last_name": "Wick", "first_name": "G.C.", "recid": 2146585}, "control_number": 61569, "dois": [{"value": "10.1103/PhysRevD.1.3267"}], "earliest_date": "1970", "document_type": ["article"], "texkeys": ["Wick:1970bd"], "abstracts": [{"source": "APS", "value": "The customary notion of superselection rule stipulates the vanishing of those matrix elements of the density matrix that connect states separated by the superselection rule, i.e., the relative phases of which are, according to the superselection rule, meaningless. It is shown that, if any two states for which an additive conserved quantity has different values are separated for all physical systems by a superselection rule at one time, the separation will persist for all times. It is concluded that the states with different electric (or baryonic) charges are so separated. The reason for the difference between electric charge and other additive conserved quantities, such as momentum, is brought out.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "OSTI", "value": "4097069"}, {"schema": "ADS", "value": "1970PhRvD...1.3267W"}, {"schema": "CDS", "value": "419868"}, {"schema": "SPIRES", "value": "SPIRES-1198360"}], "titles": [{"title": "Superselection rule for charge"}], "facet_author_name": ["2146585_G.C. Wick", "983578_Eugene P. Wigner", "1021111_Arthur Strong Wightman"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:61569", "updated": "2024-01-09T09:27:03.479395"}, "curated": true, "journal_title_variants": ["Phys.Rev.D", "Phys. Rev. D"]}, "created": "2001-05-07T00:00:00+00:00", "id": "61569"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.1.3267&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=d