, "artid": "389", "page_start": "389", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "89", "artid": "319", "page_start": "319", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47019"}}, {"reference": {"publication_info": {"journal_volume": "89", "artid": "458", "page_start": "458", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/48046"}}, {"reference": {"publication_info": {"journal_volume": "38", "artid": "453", "page_start": "453", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/50845"}}, {"reference": {"publication_info": {"journal_volume": "38", "artid": "470", "page_start": "470", "journal_title": "Rev.Mod.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "29", "artid": "454", "page_start": "454", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3662"}}, {"reference": {"publication_info": {"journal_volume": "29", "artid": "463", "page_start": "463", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47045"}}], "number_of_pages": 6, "referenced_authors_bais": ["Hugh.Everett.1", "S.T.Epstein.1", "D.Bohm.1", "J.Bub.1", "J.A.Wheeler.1"], "legacy_version": "20160315101929.0", "legacy_creation_date": "2006-07-13", "preprint_date": "1970", "author_count": 1, "first_author": {"full_name": "Dewitt, Bryce S.", "last_name": "Dewitt", "first_name": "Bryce S.", "recid": 1011894}, "control_number": 65716, "dois": [{"source": "bibcheck", "value": "10.1063/1.3022331"}], "earliest_date": "1970", "document_type": ["article"], "texkeys": ["Dewitt:1970ka"], "abstracts": [{"source": "AIP", "value": "Despite its enormous practical success, quantum theory is so contrary to intuition that, even after 45 years, the experts themselves still do not all agree what to make of it. The area of disagreement centers primarily around the problem of describing observations. Formally, the result of a measurement is a superposition of vectors, each representing the quantity being observed as having one of its possible values. The question that has to be answered is how this superposition can be reconciled with the fact that in practice we only observe one value. How is the measuring instrument prodded into making up its mind which value it has observed? Could the solution to the dilemma of indeterminism be a universe in which all possible outcomes of an experiment actually occur?", "abstract_source_suggest": {"input": "AIP"}}], "titles": [{"title": "Quantum mechanics and reality"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-6810730"}], "facet_author_name": ["1011894_Bryce S. DeWitt"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:65716", "updated": "2023-03-07T04:54:29.201823"}, "curated": true, "journal_title_variants": ["Phys. Today", "Phys.Today"]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1063%2F1.3022331&size=5&page=1&format=cv"}}