1", "artid": "1059", "page_start": "1059", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "20", "artid": "2017", "page_start": "2017", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "1322", "page_start": "1322", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "3", "artid": "1484", "page_start": "1484", "journal_title": "Phys.Rev."}}}, {"reference": {"publication_info": {"journal_volume": "26", "artid": "1817", "page_start": "1817", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/839624"}}, {"reference": {"publication_info": {"journal_volume": "209", "artid": "547", "page_start": "547", "journal_title": "Science"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/158795"}}, {"reference": {"publication_info": {"journal_volume": "36", "artid": "823", "page_start": "823", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/46675"}}, {"reference": {"publication_info": {"journal_volume": "40", "artid": "749", "page_start": "749", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3198"}}, {"reference": {"publication_info": {"journal_volume": "45", "artid": "99", "page_start": "99", "journal_title": "NOONE"}}}], "number_of_pages": 9, "referenced_authors_bais": ["Eugene.P.Wigner.1", "Y.I.Vorontsov.1", "L.S.Ornstein.1", "C.M.Caves.1", "V.B.Braginsky.1", "W.H.Zurek.1", "Kip.S.Thorne.1", "G.E.Uhlenbeck.1"], "legacy_version": "20180504133131.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "2008-09-22", "preprint_date": "1987-07-15", "author_count": 2, "first_author": {"full_name": "Haake, Fritz", "last_name": "Haake", "first_name": "Fritz", "recid": 2180321}, "control_number": 260326, "dois": [{"value": "10.1103/PhysRevA.36.730"}], "earliest_date": "1987-07-15", "document_type": ["article"], "texkeys": ["Haake:1987zz"], "abstracts": [{"source": "APS", "value": "We show that a quantum observable can be measured by coupling it to a meter which in turn interacts with a reservoir. The complete Hamiltonian is chosen so as to allow for an explicit exact solution of the quantum dynamics. In the continuum limit for the bath the solution displays irreversible behavior, two varieties of which, overdamping and amplification, turn out to be of special relevance. We establish the limit in which a suitable pointer variable (i) behaves effectively classically and (ii) acquires, through the measurement, a probability density of its eigenvalues with well-defined peaks each of which corresponds to one discrete eigenvalue of the measured observable. Under a slightly more restrictive condition the reduced density matrix of the object diagonalizes, during the measurement, in the eigenbasis of the measured observable.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Overdamped and amplifying meters in the quantum theory of measurement"}], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-7967420"}, {"schema": "MSNET", "value": "901719"}], "facet_author_name": ["2180321_Fritz Haake", "1040623_Daniel Frank Walls"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:260326", "updated": "2023-10-03T07:57:44.039326"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"]}, "created": "2008-09-22T00:00:00+00:00", "updated": "2023-10-03T07:57:44.039326+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.36.730&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.36.730&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.36.730&size=5