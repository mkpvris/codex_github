s": [{"full_name": "Lidar, D.A."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[26] D.A. Lidar et al., Phys. Rev. A 63, 022307 (2001)."}], "record": {"$ref": "https://inspirehep.net/api/literature/3031612"}}, {"reference": {"label": "27", "publication_info": {"journal_volume": "48", "artid": "1075", "year": 2000, "page_start": "1075", "journal_title": "Fortsch.Phys."}, "authors": [{"full_name": "Spiller, T.P."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[27] T.P. Spiller, Fortschritte der Physik 48, 1075 (2000)."}]}, {"reference": {"arxiv_eprint": "quant-ph/0202168", "label": "28", "authors": [{"full_name": "Wu, L.-A."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[28] L.-A. Wu et al., quant-ph/0202168."}], "record": {"$ref": "https://inspirehep.net/api/literature/3031543"}}], "number_of_pages": 4, "referenced_authors_bais": ["Seth.Lloyd.1", "D.Loss.1", "E.Knill.1", "R.Vrijen.1", "W.H.Zurek.1", "J.Kempe.1", "M.Rasetti.1", "A.V.Balandin.1", "G.Burkard.1", "J.F.Poyatos.1", "T.Mor.3", "H.W.Jiang.1", "L.M.Duan.1", "M.Byrd.1", "J.I.Cirac.1", "R.Laflamme.1", "L.A.Wu.1", "P.Zoller.1", "E.Yablonovitch.1", "P.Tombesi.2", "W.Mass.1", "S.S.Somaroo.1", "P.Zanardi.3", "K.B.Whaley.2", "I.L.Chuang.1", "G.C.Guo.1", "D.Vitali.2", "Andrew.M.Steane.1", "B.E.Kane.1", "David.Bacon.1", "M.Price.1", "L.Viola.3", "T.F.Havel.1", "D.A.Lidar.1", "F.Rossi.3", "D.G.Cory.1", "V.Roychowdhury.1", "D.P.DiVincenzo.1", "Ke.Lin.Wang.1"], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "2002-04-10", "author_count": 2, "first_author": {"full_name": "Wu, L.-A.", "last_name": "Wu", "first_name": "L.-A.", "recid": 1982154}, "public_notes": [{"source": "arXiv", "value": "This version to appear in PRL. Several small changes, including title and abstract. 4 pages, no figures"}], "control_number": 3031558, "dois": [{"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.88.207902"}], "earliest_date": "2002-04-10", "document_type": ["article"], "texkeys": ["Wu:2002mos"], "abstracts": [{"source": "arXiv", "value": "A decoherence-free subspace (DFS) isolates quantum information from deleterious environmental interactions. We give explicit sequences of strong and fast (``bang-bang'', BB) pulses that create the conditions allowing for the existence of DFSs that support scalable, universal quantum computation. One such example is the creation of the conditions for collective decoherence, wherein all system particles are coupled in an identical manner to their environment. The BB pulses needed for this are generated using only the Heisenberg exchange interaction. In conjunction with previous results, this shows that Heisenberg exchange is all by itself an enabler of universal fault tolerant quantum computation on DFSs.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "Creating Decoherence-Free Subspaces with Strong and Fast Pulses"}], "facet_author_name": ["1982154_Lian-Ao Wu", "1025066_Daniel A. Lidar"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:3031558", "updated": "2026-02-09T15:21:04.640531"}, "curated": false, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0112144"}]}, "id": "3031558", "updated": "2026-02-09T15:21:04.640531+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/3031558?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/3031558?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/3031558?format=latex-us", "json": "https://inspirehep.net/api/literature/3031558?format=json", "json-expanded": "https://inspirehep.net/api/literature/3031558?format=json-expanded", "cv": "https://inspirehep.net/api/literature/3031558?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A3031558"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.88.207902&size=5&page=1&format=cv"}}