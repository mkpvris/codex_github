113", "journal_title": "Phys.Lett.B"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/268516"}}, {"reference": {"publication_info": {"journal_volume": "87", "artid": "395", "page_start": "395", "journal_title": "Commun.Math.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/181927"}}, {"reference": {"publication_info": {"journal_volume": "3", "artid": "383", "page_start": "383", "journal_title": "Found.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "42", "artid": "78", "page_start": "78", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/280441"}}, {"reference": {"publication_info": {"journal_volume": "42", "artid": "1057", "page_start": "1057", "journal_title": "Phys.Rev.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/281858"}}, {"reference": {"publication_info": {"journal_volume": "142", "artid": "439", "page_start": "439", "journal_title": "Phys.Lett.A"}}}], "number_of_pages": 15, "referenced_authors_bais": ["Stephen.W.Hawking.1", "S.Mohanty.1", "O.Kuebler.1", "T.Weber.6", "W.H.Zurek.1", "Hugh.Everett.1", "J.A.Wheeler.1", "Eugene.P.Wigner.1", "Shinji.Machida.1", "W.G.Unruh.1", "J.R.Ellis.1", "H.D.Zeh.1", "R.Grassi.1", "M.Namiki.2", "E.Joos.1", "G.C.Ghirardi.1", "P.M.Pearle.1", "A.Rimini.2", "Dimitri.V.Nanopoulos.1", "J.N.Bahcall.1", "R.K.Ulrich.1"], "legacy_version": "20160325051635.0", "inspire_categories": [{"term": "Gravitation and Cosmology"}], "legacy_creation_date": "1993-10-29", "preprint_date": "1993-06", "author_count": 1, "public_notes": [{"value": "Submitted to Found.Phys."}], "first_author": {"full_name": "Tegmark, Max", "last_name": "Tegmark", "ids": [{"schema": "INSPIRE ID", "value": "INSPIRE-00130936"}, {"schema": "INSPIRE BAI", "value": "M.Tegmark.1"}], "first_name": "Max", "recid": 986412}, "control_number": 359421, "dois": [{"source": "ADS", "value": "10.1007/BF00662807"}], "earliest_date": "1993-06", "document_type": ["article"], "texkeys": ["Tegmark:1993yn"], "abstracts": [{"source": "arXiv", "value": "Some experimental implications of the recent progress on wave function collapse are calculated. Exact results are derived for the center-of-mass wave function collapse caused by random scatterings and applied to a range of specific examples. The results show that recently proposed experiments to measure the GRW effect are likely to fail, since the effect of naturally occurring scatterings is of the same form as the GRW effect but generally much stronger. The same goes for attempts to measure the collapse caused by quantum gravity as suggested by Hawking and others. The results also indicate that macroscopic systems tend to be found in states with $\\Delta x\\Delta p = \\hbar/\\sqrt 2$, but microscopic systems in highly tiltedly squeezed states with $\\Delta x\\Delta p \\gg \\hbar$.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["gr-qc"], "external_system_identifiers": [{"schema": "ADS", "value": "1993FoPhL...6..571T"}, {"schema": "SPIRES", "value": "SPIRES-2833573"}], "titles": [{"title": "Apparent wave function collapse caused by scattering"}], "facet_author_name": ["986412_Max Tegmark"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:359421", "updated": "2023-03-07T03:49:12.929664"}, "curated": true, "journal_title_variants": ["Found.Phys.Lett.", "Found. Phys. Lett."], "arxiv_eprints": [{"categories": ["gr-qc"], "value": "gr-qc/9310032"}]}, "id": "359421", "links": {"bibtex": "https://inspirehep.net/api/literature/359421?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/359421?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/359421?format=latex-us", "json": "https://inspirehep.net/api/literature/359421?format=json", "json-expanded": "https://inspirehep.net/api/literature/359421?format=json-expanded", "cv": "https://inspirehep.net/api/literature/359421?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A359421"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1007%2Fbf00662807&size=5&page=1&format=cv"}}