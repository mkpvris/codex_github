": "49", "journal_title": "Phys.Rev."}, "authors": [{"full_name": "Bell, J.S."}]}, "raw_refs": [{"schema": "text", "value": "J. S. Bell, Phys. Rev. 137, 49 (1986)."}]}, {"reference": {"misc": ["in Philosophical Consequences of Quantum Theory, J. Cushing and E. McMullin (eds.)"], "authors": [{"full_name": "Shimony, A."}]}, "raw_refs": [{"schema": "text", "value": "A. Shimony, in Philosophical Consequences of Quantum Theory, edited by J. Cushing and E. McMullin."}]}, {"reference": {"publication_info": {"journal_volume": "25", "artid": "583", "year": 1984, "page_start": "583", "journal_title": "Contemp.Phys."}, "authors": [{"full_name": "Leggett, A.J."}]}, "raw_refs": [{"schema": "text", "value": "A. J. Leggett, Contemp. Phys. 25, 583 (1984)."}]}, {"reference": {"publication_info": {"journal_volume": "39", "artid": "2277", "year": 1989, "page_start": "2277", "journal_title": "Phys.Rev.A"}, "authors": [{"full_name": "Pearle, P."}]}, "raw_refs": [{"schema": "text", "value": "P. Pearle, Phys. Rev. A 39, 2277 (1989)."}], "record": {"$ref": "https://inspirehep.net/api/literature/263926"}}, {"reference": {"publication_info": {"journal_volume": "102", "artid": "383", "year": 1988, "page_start": "383", "journal_title": "Nuovo Cim.B"}, "authors": [{"full_name": "Ghirardi, G.C."}, {"full_name": "Nicrosini, O."}, {"full_name": "Rimini, A."}, {"full_name": "Weber, T."}]}, "raw_refs": [{"schema": "text", "value": "G. C. Ghirardi, O. Nicrosini, A. Rimini, and T. Weber, Nuovo Cimento 102B, 383 (1988)."}], "record": {"$ref": "https://inspirehep.net/api/literature/265509"}}], "number_of_pages": 10, "referenced_authors_bais": ["E.Schrodinger.1", "L.Diosi.1", "Max.Born.1", "T.Weber.6", "W.Heisenberg.1", "F.Benatti.1", "H.D.Zeh.1", "S.Jordan.1", "N.Gisin.1", "C.M.Caves.1", "E.Joos.1", "O.Nicrosini.1", "G.C.Ghirardi.1", "P.M.Pearle.1", "A.Rimini.2", "G.J.Milburn.1"], "inspire_categories": [{"term": "Quantum Physics"}], "author_count": 1, "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/008mx9f83"}], "full_name": "Diósi, L.", "last_name": "Diósi", "first_name": "L.", "recid": 1011732}, "control_number": 2730899, "dois": [{"source": "APS", "value": "10.1103/PhysRevA.40.1165"}], "earliest_date": "1989-08-01", "document_type": ["article"], "texkeys": ["Diosi:1989hlx"], "abstracts": [{"source": "APS", "value": "This paper adopts the hypothesis that the absence of macroscopic quantum fluctuations is due to a certain universal mechanism. Such a mechanism has recently been proposed by Ghirardi et al. [Phys. Rev. D 34, 470 (1986)], and here we recapitulate a compact version of it. K\\'arolyh\\'azy [Nuovo Cimento 52, 390 (1966)] showed earlier the possible role of gravity and, along this line, we construct here a new parameter-free unification of micro- and macrodynamics. We apply gravitational measures for reducing macroscopic quantum fluctuations of the mass density. This model leads to classical trajectories in the macroscopic limit of translational motion. For massive objects, unwanted macroscopic superpositions of quantum states become destroyed in very short times. The relation between state-vector and density-operator formalisms has also been discussed. We only anticipate the need for elaborating characteristic predictions of the model in the region separating micro- and macroscopic properties.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"source": "APS", "title": "Models for universal reduction of macroscopic quantum fluctuations"}], "facet_author_name": ["1011732_Lajos Diósi"], "core": true, "imprints": [{"date": "1989-08-01"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2730899", "updated": "2024-09-17T08:40:37.751013"}, "curated": true, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"]}, "created": "2023-12-06T12:16:30.466241+00:00", "id": "2730899"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.40.1165&size=5&page=1&format=cv"}}