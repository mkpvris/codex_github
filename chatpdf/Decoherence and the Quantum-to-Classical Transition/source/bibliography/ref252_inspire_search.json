lse, "record": {"$ref": "https://inspirehep.net/api/literature/439179"}}, {"reference": {"publication_info": {"journal_volume": "90", "artid": "027903", "journal_title": "Phys.Rev.Lett."}}, "record": {"$ref": "https://inspirehep.net/api/literature/2989596"}}, {"reference": {"publication_info": {"journal_volume": "65", "artid": "040102", "journal_title": "Phys.Rev."}}}], "number_of_pages": 4, "referenced_authors_bais": ["F.SchmidtKaler.2", "N.B.Narozhny.2", "C.Monroe.2", "C.Wunderlich.2", "E.Hagley.1", "J.J.SanchezMondragon.1", "A.Maali.1", "X.Maitre.1", "H.Walther.3", "J.H.Eberly.1", "G.S.Agarwal.1", "J.Dreyer.1", "M.Brune.1", "S.Haroche.1", "E.Solano.2", "J.M.Raimond.1", "D.M.Meekhof.2", "W.M.Itano.4", "B.E.King.1", "D.J.Wineland.1"], "figures": [{"filename": "auffevesfig1.png", "material": "preprint", "caption": "(a) Experimental apparatus. (b) Timing of the experiment.", "label": "FIG1", "source": "arxiv", "key": "e53dc4f01e91afdafd8c290c63f7f2eb", "url": "https://inspirehep.net/files/e53dc4f01e91afdafd8c290c63f7f2eb"}, {"filename": "auffevesfig2.png", "material": "preprint", "caption": "(a) Field phase distribution $S_g(\\phi)$ for three $\\overline n$ values (18, 29 and 36) and $t_i=t_a=32\\ \\mu$s. The points are experimental and the curves fits on a sum of Gaussians. The thick vertical line indicates phase reference. (b) Field phase distribution for $\\overline{n}=$15, 22 and 29 and $t_i=t_b=53\\ \\mu$s. Upper curve: phase reference (no atom $A_1$ and $\\overline n=29$; for clarity, this curve has been translated along the $\\overline n$ axis). (c) Phases of the two field components versus $\\Phi^+=\\Omega t/4\\sqrt{\\overline{n}}$. Dotted and solid lines are theoretical (see text). Inset: computed cavity field Wigner function $W(\\beta_x+i\\beta_y)$ for $\\overline{n}=36$ and $t_i=t_a$.", "label": "FIG2", "source": "arxiv", "key": "afdb081a1341000a8b60a34112a4e86c", "url": "https://inspirehep.net/files/afdb081a1341000a8b60a34112a4e86c"}, {"filename": "auffevesfig3.png", "material": "preprint", "caption": "Field phase distributions $S_g(\\phi)$ following preparation of atomic states $|\\phi_a^\\pm(0)\\rangle$ by combination of Rabi and Stark pulses ($\\overline n=27$ and $t_i=t_a$). Open circles: preparation of $|\\phi_a^+(0)\\rangle$. Solid squares: preparation of $|\\phi_a^-(0)\\rangle$. Solid lines are gaussian fits.", "label": "FIG3", "source": "arxiv", "key": "d4f64ca5a80090be20c203e434a56598", "url": "https://inspirehep.net/files/d4f64ca5a80090be20c203e434a56598"}], "legacy_version": "20190520225036.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2008-07-24", "preprint_date": "2003-12-05", "author_count": 8, "first_author": {"full_name": "Auffeves, Alexia", "last_name": "Auffeves", "first_name": "Alexia", "recid": 2131876}, "control_number": 641757, "dois": [{"value": "10.1103/PhysRevLett.91.230405"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.91.230405"}], "earliest_date": "2003-12-05", "document_type": ["article"], "texkeys": ["Auffeves:2003zz"], "abstracts": [{"source": "APS", "value": "We observe that a mesoscopic field made of several tens of microwave photons exhibits quantum features when interacting with a single Rydberg atom in a high-Q cavity. The field is split into two components whose phases differ by an angle inversely proportional to the square root of the average photon number. The field and the atomic dipole are phase entangled. These manifestations of photon graininess vanish at the classical limit. This experiment opens the way to studies of large quantum state superpositions at the quantum-classical boundary.", "abstract_source_suggest": {"input": "APS"}}, {"source": "arXiv", "value": "We observe that a mesoscopic field made of several tens of microwave photons exhibits quantum features when interacting with a single Rydberg atom in a high-Q cavity. The field is split into two components whose phases differ by an angle inversely proportional to the square root of the average photon number. The field and the atomic dipole are phase-entangled. These manifestations of photon graininess vanish at the classical limit. This experiment opens the way to studies of large Schrodinger cat states at the quantum-classical boundary.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "HAL", "value": "hal-00000528"}, {"schema": "SPIRES", "value": "SPIRES-7845456"}], "titles": [{"title": "Entanglement of a Mesoscopic Field with an Atom Induced by Photon Graininess in a Cavity"}, {"source": "arXiv", "title": "Entanglement of a Mesoscopic Field with an Atom induced by Photon Graininess in a Cavity"}], "facet_author_name": ["2131876_Alexia Auffèves", "1979398_Jean-Michel Raimond", "1979400_Michel Brune", "1979401_Sébastien Gleyzes", "1997048_T. Meunier", "1190036_Serge Haroche", "2441284_Gilles Nogues", "2454902_P. Maioli"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:641757", "updated": "2026-02-06T10:00:10.092197"}, "curated": true, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0307185"}]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.230405&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.230405&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.230405&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.230405&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.230405&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.11