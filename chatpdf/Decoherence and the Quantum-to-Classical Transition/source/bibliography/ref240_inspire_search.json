ref": "https://inspirehep.net/api/literature/9152"}}, {"reference": {"publication_info": {"journal_volume": "14", "artid": "664", "page_start": "664", "journal_title": "Naturwiss."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/850152"}}, {"reference": {"publication_info": {"journal_volume": "91", "artid": "728", "page_start": "728", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/46633"}}, {"reference": {"publication_info": {"journal_volume": "6", "artid": "520", "page_start": "520", "journal_title": "NOONE"}}}, {"reference": {"publication_info": {"journal_volume": "14", "artid": "187", "page_start": "187", "journal_title": "NOONE"}}}, {"reference": {"publication_info": {"journal_volume": "48", "artid": "199", "page_start": "199", "journal_title": "Proc.Nat.Acad.Sci."}}}, {"reference": {"publication_info": {"journal_volume": "3", "artid": "831", "page_start": "831", "journal_title": "J.Math.Phys."}}, "record": {"$ref": "https://inspirehep.net/api/literature/1946037"}}, {"reference": {"publication_info": {"journal_volume": "10", "artid": "277", "page_start": "277", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3892"}}, {"reference": {"publication_info": {"journal_volume": "40", "artid": "749", "page_start": "749", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/3198"}}, {"reference": {"publication_info": {"journal_volume": "74", "artid": "295", "page_start": "295", "journal_title": "Z.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "84", "artid": "395", "page_start": "395", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/46868"}}, {"reference": {"publication_info": {"journal_volume": "10", "artid": "276", "page_start": "276", "journal_title": "Phys.Rev.Lett."}}}], "number_of_pages": 23, "referenced_authors_bais": ["E.C.G.Sudarshan.1", "E.Schrodinger.1", "S.S.Schweber.1", "R.J.Glauber.1", "Julian.Seymour.Schwinger.1", "Eugene.P.Wigner.1"], "legacy_version": "20180223134221.0", "inspire_categories": [{"term": "General Physics"}], "legacy_creation_date": "1997-06-09", "preprint_date": "1963-04", "author_count": 1, "first_author": {"full_name": "Glauber, Roy J.", "last_name": "Glauber", "first_name": "Roy J.", "recid": 1008226}, "control_number": 9024, "dois": [{"value": "10.1103/PhysRev.131.2766"}], "earliest_date": "1963-04", "document_type": ["article"], "texkeys": ["Glauber:1963tx"], "abstracts": [{"source": "APS", "value": "Methods are developed for discussing the photon statistics of arbitrary fields in fully quantum-mechanical terms. In order to keep the classical limit of quantum electrodynamics plainly in view, extensive use is made of the coherent states of the field. These states, which reduce the field correlation functions to factorized forms, are shown to offer a convenient basis for the description of fields of all types. Although they are not orthogonal to one another, the coherent states form a complete set. It is shown that any quantum state of the field may be expanded in terms of them in a unique way. Expansions are also developed for arbitrary operators in terms of products of the coherent state vectors. These expansions are discussed as a general method of representing the density operator for the field. A particular form is exhibited for the density operator which makes it possible to carry out many quantum-mechanical calculations by methods resembling those of classical theory. This representation permits clear insights into the essential distinction between the quantum and classical descriptions of the field. It leads, in addition, to a simple formulation of a superposition law for photon fields. Detailed discussions are given of the incoherent fields which are generated by superposing the outputs of many stationary sources. These fields are all shown to have intimately related properties, some of which have been known for the particular case of blackbody radiation.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "titles": [{"title": "Coherent and incoherent states of the radiation field"}], "external_system_identifiers": [{"schema": "OSTI", "value": "4648383"}, {"schema": "SPIRES", "value": "SPIRES-609102"}], "facet_author_name": ["1008226_Roy Jay Glauber"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:9024", "updated": "2023-03-10T10:38:54.914328"}, "curated": true, "journal_title_variants": ["Phys.Rev.", "Phys. Rev."]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrev.131.2766&size=5&page=1&format=cv"}}