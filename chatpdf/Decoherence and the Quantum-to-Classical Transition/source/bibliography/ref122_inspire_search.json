. Phys. 74, 2145 (1981)."}]}, {"reference": {"imprint": {"publisher": "Springer"}, "label": "44", "publication_info": {"year": 2000}, "misc": ["Decoherence: Theoretical, Experimental, and Conceptual Problems, Lecture Notes in Physics No. 538", "Berlin,)"], "authors": [{"full_name": "Blanchard, P."}, {"full_name": "Giulini, D."}, {"full_name": "Joos, E."}, {"full_name": "Kiefer, C."}, {"full_name": "Stamatescu, I."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[44] P. Blanchard, D. Giulini, E. Joos, C. Kiefer, and I. Stamatescu, eds., Decoherence: Theoretical, Experimental, and Conceptual Problems, Lecture Notes in Physics No. 538 (Springer, Berlin, 2000)."}]}, {"reference": {"label": "45", "publication_info": {"journal_volume": "82", "artid": "5181", "year": 1999, "page_start": "5181", "journal_title": "Phys.Rev.Lett."}, "authors": [{"full_name": "Paz, J.P."}, {"full_name": "Zurek, W.H."}]}, "raw_refs": [{"schema": "text", "source": "arXiv", "value": "[45] J. P. Paz and W. H. Zurek, Phys. Rev. Lett. 82, 5181 (1999)."}], "record": {"$ref": "https://inspirehep.net/api/literature/479207"}}], "number_of_pages": 11, "referenced_authors_bais": ["M.Tegmark.1", "O.Lombardi.2", "M.Arndt.1", "J.E.Sipe.1", "A.Peres.1", "Lucia.Hackermueller.1", "M.Schlosshauer.1", "W.H.Zurek.1", "A.Zeilinger.1", "S.Uttenthaler.2", "R.I.Betan.1", "J.P.Paz.1", "H.D.Zeh.1", "M.Castagnino.1", "R.Laura.1", "K.Hornberger.1", "G.N.Fleming.1", "E.Joos.1", "B.Brezger.1", "M.Gadella.1", "M.R.Gallis.2"], "figures": [{"filename": "1-new.png", "material": "preprint", "caption": "Plot of $\\log_{10} |r(t)|$, with the decoherence factor $r(t)$ given by Eq.~\\eqref{eq:r}, for two different bath sizes $N=20$ and $100$. Fast decay of $r(t)$, corresponding to local decoherence, is observed, and the degree of decoherence is seen to increase with $N$. The squared coefficients $|\\alpha_i|^2$ and the couplings $g_i$ were drawn from a uniform random distribution over the intervals $[0,1]$ and $[-\\pi,\\pi]$, respectively.", "label": "fig:r-eid", "source": "arxiv", "key": "1ff2149657ee7be5ce2341325752416d", "url": "https://inspirehep.net/files/1ff2149657ee7be5ce2341325752416d"}, {"filename": "2-new.png", "material": "preprint", "caption": "10", "label": "fig:q", "source": "arxiv", "key": "d49de2bb36881a0b6006e6333f12dc75", "url": "https://inspirehep.net/files/d49de2bb36881a0b6006e6333f12dc75"}, {"filename": "4-new.png", "material": "preprint", "caption": "10", "label": "fig:q2", "source": "arxiv", "key": "04825d228cb2398160e6e07645f45f2a", "url": "https://inspirehep.net/files/04825d228cb2398160e6e07645f45f2a"}, {"filename": "5-new.png", "material": "preprint", "caption": "10", "label": "fig:q-lim", "source": "arxiv", "key": "afaf2a175268e1aaf9fd74b4409f783b", "url": "https://inspirehep.net/files/afaf2a175268e1aaf9fd74b4409f783b"}], "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "preprint_date": "2005-08-11", "author_count": 1, "first_author": {"full_name": "Schlosshauer, Maximilian", "last_name": "Schlosshauer", "first_name": "Maximilian", "recid": 2053956}, "public_notes": [{"source": "arXiv", "value": "11 pages, 4 figures. Final published version"}], "control_number": 2979113, "dois": [{"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.72.012109"}], "earliest_date": "2005-08-11", "document_type": ["article"], "texkeys": ["Schlosshauer:2005qct"], "abstracts": [{"source": "arXiv", "value": "The \"self-induced decoherence\" (SID) approach suggests that (1) the expectation value of any observable becomes diagonal in the eigenstates of the total Hamiltonian for systems endowed with a continuous energy spectrum, and (2), that this process can be interpreted as decoherence. We evaluate the first claim in the context of a simple spin bath model. We find that even for large environments, corresponding to an approximately continuous energy spectrum, diagonalization of the expectation value of random observables does in general not occur. We explain this result and conjecture that SID is likely to fail also in other systems composed of discrete subsystems. Regarding the second claim, we emphasize that SID does not describe a physically meaningful decoherence process for individual measurements, but only involves destructive interference that occurs collectively within an ensemble of presupposed \"values\" of measurements. This leads us to question the relevance of SID for treating observed decoherence effects.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "titles": [{"source": "arXiv", "title": "Self-induced decoherence approach: Strong limitations on its validity in a simple spin bath model and on its general physical relevance"}], "facet_author_name": ["2053956_Maximilian Schlosshauer"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2979113", "updated": "2026-02-09T14:58:21.559049"}, "curated": false, "journal_title_variants": ["Phys. Rev. A", "Phys.Rev.A"], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0501138"}]}, "id": "2979113", "links": {"bibtex": "https://inspirehep.net/api/literature/2979113?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2979113?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2979113?format=latex-us", "json": "https://inspirehep.net/api/literature/2979113?format=json", "json-expanded": "https://inspirehep.net/api/literature/2979113?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2979113?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2979113"}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.72.012109&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.72.012109&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.72.012109&size=5&page=1