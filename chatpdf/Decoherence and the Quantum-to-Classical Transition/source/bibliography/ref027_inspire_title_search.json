{"hits": {"hits": [{"created": "2024-06-03T05:51:16.919171+00:00", "updated": "2024-06-03T05:51:17.041967+00:00", "metadata": {"authors": [{"full_name_unicode_normalized": "bell, j.s.", "full_name": "Bell, J.S.", "record": {"$ref": "https://inspirehep.net/api/authors/1693288"}, "last_name": "Bell", "ids": [{"schema": "INSPIRE BAI", "value": "John.Stewart.Bell.1"}], "uuid": "ec33031c-9caa-42c3-8720-114149db0b5b", "first_name": "J.S.", "recid": 1693288}, {"full_name_unicode_normalized": "aspect, alain", "full_name": "Aspect, Alain", "record": {"$ref": "https://inspirehep.net/api/authors/1382220"}, "last_name": "Aspect", "ids": [{"schema": "INSPIRE BAI", "value": "Alain.Aspect.1"}], "uuid": "29e4a6cb-c97b-41cf-a0b1-1d7549aa676e", "first_name": "Alain", "recid": 1382220}], "publication_info": [{"year": 2004}], "citation_count": 146, "citation_count_without_self_citations": 146, "isbns": [{"medium": "online", "value": "9780511815676"}], "$schema": "https://inspirehep.net/schemas/records/hep.json", "number_of_pages": 248, "inspire_categories": [{"term": "Quantum Physics"}], "author_count": 2, "first_author": {"full_name": "Bell, J.S.", "last_name": "Bell", "first_name": "J.S.", "recid": 1693288}, "control_number": 2793144, "dois": [{"value": "10.1017/cbo9780511815676"}], "earliest_date": "2004-06-03", "document_type": ["book"], "texkeys": ["Bell:2004gpx"], "abstracts": [{"value": "John Bell, FRS was one of the leading expositors and interpreters of modern quantum theory. He is particularly famous for his discovery of the crucial difference between the predictions of conventional quantum mechanics and the implications of local causality, a concept insisted on by Einstein. John Bell's work played a major role in the development of our current understanding of the profound nature of quantum concepts and of the fundamental limitations they impose on the applicability of the classical ideas of space, time and locality. This book includes all of John Bell's published and unpublished papers on the conceptual and philosophical problems of quantum mechanics, including two papers that appeared after the first edition was published. The book includes a short Preface written by the author for the first edition, and also an introduction by Alain Aspect that puts into context John Bell's enormous contribution to the quantum philosophy debate."}], "titles": [{"source": "submitter", "title": "Speakable and Unspeakable in Quantum Mechanics"}], "facet_author_name": ["1382220_Alain Aspect", "1693288_John Stewart Bell"], "core": false, "imprints": [{"date": "2004-06-03", "publisher": "Cambridge University Press"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:2793144", "updated": "2024-06-03T05:51:17.041967"}, "curated": false}, "id": "2793144", "links": {"bibtex": "https://inspirehep.net/api/literature/2793144?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/2793144?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/2793144?format=latex-us", "json": "https://inspirehep.net/api/literature/2793144?format=json", "json-expanded": "https://inspirehep.net/api/literature/2793144?format=json-expanded", "cv": "https://inspirehep.net/api/literature/2793144?format=cv", "citations": "https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2793144"}}, {"created": "1988-04-23T00:00:00+00:00", "updated": "2023-03-10T15:09:00.922351+00:00", "metadata": {"authors": [{"full_name_unicode_normalized": "bell, j.s.", "full_name": "Bell, J.S.", "record": {"$ref": "https://inspirehep.net/api/authors/1693288"}, "ids": [{"schema": "INSPIRE BAI", "value": "John.Stewart.Bell.1"}], "affiliations": [{"record": {"$ref": "https://inspirehep.net/api/institutions/902725"}, "value": "CERN"}], "last_name": "Bell", "signature_block": "BALj", "first_name": "J.S.", "uuid": "f74b0981-e0d9-4713-b9fe-0ade982de4cb", "recid": 1693288}], "publication_info": [{"pubinfo_freetext": "Cambridge, UK: Univ. Pr. (1987) 212 p"}], "citation_count": 19,