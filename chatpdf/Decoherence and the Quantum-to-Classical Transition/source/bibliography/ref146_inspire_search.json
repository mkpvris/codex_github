rsion": "20180611215416.0", "inspire_categories": [{"term": "Theory-HEP"}], "legacy_creation_date": "1992-11-20", "preprint_date": "1992-10", "author_count": 1, "urls": [{"description": "Fermilab Library Server (fulltext available)", "value": "https://lss.fnal.gov/archive/1992/pub/Pub-92-318-A.pdf"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/020hgte69"}, {"schema": "ROR", "value": "https://ror.org/041kmwe10"}], "full_name": "Albrecht, Andreas", "ids": [{"schema": "ORCID", "value": "0000-0001-9829-5211"}], "last_name": "Albrecht", "first_name": "Andreas", "recid": 1018733}, "control_number": 340532, "dois": [{"value": "10.1103/PhysRevD.48.3768"}], "earliest_date": "1992-10", "document_type": ["article"], "texkeys": ["Albrecht:1992uc"], "abstracts": [{"source": "Desy", "value": "I study the quantum mechanics of a spin interacting with an ``apparatus''. Although the evolution of the whole system is unitary, the spin evolution is not. The system is chosen so that the spin exhibits loss of quantum coherence, or ``wavefunction collapse'', of the sort usually associated with a quantum measurement. The system is analyzed from the point of view of the spin density matrix (or ``Schmidt paths''), and also using the consistent histories approach. These two points of view are contrasted with each other. Connections between the results and the form of the Hamiltonian are discussed in detail.", "abstract_source_suggest": {"input": "Desy"}}], "refereed": true, "primary_arxiv_category": ["hep-th"], "external_system_identifiers": [{"schema": "MSNET", "value": "1242525"}, {"schema": "OSTI", "value": "6200853"}, {"schema": "ADS", "value": "1993PhRvD..48.3768A"}, {"schema": "KEKSCAN", "value": "92-12-446"}, {"schema": "SPIRES", "value": "SPIRES-2648199"}], "titles": [{"title": "Following a 'collapsing' wave function"}], "facet_author_name": ["1018733_Andreas Johann Albrecht"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:340532", "updated": "2026-02-06T09:28:25.512160"}, "curated": true, "journal_title_variants": ["Phys. Rev. D", "Phys.Rev.D"], "arxiv_eprints": [{"categories": ["hep-th"], "value": "hep-th/9309051"}]}, "id": "340532", "created": "1992-11-20T00:00:00+00:00", "updated": "2026-02-06T09:28:25.512160+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevd.48.3768&size=5&page=1&format=cv"}}