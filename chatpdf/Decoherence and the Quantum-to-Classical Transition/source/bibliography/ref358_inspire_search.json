erature/2794305"}}, {"reference": {"label": "26", "misc": ["in preparation. 17"], "authors": [{"full_name": "Miquel, C."}, {"full_name": "Paz, J.P."}, {"full_name": "Perazzo, R."}]}}], "number_of_pages": 26, "referenced_authors_bais": ["B.Charles.H.1", "T.Sleator.1", "I.L.Chuang.1", "W.H.Zurek.1", "M.B.Plenio.1", "B.Schumacher.1", "P.W.Shor.1", "S.Popescu.2", "A.Barenco.1", "J.I.Cirac.1", "R.Laflamme.1", "N.Margolus.1", "R.Cleve.1", "W.K.Wootters.1", "J.A.Smolin.1", "P.Zoller.1", "H.Weinfurter.1", "D.P.DiVincenzo.1", "G.Brassard.1", "C.H.Bennett.1", "Y.Yamamoto.1", "Peter.Knight.1", "W.G.Unruh.1"], "legacy_version": "20150616111438.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1996-01-24", "preprint_date": "1996-01", "author_count": 3, "public_notes": [{"source": "arXiv", "value": "plain tex, 18 pages, 8 postscript figures"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/0081fs513"}], "full_name": "Miquel, Cesar", "last_name": "Miquel", "first_name": "Cesar", "recid": 1032660}, "control_number": 415447, "dois": [{"source": "ADS", "value": "10.1103/PhysRevA.54.2605"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevA.54.2605"}], "earliest_date": "1996-01", "document_type": ["article"], "texkeys": ["Miquel:1996mm"], "abstracts": [{"value": "We describe an array of quantum gates implementing Shor's algorithm for prime factorization in a quantum computer. The array includes a circuit for modular exponentiation with several subcomponents (such as controlled multipliers, adders, etc) which are described in terms of elementary Toffoli gates. We present a simple analysis of the impact of losses and decoherence on the performance of this quantum factoring circuit. For that purpose, we simulate a quantum computer which is running the program to factor N = 15 while interacting with a dissipative environment. As a consequence of this interaction randomly selected qubits may spontaneously decay. Using the results of our numerical simulations we analyze the efficiency of some simple error correction techniques."}, {"source": "arXiv", "value": "We describe an array of quantum gates implementing Shor's algorithm for prime factorization in a quantum computer. The array includes a circuit for modular exponentiation with several subcomponents (such as controlled multipliers, adders, etc) which are described in terms of elementary Toffoli gates. We present a simple analysis of the impact of losses and decoherence on the performance of this quantum factoring circuit. For that purpose, we simulate a quantum computer which is running the program to factor N = 15 while interacting with a dissipative environment. As a consequence of this interaction randomly selected qubits may spontaneously decay. Using the results of our numerical simulations we analyze the efficiency of some simple error correction techniques.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "1996PhRvA..54.2605M"}, {"schema": "SPIRES", "value": "SPIRES-3291723"}], "titles": [{"title": "Factoring in a dissipative quantum computer"}, {"source": "arXiv", "title": "Factoring in a Dissipative Quantum Computer"}], "facet_author_name": ["2281891_R.P.J. Perazzo", "993991_Juan Pablo Paz", "1032660_César Miquel-Espanya"], "core": true, "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:415447", "updated": "2025-10-01T10:34:39.679476"}, "curated": true, "journal_title_variants": ["Phys.Rev.A", "Phys. Rev. A"], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9601021"}]}, "created": "1996-01-24T00:00:00+00:00", "updated": "2025-10-01T10:34:39.679476+00:00"}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysreva.54.2605&size=5&page=1", "bibtex": "https://insp