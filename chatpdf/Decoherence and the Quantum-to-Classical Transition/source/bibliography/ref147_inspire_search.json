": {"arxiv_eprint": "gr-qc/9311022", "publication_info": {"journal_volume": "50", "artid": "5093", "page_start": "5093", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/36444"}}, {"reference": {"publication_info": {"journal_volume": "23", "artid": "927", "page_start": "927", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/9946"}}, {"reference": {"publication_info": {"journal_volume": "131", "artid": "2766", "page_start": "2766", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/9024"}}, {"reference": {"publication_info": {"journal_volume": "1", "artid": "3217", "page_start": "3217", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/54984"}}, {"reference": {"publication_info": {"journal_volume": "19", "artid": "1669", "page_start": "1669", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/145817"}}, {"reference": {"publication_info": {"journal_volume": "79", "artid": "150", "page_start": "150", "journal_title": "Phys.Lett.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/159151"}}], "number_of_pages": 15, "referenced_authors_bais": ["V.I.Manko.3", "M.Mijic.1", "J.A.Wheeler.1", "H.A.Feldman.1", "Alexander.Vilenkin.1", "W.G.Unruh.1", "R.H.Brandenberger.1", "T.Padmanabhan.1", "V.P.Gutschick.1", "W.H.Zurek.1", "J.E.Moyal.1", "E.Calzetta.1", "C.Kiefer.1", "J.Louko.1", "E.V.Kurmyshev.1", "A.Higuchi.1", "A.Anderson.6", "R.Laflamme.1", "R.Camporesi.1", "Salman.Habib.1", "Aleksandr.Y.Kamenshchik.1", "R.J.Glauber.1", "G.A.Hagedorn.1", "F.Mellor.1", "M.Morikawa.1", "V.Dodonov.2", "J.n.Hollenhorst.1", "Stephen.W.Hawking.1", "L.M.Simmons.1", "S.Wada.4", "H.D.Zeh.1", "J.J.Halliwell.1", "J.B.Hartle.1", "R.Omnes.1", "A.I.Zelnikov.1", "M.M.Nieto.1", "Andrei.O.Barvinsky.1", "Hugh.Everett.1", "A.Albrecht.1", "Eugene.P.Wigner.1", "D.Deutsch.1", "D.Stoler.1", "E.Schrodinger.1", "F.D.Mazzitelli.1", "R.B.Griffiths.1"], "legacy_version": "20180204165812.0", "legacy_creation_date": "1996-04-07", "preprint_date": "1995", "author_count": 2, "first_author": {"full_name": "Barvinsky, A.O.", "last_name": "Barvinsky", "first_name": "A.O.", "recid": 1017200}, "control_number": 405819, "dois": [{"value": "10.1103/PhysRevD.52.743"}], "earliest_date": "1995", "document_type": ["article"], "texkeys": ["Barvinsky:1995va"], "abstracts": [{"source": "APS", "value": "We revive an old proposal of Zeh for the preferred basis in the many-worlds interpretation of quantum mechanics. The algorithm for the basis reduces to the eigenvalue problems for density matrices of subsystems forming the whole system under consideration. We generalize this procedure to the case of degenerate eigenvalues of reduced density matrices. A semiclassical calculational method for these eigenvalues is developed and applied to some model problems. The classical properties of elements of the preferred basis are investigated. It is shown that classicality exists only in some part of many-worlds branches. Moreover, it depends crucially on the initial conditions and Hamiltonians and under some circumstances turns out to be a temporary phenomenon. Applications of the preferred-basis proposal to quantum cosmology are discussed. The relation between the preferred-basis approach and quantum-histories approach is discussed.", "abstract_source_suggest": {"input": "APS"}}], "refereed": true, "external_system_identifiers": [{"schema": "ADS", "value": "1995PhRvD..52..743B"}, {"schema": "SPIRES", "value": "SPIRES-3333850"}, {"schema": "MSNET", "value": "1344153"}], "titles": [{"title": "Preferred basis in quantum theory and the problem of classicalization of the quantum universe"}], "facet_author_name": ["1017200_Andrei O. Barvinsky