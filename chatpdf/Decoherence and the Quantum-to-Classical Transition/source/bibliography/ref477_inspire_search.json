int": "quant-ph/0211102"}, "record": {"$ref": "https://inspirehep.net/api/literature/2990148"}}, {"reference": {"publication_info": {"journal_volume": "63", "artid": "013808", "journal_title": "Phys.Rev.A"}}, "record": {"$ref": "https://inspirehep.net/api/literature/2988537"}}, {"reference": {"publication_info": {"journal_volume": "70", "artid": "137", "page_start": "137", "journal_title": "Rev.Sci.Instrum."}}}, {"reference": {"publication_info": {"journal_volume": "3", "artid": "2000", "page_start": "2000", "journal_title": "Living Rev.Rel."}}}, {"reference": {"publication_info": {"journal_volume": "65", "artid": "1317", "page_start": "1317", "journal_title": "Phys.Rev.Lett."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/298850"}}, {"reference": {"publication_info": {"journal_volume": "120", "artid": "121", "page_start": "121", "journal_title": "J.Low Temp.Phys."}}}, {"reference": {"publication_info": {"journal_volume": "77", "artid": "3860", "page_start": "3860", "journal_title": "Appl.Phys.Lett."}}}], "number_of_pages": 5, "referenced_authors_bais": ["Seth.Lloyd.1", "X.Fei.1", "Sougato.Bose.1", "D.F.Walls.1", "T.Weber.6", "A.D.Armour.1", "Jun.Ye.1", "M.Pinard.2", "W.H.Zurek.1", "R.Graham.1", "M.J.Collett.1", "J.Ruostekoski.2", "K.Jacobs.2", "M.P.Blencowe.1", "L.Ribichini.1", "C.J.P.M.Harmans.1", "K.C.Law.1", "J.I.Cirac.1", "L.A.Orozco.1", "A.C.J.ter.Haar.1", "P.Zoller.1", "J.E.Mooij.1", "D.I.Fivel.1", "H.Kalinowsky.6", "Pierre.Francois.Cohadon.1", "P.M.Pearle.1", "W.Kells.10", "C.J.Hood.1", "P.Tombesi.2", "K.Moelmer.1", "Gabriele.Gabrielse.1", "D.Vitali.2", "S.Mancini.1", "F.K.WilhelmMauch.1", "T.Briant.2", "J.M.Courty.1", "G.C.Ghirardi.1", "H.J.Kimble.1", "E.Schrodinger.1", "C.H.van.der.Wal.1", "T.P.Orlando.1", "A.Rimini.2", "Antoine.Heidmann.1", "R.L.Tjoelker.1", "V.I.Manko.3", "M.Lewenstein.1", "J.Haas.2", "T.A.Trainor.1", "R.N.Schouten.1", "K.C.Schwab.1", "Peter.Knight.1"], "figures": [{"filename": "Fig1.png", "material": "preprint", "caption": "The proposed setup: a Michelson interferometer for a single photon, where in each arm there is a high-finesse cavity. The cavity in arm A has a very small end mirror mounted on a micro-mechanical oscillator. The single photon comes in through I. If the photon is in arm A, the motion of the small mirror is affected by its radiation pressure. The photon later leaks out of either cavity and is detected at D1 or D2.", "label": "setup", "source": "arxiv", "key": "2b3c6e40cdf4ffabe7a264fd800663f0", "url": "https://inspirehep.net/files/2b3c6e40cdf4ffabe7a264fd800663f0"}, {"filename": "Fig2.png", "material": "preprint", "caption": "Time evolution of the interference visibility of the photon over one period of the mirror's motion for $\\kappa=1$, $T=1$mK and $T=60 \\mu$K. The time is given in units of $1/\\omega_m$. The visibility decays very fast after $t=0$, but in the absence of decoherence there is a sharp revival of the visibility after a full period. The width of each peak scales like $1/\\sqrt{T}$.", "label": "peak", "source": "arxiv", "key": "69da6a406355e780570a6893c92d0532", "url": "https://inspirehep.net/files/69da6a406355e780570a6893c92d0532"}], "legacy_version": "20200526184437.0", "inspire_categories": [{"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2006-11-13", "preprint_date": "2002-09-30", "author_count": 4, "public_notes": [{"source": "arXiv", "value": "5 pages, 2 figures, submitted to Phys. Rev. Lett"}], "first_author": {"full_name": "Marshall, William", "last_name": "Marshall", "first_name": "William", "recid": 2285258}, "control_number": 640476, "dois": [{"value": "10.1103/PhysRevLett.91.130401"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.91.130401"}], "earliest_date": "2002-09-30", "document_type": ["article"], "texkeys": ["Marshall:2002exi", "Marshall:2003dj"], "abstracts": [{"source": "APS", "value": "We propose an experiment for creating quantum superposition states involving of the order of 1014 atoms via the interaction of a single photon with a tiny mirror. This mirror, mounted on a high-quality mechanical oscillator, is part of a high-finesse optical cavity which forms one arm of a Michelson interferometer. By observing the interference of the photon only, one can study the creation and decoherence of superpositions involving the mirror. A detailed analysis of the requirements shows that the experiment is within reach using a combination of state-of-the-art technologies.", "abstract_source_suggest": {"input": "APS"}}, {"source": "arXiv", "value": "We propose a scheme for creating quantum superposition states involving of order $10^{14}$ atoms via the interaction of a single photon with a tiny mirror. This mirror, mounted on a high-quality mechanical oscillator, is part of a high-finesse optical cavity which forms one arm of a Michelson interferometer. By observing the interference of the photon only, one can study the creation and decoherence of superpositions involving the mirror. All experimental requirements appear to be within reach of current technology.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-6976182"}, {"schema": "MSNET", "value": "2036434"}], "titles": [{"title": "Towards quantum superpositions of a mirror"}, {"source": "arXiv", "title": "Towards quantum superpositions of a mirror"}], "facet_author_name": ["1948138_Christoph Simon", "2285258_Trevor W. Marshall", "993859_Sir Roger Penrose", "1259132_Dirk Bouwmeester"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:640476", "updated": "2026-02-06T10:00:05.008970"}, "curated": true, "journal_title_variants": ["Phys. Rev. Lett.", "Phys.Rev.Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/0210001"}]}}], "total": 1}, "links": {"self": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1", "bibtex": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=latex-us", "json": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=json", "json-expanded": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=json-expanded", "cv": "https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.91.130401&size=5&page=1&format=cv"}}