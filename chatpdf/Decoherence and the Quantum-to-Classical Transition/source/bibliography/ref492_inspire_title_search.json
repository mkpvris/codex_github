 "A.Crisanti.1", "M.Falcioni.2", "A.Vulpiani.2", "B.Nachtergaele.1", "M.Fannes.1", "S.Pigolotti.1", "M.O.Scully.1", "S.A.Olivares.Pino.1", "M.Frasca.1", "Massimo.Falcioni.1", "P.Tombesi.2", "L.Van.Hove.1", "H.Narnhofer.1", "R.F.Werner.1", "R.Bonifacio.3", "D.Vitali.2", "I.S.Gomez.1", "Alain.Connes.1", "M.Castagnino.1", "F.Benatti.1", "V.Cappellini.1", "G.Mantica.1", "Eugene.P.Wigner.1", "Robert.F.OConnell.1"], "figures": [{"filename": "Fig1.png", "material": "preprint", "caption": "\\small{Figure 1.A. The domains and the frontier. $\\Delta x\\Delta p=\\frac{1}{2}\\hbar$. Figure 1.B A cell decomposed in small square boxes.}", "label": "f1", "source": "arxiv", "key": "1be641095a0e7aeb214abb6b0cabaff7", "url": "https://inspirehep.net/files/1be641095a0e7aeb214abb6b0cabaff7"}, {"filename": "Fig2.png", "material": "preprint", "caption": "\\small{Evolution of a cell with constant velocity.}", "label": "f2", "source": "arxiv", "key": "2b28e0e21fd71ecb4b272abea40f3e74", "url": "https://inspirehep.net/files/2b28e0e21fd71ecb4b272abea40f3e74"}, {"filename": "Fig3.png", "material": "preprint", "caption": "\\small{Evolution of the cell with linear velocity.}", "label": "f3", "source": "arxiv", "key": "9ead6b405b39af8eb780b13e6c982044", "url": "https://inspirehep.net/files/9ead6b405b39af8eb780b13e6c982044"}, {"filename": "Fig4.png", "material": "preprint", "caption": "\\small{Evolution of the cell with non linear velocity.}", "label": "f4", "source": "arxiv", "key": "7ee1704df0c2fe1d2ba62e9b6cf3feaf", "url": "https://inspirehep.net/files/7ee1704df0c2fe1d2ba62e9b6cf3feaf"}, {"filename": "Fig5.png", "material": "preprint", "caption": "\\small{Evolution of the cell with periodical velocity.}", "label": "f5", "source": "arxiv", "key": "e3df81b23076b806142db7f7b1c80ef8", "url": "https://inspirehep.net/files/e3df81b23076b806142db7f7b1c80ef8"}, {"filename": "Fig6.png", "material": "preprint", "caption": "\\small{Figure 6A. A square cell scattered by a frontier. Figure 6B. A square cell becomes an ameoboidal cell.}", "label": "f6", "source": "arxiv", "key": "0012dae0fc0d14913acfa7e769bc80e5", "url": "https://inspirehep.net/files/0012dae0fc0d14913acfa7e769bc80e5"}], "legacy_version": "20200505083757.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2014-09-02", "preprint_date": "2010-09-27", "author_count": 2, "public_notes": [{"source": "arXiv", "value": "27 pages, 6 figures"}], "first_author": {"full_name": "Gomez, Ignacio", "last_name": "Gomez", "first_name": "Ignacio", "recid": 1889262}, "control_number": 1313433, "dois": [{"source": "Elsevier", "value": "10.1016/j.chaos.2014.07.008"}, {"value": "10.1016/j.chaos.2014.07.008"}, {"material": "publication", "source": "arXiv", "value": "10.1016/j.chaos.2014.07.008"}], "earliest_date": "2010-09-27", "document_type": ["article"], "texkeys": ["Gomez:2010ynq", "Gomez:2014rya"], "abstracts": [{"source": "Elsevier", "value": "The aim of this paper is to review the classical limit of Quantum Mechanics and to precise the well known threat of chaos (and fundamental graininess) to the correspondence principle. We will introduce a formalism for this classical limit that allows us to find the surfaces defined by the constants of the motion in phase space. Then in the integrable case we will find the classical trajectories, and in the non-integrable one the fact that regular initial cells become “amoeboid-like”. This deformations and their consequences can be considered as a threat to the correspondence principle unless we take into account the characteristic timescales of quantum chaos. Essentially we present an analysis of the problem similar to the one of Omnès (1994,1999), but with a simpler mathematical structure.", "abstract_source_suggest": {"input": "Elsevier"}}, {"source": "arXiv", "value": "The aim of this paper is to review the classical limit of Quantum Mechanics and to precise the well known threat of chaos (and fundamental graininess)to the correspondence principle. We will introduce a formalism for this classical limit that allows us to find the surfaces defined by the constants of the motion in phase space. Then in the integrable case we will find the classical trajectories, and in the non-integrable one the fact that regular initial cells become \"amoeboid-like\". This deformations and their consequences can be considered as a threat to the correspondence principle unless we take into account the characteristic timescales of quantum chaos. Essentially we present an analysis of the problem similar to the one of Omnès [10,11], but with a simpler mathematical structure.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "2014CSF....68...98G"}, {"schema": "MSNET", "value": "3260200"}], "titles": [{"title": "On the classical limit of quantum mechanics, fundamental graininess and chaos: Compatibility of chaos with the correspondence principle"}, {"source": "arXiv", "title": "On the classical limit of quantum mechanics, fundamental graininess and chaos: compatibility of chaos with the correspondence principle"}], "publication_type": ["review"], "facet_author_name": ["1889262_Ignacio S. Gomez", "1014317_Mario Castagnino"], "license": [{"imposing": "arXiv", "url": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}, {"license": "arXiv nonexclusive-distrib 1.0", "material": "preprint", "url": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "imprints": [{"date": "2014-07-23"}], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:1313433", "updated": "2025-10-03T07:47:37.311242"}, "curated": false, "journal_title_variants": ["Chaos Solitons Fractals"], "arxiv_eprints": [{"categories": ["quant-ph", "math-ph", "math.MP"], "value": "1009.5267"}]}, "updated": "2025-10-03T07:47:37.311242+00:00", "created": "2014-09-02T00:00:00+00:00"}], "total": 2}, "links": {"s