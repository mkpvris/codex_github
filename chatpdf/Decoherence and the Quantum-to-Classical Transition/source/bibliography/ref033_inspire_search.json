lation": false, "record": {"$ref": "https://inspirehep.net/api/literature/54978"}}, {"reference": {"publication_info": {"journal_volume": "38", "artid": "38", "page_start": "38", "journal_title": "Phys.Today"}}}, {"reference": {"publication_info": {"journal_volume": "9", "artid": "1", "page_start": "1", "journal_title": "Comput.Math.Appl."}}}], "number_of_pages": 5, "referenced_authors_bais": ["H.Zbinden.3", "A.Shimony.1", "J.Brendel.1", "B.Gisin.1", "P.R.Tapster.1", "John.F.Clauser.1", "S.J.Freedman.1", "T.Herzog.1", "P.Kwiat.1", "M.A.Horne.1", "B.Podolsky.1", "A.Y.Shih.1", "Nathan.Rosen.1", "N.Gisin.1", "R.A.Holt.2", "W.Tittel.1", "P.C.M.Owens.1", "G.Roger.1", "Alain.Aspect.1", "H.Weinfurter.1", "Albert.Einstein.1", "A.V.Sergienko.1", "A.Zeilinger.1", "K.Mattle.1", "P.M.Pearle.1", "J.G.Rarity.1", "J.Dalibard.1"], "legacy_version": "20160616173436.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "1998-10-27", "preprint_date": "1998-10", "author_count": 5, "public_notes": [{"source": "arXiv", "value": "5 pages, 3 figures, accepted for publication in Phys. Rev. Lett.; find photographs and experimental data at http://www.quantum.at"}], "first_author": {"full_name": "Weihs, Gregor", "last_name": "Weihs", "first_name": "Gregor", "recid": 2029076}, "control_number": 478453, "dois": [{"value": "10.1103/PhysRevLett.81.5039"}, {"material": "publication", "source": "arXiv", "value": "10.1103/PhysRevLett.81.5039"}], "earliest_date": "1998-10", "document_type": ["article"], "texkeys": ["Weihs:1998gy"], "abstracts": [{"value": "We observe strong violation of Bell's inequality in an Einstein, Podolsky and Rosen type experiment with independent observers. Our experiment definitely implements the ideas behind the well known work by Aspect et al. We for the first time fully enforce the condition of locality, a central assumption in the derivation of Bell's theorem. The necessary space-like separation of the observations is achieved by sufficient physical distance between the measurement stations, by ultra-fast and random setting of the analyzers, and by completely independent data registration."}, {"source": "arXiv", "value": "We observe strong violation of Bell's inequality in an Einstein, Podolsky and Rosen type experiment with independent observers. Our experiment definitely implements the ideas behind the well known work by Aspect et al. We for the first time fully enforce the condition of locality, a central assumption in the derivation of Bell's theorem. The necessary space-like separation of the observations is achieved by sufficient physical distance between the measurement stations, by ultra-fast and random setting of the analyzers, and by completely independent data registration.", "abstract_source_suggest": {"input": "arXiv"}}], "refereed": true, "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "ADS", "value": "1998PhRvL..81.5039W"}, {"schema": "SPIRES", "value": "SPIRES-3878155"}, {"schema": "MSNET", "value": "1658032"}], "titles": [{"title": "Violation of Bell's inequality under strict Einstein locality conditions"}, {"source": "arXiv", "title": "Violation of Bell's inequality under strict Einstein locality conditions"}], "facet_author_name": ["1917639_Thomas Jennewein", "1956906_Harald Weinfurter", "1948138_Christoph Simon", "2029076_G. Weihs", "1693289_Anton Zeilinger"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:478453", "updated": "2025-10-01T10:44:49.473950"}, "curated": true, "journal_title_variants": ["Phys.Rev.Lett.", "Phys. Rev. Lett."], "arxiv_eprints": [{"categories": ["quant-ph"], "value": "quant-ph/9810080"}]}, "created": "1998-10-27T00:00:00+00:00", "updated": "2025-10-01T10:44:49.473950+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/478453?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/478453?format=latex-eu", "latex-us": "https://inspirehep.net/ap