27", "artid": "2885", "page_start": "2885", "journal_title": "Phys.Rev.D"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/13239"}}, {"reference": {"publication_info": {"journal_volume": "126", "artid": "1864", "page_start": "1864", "journal_title": "Phys.Rev."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/46915"}}, {"reference": {"publication_info": {"journal_volume": "116", "artid": "9", "page_start": "9", "journal_title": "Phys.Lett.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/232862"}}, {"reference": {"publication_info": {"journal_volume": "126", "artid": "311", "page_start": "311", "journal_title": "Phys.Lett.A"}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/250130"}}, {"reference": {"publication_info": {"journal_volume": "29", "artid": "463", "page_start": "463", "journal_title": "Rev.Mod.Phys."}}, "curated_relation": false, "record": {"$ref": "https://inspirehep.net/api/literature/47045"}}], "number_of_pages": 21, "referenced_authors_bais": ["S.Haroche.1", "T.Weber.6", "W.H.Zurek.1", "A.A.Starobinsky.1", "C.Kiefer.1", "D.N.Page.1", "Lucien.Hardy.1", "J.M.Raimond.1", "W.K.Wootters.1", "Freeman.J.Dyson.1", "P.M.Pearle.1", "M.Brune.1", "E.Joos.1", "E.Hagley.1", "R.F.Baierlein.1", "D.Polarski.1", "X.Maitre.1", "C.Wunderlich.2", "H.D.Zeh.1", "A.Maali.1", "D.H.Sharp.1", "J.E.Griffin.1", "G.C.Ghirardi.1", "A.Rimini.2", "R.B.Griffiths.1", "M.Tegmark.1", "G.C.Hegerfeldt.1", "J.A.Wheeler.1", "J.Dreyer.1", "B.S.DeWitt.1"], "legacy_version": "20190508154121.0", "inspire_categories": [{"term": "General Physics"}, {"term": "Quantum Physics", "source": "arxiv"}], "legacy_creation_date": "2002-04-18", "preprint_date": "2002-04", "author_count": 1, "public_notes": [{"value": "Invited chapter for Science and Ultimate Reality, a forthcoming book in honor of John Archibald Wheeler on occasion of his 90th birthday"}, {"source": "arXiv", "value": "Several comments added, in particular regarding the role of a \"second\" quantization and concerning some recently proposed cosmological models. -- 21 pages, Latex"}], "first_author": {"affiliations_identifiers": [{"schema": "ROR", "value": "https://ror.org/038t36y30"}], "full_name": "Zeh, H.D.", "last_name": "Zeh", "first_name": "H.D.", "recid": 982291}, "control_number": 585565, "earliest_date": "2002-04", "document_type": ["article"], "texkeys": ["Zeh:2002ay"], "abstracts": [{"value": "Schroedinger's wave function shows many aspects of a state of incomplete knowledge or information (bit): (1) it is usually defined on a space of classical configurations, (2) its generic entanglement is, therefore, analogous to statistical correlations, and (3) it determines probabilities of measurement outcomes. Nonetheless, quantum superpositions (such as represented by a wave function) define individual physical states (it). This conceptual dilemma may have its origin in the conventional operational foundation of physical concepts, successful in classical physics, but inappropriate in quantum theory because of the existence of mutually exclusive operations (used for the definition of concepts). In contrast, a hypothetical realism, based on concepts that are justified only by their universal and consistent applicability, favors the wave function as a description of (thus nonlocal) physical reality. The (conceptually local) classical world then appears as an illusion, facilitated by the phenomenon of decoherence, which is consistently explained by the very entanglement that must dynamically arise in a universal wave function."}, {"source": "arXiv", "value": "Schroedinger's wave function shows many aspects of a state of incomplete knowledge or information (\"bit\"): (1) it is usually defined on a space of classical configurations, (2) its generic entanglement is, therefore, analogous to statistical correlations, and (3) it determines probabilities of measurement outcomes. Nonetheless, quantum superpositions (such as represented by a wave function) define individual physical states (\"it\"). This conceptual dilemma may have its origin in the conventional operational foundation of physical concepts, successful in classical physics, but inappropriate in quantum theory because of the existence of mutually exclusive operations (used for the definition of concepts). In contrast, a hypothetical realism, based on concepts that are justified only by their universal and consistent applicability, favors the wave function as a description of (thus nonlocal) physical reality. The (conceptually local) classical world then appears as an illusion, facilitated by the phenomenon of decoherence, which is consistently explained by the very entanglement that must dynamically arise in a universal wave function.", "abstract_source_suggest": {"input": "arXiv"}}], "primary_arxiv_category": ["quant-ph"], "external_system_identifiers": [{"schema": "SPIRES", "value": "SPIRES-4907752"}], "titles": [{"title": "The Wave function: It or bit?"}, {"source": "arXiv", "title": "The Wave function: It or bit?"}, {"source": "arXiv", "title": "The Wave Function: It or Bit?"}], "facet_author_name": ["982291_H.Dieter Zeh"], "_oai": {"sets": ["Literature"], "id": "oai:inspirehep.net:585565", "updated": "2025-09-30T13:47:05.262185"}, "curated": true, "arxiv_eprints": [{"categories": ["quant-ph", "gr-qc", "physics.ed-ph", "physics.pop-ph"], "value": "quant-ph/0204088"}]}, "id": "585565", "updated": "2025-09-30T13:47:05.262185+00:00", "created": "2002-04-18T00:00:00+00:00", "links": {"bibtex": "https://inspirehep.net/api/literature/585565?format=bibtex", "latex-eu": "https://inspirehep.net/api/literature/585565?format=latex-eu", "latex-us": "https://inspirehep.net/api/literature/585565?format=latex-us", "json": "https://inspirehep.net/api/literature/585565?format=json", "json-expanded": "https://inspirehep.net/api/literature/585565?format=json-expanded", 