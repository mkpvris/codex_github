rink, L."},{"full_name":"Nielsen, H.B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/84904"}},{"reference":{"label":"5","publication_info":{"journal_volume":"177","artid":"2309","year":1969,"page_start":"2309","journal_title":"Phys.Rev."},"authors":[{"full_name":"Virasoro, M.A."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/55637"}},{"reference":{"label":"5","publication_info":{"journal_volume":"33","artid":"361","year":1970,"page_start":"361","journal_title":"Phys.Lett.B"},"authors":[{"full_name":"Shapiro, J."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/63048"}},{"reference":{"label":"6","publication_info":{"journal_volume":"31","artid":"86","year":1971,"page_start":"86","journal_title":"Nucl.Phys.B"},"authors":[{"full_name":"Neveu, A."},{"full_name":"Schwarz, J.H."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/67206"}},{"reference":{"label":"6","publication_info":{"journal_volume":"35","artid":"529","year":1971,"page_start":"529","journal_title":"Phys.Lett.B"},"authors":[{"full_name":"Neveu, A."},{"full_name":"Schwarz, J.H."},{"full_name":"Thorn, C.B."}]},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/68388"}}],"number_of_pages":5,"legacy_creation_date":"1986-05-12","preprint_date":"1986","author_count":2,"earliest_date":"1973","refereed":true,"external_system_identifiers":[{"schema":"OSTI","value":"4447815"},{"schema":"ADS","value":"1973PhLB...45..332B"},{"schema":"CDS","value":"880654"},{"schema":"SPIRES","value":"SPIRES-1499777"}],"facet_author_name":["995679_Holger Bech Nielsen","1015291_Lars Brink"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:228663","updated":"2023-03-10T14:34:10.169913"},"journal_title_variants":["Phys. Lett. B","Phys.Lett.B"],"referenced_authors_bais":["John.H.Schwarz.1","A.Neveu.1","E.Cremmer.1","C.Lovelace.1","H.B.Nielsen.1","J.Scherk.1","Charles.B.Thorn.1","M.A.Virasoro.1","Richard.C.Brower.1","J.A.Shapiro.1","Peter.Goddard.1","L.Brink.1"],"legacy_version":"20180203112700.0","inspire_categories":[{"term":"General Physics","source":"curator"},{"term":"Phenomenology-HEP","source":"curator"}],"first_author":{"full_name":"Brink, L.","last_name":"Brink","first_name":"L.","recid":1015291},"control_number":228663,"dois":[{"value":"10.1016/0370-2693(73)90048-8"}],"document_type":["article"],"texkeys":["Brink:1973oxp","Brink:1986ja"],"abstracts":[{"source":"Elsevier","value":"The energy due to zero point fluctuations of the dual string is calculated and shown to be divergent. We make it finite by introducing a cut-off. The result is non-covariant but invariant under reparametrization, so one has to modify the classical Lagrangian so as to get a covariant result. It is then shown that this leads to the well-known relation relating the mass squared of the lowest state to the number of dimensions space-time. This result is independent of the cut-off and shows clearly the physical significance of the critical dimension of space-time. Similar considerations for the Neveu-Schwarz model are also discussed.","abstract_source_suggest":{"input":"Elsevier"}}],"titles":[{"title":"A Simple Physical Interpretation of the Critical Dimension of Space-Time in Dual Models"}],"imprints":[{"date":"1973"}],"curated":true},"updated":"2023-03-10T14:34:10.169913+00:00","created":"1986-05-12T00:00:00+00:00","id":"228663"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0370-2693%2873%2990048-8&size=15&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0370-2693%2873%2990048-8&size=15&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0370-2693%2873%2990048-8&size=15&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0370-2693%2873%2990048-8&size=15&page=1&format=latex-us","json":"h