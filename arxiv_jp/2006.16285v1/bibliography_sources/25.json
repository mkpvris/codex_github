    "abstracts": [
      {
        "value": "Astronomical observations indicate that the cosmological constant is many orders of magnitude smaller than estimated in modern theories of elementary particles. After a brief review of the history of this problem, five different approaches to its solution are described.",
        "source": "APS"
      }
