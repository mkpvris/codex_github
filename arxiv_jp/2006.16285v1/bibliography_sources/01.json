{"metadata":{"citation_count_without_self_citations":370,"publication_info":[{"year":2007}],"citation_count":370,"core":true,"dois":[{"value":"10.1017/CBO9780511813917"}],"isbns":[{"value":"9780521864497","medium":"print"},{"value":"9780511267208","medium":"online"}],"titles":[{"title":"Quantum field theory"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"5df406e3-b08c-41cd-aaf5-99a1d75fdf40","record":{"$ref":"https://inspirehep.net/api/authors/987829"},"full_name":"Srednicki, M.","affiliations":[{"value":"UC, Santa Barbara","record":{"$ref":"https://inspirehep.net/api/institutions/903307"}}],"signature_block":"SRADNACm","raw_affiliations":[{"value":"University of California, Santa Barbara"}]}],"curated":true,"texkeys":["Srednicki:2007qs"],"imprints":[{"date":"2007-01-25","publisher":"Cambridge University Press"}],"keywords":[{"value":"book","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"quantization","schema":"INSPIRE"},{"value":"quantum mechanics","schema":"INSPIRE"},{"value":"Feynman graph","schema":"INSPIRE"},{"value":"path integral","schema":"INSPIRE"},{"value":"renormalization","schema":"INSPIRE"},{"value":"spinor","schema":"INSPIRE"},{"value":"spin: 1/2","schema":"INSPIRE"},{"value":"spin: 1","schema":"INSPIRE"},{"value":"gauge field theory","schema":"INSPIRE"},{"value":"spontaneous symmetry breaking","schema":"INSPIRE"},{"value":"supersymmetry","schema":"INSPIRE"}],"abstracts":[{"value":"Quantum field theory is the basic mathematical framework that is used to describe elementary particles. This textbook provides a complete and essential introduction to the subject. Assuming only an undergraduate knowledge of quantum mechanics and special relativity, this book is ideal for graduate students beginning the study of elementary particles. The step-by-step presentation begins with basic concepts illustrated by simple examples, and proceeds through historically important results to thorough treatments of modern topics such as the renormalization group, spinor-helicity methods for quark and gluon scattering, magnetic monopoles, instantons, supersymmetry, and the unification of forces. The book is written in a modular format, with each chapter as self-contained as possible, and with the necessary prerequisite material clearly identified. It is based on a year-long course given by the author and contains extensive problems, with password protected solutions available to lecturers at www.cambridge.org/9780521864497.","source":"Cambridge University Press"}],"document_type":["book"],"preprint_date":"2007","control_number":752478,"legacy_version":"20150727111256.0","number_of_pages":660,"inspire_categories":[{"term":"Theory-HEP"}],"legacy_creation_date":"2007-06-07","external_system_identifiers":[{"value":"SPIRES-7209290","schema":"SPIRES"}]},"created":"2007-06-07T00:00:00+00:00","id":"752478","updated":"2024-04-16T14:21:11.067625+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/752478?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/752478?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/752478?format=latex-us","json":"https://inspirehep.net/api/literature/752478?format=json","json-expanded":"https://inspirehep.net/api/literature/752478?format=json-expanded","cv":"https://inspirehep.net/api/literature/752478?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A752478"},"uuid":"ed7362a7-173b-46e6-97cd-8b16b8d5bc6d","revision_id":90}