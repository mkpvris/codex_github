    "refereed": true,
    "abstracts": [
      {
        "value": "I show how to organize the coefficients in an effective field theory so that the accuracy of the effective field theory calculation is less seriously degraded when there are ratios of mass scales in the problem that are not large. I show how this new effective field theory can be obtained automatically, by doing the matching calculation on the perturbative mass shell. I also speculate about how to do even better by consistently including non-local terms in the effective lagrangian.",
        "source": "Elsevier"
      }
    ],
