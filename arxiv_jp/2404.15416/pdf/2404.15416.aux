\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 閉時間経路上の $\epsilon _r$ 変換と $\epsilon _a$ 変換。両輪郭とも時間は左から右へ進み、矢印は経路順序を表す（$\mathinner {|{in}\rangle }$ では時間順序、$\mathinner {\langle {in}|}$ では反時間順序）。$\epsilon _r$ は「$+$」と「$-$」の変数を同じ方向へ移し、$\epsilon _a$ は逆方向へ移す。$\epsilon _r$ 変換は保たれるが、$\epsilon _a$ 変換は散逸効果によって明示的に破れる \cite  {Hongo:2018ant}。}}{15}{figure.caption.10}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:sym}{{2}{15}{閉時間経路上の $\epsilon _r$ 変換と $\epsilon _a$ 変換。両輪郭とも時間は左から右へ進み、矢印は経路順序を表す（$\ket {in}$ では時間順序、$\bra {in}$ では反時間順序）。$\epsilon _r$ は「$+$」と「$-$」の変数を同じ方向へ移し、$\epsilon _a$ は逆方向へ移す。$\epsilon _r$ 変換は保たれるが、$\epsilon _a$ 変換は散逸効果によって明示的に破れる \cite {Hongo:2018ant}。}{figure.caption.10}{}}
\newlabel{eq:LorentzRsym}{{2.18}{15}{時間並進対称性の破れ}{equation.2.18}{}}
