\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 運動量保存 $\delta ({\bm  {k}}_1+{\bm  {k}}_2+{\bm  {k}}_3)$ を満たす三角形の形状。$x_2\equiv k_2/k_1$、$x_3\equiv k_3/k_1$ とし、閉じた三角形を作る条件 $x_3<x_2<1$、$x_2+x_3>1$ を満たす。特に関心があるのは $x_2+x_3\simeq 1$ の折り畳み領域で、スクイーズ配置と等脚折り畳み配置をつなぐ。式~\eqref  {eq:singdissip} の特異性構造はこの領域付近でピークをもち、散逸的ダイナミクスの明瞭な兆候を与える。}}{40}{figure.caption.30}\protected@file@percent }
\newlabel{fig:triangles}{{5}{40}{運動量保存 $\delta (\bmk _1+\bmk _2+\bmk _3)$ を満たす三角形の形状。$x_2\equiv k_2/k_1$、$x_3\equiv k_3/k_1$ とし、閉じた三角形を作る条件 $x_3<x_2<1$、$x_2+x_3>1$ を満たす。特に関心があるのは $x_2+x_3\simeq 1$ の折り畳み領域で、スクイーズ配置と等脚折り畳み配置をつなぐ。\Eq {eq:singdissip} の特異性構造はこの領域付近でピークをもち、散逸的ダイナミクスの明瞭な兆候を与える。}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 式~\eqref  {eq:D2resultdissip} の Minkowski 時空の $\dot  {\pi }_a^3$ が生む接触型バイスペクトルの形状関数。左：散逸が小さいと、式~\eqref  {eq:singdissip} の $\mathrm  {Sing}_\gamma $ が $x_2+x_3\simeq 1$ の折り畳み領域で小さくなり、バイスペクトルが増強される。右：散逸が大きいと、散逸による虚数項が $\mathrm  {Sing}_\gamma $ を支配し、折り畳み領域での増強は見られない。}}{40}{figure.caption.31}\protected@file@percent }
\newlabel{fig:shapeMink}{{6}{40}{\Eq {eq:D2resultdissip} の Minkowski 時空の $\dot {\pi }_a^3$ が生む接触型バイスペクトルの形状関数。左：散逸が小さいと、\Eq {eq:singdissip} の $\mathrm {Sing}_\gamma $ が $x_2+x_3\simeq 1$ の折り畳み領域で小さくなり、バイスペクトルが増強される。右：散逸が大きいと、散逸による虚数項が $\mathrm {Sing}_\gamma $ を支配し、折り畳み領域での増強は見られない。}{figure.caption.31}{}}
\newlabel{eq:shaperef}{{4.12}{40}{$\dot {\pi }^3$ 相互作用}{equation.4.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 左上は、式~\eqref  {eq:D2resultdissip} の Minkowski 時空における $\dot  {\pi }_a^3$ が生む接触型バイスペクトルの三次元形状関数を、$\gamma =0.08,0.12,0.16$ について示す。$\gamma $ が減るにつれ、正三角形配置から折り畳み配置へピークが移る。右上は赤線 $x_2=x_3=x$ に沿う二次元断面。特異性が解消され、任意の三角形配置と散逸パラメータ $\gamma $ に対してバイスペクトルがよく定義される。左下は黒線 $x_2=1$ に沿う二次元断面。整合関係により $x_3\ll 1$ のスクイーズ極限で信号は消える。右下は紫線 $x_2=1-x_3$ に沿う二次元断面。同じくスクイーズ極限で整合関係が見られる。}}{41}{figure.caption.32}\protected@file@percent }
\newlabel{fig:foldedMink}{{7}{41}{左上は、\Eq {eq:D2resultdissip} の Minkowski 時空における $\dot {\pi }_a^3$ が生む接触型バイスペクトルの三次元形状関数を、$\gamma =0.08,0.12,0.16$ について示す。$\gamma $ が減るにつれ、正三角形配置から折り畳み配置へピークが移る。右上は赤線 $x_2=x_3=x$ に沿う二次元断面。特異性が解消され、任意の三角形配置と散逸パラメータ $\gamma $ に対してバイスペクトルがよく定義される。左下は黒線 $x_2=1$ に沿う二次元断面。整合関係により $x_3\ll 1$ のスクイーズ極限で信号は消える。右下は紫線 $x_2=1-x_3$ に沿う二次元断面。同じくスクイーズ極限で整合関係が見られる。}{figure.caption.32}{}}
