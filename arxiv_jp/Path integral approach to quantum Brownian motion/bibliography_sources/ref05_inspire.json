{"updated":"2023-03-09T12:43:11.732280+00:00","id":"50055","links":{"bibtex":"https://inspirehep.net/api/literature/50055?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/50055?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/50055?format=latex-us","json":"https://inspirehep.net/api/literature/50055?format=json","json-expanded":"https://inspirehep.net/api/literature/50055?format=json-expanded","cv":"https://inspirehep.net/api/literature/50055?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A50055"},"revision_id":94,"created":"1997-05-27T00:00:00+00:00","metadata":{"publication_info":[{"year":1966,"page_end":"1085","page_start":"1079","journal_title":"Phys.Rev.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214516"},"journal_volume":"150"}],"citation_count":836,"citation_count_without_self_citations":836,"dois":[{"value":"10.1103/PhysRev.150.1079"}],"titles":[{"title":"Derivation of the Schrodinger equation from Newtonian mechanics"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"596c308b-b8eb-42dd-904e-426d2c518a1b","record":{"$ref":"https://inspirehep.net/api/authors/1019260"},"full_name":"Nelson, Edward","affiliations":[{"value":"Princeton U.","record":{"$ref":"https://inspirehep.net/api/institutions/903139"}}],"signature_block":"NALSANe","curated_relation":true}],"curated":true,"texkeys":["Nelson:1966sp"],"citeable":true,"refereed":true,"abstracts":[{"value":"We examine the hypothesis that every particle of mass m is subject to a Brownian motion with diffusion coefficient ℏ2m and no friction. The influence of an external field is expressed by means of Newton's law F=ma, as in the Ornstein-Uhlenbeck theory of macroscopic Brownian motion with friction. The hypothesis leads in a natural way to the Schrödinger equation, but the physical interpretation is entirely classical. Particles have continuous trajectories and the wave function is not a complete description of the state. Despite this opposition to quantum mechanics, an examination of the measurement process suggests that, within a limited framework, the two theories are equivalent.","source":"APS"}],"references":[{"reference":{"publication_info":{"artid":"162","page_start":"162","journal_title":"Rev.Mod.Phys.","journal_volume":"6"}}},{"reference":{"publication_info":{"artid":"671","page_start":"671","journal_title":"Duke Math.J.","journal_volume":"25"}}},{"reference":{"publication_info":{"artid":"447","page_start":"447","journal_title":"Compt.Rend.Hebd.Seances Acad.Sci.","journal_volume":"183"}}},{"reference":{"publication_info":{"artid":"273","page_start":"273","journal_title":"Compt.Rend.Hebd.Seances Acad.Sci.","journal_volume":"184"}}},{"reference":{"publication_info":{"artid":"380","page_start":"380","journal_title":"Compt.Rend.Hebd.Seances Acad.Sci.","journal_volume":"185"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/8809"},"reference":{"publication_info":{"artid":"166","page_start":"166","journal_title":"Phys.Rev.","journal_volume":"85"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/8810"},"reference":{"publication_info":{"artid":"180","page_start":"180","journal_title":"Phys.Rev.","journal_volume":"85"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/47036"},"reference":{"publication_info":{"artid":"208","page_start":"208","journal_title":"Phys.Rev.","journal_volume":"96"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"81","page_start":"81","journal_title":"Z.Phys.","journal_volume":"132"}}},{"reference":{"publication_info":{"artid":"264","page_start":"264","journal_title":"Z.Phys.","journal_volume":"134"}}},{"reference":{"publication_info":{"artid":"270","page_start":"270","journal_title":"Z.Phys.","journal_volume":"135"}}},{"reference":{"publication_info":{"artid":"582","page_start":"582","journal_title":"Z.Phys.","journal_volume":"136