value":"05.40.+j","schema":"PACS"},{"value":"72.70.+m","schema":"PACS"},{"value":"74.50.+r","schema":"PACS"}],"refereed":true,"abstracts":[{"value":"It is shown that the low-frequency spectral density of the voltage noise in a current-biased Josephson junction with critical current I0, shunt resistance R, and small capacitance is eI02R3πV in the limit eV≫kBT(II0)2 and I>I0, where V is the voltage and I is the current. The noise arises from zero-point current fluctuations in the shunt resistor. The rounding of the current-voltage characteristic caused by the quantum fluctuations and the effects of nonzero junction capacitance are calculated.","source":"APS"}],"references":[{"reference":{"publication_info":{"artid":"277","page_start":"277","journal_title":"Appl.Phys.Lett.","journal_volume":"12"}}},{"reference":{"publication_info":{"artid":"3113","page_start":"3113","journal_title":"J.Appl.Phys.","journal_volume":"39"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/45258"},"reference":{"publication_info":{"artid":"251","page_start":"251","journal_title":"Phys.Lett.","journal_volume":"1"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"417","page_start":"417","journal_title":"J.Phys.E","journal_volume":"9"}}},{"reference":{"publication_info":{"artid":"625","page_start":"625","journal_title":"Pisma Zh.Eksp.Teor.Fiz.","journal_volume":"15"}}},{"reference":{"publication_info":{"artid":"79","page_start":"79","journal_title":"NOONE","journal_volume":"9"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/60527"},"reference":{"publication_info":{"artid":"531","page_start":"531","journal_title":"Phys.Rev.","journal_volume":"182"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"1416","page_start":"1416","journal_title":"Phys.Rev.Lett.","journal_volume":"22"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/45155"},"reference":{"publication_info":{"artid":"34","page_start":"34","journal_title":"Phys.Rev.",