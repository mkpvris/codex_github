{"updated":"2024-06-04T02:56:48.323779+00:00","id":"3198","created":"1997-01-16T00:00:00+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/3198?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/3198?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/3198?format=latex-us","json":"https://inspirehep.net/api/literature/3198?format=json","json-expanded":"https://inspirehep.net/api/literature/3198?format=json-expanded","cv":"https://inspirehep.net/api/literature/3198?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A3198"},"revision_id":104,"uuid":"24a817c0-45d6-4987-9971-0d09e5d6344a","metadata":{"citation_count":3494,"publication_info":[{"year":1932,"page_end":"760","page_start":"749","journal_title":"Phys.Rev.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214516"},"journal_volume":"40"}],"citation_count_without_self_citations":3489,"dois":[{"value":"10.1103/PhysRev.40.749"}],"titles":[{"title":"On the quantum correction for thermodynamic equilibrium"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"d9036a5d-069c-40a8-a14c-73a3f0a104a2","record":{"$ref":"https://inspirehep.net/api/authors/983578"},"full_name":"Wigner, Eugene P.","affiliations":[{"value":"Princeton U.","record":{"$ref":"https://inspirehep.net/api/institutions/903139"},"curated_relation":true}],"signature_block":"WAGNARe","curated_relation":true}],"curated":true,"texkeys":["Wigner:1932eb"],"citeable":true,"refereed":true,"abstracts":[{"value":"The probability of a configuration is given in classical theory by the Boltzmann formula exp[−VhT] where V is the potential energy of this configuration. For high temperatures this of course also holds in quantum theory. For lower temperatures, however, a correction term has to be introduced, which can be developed into a power series of h. The formula is developed for this correction by means of a probability function and the result discussed.","source":"APS"}],"references":[{"reference":{"report_numbers":["AWGPA,273"]}},{"record":{"$ref":"https://inspirehep.net/api/literature/2793487"},"reference":{"publication_info":{"artid":"555","page_start":"555","journal_title":"Z.Phys.","journal_volume":"52"}}},{"reference":{"report_numbers":["AWGPA,245"]}},{"reference":{"publication_info":{"artid":"430","page_start":"430","journal_title":"Z.Phys.","journal_volume":"45"}}},{"reference":{"publication_info":{"artid":"245","page_start":"245","journal_title":"Z.Phys.","journal_volume":"63"}}},{"reference":{"publication_info":{"artid":"682","page_start":"682","journal_title":"Phys.Rev.","journal_volume":"37"}}},{"reference":{"publication_info":{"artid":"516","page_start":"516","journal_title":"Phys.Rev.","journal_volume":"38"}}},{"reference":{"report_numbers":["PROC,230"]}},{"record":{"$ref":"https://inspirehep.net/api/literature/43578"},"reference":{"publication_info":{"artid":"237","page_start":"237","journal_title":"Phys.Rev.","journal_volume":"38"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"39","page_start":"39","journal_title":"NOONE","journal_volume":"33"}}},{"reference":{"publication_info":{"artid":"295","page_start":"295","journal_title":"Z.Phys.","journal_volume":"74"}}}],"document_type":["article"],"preprint_date":"1932","control_number":3198,"legacy_version":"20180220141512.0","number_of_pages":12,"inspire_categories":[{"term":"General Physics"}],"legacy_creation_date":"1997-01-16","external_system_identifiers":[{"value":"SPIRES-110426","schema":"SPIRES"}]}}