 recently been approved and progress in the design of the cyclotron and related aspects of the proposed facility is reported here.","abstract_source_suggest":{"input":"IEEE"}}],"titles":[{"title":"A New Multidisciplinary Separated Sector Cyclotron Facility"}],"curated":true}},{"created":"2010-03-16T00:00:00+00:00","id":"849000","links":{"bibtex":"https://inspirehep.net/api/literature/849000?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/849000?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/849000?format=latex-us","json":"https://inspirehep.net/api/literature/849000?format=json","json-expanded":"https://inspirehep.net/api/literature/849000?format=json-expanded","cv":"https://inspirehep.net/api/literature/849000?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A849000"},"updated":"2023-03-06T14:15:39.365777+00:00","metadata":{"authors":[{"full_name_unicode_normalized":"dekker, j.w.m.","full_name":"Dekker, J.W.M.","record":{"$ref":"https://inspirehep.net/api/authors/2379500"},"ids":[{"schema":"INSPIRE BAI","value":"J.W.M.Dekker.1"}],"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/904516"},"value":"Netherlands Energy Res. Found."}],"last_name":"Dekker","signature_block":"DACARj","uuid":"366b9d88-4f45-4b29-8976-b8e6f2b89f3b","first_name":"J.W.M.","recid":2379500}],"citation_count":0,"citation_count_without_self_citations":0,"report_numbers":[{"value":"ECN-14"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","number_of_pages":142,"legacy_version":"20150619005105.0","legacy_creation_date":"2010-03-16","preprint_date":"1977-02","author_count":1,"first_author":{"full_name":"Dekker, J.W.M.","last_name":"Dekker","first_name":"J.W.M.","recid":2379500},"public_notes":[{"value":"Microfiche at Fermilab (library@fnal.gov)"}],"control_number":849000,"earliest_date":"1977-02","document_type":["article"],"texkeys":["Dekker:1977zz"],"titles":[{"title":"Tables and figures and 