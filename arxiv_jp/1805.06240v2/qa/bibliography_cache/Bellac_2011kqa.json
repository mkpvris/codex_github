{"hits":{"hits":[{"updated":"2024-09-17T08:59:28.534620+00:00","created":"2015-07-27T00:00:00+00:00","id":"1384874","metadata":{"citation_count":287,"publication_info":[{"year":2011}],"citation_count_without_self_citations":287,"authors":[{"raw_affiliations":[{"value":"Université de Nice, Sophia Antipolis"}],"full_name_unicode_normalized":"bellac, michel le","full_name":"Bellac, Michel Le","record":{"$ref":"https://inspirehep.net/api/authors/1016874"},"last_name":"Bellac","affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903069"},"value":"Nice U."}],"ids":[{"schema":"INSPIRE BAI","value":"M.Le.Bellac.1"}],"signature_block":"BALACm","uuid":"e823e4ae-b194-4286-a255-0916b9d16245","first_name":"Michel Le","recid":1016874}],"isbns":[{"medium":"online","value":"9780511885068"},{"medium":"print","value":"9780521654777"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","legacy_version":"20180612171247.0","inspire_categories":[{"term":"Theory-HEP"}],"legacy_creation_date":"2015-07-27","author_count":1,"urls":[{"value":"http://www.cambridge.org/mw/academic/subjects/physics/theoretical-physics-and-mathematical-physics/thermal-field-theory?format=AR"}],"first_author":{"full_name":"Bellac, Michel Le","last_name":"Bellac","first_name":"Michel Le","recid":1016874},"control_number":1384874,"dois":[{"value":"10.1017/CBO9780511721700"}],"earliest_date":"2011-03-04","document_type":["book"],"texkeys":["Bellac:2011kqa"],"abstracts":[{"source":"Cambridge University Press","value":"Now in paperback, this text introduces the theoretical framework for describing the quark-gluon plasma, an important new state of matter. The first part of this book is a self-contained introduction to relativistic thermal field theory. Topics include the path integral approach, the real and the imaginary time formalisms, fermion fields and gauge fields at finite temperature. Useful techniques such as the evaluation of frequency sums or the use of cutting rules are illustrated on various examples. The second part of the book is devoted to recent developments, giving a detailed account of collective excitations (bosonic and fermionic), and showing how they give rise to energy scales which imply a reorganization of perturbation theory. The relation with kinetic theory is also explained. Applications to processes which occur in heavy ion collisions and in astrophysics are worked out in detail. Each chapter ends with exercises and a guide to the literature.","abstract_source_suggest":{"input":"Cambridge University Press"}}],"titles":[{"title":"Thermal Field Theory"}],"book_series":[{"title":"Cambridge Monographs on Mathematical Physics"}],"facet_author_name":["1016874_Michel Le Bellac"],"core":true,"imprints":[{"date":"2011-03-04","publisher":"Cambridge University Press"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1384874","updated":"2024-09-17T08:59:28.534620"},"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/1384874?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1384874?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1384874?format=latex-us","json":"https://inspirehep.net/api/literature/1384874?format=json","json-expanded":"https://inspirehep.net/api/literature/1384874?format=json-expanded","cv":"https://inspirehep.net/api/literature/1384874?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1384874"}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1","bibtex":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=texkey%20Bellac%3A2011kqa&size=10&page=1&format=cv"}}