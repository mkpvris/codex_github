":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1278498","updated":"2023-03-07T00:50:58.570350"},"journal_title_variants":["Phys.Rev.D","Phys. Rev. D"],"arxiv_eprints":[{"categories":["hep-ph","cond-mat.stat-mech","hep-th"],"value":"1401.5596"}],"referenced_authors_bais":["K.T.Grosvenor.1","Yoshimasa.Hidaka.1","G.Blatter.1","Petr.Horava.1","B.Theiler.1","A.Nicolis.1","Haruki.Watanabe.1","H.Leutwyler.1","Rachel.A.Rosen.1","V.I.Ogievetsky.1","I.N.McArthur.1","R.Penco.1","E.A.Ivanov.1","M.Trodden.1","J.E.Wess.1","B.Zumino.1","W.Kohn.1","A.Joyce.1","Sidney.R.Coleman.1","C.G.Callan.1","S.Huber.1","Hitoshi.Murayama.1","E.Altman.1","D.T.Son.1","Ziqi.Yan.1","G.L.Goon.1","Tom.Griffin.1","Federico.Piazza.1","Aneesh.V.Manohar.1","T.Brauner.1","M.Wingate.1","K.Hinterbichler.1","D.V.Volkov.1","I.Low.1"],"legacy_version":"20160728133417.0","inspire_categories":[{"term":"Phenomenology-HEP"},{"term":"Theory-HEP"},{"term":"General Physics"},{"term":"Condensed Matter","source":"arxiv"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/040af2s02"},{"schema":"ROR","value":"https://ror.org/04jymbd90"}],"full_name":"Brauner, Tomáš","last_name":"Brauner","ids":[{"schema":"ORCID","value":"0000-0002-5564-4845"},{"schema":"INSPIRE BAI","value":"T.Brauner.1"}],"first_name":"Tomáš","recid":1019551},"control_number":1278498,"dois":[{"value":"10.1103/PhysRevD.89.085004"}],"document_type":["article"],"texkeys":["Brauner:2014aha"],"abstracts":[{"source":"APS","value":"It has long been known that when spacetime symmetry is spontaneously broken, some of the broken generators may not give rise to independent gapless Nambu-Goldstone excitations. We provide two complementary viewpoints of this phenomenon. On the one hand, we show that the corresponding field degrees of freedom have the same symmetry transformation properties as massive matter fields. The “inverse Higgs constraints,” sometimes employed to eliminate these modes from the theory, are reinterpreted as giving a field parametrization that makes these transformation properties manifest. On the other hand, relations among classical symmetry transformations generally lead to identities for the associated Noether currents that allow saturation of the Ward-Takahashi identities for all the broken symmetries with fewer gapless excitations than suggested by the mere counting of broken generators.","abstract_source_suggest":{"input":"APS"}},{"value":"It has long been known that when spacetime symmetry is spontaneously broken, some of the broken generators may not give rise to independent gapless Nambu-Goldstone excitations. We provide two complementary viewpoints of this phenomenon. On the one hand, we show that the corresponding field degrees of freedom have the same symmetry transformation properties as massive matter fields. The “inverse Higgs constraints,” sometimes employed to eliminate these modes from the theory, are reinterpreted as giving a field parametrization that makes these transformation properties manifest. On the other hand, relations among classical symmetry transformations generally lead to identities for the associated Noether currents that allow saturation of the Ward-Takahashi identities for all the broken symmetries with fewer gapless excitations than suggested by the mere counting of broken generators."},{"source":"arXiv","value":"It has been long known that when spacetime symmetry is spontaneously broken, some of the broken generators may not give rise to independent gapless, Nambu-Goldstone excitations. We provide two complementary viewpoints of this phenomenon. On the one hand, we show that the corresponding field degrees of freedom have the same symmetry transformation properties as massive, matter fields. The \"inverse Higgs constraints\", sometimes employed to eliminate these modes from the theory, are reinterpreted as giving a field parametrization that makes these transformation properties manifest. On the other hand, relations among classical symmetry transformations generally lead to identities for the associated Noether currents that allow saturation of the Ward-Takahashi identities for all the broken symmetries with fewer gapless excitations than suggested by mere counting of broken generators.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["hep-ph"],"titles":[{"source":"arXiv","title":"Spontaneous breaking of spacetime symmetries and the inverse Higgs effect"}],"imprints":[{"date":"2014-04-02"}],"curated":true},"updated":"2023-03-07T00:50:58.570350+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/1278498?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1278498?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1278498?format=latex-us","json":"https://inspirehep.net/api/literature/1278498?format=json","json-expanded":"https://inspirehep.net/api/literature/1278498?format=json-expanded","cv":"https://inspirehep.net/api/literature/1278498?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1278498"},"id":"1278498"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1","bibtex":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=texkey%20Brauner%3A2014aha&size=10&page=1&format=cv"}}