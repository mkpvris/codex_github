public_notes":[{"source":"arXiv","value":"V3: 11 pages. Discussion of the background material and effective CTP actions is vastly enlarged. Discussion of the entropy production is added. While all results remain unchanged, they are now discussed in greater detail. References are also added. The version is to appear in PRD"}],"earliest_date":"2013-05-15","refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"3421392"}],"facet_author_name":["993041_Janos Polonyi","1236282_Sašo Grozdanov"],"core":true,"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:1233729","updated":"2023-03-10T15:17:59.600780"},"journal_title_variants":["Phys.Rev.D","Phys. Rev. D"],"arxiv_eprints":[{"categories":["hep-th"],"value":"1305.3670"}],"referenced_authors_bais":["Julian.Seymour.Schwinger.1","C.R.Galley.1","J.Bhattacharya.1","G.Mandal.1","Thomas.Gregoire.1","Riccardo.Rattazzi.1","M.Rangamani.1","M.Harder.2","Sayantani.Bhattacharyya.1","J.Polonyi.1","V.E.Hubeny.1","Toshifumi.Noumi.1","Yoshimasa.Hidaka.1","S.Grozdanov.1","Richard.P.Feynman.1","A.Nicolis.1","H.S.Reall.1","H.Leutwyler.1","Jun.Pu.Wang.1","Rachel.A.Rosen.1","Spenta.Rustom.Wadia.1","L.V.Keldysh.1","F.L.Vernon.1","Rafael.A.Porto.1","G.D.Moore.1","P.Kovtun.1","P.Romatschke.1","S.L.Dubovsky.1","T.Morita.1","L.Tinti.1","F.Becattini.1","R.Penco.1","E.Grossi.1","A.Ritz.1","S.Minwalla.1","L.Bucciantini.3","R.Loganayagam.1","A.Yarom.1","Tamas.Sandor.Biro.1","M.Hongo.1","Peter.Van.1","S.Endlich.1","T.Hayata.1","F.M.Haehl.1","D.T.Son.1","Lam.Hui.1"],"legacy_version":"20180612225418.0","inspire_categories":[{"term":"Theory-HEP"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/052gg0110"}],"full_name":"Grozdanov, Sašo","last_name":"Grozdanov","ids":[{"schema":"INSPIRE ID","value":"INSPIRE-00376816"},{"schema":"ORCID","value":"0000-0001-5548-2412"},{"schema":"INSPIRE BAI","value":"S.Grozdanov.1"}],"first_name":"Sašo","recid":1236282},"control_number":1233729,"dois":[{"value":"10.1103/PhysRevD.91.105031"}],"document_type":["article"],"texkeys":["Grozdanov:2013dba"],"abstracts":[{"source":"APS","value":"With the goal of deriving dissipative hydrodynamics from an action, we study classical actions for open systems, which follow from the generic structure of effective actions in the Schwinger-Keldysh closed-time-path (CTP) formalism with two time axes and a doubling of degrees of freedom. The central structural feature of such effective actions is the coupling between degrees of freedom on the two time axes. This reflects the fact that from an effective field theory point of view, dissipation is the loss of energy of the low-energy hydrodynamical degrees of freedom to the integrated-out, UV degrees of freedom of the environment. The dynamics of only the hydrodynamical modes may therefore not possess a conserved stress-energy tensor. After a general discussion of the CTP effective actions, we use the variational principle to derive the energy-momentum balance equation for a dissipative fluid from an effective Goldstone action of the long-range hydrodynamical modes. Despite the absence of conserved energy and momentum, we show that we can construct the first-order dissipative stress-energy tensor and derive the Navier-Stokes equations near hydrodynamical equilibrium. The shear viscosity is shown to vanish in the classical theory under consideration, while the bulk viscosity is determined by the form of the effective action. We also discuss the thermodynamics of the system and analyze the entropy production.","abstract_source_suggest":{"input":"APS"}},{"source":"arXiv","value":"With the goal of deriving dissipative hydrodynamics from an action, we study classical actions for open systems, which follow from the generic structure of effective actions in the Schwinger-Keldysh Closed-Time-Path formalism with two time axes and a doubling of degrees of freedom. The central structural feature of such effective actions is the coupling between degrees of freedom on the two time axes. This reflects the fact that from an effective field theory point of view, dissipation is the loss of energy of the low-energy hydrodynamical degrees of freedom to the integrated-out, UV degrees of freedom of the environment. The dynamics of only the hydrodynamical modes may therefore not posses a conserved stress-energy tensor. After a general discussion of the CTP effective actions, we use the variational principle to derive the energy-momentum balance equation for a dissipative fluid from an effective Goldstone action of the long-range hydrodynamical modes. Despite the absence of conserved energy and momentum, we show that we can construct the first-order dissipative stress-energy tensor and derive the Navier-Stokes equations near hydrodynamical equilibrium. The shear viscosity is shown to vanish in the classical theory under consideration, while the bulk viscosity is determined by the form of the effective action. We also discuss the thermodynamics of the system and analyse the entropy production.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["hep-th"],"titles":[{"source":"arXiv","title":"Viscosity and dissipative hydrodynamics from effective field theory"}],"imprints":[{"date":"2015-05-29"}],"curated":true},"links":{"bibtex":"https://inspirehep.net/api/literature/1233729?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/1233729?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/1233729?format=latex-us","json":"https://inspirehep.net/api/literature/1233729?format=json","json-expanded":"https://inspirehep.net/api/literature/1233729?format=json-expanded","cv":"https://inspirehep.net/api/literature/1233729?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A1233729"}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=texkey%20Grozdanov%3A201