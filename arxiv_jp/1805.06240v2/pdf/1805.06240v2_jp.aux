\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  生成汎関数が定義される閉時間経路。初期密度演算子 $\hat  {\rho }_0$ が熱的密度演算子 $\hat  {\rho }_0 \propto e^{-\beta \hat  {H}}$ で与えられると仮定すると、負の虚時間方向へ延びる別の経路が存在する（付録\ref {kim}を参照）。}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:CTP}{{1}{12}{生成汎関数が定義される閉時間経路。初期密度演算子 $\hat {\rho }_0$ が熱的密度演算子 $\hat {\rho }_0 \propto e^{-\beta \hat {H}}$ で与えられると仮定すると、負の虚時間方向へ延びる別の経路が存在する（付録\ref {kim}を参照）。}{figure.1}{}}
\newlabel{pi_micro}{{2.44}{12}{対称性の微視的起源}{equation.2.44}{}}
\newlabel{eq:MSR10}{{2.46}{12}{対称性の微視的起源}{equation.2.46}{}}
\newlabel{eq:TotalL}{{2.47}{12}{対称性の微視的起源}{equation.2.47}{}}
\citation{kamenev2011field}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  閉時間経路上の $\epsilon _{R}$ 変換と $\epsilon _{A}$ 変換。$\epsilon _{R}$ は $a=1,2$ の変数を同じ方向に並進させる一方、$\epsilon _{A}$ は逆方向に並進させる。$t$ に陽に依存しない Lagrangian は、$\epsilon _{R}$ 並進の下でのみ不変である。右図に示すように、同時刻の $1$--$2$ 結合は、$\epsilon _A$ 変換を行うと、もはや同時刻の結合ではなくなる。}}{13}{figure.2}\protected@file@percent }
\newlabel{fig:TwoTimeTr}{{2}{13}{閉時間経路上の $\epsilon _{R}$ 変換と $\epsilon _{A}$ 変換。$\epsilon _{R}$ は $a=1,2$ の変数を同じ方向に並進させる一方、$\epsilon _{A}$ は逆方向に並進させる。$t$ に陽に依存しない Lagrangian は、$\epsilon _{R}$ 並進の下でのみ不変である。右図に示すように、同時刻の $1$--$2$ 結合は、$\epsilon _A$ 変換を行うと、もはや同時刻の結合ではなくなる。}{figure.2}{}}
