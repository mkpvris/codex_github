\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 初期時刻に熱化した系の一般的な閉時間経路（CTP）積分路$C$（左図）から出発し、初期時刻を過去無限遠へ移し（$t_0\to -\infty $）、前進経路と後退経路を互いに重ねる（$\sigma =\epsilon \ll 1$）極限（右図）を選ぶ。この極限では、前進経路と後退経路上の変数（それぞれ$(X_1,\sigma _1)$および$(X_2,\sigma _2)$で表される）の間のGreen関数のみを考えればよい。}}{31}{figure.3}\protected@file@percent }
\newlabel{app:ctp}{{3}{31}{初期時刻に熱化した系の一般的な閉時間経路（CTP）積分路$C$（左図）から出発し、初期時刻を過去無限遠へ移し（$t_0\to -\infty $）、前進経路と後退経路を互いに重ねる（$\sigma =\epsilon \ll 1$）極限（右図）を選ぶ。この極限では、前進経路と後退経路上の変数（それぞれ$(X_1,\sigma _1)$および$(X_2,\sigma _2)$で表される）の間のGreen関数のみを考えればよい。}{figure.3}{}}
