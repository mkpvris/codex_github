g/047426m28"}],"full_name":"Ozawa, Tomoki","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/2826239"},"ids":[{"schema":"ORCID","value":"0000-0002-0319-5910"},{"schema":"INSPIRE BAI","value":"T.Ozawa.8"}],"signature_block":"OSt","first_name":"Tomoki","recid":2826239}],"citation_count":51,"citeable":true,"$schema":"https://inspirehep.net/schemas/records/hep.json","references":[{"reference":{"publication_info":{"journal_volume":"75","artid":"3783","page_start":"3783","journal_title":"Phys.Rev.Lett."}}},{"reference":{"arxiv_eprint":"hep-th/0405033","publication_info":{"journal_volume":"93","artid":"211101","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/649638"}},{"reference":{"publication_info":{"journal_volume":"100","artid":"220402","journal_title":"Phys.Rev.Lett."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/788000"}},{"reference":{"publication_info":{"journal_volume":"10","artid":"2445","page_start":"2445","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/89145"}},{"reference":{"publication_info":{"journal_volume":"63","artid":"032102","journal_title":"Phys.Rev.A"}},"record":{"$ref":"https://inspirehep.net/api/literature/2948600"}},{"reference":{"publication_info":{"journal_volume":"52","artid":"341","page_start":"341","journal_title":"Rev.Mod.Phys."}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/158082"}}],"number_of_pages":8,"referenced_authors_bais":["J.F.Roch.1","H.P.Breuer.3","S.D.H.Hsu.1","R.W.P.Drever.1","Francesco.Petruccione.1","F.Grosshans.1","M.Zimmermann.2","E.Wu.1","V.Sandberg.1","F.Treussart.1","C.M.Caves.1","X.Calmet.1","Alain.Aspect.1","V.Jacques.1","K.G.Wilson.1","M.L.Graesser.1","P.Grangier.1","Kip.S.Thorne.1"],"figures":[{"filename":"two-slit.png","material":"preprint","caption":"Two slit diffraction with single electrons, in which one measures the Coulomb field produced by the electrons at the far-away detector.","label":"setup","source":"arxiv","key":"85ff98543415e429d3888b85d23fd5c6","url":"https://inspirehep.net/files/85ff98543415e429d3888b85d23fd5c6"},{"filename":"apparatus.png","material":"preprint","caption":"Bohr-Rosenfeld apparatus for measuring the electric field. The positively charged object $A$ slides on the negatively charged fixed object $B$.","label":"apparatus","source":"arxiv","key":"ec1211c1ed830e3e7005f4cf44f2499d","url":"https://inspirehep.net/files/ec1211c1ed830e3e7005f4cf44f2499d"},{"filename":"visdissum2.png","material":"preprint","caption":"Visibility and distingishability vs charge for the parameters of Ref.~\\cite{tonomura}, for which the characteristic charge $Z_1$ for distinguishing paths by measuring the Coulomb field is $\\sim 7\\times 10^5$, and the characteristic charge $Z_2$ for loss of interference is $\\sim 1.5\\times 10^5$. Also shown is $\\mathcal{V}^2 + \\mathcal{D}^2$ (dotted line).","label":"vis1","source":"arxiv","key":"7026535b20e1525969d57d4d91a02351","url":"https://inspirehep.net/files/7026535b20e1525969d57d4d91a02351"},{"filename":"gravitational_detector.png","material":"preprint","caption":"Gravitational field detector","label":"gravitational_detector","source":"arxiv","key":"a4af50f2b64950c4e202e52d70911c50","url":"https://inspirehep.net/files/a4af50f2b64950c4e202e52d70911c50"}],"legacy_version":"20160421163116.0","inspire_categories":[{"term":"General Physics"},{"term":"Theory-HEP"},{"term":"Quantum Physics","source":"arxiv"}],"legacy_creation_date":"2009-02-16","preprint_date":"2009-02","author_count":2,"public_notes":[{"source":"arXiv","value":"8 pages, 4 figures. To appear in Proc. Natl. Acad. Sci"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/047426m28"}],"full_name":"Baym, Gordon","ids":[{"schema":"ORCID","value":"0000-0003-0259-4845"},{"schema":"INSPIRE BAI","value":"G.Baym.1"}],"last_name":"Baym","first_name":"Gordon","recid":1017059},"control_number":813440,"dois":[{"value":"10.1073/pnas.0813239106"},{"material":"publication","source":"arXiv","value":"10.1073/pnas.0813239106"}],"earliest_date":"2009-02","document_type":["article"],"texkeys":["Baym:2009zu"],"abstracts":[{"source":"arXiv","value":"We analyze Niels Bohr's proposed two-slit interference experiment with highly charged particles that argues that the consistency of elementary quantum mechanics requires that the electromagnetic field must be quantized. In the experiment a particle's path through the slits is determined by measuring the Coulomb field that it produces at large distances; under these conditions the interference pattern must be suppressed. The key is that as the particle's trajectory is bent in diffraction by the slits it must radiate and the radiation must carry away phase information. Thus the radiation field must be a quantized dynamical degree of freedom. On the other hand, if one similarly tries to determine the path of a massive particle through an inferometer by measuring the Newtonian gravitational potential the particle produces, the interference pattern would have to be finer than the Planck length and thus undiscernable. Unlike for the electromagnetic field, Bohr's argument does not imply that the gravitational field must be quantized.","abstract_source_suggest":{"input":"arXiv"}}],"refereed":true,"primary_arxiv_category":["quant-ph"],"external_system_identifiers":[{"schema":"ADS","value":"2009PNAS..106.3035B"},{"schema":"SPIRES","value":"SPIRES-8179158"}],"titles":[{"title":"Two-slit diffraction with highly charged particles: Niels Bohr's consistency argument that the electromagnetic field must be quantized"},{"source":"arXiv","title":"Two-slit diffraction with highly charged particles: Niels Bohr's consistency argument that the electromagnetic field must be quantized"}],"facet_author_name":["1017059_Gordon A. Baym","2826239_Tomoki Ozawa"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:813440","updated":"2025-10-01T10:00:13.797691"},"curated":true,"journal_title_variants":["Proc.Nat.Acad.Sci.","Proc. Nat. Acad. Sci."],"arxiv_eprints":[{"categories":["quant-ph","cond-mat.other","hep-th"],"value":"0902.2615"}]},"created":"2009-02-16T00:00:00+00:00","updated":"2025-10-01T10:00:13.797691+00:00"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=doi%3A10.1073%2Fpnas.0813239106&size=5&page=1&format=cv"}}