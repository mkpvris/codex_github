net/api/literature/192909"}},{"reference":{"publication_info":{"journal_volume":"116","artid":"6","page_start":"6","journal_title":"NOONE"}}},{"reference":{"publication_info":{"journal_volume":"116","artid":"311","page_start":"311","journal_title":"NOONE"}}},{"reference":{"publication_info":{"journal_volume":"39","artid":"1116","page_start":"1116","journal_title":"NOONE"}}},{"reference":{"publication_info":{"journal_volume":"39","artid":"2912","page_start":"2912","journal_title":"Phys.Rev.D"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/276857"}},{"reference":{"publication_info":{"journal_volume":"4","artid":"1396","page_start":"1396","journal_title":"Class.Quant.Grav."}}}],"number_of_pages":61,"referenced_authors_bais":["H.Haken.1","N.R.Johnson.1","S.C.Pancholi.2","J.Wells.1","Alexander.Vilenkin.1","M.W.Guidry.1","A.H.Guth.1","V.Ambegaokar.1","J.M.Cornwall.1","S.Nakajima.8","M.Zimmermann.2","A.O.Caldeira.1","Andrei.D.Linde.1","W.H.Zurek.1","G.S.Agarwal.1","F.K.McGowan.1","So.Young.Pi.1","R.W.P.Drever.1","M.P.Fewell.8","V.Hakim.2","I.Y.Lee.2","B.Yurke.1","Stephen.W.Hawking.1","A.J.Leggett.1","C.M.Caves.1","J.S.Hattula.1","H.Mori.7","J.J.Halliwell.1","J.B.Hartle.1","L.L.Riedinger.1","V.Sandberg.1","R.Bruinsma.1","Kip.S.Thorne.1","I.R.Senitzky.1","D.Stoler.1","Y.Schutz.1","C.Baktash.1"],"legacy_version":"20200604115912.0","inspire_categories":[{"term":"Theory-HEP","source":"curator"},{"term":"General Physics","source":"curator"}],"legacy_creation_date":"1989-01-25","preprint_date":"1989-01-25","author_count":2,"first_author":{"full_name":"Unruh, W.G.","last_name":"Unruh","first_name":"W.G.","recid":985209},"control_number":25029,"dois":[{"value":"10.1103/PhysRevD.40.1071"}],"earliest_date":"1989-01-25","document_type":["article"],"texkeys":["Unruh:1989dd"],"abstracts":[{"source":"APS","value":"The effect of the environment on a quantum system is studied on an exactly solvable model: a harmonic oscillator interacting with a one-dimensional massless scalar field. We show that in an open quantum system, dissipation can cause decorrelation on a time scale significantly shorter than the relaxation time which characterizes the approach of the system to thermodynamic equilibrium. In particular, we demonstrate that the density matrix decays rapidly toward a mixture of ‘‘approximate eigenstates’’ of the ‘‘pointer observable,’’ which commutes with the system-environment interaction Hamiltonian. This observable can be regarded as continuously, if inaccurately, monitored by the scalar field environment. Both because in a harmonic oscillator the state of the system rotates in the phase space and because the effective environment ‘‘measurement’’ is weak, the system, on the short ‘‘collision’’ time scale (1/Γ), maintains a coherence in this pointer observable on time scales of order [γ/Ωln(Γ/Ω)]1/2 and on longer time scales settles into a mixture of coherent states with a dispersion approximately consistent with the vacuum state. The master equation satisfied by the exact solution differs from the other master equations derived both for the high-temperature limit and for T=0. We discuss these differences and study the transition region between the high- and low-temperature regimes. We also consider the behavior of the system in the short-time ‘‘transient’’ regime. For T=0, we find that, in the long-time limit, the system behaves as if it were subject to ‘‘1/f noise.’’ The generality of our model is considered and its predictions are compared with previous treatments of related problems. Some of the possible applications of the results to experimentally realizable situations are outlined. The significance of the environment-induced reduction of the wave packet for cosmological models is also briefly considered.","abstract_source_suggest":{"input":"APS"}}],"refereed":true,"external_system_identifiers":[{"schema":"MSNET","value":"1008882"},{"schema":"OSTI","value":"5537905"},{"schema":"ADS","value":"1989PhRvD..40.1071U"},{"schema":"KEKSCAN","value":"2000-33-734"},{"schema":"SPIRES","value":"SPIRES-1936123"}],"titles":[{"title":"Reduction of a Wave Packet in Quantum Brownian Motion"}],"facet_author_name":["981896_Wojciech H. Zurek","985209_William G. Unruh"],"core":true,"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:25029","updated":"2023-12-13T12:53:21.928833"},"curated":true,"journal_title_variants":["Phys.Rev.D","Phys. Rev. D"]},"created":"1989-01-25T00:00:00+00:00","id":"25029"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.40.1071&size=5&page=1&format=cv"}}