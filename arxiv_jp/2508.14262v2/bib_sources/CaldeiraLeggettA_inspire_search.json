 in quantum mechanics.","abstract_source_suggest":{"input":"Elsevier"}}],"refereed":true,"titles":[{"title":"Path integral approach to quantum Brownian motion"}],"external_system_identifiers":[{"schema":"SPIRES","value":"SPIRES-589632"},{"schema":"MSNET","value":"726154"}],"facet_author_name":["1019446_Anthony James Leggett","1066035_Amir Ordacgi Caldeira"],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:176411","updated":"2023-12-13T12:07:41.895500"},"curated":true,"journal_title_variants":["Physica A"]},"created":"1997-05-13T00:00:00+00:00","updated":"2023-12-13T12:07:41.895500+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/176411?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/176411?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/176411?format=latex-us","json":"https://inspirehep.net/api/literature/176411?format=json","json-expanded":"https://inspirehep.net/api/literature/176411?format=json-expanded","cv":"https://inspirehep.net/api/literature/176411?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A176411"},"id":"176411"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=doi%3A10.1016%2F0378-4371%2883%2990013-4&size=5&page=1&format=cv"}}