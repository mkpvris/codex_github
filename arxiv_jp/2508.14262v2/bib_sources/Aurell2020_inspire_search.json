d":"062117","year":2018,"journal_title":"Phys.Rev.E"},"authors":[{"full_name":"E, Aurell"}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[47] Aurell E 2018 Phys. Rev. E 97(6) 062117"}],"record":{"$ref":"https://inspirehep.net/api/literature/3042261"}},{"reference":{"texkey":"DiosiFerialdi2014","label":"48","publication_info":{"journal_volume":"113","artid":"200403","year":2014,"journal_title":"Phys.Rev.Lett."},"misc":["Diósi L and Ferialdi L"]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[48] Diósi L and Ferialdi L 2014 Phys. Rev. Lett. 113(20) 200403"}],"record":{"$ref":"https://inspirehep.net/api/literature/3014671"}},{"reference":{"texkey":"GasbarriFerialdi2018","label":"49","publication_info":{"journal_volume":"98","artid":"042111","year":2018,"journal_title":"Phys.Rev.A"},"authors":[{"full_name":"G, Gasbarri"},{"full_name":"L, Ferialdi"}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[49] Gasbarri G and Ferialdi L 2018 Phys. Rev. A 98(4) 042111"}],"record":{"$ref":"https://inspirehep.net/api/literature/3044117"}},{"reference":{"texkey":"Golubev2013","label":"50","publication_info":{"journal_volume":"87","artid":"094522","year":2013,"journal_title":"Phys.Rev.B"},"authors":[{"full_name":"D, Golubev"},{"full_name":"T, Faivre"},{"full_name":"P, Pekola J."}]},"raw_refs":[{"schema":"text","source":"arXiv","value":"[50] Golubev D, Faivre T and Pekola J P 2013 Phys. Rev. B 87(9) 094522"}]}],"number_of_pages":13,"referenced_authors_bais":["P.Hanggi.1","P.Schramm.1","A.T.Dorsey.1","B.Vacchini.1","Alessandro.Braggio.1","S.Nakajima.8","Richard.P.Feynman.1","A.O.Caldeira.1","S.M.Dutra.1","R.Zwanzig.1","K.Funo.1","F.L.Vernon.1","H.Westfahl.2","Daniel.Alonso.1","J.Piilo.1","P.Talkner.1","P.Strasberg.1","A.Kato.3","D.H.Miller.1","I.de.Vega.1","A.Garg.4","M.Fisher.2","H.Grabert.1","W.Zwerger.1","E.Aurell.1","M.Grifoni.1","G.Schaller.2","H.T.Quan.1","Sudip.Chakravarty.1","M.Rosenau.da.Costa.1","M.Esposito.1","A.J.Leggett.1","G.Lindblad.1","E.M.Laine.1","U.Weiss.3","T.Brandes.2","G.Gasbarri.1","M.Carrega.1","L.Diosi.1","H.P.Breuer.3","J.K.Anders.1","M.Sassetti.1","P.Solinas.1","L.Ferialdi.1","Y.Tanimura.1","G.L.Ingold.1"],"figures":[{"filename":"two-points-time-line.png","material":"preprint","caption":"Time-line diagrams for two-time correlation for $\\tau = t_1-t_2> 0$.  The upper (lower) branch shows anti-chronological (chronological) time line.  The time on chronological branch shifts by $\\nu$.  For $C^{++}(t_1,t_2)$, both times shift by the same amount and thus the time difference is not affected by the shift.  The situation for $C^{--}(t_1,t_2)$ is identical to the normal correlation. For the cross correlation $C^{+-}(t_1,t_2)$, only $t_1$ on the chronological branch shifts and thus the time difference also shifts.  The situation for $C^{-+}(t_1,t_2)$  is similar to $C^{+-}(t_1,t_2)$ except that $t_2$ shifts by $\\nu$ instead of $t_1$.  For $t_1<t_2$, the direction of $\\tau$ is reversed for $C^{++}(t_1,t_2)$ and $C^{--}(t_1,t_2)$. However, the sign of $t_1-t_2$ does not affect the situation of $C^{+-}(t_1,t_2)$ and $C^{-+}(t_1,t_2)$.","label":"fig:2points-time-line","source":"arxiv","key":"b37d819cf54d83acb3729585eedfce99","url":"https://inspirehep.net/files/b37d819cf54d83acb3729585eedfce99"},{"filename":"time-line.png","material":"preprint","caption":"Time evolution of density operator, the operators $\\widetilde{V}(s)$ are ordered along the time line from $t$ to $t_i$ (anti-chronological order) and then from $t_i$ to $t$ (chronological order). This particular diagram shows the case of $V(s_2) V(s_1) \\rho(t_i) V(s'_1) V(s'_2)$.","label":"fig:time-line","source":"arxiv","key":"ed93533ebe5ccacfc342a73b6521eb0c","url":"https://inspirehep.net/files/ed93533ebe5ccacfc342a73b6521eb0c"}],"inspire_categories":[{"term":"Quantum Physics","source":"arxiv"},{"term":"Condensed Matter","source":"arxiv"}],"preprint_date":"2019-12-02","author_count":3,"first_author":{"emails":["eaurell@kth.se"],"full_name":"Aurell, Erik","last_name":"Aurell","first_name":"Erik","recid":1017874},"public_notes":[{"source":"arXiv","value":"13 pages, 2 figures"}],"control_number":3055038,"dois":[{"material":"publication","source":"arXiv","value":"10.1088/1751-8121/ab9274"}],"earliest_date":"2019-12-02","document_type":["article"],"texkeys":["Aurell:2019eks"],"abstracts":[{"source":"arXiv","value":"We present a derivation of the Feynman-Vernon approach to open quantum systems in the language of super-operators. We show that this gives a new and more direct derivation of the generating function of energy changes in a bath, or baths. This generating function is given by a Feynman-Vernon-like influence functional, with only time shifts in some of the kernels. We further show that the approach can be extended to anharmonic baths by an expansion in cumulants. Every non-zero cumulant of certain environment correlation functions thus gives a kernel in a higher-order term in the Feynman-Vernon action.","abstract_source_suggest":{"input":"arXiv"}}],"primary_arxiv_category":["quant-ph"],"titles":[{"source":"arXiv","title":"An operator derivation of the Feynman-Vernon theory, with applications to the generating function of bath energy changes and to anharmonic baths"}],"facet_author_name":["2136665_Ryoichi Kawai","2176901_Shiv Kumar Goyal","1017874_Erik Aurell"],"license":[{"license":"arXiv nonexclusive-distrib 1.0","material":"preprint","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["Literature"],"id":"oai:inspirehep.net:3055038","updated":"2025-10-03T16:22:51.793558"},"curated":false,"arxiv_eprints":[{"categories":["quant-ph","cond-mat.stat-mech"],"value":"1907.02671"}]}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=doi%3A10.1088%2F1751-8121%2Fab9274&size=5&page=1&format=cv"}}