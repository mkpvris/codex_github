urated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/251429"}},{"reference":{"publication_info":{"journal_volume":"216","artid":"41","page_start":"41","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/265437"}},{"reference":{"publication_info":{"journal_volume":"234","artid":"276","page_start":"276","journal_title":"Phys.Lett.B"}},"curated_relation":false,"record":{"$ref":"https://inspirehep.net/api/literature/282948"}},{"reference":{"publication_info":{"journal_volume":"49","artid":"24","page_start":"24","journal_title":"Phys.Today"}}}],"number_of_pages":37,"referenced_authors_bais":["Edward.Witten.1","Gregory.L.Landsberg.1","P.F.Mende.1","A.Nicolis.1","C.Deffayet.1","A.I.Vainshtein.1","W.Fischler.1","J.Terning.1","M.Ciafaloni.1","G.Gabadadze.1","Nima.Arkani.Hamed.1","T.Banks.1","David.J.Gross.1","G.R.Dvali.1","A.V.Gruzinov.1","I.Antoniadis.1","J.Khoury.1","V.F.Mukhanov.1","S.D.Thomas.1","Daniele.Amati.1","Hitoshi.Murayama.1","Luigi.Pilo.1","Cesar.Gomez.1","C.Csaki.1","S.B.Giddings.1","C.Grojean.1","P.Provero.1","Francesco.Nitti.1","G.Veneziano.1","R.Rattazzi.1","Stefan.Hofmann.1","S.Dimopoulos.1","Kenichi.Konishi.1","G.Paffuti.1","M.Kolanovic.1"],"legacy_version":"20170307160800.0","inspire_categories":[{"term":"Phenomenology-HEP"},{"term":"Theory-HEP"}],"legacy_creation_date":"2010-10-07","preprint_date":"2010-10","author_count":4,"public_notes":[{"source":"arXiv","value":"37 pages"}],"first_author":{"affiliations_identifiers":[{"schema":"ROR","value":"https://ror.org/05591te55"},{"schema":"ROR","value":"https://ror.org/0079jjr10"},{"schema":"ROR","value":"https://ror.org/01ggx4157"},{"schema":"ROR","value":"https://ror.org/0190ak572"}],"full_name":"Dvali, Gia","last_name":"Dvali","first_name":"Gia","recid":1011120},"control_number":872211,"dois":[{"value":"10.1007/JHEP08(2011)108"}],"earliest_date":"2010-10","document_type":["article"],"texkeys":["Dvali:2010jz"],"abstracts":[{"source":"arXiv","value":"We suggest a novel approach to UV-completion of a class of non-renormalizable theories, according to which the high-energy scattering amplitudes get unitarized by production of extended classical objects (classicalons), playing a role analogous to black holes, in the case of non-gravitational theories. The key property of classicalization is the existence of a classicalizer field that couples to energy-momentum sources. Such localized sources are excited in high-energy scattering processes and lead to the formation of classicalons. Two kinds of natural classicalizers are Nambu-Goldstone bosons (or, equivalently, longitudinal polarizations of massive gauge fields) and scalars coupled to energy-momentum type sources. Classicalization has interesting phenomenological applications for the UV-completion of the Standard Model both with or without the Higgs. In the Higgless Standard Model the high-energy scattering amplitudes of longitudinal $W$-bosons self-unitarize via classicalization, without the help of any new weakly-coupled physics. Alternatively, in the presence of a Higgs boson, classicalization could explain the stabilization of the hierarchy. In both scenarios the high-energy scatterings are dominated by the formation of classicalons, which subsequently decay into many particle states. The experimental signatures at the LHC are quite distinctive, with sharp differences in the two cases.","abstract_source_suggest":{"input":"arXiv"}}],"refereed":true,"primary_arxiv_category":["hep-ph"],"external_system_identifiers":[{"schema":"ADS","value":"2011JHEP...08..108D"},{"schema":"CDS","value":"1298497"},{"schema":"SPIRES","value":"SPIRES-8826722"}],"titles":[{"title":"UV-Completion by Classicalization"},{"source":"arXiv","title":"UV-Completion by Classicalization"}],"facet_author_name":["1003314_Alexandros A. Kehagias","1008045_César Gómez","1008272_Gian Francesco Giudice","1011120_Georgi R. Dvali"],"core":true,"license":[{"imposing":"arXiv","url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"_oai":{"sets":["CERN:arXiv","Literature"],"id":"oai:inspirehep.net:872211","updated":"2023-03-10T08:36:05.761510"},"curated":true,"journal_title_variants":["JHEP"],"arxiv_eprints":[{"categories":["hep-ph"],"value":"1010.1415"}]},"id":"872211","created":"2010-10-07T00:00:00+00:00","updated":"2023-03-10T08:36:05.761510+00:00"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=doi%3A10.1007%2FJHEP08%282011%29108&size=5&page=1&format=cv"}}