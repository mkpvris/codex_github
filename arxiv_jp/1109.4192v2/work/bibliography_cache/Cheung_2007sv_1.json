{"updated":"2023-03-09T22:56:16.016619+00:00","uuid":"4ef00588-5fc2-4ded-b2b7-f0837649bfc8","id":"0709.0295","metadata":{"publication_info":[{"year":2008,"artid":"021","page_start":"021","journal_title":"JCAP","journal_record":{"$ref":"https://inspirehep.net/api/journals/1212538"},"journal_volume":"02"}],"citation_count_without_self_citations":290,"citation_count":313,"core":true,"dois":[{"value":"10.1088/1475-7516/2008/02/021"}],"urls":[{"value":"http://www.iop.org/EJ/abstract/1475-7516/2008/i=02/a=021","description":"JCAP Electronic Journal Server"}],"titles":[{"title":"On the consistency relation of the 3-point function in single field inflation"},{"title":"On the consistency relation of the 3-point function in single field inflation","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"c78438ab-4890-48f0-95b9-0f060bfbba32","record":{"$ref":"https://inspirehep.net/api/authors/1049654"},"full_name":"Cheung, Clifford","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"CANGc","curated_relation":true},{"uuid":"f4f3f17c-60e4-43d7-8b09-dbbd08e2add4","record":{"$ref":"https://inspirehep.net/api/authors/1041347"},"full_name":"Fitzpatrick, A.Liam","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"FATSPATRACa","curated_relation":true},{"uuid":"6d190cb8-f44b-42cf-8358-c10bc1ad7d0c","record":{"$ref":"https://inspirehep.net/api/authors/1055569"},"full_name":"Kaplan, Jared","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"CAPLANj","curated_relation":true},{"uuid":"26f81dd5-9e56-43d9-9ef9-74a6865745e4","record":{"$ref":"https://inspirehep.net/api/authors/1033719"},"full_name":"Senatore, Leonardo","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"SANATARl"}],"curated":true,"texkeys":["Cheung:2007sv"],"citeable":true,"keywords":[{"value":"CMBR theory","source":"author"},{"value":"cosmological perturbation theory","source":"author"},{"value":"inflation","source":"author"},{"value":"inflation","schema":"INSPIRE"},{"value":"n-point function: 3","schema":"INSPIRE"},{"value":"effective Hamiltonian","schema":"INSPIRE"},{"value":"fluctuation: scalar","schema":"INSPIRE"},{"value":"operator: algebra","schema":"INSPIRE"},{"value":"cosmic background radiation","schema":"INSPIRE"},{"value":"slow-roll approximation","schema":"INSPIRE"},{"value":"non-Gaussianity","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"The consistency relation for the 3-point function of the CMB is a very powerful observational signature which is believed to be true for every inflationary model in which there is only one dynamical degree of freedom. Its importance relies on the fact that deviations from it might be detected in next generation experiments, allowing us to rule out all single field inflationary models. After making more precise the already existing proof of the consistency relation, we use a recently developed effective field theory for inflationary perturbations to provide an alternative and very explicit proof valid at leading non trivial order in slow roll parameters.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/600699"},"reference":{"arxiv_eprint":"astro-ph/0210603","publication_info":{"year":2003,"artid":"013","page_start":"013","journal_title":"JHEP","journal_volume":"05"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/635193"},"reference":{"arxiv_eprint":"hep-th/0312100","publication_info":{"year":2004,"artid":"001","page_start":"001","journal_title":"JCAP","journal_volume":"04"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/651897"},