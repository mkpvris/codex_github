{"metadata":{"citation_count":138,"publication_info":[{"year":2011,"artid":"102","page_start":"102","journal_title":"JHEP","journal_record":{"$ref":"https://inspirehep.net/api/journals/1213103"},"journal_volume":"04"}],"citation_count_without_self_citations":117,"core":true,"dois":[{"value":"10.1007/JHEP04(2011)102"}],"titles":[{"title":"The Quantum mechanics of perfect fluids"},{"title":"The quantum mechanics of perfect fluids","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"b0063b92-8921-4b87-b5ac-26db142fb208","record":{"$ref":"https://inspirehep.net/api/authors/1078348"},"full_name":"Endlich, Solomon","affiliations":[{"value":"Columbia U.","record":{"$ref":"https://inspirehep.net/api/institutions/902749"}},{"value":"ISCAP, New York","record":{"$ref":"https://inspirehep.net/api/institutions/908464"}}],"signature_block":"ENDLACHs"},{"uuid":"5578cbca-a5cc-4121-a8c2-cb9b38f52733","record":{"$ref":"https://inspirehep.net/api/authors/995704"},"full_name":"Nicolis, Alberto","affiliations":[{"value":"Columbia U.","record":{"$ref":"https://inspirehep.net/api/institutions/902749"}},{"value":"ISCAP, New York","record":{"$ref":"https://inspirehep.net/api/institutions/908464"}}],"signature_block":"NACALa","curated_relation":true},{"uuid":"cccd7811-17cf-4d26-8fea-121fcda75b8f","record":{"$ref":"https://inspirehep.net/api/authors/992222"},"full_name":"Rattazzi, Riccardo","affiliations":[{"value":"ITPP, Lausanne","record":{"$ref":"https://inspirehep.net/api/institutions/910559"}}],"signature_block":"RATASr","curated_relation":true},{"uuid":"48bbc210-1a88-4f32-aa5e-82b3ea5fed41","record":{"$ref":"https://inspirehep.net/api/authors/1314939"},"full_name":"Wang, Junpu","affiliations":[{"value":"Columbia U.","record":{"$ref":"https://inspirehep.net/api/institutions/902749"}},{"value":"ISCAP, New York","record":{"$ref":"https://inspirehep.net/api/institutions/908464"}}],"signature_block":"WANGj","curated_relation":true}],"curated":true,"texkeys":["Endlich:2010hf"],"citeable":true,"keywords":[{"value":"Sigma Models","source":"author"},{"value":"Spontaneous Symmetry Breaking","source":"author"},{"value":"Nonperturbative Effects","source":"author"},{"value":"Global Symmetries","source":"author"},{"value":"quantization: canonical","schema":"INSPIRE"},{"value":"coupling: derivative","schema":"INSPIRE"},{"value":"fluid: quantum","schema":"INSPIRE"},{"value":"vacuum state: semiclassical","schema":"INSPIRE"},{"value":"strong coupling","schema":"INSPIRE"},{"value":"vortex","schema":"INSPIRE"},{"value":"effective field theory","schema":"INSPIRE"},{"value":"ground state","schema":"INSPIRE"},{"value":"unitarity","schema":"INSPIRE"},{"value":"long-range","schema":"INSPIRE"},{"value":"ultraviolet","schema":"INSPIRE"},{"value":"fluctuation: quantum","schema":"INSPIRE"},{"value":"velocity: acoustic","schema":"INSPIRE"},{"value":"polarization: transverse","schema":"INSPIRE"},{"value":"analysis: dimensional","schema":"INSPIRE"},{"value":"spontaneous symmetry breaking","schema":"INSPIRE"},{"value":"phase space","schema":"INSPIRE"},{"value":"hydrodynamics","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We consider the canonical quantization of an ordinary fluid. The resulting long-distance effective field theory is derivatively coupled, and therefore strongly coupled in the UV. The system however exhibits a number of peculiarities, associated with the vortex degrees of freedom. On the one hand, these have formally a vanishing strong-coupling energy scale, thus suggesting that the effective theory's regime of validity is vanishingly narrow. On the other hand, we prove an analog of Coleman's theorem, whereby the semiclassical vacuum has no quantum counterpart, thus suggesting that the vortex premature strong-coupling phenomenon stems from a bad identification of the ground state and of the perturbative degrees of freedom. Finally, vortices break the usual connection between short distances and high energies, thus potentially impairing the unitarity of the effective theory.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/868595"},"reference":{"arxiv_eprint":"1009.3094","publication_info":{"artid":"075010","journal_title":"New J.Phys.","journal_volume":"13"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/832966"},"reference":{"arxiv_eprint":"0910.0645","publication_info":{"year":2010,"artid":"018","page_start":"018","journal_title":"JHEP","journal_volume":"01"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/700964"},"reference":{"arxiv_eprint":"hep-th/0512260","publication_info":{"year":2006,"artid":"025","page_start":"025","journal_title":"JHEP","journal_volume":"03"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/635192"},"reference":{"arxiv_eprint":"hep-th/0312099","publication_info":{"year":2004,"artid":"074","page_start":"074","journal_title":"JHEP","journal_volume":"05"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/83738"},"reference":{"publication_info":{"artid":"259","page_start":"259","journal_title":"Commun.Math.Phys.","journal_volume":"31"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/130919"},"reference":{"publication_info":{"artid":"110","page_start":"110","journal_title":"Nucl.Phys.B","journal_volume":"145"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/787731"},"reference":{"arxiv_eprint":"0806.1534","publication_info":{"year":2008,"artid":"092","page_start":"092","journal_title":"JHEP","journal_volume":"12"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/651094"},"reference":{"arxiv_eprint":"hep-th/0405231","publication_info":{"artid":"111601","journal_title":"Phys.Rev.Lett.","journal_volume":"94"}},"curated_relation":false}],"arxiv_eprints":[{"valu