sor modes from inflation does not automatically constitute a determination of the inflationary Hubble scale.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/428039"},"reference":{"arxiv_eprint":"astro-ph/9609170","publication_info":{"artid":"1830","page_start":"1830","journal_title":"Phys.Rev.D","journal_volume":"55"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/426082"},"reference":{"arxiv_eprint":"astro-ph/9611125","publication_info":{"artid":"7368","page_start":"7368","journal_title":"Phys.Rev.D","journal_volume":"55"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/770093"},"reference":{"arxiv_eprint":"0712.1513","publication_info":{"artid":"1423","page_start":"1423","journal_title":"Nuovo Cim.B","journal_volume":"122"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/711725"},"reference":{"arxiv_eprint":"astro-ph/0603118","publication_info":{"artid":"204","page_start":"204","journal_title":"Prog.Theor.Phys.Suppl.","journal_volume":"163"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/713842"},"reference":{"arxiv_eprint":"astro-ph/0604101"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/922831"},"reference":{"arxiv_eprint":"1108.2043"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/419887"},"reference":{"arxiv_eprint":"hep-ph/9606387","publication_info":{"artid":"1861","page_start":"1861","journal_title":"Phys.Rev.Lett.","journal_volume":"78"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/678454"},"reference":{"arxiv_eprint":"astro-ph/0503360","publication_info":{"year":2005,"artid":"008","page_start":"008","journal_title":"JCAP","journal_volume":"05"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/851750"},"reference":{"arxiv_epri