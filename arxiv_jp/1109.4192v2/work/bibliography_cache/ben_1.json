{"id":"hep-ph/0604255","created":"2006-04-30T00:00:00+00:00","metadata":{"citation_count_without_self_citations":102,"citation_count":111,"publication_info":[{"year":2007,"artid":"041601","journal_title":"Phys.Rev.Lett.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"journal_volume":"98"}],"report_numbers":[{"value":"UCSD-PTH-06-06"},{"value":"UTTTG-06-06"},{"value":"CMUHEP-06-07"}],"core":true,"dois":[{"value":"10.1103/PhysRevLett.98.041601"}],"titles":[{"title":"Falsifying Models of New Physics via WW Scattering"},{"title":"Falsifying String Theory Through WW Scattering"},{"title":"Falsifying Models of New Physics Via WW Scattering","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"81a61e23-d0ef-4324-9511-14770236279c","record":{"$ref":"https://inspirehep.net/api/authors/1011716"},"full_name":"Distler, Jacques","affiliations":[{"value":"Texas U.","record":{"$ref":"https://inspirehep.net/api/institutions/903264"}}],"signature_block":"DASTLARj"},{"uuid":"fca13c26-59b9-4b1c-bddb-510fbeaf0159","record":{"$ref":"https://inspirehep.net/api/authors/1007511"},"full_name":"Grinstein, Benjamin","affiliations":[{"value":"UC, San Diego","record":{"$ref":"https://inspirehep.net/api/institutions/903305"}}],"signature_block":"GRANSTANb","curated_relation":true},{"uuid":"5b9a892d-4026-470d-afbf-df2abc692d44","record":{"$ref":"https://inspirehep.net/api/authors/992929"},"full_name":"Porto, Rafael A.","affiliations":[{"value":"Carnegie Mellon U.","record":{"$ref":"https://inspirehep.net/api/institutions/902719"}}],"signature_block":"PARTr","curated_relation":true},{"uuid":"23cab755-33e9-4024-a585-a2c9f2407022","record":{"$ref":"https://inspirehep.net/api/authors/991142"},"full_name":"Rothstein, Ira Z.","affiliations":[{"value":"Carnegie Mellon U.","record":{"$ref":"https://inspirehep.net/api/institutions/902719"}}],"signature_block":"RATHSTANi","curated_relation":true}],"curated":true,"texkeys":["Distler:2006if"],"citeable":true,"keywords":[{"value":"12.15.Ji","schema":"PACS"},{"value":"12.60.Fr","schema":"PACS"},{"value":"11.55.-m","schema":"PACS"},{"value":"11.25.Wx","schema":"PACS"},{"value":"string model","schema":"INSPIRE"},{"value":"W W: scattering","schema":"INSPIRE"},{"value":"decoupling","schema":"INSPIRE"},{"value":"analytic properties","schema":"INSPIRE"},{"value":"unitarity","schema":"INSPIRE"},{"value":"effective Lagrangian","schema":"INSPIRE"},{"value":"scattering amplitude: forward scattering","schema":"INSPIRE"},{"value":"sigma model: nonlinear","schema":"INSPIRE"},{"value":"dispersion relation","schema":"INSPIRE"},{"value":"electroweak interaction: symmetry breaking","schema":"INSPIRE"},{"value":"invariance: Lorentz","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We show that the coefficients of operators in the electroweak chiral Lagrangian can be bounded if the underlying theory obeys the usual assumptions of Lorentz invariance, analyticity, unitarity and crossing to arbitrarily short distances. Violations of these bounds can be explained by either the existence of new physics below the naive cut-off of the the effective theory, or by the breakdown of one of these assumptions in the short distance theory. As a corollary, if no light resonances are found, then a measured violation of the bound would falsify generic models of string theory.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/214780"},"reference":{"publication_info":{"artid":"3027","page_start":"3027","journal_title":"Phys.Rev.D","journal_volume":"31"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/378468"},"reference":{"arxiv_eprint":"hep-ph/9410302","publication_info":{"artid":"1093","page_start":"1093","journal_title":"Phys.Rev.D","journal_volume":"51"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/377370"},"reference":{"arxiv_eprint":"hep-ph/9409426","public