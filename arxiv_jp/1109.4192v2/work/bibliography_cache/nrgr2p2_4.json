{"updated":"2023-03-06T16:00:00.622128+00:00","uuid":"91c5b10f-08a5-45a7-b952-6722505d2568","created":"2007-12-12T00:00:00+00:00","revision_id":87,"links":{"bibtex":"https://inspirehep.net/api/arxiv/0712.2032?format=bibtex","latex-eu":"https://inspirehep.net/api/arxiv/0712.2032?format=latex-eu","latex-us":"https://inspirehep.net/api/arxiv/0712.2032?format=latex-us","json":"https://inspirehep.net/api/arxiv/0712.2032?format=json","json-expanded":"https://inspirehep.net/api/arxiv/0712.2032?format=json-expanded","cv":"https://inspirehep.net/api/arxiv/0712.2032?format=cv"},"id":"0712.2032","metadata":{"citation_count_without_self_citations":41,"citation_count":56,"core":true,"titles":[{"title":"Comment on `On the next-to-leading order gravitational spin(1) - spin(2) dynamics' by J. Steinhoff et al"},{"title":"Comment on `On the next-to-leading order gravitational spin(1)-spin(2) dynamics' by J. Steinhoff et al","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"46feb716-69a2-4043-a62e-5297de2f0a8f","record":{"$ref":"https://inspirehep.net/api/authors/992929"},"full_name":"Porto, Rafael A.","affiliations":[{"value":"UC, Santa Barbara","record":{"$ref":"https://inspirehep.net/api/institutions/903307"}}],"signature_block":"PARTr","curated_relation":true},{"uuid":"1e4c6a42-9662-454b-838b-cfa4ba5a39c6","record":{"$ref":"https://inspirehep.net/api/authors/991142"},"full_name":"Rothstein, Ira Z.","affiliations":[{"value":"Carnegie Mellon U.","record":{"$ref":"https://inspirehep.net/api/institutions/902719"}}],"signature_block":"RATHSTANi","curated_relation":true}],"curated":true,"texkeys":["Porto:2007tt"],"citeable":true,"keywords":[{"value":"spin: potential","schema":"INSPIRE"},{"value":"effective field theory","schema":"INSPIRE"},{"value":"spin: orbit","schema":"INSPIRE"}],"abstracts":[{"value":"In this comment we explain the discrepancy found between the results in arXiv:0712.1716v1 for the 3PN spin-spin potential and those previously derived in gr-qc/0604099. We point out that to compare one must include sub-leading lower order spin-orbit effects which contribute to the spin-spin potential once one transforms to the PN frame. When these effects are included the results in arXiv:0712.1716v1 do indeed reproduce those found in gr-qc/0604099.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/715168"},"reference":{"arxiv_eprint":"gr-qc/0604099","publication_info":{"artid":"021101","journal_title":"Phys.Rev.Lett.","journal_volume":"97"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/659452"},"reference":{"arxiv_eprint":"hep-th/0409156","publication_info":{"artid":"104029","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697886"},"reference":{"arxiv_eprint":"hep-th/0511133","publication_info":{"artid":"104030","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742566"},"reference":{"arxiv_eprint":"hep-ph/0701129"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697837"},"reference":{"arxiv_eprint":"gr-qc/0511061","publication_info":{"artid":"104031","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/770180"},"reference":{"arxiv_eprint":"0712.1716","publication_info":{"artid":"081501","journal_title":"Phys.Rev.D","journal_volume":"77"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742662"},"reference":{"arxiv_eprint":"gr-qc/0701106"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/877"},"reference":{"publication_info":{"artid":"498","page_start":"498","journal_title":"Annals Phys.","journal_volume":"87"}},"curated_relation":false}],"arxiv_eprints":[{"value":"07