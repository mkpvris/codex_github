{"id":"1102.5343","created":"2011-02-28T00:00:00+00:00","metadata":{"citation_count_without_self_citations":214,"citation_count":246,"publication_info":[{"year":2011,"artid":"014","page_start":"014","journal_title":"JCAP","journal_record":{"$ref":"https://inspirehep.net/api/journals/1212538"},"journal_volume":"09"}],"core":true,"dois":[{"value":"10.1088/1475-7516/2011/09/014"}],"titles":[{"title":"Equilateral Non-Gaussianity and New Physics on the Horizon"},{"title":"Equilateral Non-Gaussianity and New Physics on the Horizon","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"e83d52ff-4de6-48c4-93dc-e90d439e851e","record":{"$ref":"https://inspirehep.net/api/authors/1070506"},"full_name":"Baumann, Daniel","affiliations":[{"value":"Princeton, Inst. Advanced Study","record":{"$ref":"https://inspirehep.net/api/institutions/903138"}}],"signature_block":"BANANd","curated_relation":true},{"uuid":"137862e9-dcb6-4956-ad94-ec96636d9184","record":{"$ref":"https://inspirehep.net/api/authors/1058157"},"full_name":"Green, Daniel","affiliations":[{"value":"Princeton, Inst. Advanced Study","record":{"$ref":"https://inspirehep.net/api/institutions/903138"}}],"signature_block":"GRANd","curated_relation":true}],"curated":true,"license":[{"url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","imposing":"arXiv"}],"texkeys":["Baumann:2011su"],"citeable":true,"keywords":[{"value":"perturbation: scalar","schema":"INSPIRE"},{"value":"velocity: acoustic","schema":"INSPIRE"},{"value":"non-Gaussianity: primordial","schema":"INSPIRE"},{"value":"new physics","schema":"INSPIRE"},{"value":"inflation","schema":"INSPIRE"},{"value":"effective field theory","schema":"INSPIRE"},{"value":"time: anisotropy","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We examine the effective theory of single-field inflation in the limit where the scalar perturbations propagate with a small speed of sound. In this case the non-linearly realized time-translation symmetry of the Lagrangian implies large interactions, giving rise to primordial non-Gaussianities. When the non-Gaussianities are measurable, these interactions will become strongly coupled unless new physics appears close to the Hubble scale. Due to its proximity to the Hubble scale, the new physics is not necessarily decoupled from inflationary observables and can potentially affect the predictions of the model. To understand the types of corrections that may arise, we construct weakly-coupled completions of the theory and study their observational signatures.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/133288"},"reference":{"publication_info":{"artid":"327","page_start":"327","journal_title":"Physica A","journal_volume":"96"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/759730"},"reference":{"arxiv_eprint":"0709.0293","publication_info":{"year":2008,"artid":"014","page_start":"014","journal_title":"JHEP","journal_volume":"03"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/719001"},"reference":{"arxiv_eprint":"hep-th/0606090","publication_info":{"year":2006,"artid":"080","page_start":"080","journal_title":"JHEP","journal_volume":"12"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/867596"},"reference":{"arxiv_eprint":"1009.2093"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/119348"},"reference":{"publication_info":{"artid":"1519","page_start":"1519","journal_title":"Phys.Rev.D","journal_volume":"16"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/118829"},"reference":{"publication_info":{"artid":"883","page_start":"883","journal_title":"Phys.Rev.Lett.","journal_volume":"38"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/154280"},"reference":{"publication_info":{"artid":"347","page_star