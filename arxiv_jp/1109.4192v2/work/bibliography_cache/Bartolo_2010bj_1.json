net/files/97fe2bb74750c8d3302dbbdf568aa45e","source":"arxiv","caption":"exact DBI configuration on the left; approximated ghost shape on the right.","filename":"Mb9ghostx.png"},{"key":"748c97a8a4406cbebc1d103d0358a217","url":"https://inspirehep.net/files/748c97a8a4406cbebc1d103d0358a217","source":"arxiv","caption":"$A$ on the left, $B$ configuration on the right for the $\\bar M_9$-driven interaction term.","filename":"Mb9g1x.png"},{"key":"d2ab56f4d7f881cb1adb2c3c9c6e06f7","url":"https://inspirehep.net/files/d2ab56f4d7f881cb1adb2c3c9c6e06f7","source":"arxiv","caption":"$A$ on the left, $B$ configuration on the right for the $\\bar M_9$-driven interaction term.","filename":"Mb9g2x.png"}],"license":[{"url":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","imposing":"arXiv"}],"texkeys":["Bartolo:2010bj"],"citeable":true,"keywords":[{"value":"inflation","schema":"INSPIRE"},{"value":"effective field theory","schema":"INSPIRE"},{"value":"non-Gaussianity","schema":"INSPIRE"},{"value":"correlation function","schema":"INSPIRE"},{"value":"power spectrum","schema":"INSPIRE"},{"value":"curvature","schema":"INSPIRE"},{"value":"differential equations: solution","schema":"INSPIRE"},{"value":"amplitude analysis","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"ghost","schema":"INSPIRE"},{"value":"parameter space","schema":"INSPIRE"},{"value":"event shape analysis","schema":"INSPIRE"},{"value":"numerical calculations","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"The methods of effective field theory are used to study generic theories of inflation with a single inflaton field and to perform a general analysis of the associated non-Gaussianities. We investigate the amplitudes and shapes of the various generic three-point correlators, the bispectra, which may be generated by different classes of single-field inflationary models. Besides the well-known results for the DBI-like models and the ghost inflationary theories, we point out that curvature-related interactions may give rise to large non-Gaussianities in the form of bispectra characterized by a flat shape which, quite interestingly, is independently produced by several interaction terms. In a subsequent work, we will perform a similar general analysis for the non-Gaussianities generated by the generic four-point correlator, the trispectrum.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/333970"},"reference":{"publication_info":{"artid":"L1","page_start":"L1","journal_title":"Astrophys.J.","journal_volume":"396"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/415293"},"reference":{"arxiv_eprint":"astro-ph/9601067","publication_info":{"artid":"L1","page_start":"L1","journal_title":"Astrophys.J.","journal_volume":"464"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/415294"},"reference":{"arxiv_eprint":"astro-ph/9601063","publication_info":{"artid":"L11","page_start":"L11","journal_title":"Astrophys.J.","journal_volume":"464"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/679335"},"reference":{"arxiv_eprint":"astro-ph/0503669","publication_info":{"artid":"25","page_start":"25","journal_title":"Nucl.Phys.B","journal_volume":"747"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/712597"},"reference":{"arxiv_eprint":"astro-ph/0603449","publication_info":{"artid":"377","page_start":"377","journal_title":"Astrophys.J.Suppl.","journal_volume":"170"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/780697"},"reference":{"arxiv_eprint":"0803.0547","publication_info":{"artid":"330","page_start":"330","journal_title":"Astrophys.J.Suppl.","journal_volume":"180"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/843543"},"reference":{"arxiv_eprint":"1001.4538","publication_info":{"artid":"18","pag