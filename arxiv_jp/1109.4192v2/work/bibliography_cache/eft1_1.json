ep.net/api/authors/1041347"},"full_name":"Fitzpatrick, A.Liam","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"FATSPATRACa","curated_relation":true},{"uuid":"c99345c0-fb36-4fe3-b5b8-49ebb88dd294","record":{"$ref":"https://inspirehep.net/api/authors/1055569"},"full_name":"Kaplan, Jared","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"CAPLANj","curated_relation":true},{"uuid":"866539db-c404-44a0-9a49-2ff0db86673a","record":{"$ref":"https://inspirehep.net/api/authors/1033719"},"full_name":"Senatore, Leonardo","affiliations":[{"value":"Harvard U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/908519"}}],"signature_block":"SANATARl"}],"curated":true,"texkeys":["Cheung:2007st"],"citeable":true,"keywords":[{"value":"gravitation: action","schema":"INSPIRE"},{"value":"space-time: de Sitter","schema":"INSPIRE"},{"value":"fluctuation","schema":"INSPIRE"},{"value":"inflation: effective field theory","schema":"INSPIRE"},{"value":"ghost: condensation","schema":"INSPIRE"},{"value":"field equations: solution","schema":"INSPIRE"},{"value":"diffeomorphism","schema":"INSPIRE"},{"value":"Goldstone particle","schema":"INSPIRE"},{"value":"non-Gaussianity","schema":"INSPIRE"},{"value":"velocity: acoustic","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We study the effective field theory of inflation, i.e. the most general theory describing the fluctuations around a quasi de Sitter background, in the case of single field models. The scalar mode can be eaten by the metric by going to unitary gauge. In this gauge, the most general theory is built with the lowest dimension operators invariant under spatial diffeomorphisms, like g^{00} and K_{mu nu}, the extrinsic curvature of constant time surfaces. This approach allows us to characterize all the possible high energy corrections to simple slow-roll inflation, whose sizes are constrained by experiments. Also, it describes in a common language all single field models, including those with a small speed of sound and Ghost Inflation, and it makes explicit the implications of having a quasi de Sitter background. The non-linear realization of time diffeomorphisms forces correlation among different observables, like a reduced speed of sound and an enhanced level of non-Gaussianity.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/648032"},"reference":{"arxiv_eprint":"hep-th/0404084","publication_info":{"artid":"123505","journal_title":"Phys.Rev.D","journal_volume":"70"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/675471"},"reference":{"arxiv_eprint":"hep-th/0501184","publication_info":{"year":2005,"artid":"045","page_start":"045","journal_title":"JHEP","journal_volume":"08"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/715300"},"reference":{"arxiv_eprint":"hep-th/0604186","publication_info":{"year":2006,"artid":"010","page_start":"010","journal_title":"JCAP","journal_volume":"11"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/708649"},"reference":{"arxiv_eprint":"hep-th/0601099","publication_info":{"year":2006,"artid":"007","page_start":"007","journal_title":"JCAP","journal_volume":"05"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/717312"},"reference":{"arxiv_eprint":"hep-th/0605189","publication_info":{"year":2006,"artid":"076","page_start":"076","journal_title":"JHEP","journal_volume":"09"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/729001"},"reference":{"arxiv_eprint":"hep-th/0610151","publication_info":{"artid":"051301","journal_title":"Phys.Rev.Lett.","journal_volume":"98"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literatu