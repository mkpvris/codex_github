{"metadata":{"citation_count_without_self_citations":367,"citation_count":441,"publication_info":[{"year":1995,"page_end":"1915","page_start":"1912","journal_title":"Phys.Rev.Lett.","journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"journal_volume":"74"}],"report_numbers":[{"value":"AZPH-TH-94-8"}],"core":true,"dois":[{"value":"10.1103/PhysRevLett.74.1912"}],"titles":[{"title":"Thermally induced density perturbations in the inflation era"},{"title":"Thermally Induced Density Perturbations in the Inflation Era","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"dc9d9101-aede-4cb9-aba1-12b94c815749","record":{"$ref":"https://inspirehep.net/api/authors/1016688"},"full_name":"Berera, Arjun","affiliations":[{"value":"Arizona U.","record":{"$ref":"https://inspirehep.net/api/institutions/902647"}}],"signature_block":"BARARa"},{"uuid":"c3fade74-1e83-4723-8ec9-dc64d43f667d","record":{"$ref":"https://inspirehep.net/api/authors/1027907"},"full_name":"Fang, Li-Zhi","affiliations":[{"value":"Arizona U.","record":{"$ref":"https://inspirehep.net/api/institutions/902647"}}],"signature_block":"FANGl","curated_relation":true}],"curated":true,"texkeys":["Berera:1995wh"],"citeable":true,"keywords":[{"value":"inflation","schema":"INSPIRE"},{"value":"density: perturbation","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"temperature: fluctuation","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"The possibility of thermally induced initial density perturbations in inflationary cosmology is examined. The fluctuation dynamics of a scalar field plus thermal bath system during slow roll is described by a Langevin-like equation. Fluctuation-dissipation arguments show that for a wide parameter range within the standard inflation model, the thermal fluctuations of the scalar field can dominate its quantum fluctuations. The initial amplitude of density perturbations is found to lie in a range which is consistent with the recent observations of cosmic temperature fluctuations.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/333970"},"reference":{"publication_info":{"artid":"L1","page_start":"L1","journal_title":"Astrophys.J.","journal_volume":"396"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/13328"},"reference":{"publication_info":{"artid":"679","page_start":"679","journal_title":"Phys.Rev.D","journal_volume":"28"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/196244"},"reference":{"publication_info":{"artid":"177","page_start":"177","journal_title":"Phys.Lett.B","journal_volume":"129"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"2172","page_start":"2172","journal_title":"Phys.Rev.D","journal_volume":"28"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/827"},"reference":{"publication_info":{"artid":"3357","page_start":"3357","journal_title":"Phys.Rev.D","journal_volume":"9"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/231225"},"reference":{"publication_info":{"artid":"706","page_start":"706","journal_title":"Nucl.Phys.B","journal_volume":"284"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/299256"},"reference":{"publication_info":{"artid":"1005","page_start":"1005","journal_title":"Phys.Rev.D","journal_volume":"43"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/37039"},"reference":{"arxiv_eprint":"astro-ph/9401023","publication_info":{"artid":"458","page_start":"458","journal_title":"Phys.Rev.Lett.","journal_volume":"72"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"342","page_start":"342","journal_title":"Phys.Rev.Lett.","journal_volume":"56"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/147727"},"reference":{"publication_info":{"artid"