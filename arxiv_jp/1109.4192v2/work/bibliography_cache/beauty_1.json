ord":{"$ref":"https://inspirehep.net/api/institutions/903206"}}],"signature_block":"Lx","curated_relation":true},{"uuid":"1aa2c69a-462b-4911-a3a7-54911c72f6c9","record":{"$ref":"https://inspirehep.net/api/authors/1020466"},"full_name":"Maloney, Alexander","affiliations":[{"value":"Stanford U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/903222"}},{"value":"SLAC","record":{"$ref":"https://inspirehep.net/api/institutions/903206"}}],"signature_block":"MALANYa","curated_relation":true},{"uuid":"5ecfa376-4ea5-48d9-b5f4-ad564302a656","record":{"$ref":"https://inspirehep.net/api/authors/1020224"},"full_name":"McAllister, Liam","affiliations":[{"value":"Stanford U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/903222"}},{"value":"SLAC","record":{"$ref":"https://inspirehep.net/api/institutions/903206"}}],"signature_block":"MCALASTARl","curated_relation":true},{"uuid":"78b63000-68a3-4270-89ff-90054783186e","record":{"$ref":"https://inspirehep.net/api/authors/988667"},"full_name":"Silverstein, Eva","affiliations":[{"value":"Stanford U., Phys. Dept.","record":{"$ref":"https://inspirehep.net/api/institutions/903222"}},{"value":"SLAC","record":{"$ref":"https://inspirehep.net/api/institutions/903206"}}],"signature_block":"SALVARSTANe","curated_relation":true}],"curated":true,"texkeys":["Kofman:2004yc"],"citeable":true,"keywords":[{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"particle: production","schema":"INSPIRE"},{"value":"membrane model: D-brane","schema":"INSPIRE"},{"value":"moduli space","schema":"INSPIRE"},{"value":"inflation","schema":"INSPIRE"},{"value":"acceleration","schema":"INSPIRE"},{"value":"string model","schema":"INSPIRE"},{"value":"vacuum state","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We study quantum effects on moduli dynamics arising from the production of particles which are light at special points in moduli space. The resulting forces trap the moduli at these points, which often exhibit enhanced symmetry. Moduli trapping occurs in time-dependent quantum field theory, as well as in systems of moving D-branes, where it leads the branes to combine into stacks. Trapping also occurs in an expanding universe, though the range over which the moduli can roll is limited by Hubble friction. We observe that a scalar field trapped on a steep potential can induce a stage of acceleration of the universe, which we call trapped inflation. Moduli trapping ameliorates the cosmological moduli problem and may affect vacuum selection. In particular, rolling moduli are most powerfully attracted to the points with the largest number of light particles, which are often the points of greatest symmetry. Given suitable assumptions about the dynamics of the very early universe, this effect might help to explain why among the plethora of possible vacuum states of string theory, we appear to live in one with a large number of light particles and (spontaneously broken) symmetries. In other words, some of the surprising properties of our world might arise not through pure chance or miraculous cancellations, but through a natural selection mechanism during dynamical evolution."}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/442654"},"reference":{"arxiv_eprint":"hep-ph/9704452","publication_info":{"artid":"3258","page_start":"3258","journal_title":"Phys.Rev.D","journal_volume":"56"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/480683"},"reference":{"arxiv_eprint":"hep-ph/9812289","publication_info":{"artid":"123523","journal_title":"Phys.Rev.D","journal_volume":"59"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/496766"},"reference":{"arxiv_eprint":"hep-ph/9903350","publication_info":{"artid":"103505","journal_title":"Phys.Rev.D","journal_volume":"60"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/508964"},"reference":{"arxiv_e