{"updated":"2023-03-07T03:46:11.474563+00:00","created":"2002-05-14T00:00:00+00:00","revision_id":91,"id":"astro-ph/0205152","metadata":{"citation_count_without_self_citations":78,"publication_info":[{"year":2002,"artid":"043510","journal_title":"Phys.Rev.D","journal_volume":"66"}],"citation_count":105,"core":true,"dois":[{"value":"10.1103/PhysRevD.66.043510"}],"titles":[{"title":"Non-Gaussian signatures in the cosmic background radiation from warm inflation"},{"title":"NONGAUSSIAN"},{"title":"Non-Gaussian signatures in the cosmic background radiation from warm inflation.","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"90c4c80d-9cfc-40ab-9a65-d929a335666d","record":{"$ref":"https://inspirehep.net/api/authors/1042042"},"full_name":"Gupta, Sujata","affiliations":[{"value":"Edinburgh U., Inst. Astron.","record":{"$ref":"https://inspirehep.net/api/institutions/908036"}}],"signature_block":"GAPTs"},{"uuid":"5fc7a5d4-3ad1-404b-ab0d-55e64d299d72","record":{"$ref":"https://inspirehep.net/api/authors/1016688"},"full_name":"Berera, A.","affiliations":[{"value":"Edinburgh U.","record":{"$ref":"https://inspirehep.net/api/institutions/902787"}}],"signature_block":"BARARa"},{"uuid":"1bb950aa-bb39-4226-b974-2242008874d4","record":{"$ref":"https://inspirehep.net/api/authors/1026136"},"full_name":"Heavens, A.F.","affiliations":[{"value":"Edinburgh U., Inst. Astron.","record":{"$ref":"https://inspirehep.net/api/institutions/908036"}}],"signature_block":"HAVANa"},{"uuid":"dd8cd0a2-d412-409e-be11-b81947723807","record":{"$ref":"https://inspirehep.net/api/authors/998433"},"full_name":"Matarrese, S.","affiliations":[{"value":"Padua U.","record":{"$ref":"https://inspirehep.net/api/institutions/903113"}},{"value":"INFN, Padua","record":{"$ref":"https://inspirehep.net/api/institutions/902884"}}],"signature_block":"MATARASs","curated_relation":true}],"curated":true,"texkeys":["Gupta:2002kn"],"citeable":true,"keywords":[{"value":"98.70.Vc","schema":"PACS"},{"value":"98.80.Cq","schema":"PACS"},{"value":"98.80.Es","schema":"PACS"},{"value":"inflation","schema":"INSPIRE"},{"value":"cosmic background radiation","schema":"INSPIRE"},{"value":"graviton: fluctuation","schema":"INSPIRE"},{"value":"spectrum: fluctuation","schema":"INSPIRE"},{"value":"potential: dissipation","schema":"INSPIRE"},{"value":"field theory: scalar","schema":"INSPIRE"},{"value":"statistics: perturbation","schema":"INSPIRE"},{"value":"bibliography","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We calculate the bispectrum of the gravitational field fluctuations generated during warm inflation, where dissipation of the vacuum potential during inflation is the mechanism for structure formation. The bispectrum is non--zero because of the self--interaction of the scalar field. We compare the predictions with those of standard, or `supercooled', inflationary models, and consider the detectability of these levels of non--Gaussianity in the bispectrum of the cosmic microwave background. We find that the levels of non--Gaussianity for warm and supercooled inflation are comparable, and over--ridden by the contribution to the bispectrum due to other physical effects. We also conclude that the resulting bispectrum values will be undetectable in the cosmic microwave background for both the MAP and Planck Surveyor satellites.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/361128"},"reference":{"arxiv_eprint":"astro-ph/9312033","publication_info":{"artid":"447","page_start":"447","journal_title":"Astrophys.J.","journal_volume":"430"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"141","page_start":"141","journal_title":"Mon.Not.Roy.Astron.Soc.","journal_volume":"313"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/504977"},"reference":{"arxiv_eprint":"astro-ph/9907431","publication_info":{"artid":"063504","journal_title":"Phys.Rev.D","journal_volume":"61"}},"cu