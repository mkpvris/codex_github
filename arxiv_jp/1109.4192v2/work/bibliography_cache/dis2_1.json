{"revision_id":88,"metadata":{"citation_count":146,"publication_info":[{"year":2008,"artid":"064026","journal_title":"Phys.Rev.D","journal_volume":"77"}],"citation_count_without_self_citations":111,"core":true,"dois":[{"value":"10.1103/PhysRevD.77.064026"}],"titles":[{"title":"Absorption effects due to spin in the worldline approach to black hole dynamics"},{"title":"Absorption Effects due to Spin in the Worldline Approach to Black Hole Dynamics","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"848b9050-6015-4418-9ede-2ad176f2183e","record":{"$ref":"https://inspirehep.net/api/authors/992929"},"full_name":"Porto, Rafael A.","affiliations":[{"value":"UC, Santa Barbara","record":{"$ref":"https://inspirehep.net/api/institutions/903307"}}],"signature_block":"PARTr","curated_relation":true}],"curated":true,"figures":[{"key":"ac0b9ddadb7f5ecdfb1bb2d71c9db00f","url":"https://inspirehep.net/files/ac0b9ddadb7f5ecdfb1bb2d71c9db00f","source":"arxiv","caption":"Feynman diagram whose imaginary part gives the leading order contribution to the absorptive cross section. The dots correspond to insertions of leading multipole worldline operators.","filename":"abs.png"},{"key":"3df138ad32c235dd4e0dcec15053d182","url":"https://inspirehep.net/files/3df138ad32c235dd4e0dcec15053d182","source":"arxiv","caption":"Leading order contribution to the absorptive potential. The dots correspond to insertions of the leading worldline multipole operators.","filename":"abspot.png"}],"texkeys":["Porto:2007qi"],"citeable":true,"keywords":[{"value":"04.25.Nx","schema":"PACS"},{"value":"04.70.Bw","schema":"PACS"},{"value":"04.62.+v","schema":"PACS"},{"value":"black hole: rotation","schema":"INSPIRE"},{"value":"absorption: effect","schema":"INSPIRE"},{"value":"cross section: absorption","schema":"INSPIRE"},{"value":"gravitation: absorption","schema":"INSPIRE"},{"value":"space-time: background","schema":"INSPIRE"},{"value":"neutron star: rotation","schema":"INSPIRE"},{"value":"graviton: absorption","schema":"INSPIRE"},{"value":"spin","schema":"INSPIRE"},{"value":"binary","schema":"INSPIRE"},{"value":"correlation function","schema":"INSPIRE"},{"value":"nonrelativistic","schema":"INSPIRE"},{"value":"superradiance","schema":"INSPIRE"},{"value":"enhancement","schema":"INSPIRE"},{"value":"dissipation","schema":"INSPIRE"},{"value":"velocity","schema":"INSPIRE"}],"refereed":true,"abstracts":[{"value":"We generalize the effective point particle approach to black hole dynamics to include spin. In this approach dissipative effects are captured by degrees of freedom localized on the wordline. The absorptive properties of the black hole are determined by correlation functions which can be matched with the graviton absorption cross section in the long wavelength approximation. For rotating black holes, superradiance is responsible for the leading contribution. The effective theory is then used to predict the power loss due to spin in the dynamics of non-relativistic binary systems. An enhancement of three powers of the relative velocity is found with respect to the non-rotating case. Then we generalize the results to other type of constituents in the binary system, such as rotating neutron stars. Finally we compute the power loss absorbed by a test spinning black hole in a given spacetime background.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/626735"},"reference":{"arxiv_eprint":"hep-ph/0308266"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/659452"},"reference":{"arxiv_eprint":"hep-th/0409156","publication_info":{"artid":"104029","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742566"},"reference":{"arxiv_eprint":"hep-ph/0701129"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697837"},"reference":{"arxiv_eprint":"gr-qc/0511061","publication_info":{"artid":"104031","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742661"},"reference":{"arxiv_eprint":"gr-qc/0701105"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/715168"},"reference":{"arxiv_eprint":"gr-qc/0604099","publication_info":{"artid":"021101","journal_title":"Phys.Rev.Lett.","journal_volume":"97"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742662"},"reference":{"arxiv_eprint":"gr-qc/0701106"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697886"},"reference":{"arxiv_eprint":"hep-th/0511133","publication_info":{"artid":"104030","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"3","page_start":"3","journal_title":"Zh.Eksp.Teor.Fiz.","journal_volume":"65"}}},{"record":{"$ref":"https://inspirehep.net/api/literature/113270"},"reference":{"publication_info":{"artid":"198","page_start":"198","journal_title":"Phys.Rev.D","journal_volume":"13"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/381190"},"reference":{"arxiv_eprint":"gr-qc/9412027","publication_info":{"artid":"5753","page_start":"5753","journal_title":"Phys.Rev.D","journal_volume":"51"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/451524"},"reference":{"arxiv_eprint":"gr-qc/9711072","publication_info":{"artid":"829","page_start":"829","journal_title":"Prog.Theor.Phys.","journal_volume":"98"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/654316"},"reference":{"arxiv_eprint":"gr-qc/0407050","publication_info":{"artid":"084044","journal_title":"Phys.Rev.D","journal_volume":"70"}},"curated_relation":false},{"reference":{"publication_info":{"artid":"270","page_start":"270","journal_title":"Zh.Eksp.Teor