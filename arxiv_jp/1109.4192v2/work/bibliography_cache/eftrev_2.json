{"created":"2007-01-18T00:00:00+00:00","revision_id":87,"metadata":{"citation_count_without_self_citations":13,"citation_count":27,"publication_info":[{"cnum":"C06-07-31.1","conference_record":{"$ref":"https://inspirehep.net/api/conferences/977514"}}],"titles":[{"title":"Scalar gravity: Post-Newtonian corrections via an effective field theory approach"},{"title":"POSTNEWTONIAN"},{"title":"Scalar gravity: Post-Newtonian corrections via an effective field theory approach","source":"arXiv"}],"$schema":"https://inspirehep.net/schemas/records/hep.json","authors":[{"uuid":"e29d4cf7-3789-40e3-ba49-d98cf94393e3","record":{"$ref":"https://inspirehep.net/api/authors/992929"},"full_name":"Porto, Rafael A.","affiliations":[{"value":"Carnegie Mellon U.","record":{"$ref":"https://inspirehep.net/api/institutions/902719"}}],"signature_block":"PARTr","curated_relation":true},{"uuid":"a658a3f2-8b62-48af-9b51-0102b99388ab","record":{"$ref":"https://inspirehep.net/api/authors/1039870"},"full_name":"Sturani, Riccardo","affiliations":[{"value":"Geneva U.","record":{"$ref":"https://inspirehep.net/api/institutions/902813"}},{"value":"INFN, Rome","record":{"$ref":"https://inspirehep.net/api/institutions/902887"}}],"signature_block":"STARANr"}],"curated":true,"texkeys":["Porto:2007pw"],"citeable":true,"abstracts":[{"value":"The problem of motion in General Relativity has lost its academic status and become an active research area since the next generation of gravity wave detectors will rely upon its solution. Here we will show, within scalar gravity, how ideas borrowed from Quantum Field Theory can be used to solve the problem of motion in a systematic fashion. We will concentrate in Post-Newtonian corrections. We will calculate the Einstein-Infeld-Hoffmann action and show how a systematic perturbative expansion puts strong constraints on the couplings of non-derivative interactions in the theory.","source":"arXiv"}],"references":[{"record":{"$ref":"https://inspirehep.net/api/literature/651641"},"reference":{"arxiv_eprint":"gr-qc/0406012","publication_info":{"artid":"091101","journal_title":"Phys.Rev.Lett.","journal_volume":"93"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/659452"},"reference":{"arxiv_eprint":"hep-th/0409156","publication_info":{"artid":"104029","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697837"},"reference":{"arxiv_eprint":"gr-qc/0511061","publication_info":{"artid":"104031","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/697886"},"reference":{"arxiv_eprint":"hep-th/0511133","publication_info":{"artid":"104030","journal_title":"Phys.Rev.D","journal_volume":"73"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/715168"},"reference":{"arxiv_eprint":"gr-qc/0604099","publication_info":{"artid":"021101","journal_title":"Phys.Rev.Lett.","journal_volume":"97"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/742566"},"reference":{"arxiv_eprint":"hep-ph/0701129"},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/155769"},"reference":{"publication_info":{"artid":"2291","page_start":"2291","journal_title":"Phys.Rev.D","journal_volume":"23"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/639311"},"reference":{"publication_info":{"artid":"374","page_start":"374","journal_title":"Nature","journal_volume":"425"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/332753"},"reference":{"publication_info":{"artid":"2093","page_start":"2093","journal_title":"Class.Quant.Grav.","journal_volume":"9"}},"curated_relation":false},{"record":{"$ref":"https://inspirehep.net/api/literature/635833"},"reference":{"arxiv_eprint":"hep-th/0312212"},"curated_relation":false}],"arx