\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces $\gamma $の異なる3つの値に対するGreen関数$G_{\gamma }(0,y)=y^2 g_{\gamma }(0,y)$。$4+\gamma /H=5^2$（黒実線）、$4+\gamma /H=7^2$（破線）、$4+\gamma /H=10^2$（点線）に対し、$G_{\gamma }$の最初のピークはそれぞれ$y=5,\,7,$および$10$付近にあり、ピークの位置が$\sqrt  {4+\gamma /H}$であることを裏づけている。}}{61}{figure.6}\protected@file@percent }
\newlabel{GreGamma}{{6}{61}{$\gamma $の異なる3つの値に対するGreen関数$G_{\gamma }(0,y)=y^2 g_{\gamma }(0,y)$。$4+\gamma /H=5^2$（黒実線）、$4+\gamma /H=7^2$（破線）、$4+\gamma /H=10^2$（点線）に対し、$G_{\gamma }$の最初のピークはそれぞれ$y=5,\,7,$および$10$付近にあり、ピークの位置が$\sqrt {4+\gamma /H}$であることを裏づけている。}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Green関数$G_{\gamma }(x,y)$（上段）と、Hubble時間を単位としたその時間微分$\partial _tG_{\gamma }(x,y)/H=-x\partial _xG_{\gamma }(x,y)$（下段）。左列は$x^\star =\sqrt  {4+\gamma /H}$を固定した$y>x^\star $の関数、右列は$y^\star =\sqrt  {4+\gamma /H}$を固定した$x<y^\star $の関数として示す。すべての図は$x^\star =y^\star =10$に対応する。}}{61}{figure.7}\protected@file@percent }
\newlabel{GreGamma2}{{7}{61}{Green関数$G_{\gamma }(x,y)$（上段）と、Hubble時間を単位としたその時間微分$\partial _tG_{\gamma }(x,y)/H=-x\partial _xG_{\gamma }(x,y)$（下段）。左列は$x^\star =\sqrt {4+\gamma /H}$を固定した$y>x^\star $の関数、右列は$y^\star =\sqrt {4+\gamma /H}$を固定した$x<y^\star $の関数として示す。すべての図は$x^\star =y^\star =10$に対応する。}{figure.7}{}}
