\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}運動学：共形時間と地平線}{15}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces 光円錐と因果律．光子は，{\it  ヌル測地線}と呼ばれる，固有時間がゼロの世界線${\rm  d}s^2 =0$に沿って進む．質量を持つ粒子は，{\it  時間的測地線}と呼ばれる，実数の固有時間を持つ世界線${\rm  d}s^2 > 0$に沿って進む．因果的につながっていない時空の領域は，{\it  空間的}な間隔${\rm  d}s^2 < 0$で隔てられる．時空のある点（あるいは{\it  事象}）を通るすべてのヌル測地線の集合を，{\it  光円錐}という．すべてのヌル測地線と時間的測地線からなる光円錐の内部が，その事象と因果的に関係する時空の領域を定める．}}{16}{figure.caption.13}\protected@file@percent }
\newlabel{fig:lightcone}{{3}{16}{光円錐と因果律．光子は，{\it ヌル測地線}と呼ばれる，固有時間がゼロの世界線$\d s^2 =0$に沿って進む．質量を持つ粒子は，{\it 時間的測地線}と呼ばれる，実数の固有時間を持つ世界線$\d s^2 > 0$に沿って進む．因果的につながっていない時空の領域は，{\it 空間的}な間隔$\d s^2 < 0$で隔てられる．時空のある点（あるいは{\it 事象}）を通るすべてのヌル測地線の集合を，{\it 光円錐}という．すべてのヌル測地線と時間的測地線からなる光円錐の内部が，その事象と因果的に関係する時空の領域を定める．}{figure.caption.13}{}}
\citation{Dodelson,Mukhanov,WeinbergCosmology}
